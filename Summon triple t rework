-- which blessings Trial I may give (no drone, no missile, nothing too strong). nil = anything that is still available.
K.TRIAL_REWARD_POOL = {[1] = {"speed", "jump", "magnet", "fortune", "mercy", "djump", "glide"}}

-- the buff-selection menu: pick ONE blessing for free, then done() is called
function V.Trials.openReward(poolIds, title, done)
	local defs = {}
	for _, d in ipairs(K.BLESSINGS) do
		local inPool = true
		if poolIds then inPool = table.find(poolIds, d.id) ~= nil end
		if inPool and blessingAvailable(d) and (V.lv[d.key] == nil or V.lv[d.key] < (K.CAP[d.key] or 99)) then table.insert(defs, d) end
	end
	if #defs == 0 then toast("Nothing is left to choose from.", 3) done() return end
	local overlay = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = .35, ZIndex = 50, Active = true}, V.gui)
	new("TextLabel", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 70), Size = UDim2.fromOffset(340, 56), BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(255, 200, 120), Font = Enum.Font.GothamBold, TextSize = 22, TextWrapped = true, ZIndex = 51,
		Text = title .. "\nChoose your reward"}, overlay)
	local list = new("ScrollingFrame", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 140), Size = UDim2.new(0, 330, 1, -170),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, #defs * 68), ZIndex = 51}, overlay)
	local chosen = false
	for i, d in ipairs(defs) do
		local card = new("TextButton", {Position = UDim2.fromOffset(0, (i - 1) * 68), Size = UDim2.new(1, -8, 0, 60), BackgroundColor3 = Color3.fromRGB(40, 24, 24),
			TextColor3 = Color3.fromRGB(255, 235, 220), Font = Enum.Font.GothamBold, TextSize = 15, TextWrapped = true, ZIndex = 52,
			Text = d.name .. "\n" .. d.desc}, list)
		corner(card, 10)
		new("UIStroke", {Color = Color3.fromRGB(200, 70, 40), Thickness = 1.5}, card)
		card.MouseButton1Click:Connect(function()
			if chosen then return end
			chosen = true
			grant(d.key, d.greater)
			if d.key == "glide" then V.glideEnergy = V.glideMax end
			refresh()
			sync()
			overlay:Destroy()
			toast("You received: " .. d.name, 4)
			done()
		end)
	end
end
V.Trials.rewards[1] = function(done) V.Trials.openReward(K.TRIAL_REWARD_POOL[1], "TRIAL OF STONE CONQUERED", done) end
V.Trials.rewards[2] = function(done) V.Trials.openReward(nil, "TRIAL OF BONE CONQUERED", done) end -- Trial II: ANY blessing that is still available

function V.Trials.startFight(ctx, cfg)
	local model = ctx.model
	local lp = V.lp
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) then return end
	local A = ctx.origin + Vector3.new(0, 0, 520) -- arena centre (the floor's top surface is at A.Y)
	local FLOOR_R, WALL_R, WALL_H = 80, 86, 70
	local EMBER, PURPLE, ROCKC = Color3.fromRGB(255, 90, 30), Color3.fromRGB(170, 60, 255), Color3.fromRGB(46, 36, 34)
	local bc = cfg.boss

	-- ---------- the arena ----------
	local function solid(size, cf, color, mat, collide, shape)
		return new("Part", {Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Basalt, Anchored = true,
			CanCollide = collide ~= false, CanTouch = false, Shape = shape or Enum.PartType.Block}, model)
	end
	local function cylY(diam, h, pos, color, mat, collide)
		return solid(Vector3.new(h, diam, diam), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, mat, collide, Enum.PartType.Cylinder)
	end
	cylY(FLOOR_R * 2 + 2, 3.6, A - Vector3.new(0, 2.2, 0), EMBER, Enum.Material.Neon)                 -- glowing rim
	cylY(FLOOR_R * 2, 4, A - Vector3.new(0, 2, 0), Color3.fromRGB(58, 48, 46), Enum.Material.Slate)     -- the floor
	cylY(44, .1, A + Vector3.new(0, .06, 0), EMBER, Enum.Material.Neon, false)                          -- ritual circle in the middle
	cylY(41, .12, A + Vector3.new(0, .1, 0), Color3.fromRGB(40, 32, 30), Enum.Material.Slate, false)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		solid(Vector3.new(.6, .1, 16), CFrame.new(A + Vector3.new(math.cos(a) * 14, .14, math.sin(a) * 14)) * CFrame.Angles(0, -a, 0), EMBER, Enum.Material.Neon, false)
	end
	for i = 0, 27 do -- the wall: 28 slabs facing the middle
		local a = i / 28 * math.pi * 2
		local pos = A + Vector3.new(math.cos(a) * WALL_R, WALL_H / 2 - 2, math.sin(a) * WALL_R)
		solid(Vector3.new(2 * math.pi * WALL_R / 28 + 1.2, WALL_H, 6), CFrame.lookAt(pos, Vector3.new(A.X, pos.Y, A.Z)), Color3.fromRGB(34, 26, 25))
		local band = A + Vector3.new(math.cos(a) * (WALL_R - 3.2), .6, math.sin(a) * (WALL_R - 3.2))
		solid(Vector3.new(2 * math.pi * WALL_R / 28, 1.2, .5), CFrame.lookAt(band, Vector3.new(A.X, band.Y, A.Z)), EMBER, Enum.Material.Neon, false)
	end
	cylY(WALL_R * 2 + 16, 6, A + Vector3.new(0, WALL_H + 1, 0), Color3.fromRGB(34, 26, 25))              -- the roof
	for _ = 1, 30 do
		local w, h = math.random(3, 8), math.random(8, 28)
		local a, r = math.random() * math.pi * 2, math.random() * (WALL_R - 8)
		solid(Vector3.new(w, h, w), CFrame.new(A + Vector3.new(math.cos(a) * r, WALL_H - 2 - h / 2, math.sin(a) * r)), ROCKC, Enum.Material.Basalt, false)
	end
	for k = 0, 7 do -- fire bowls on stone stands around the arena
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local pos = A + Vector3.new(math.cos(a) * 66, 0, math.sin(a) * 66)
		solid(Vector3.new(5, 8, 5), CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.fromRGB(70, 62, 58), Enum.Material.Slate)
		local bowl = solid(Vector3.new(2, 7, 7), CFrame.new(pos + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(50, 44, 42), Enum.Material.Slate, false, Enum.PartType.Cylinder)
		new("Fire", {Size = 9, Heat = 10, Color = Color3.fromRGB(255, 70, 0), SecondaryColor = Color3.fromRGB(255, 170, 40)}, bowl)
		new("PointLight", {Color = Color3.fromRGB(255, 110, 40), Range = 38, Brightness = 1.3, Shadows = false}, bowl)
	end

	-- ---------- player: your health is the normal Roblox health; the bar on the screen is the giant orb's ----------
	local invuln = 0
	local gui = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 8, Active = false}, V.gui)
	table.insert(ctx.cleanups, function() gui:Destroy() end)
	local objective = new("TextLabel", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 100), Size = UDim2.fromOffset(380, 30), BackgroundColor3 = Color3.fromRGB(15, 8, 8),
		BackgroundTransparency = .3, TextColor3 = Color3.fromRGB(255, 220, 190), Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true, Text = "", ZIndex = 9}, gui)
	corner(objective, 8)
	local hurt = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(200, 0, 0), BackgroundTransparency = 1, ZIndex = 7}, gui)
	local function setObjective(t) objective.Text = t end

	local bossBarFill -- (only Trial II and later show the boss health bar)
	local barFills = {}
	if bc.bar then
		local holder = new("Frame", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 134), Size = UDim2.fromOffset(440, 48), BackgroundTransparency = 1, ZIndex = 9}, gui)
		new("TextLabel", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = bc.name, TextColor3 = Color3.fromRGB(235, 205, 255), TextStrokeTransparency = .3,
			Font = Enum.Font.GothamBold, TextSize = 14, ZIndex = 10}, holder) -- the name is above the bar
		local bar = new("Frame", {Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Color3.fromRGB(20, 8, 20), ZIndex = 9}, holder)
		corner(bar, 6)
		new("UIStroke", {Color = Color3.fromRGB(190, 80, 255), Thickness = 1.5}, bar)
		for i = 1, bc.sections do
			local seg = new("Frame", {Position = UDim2.new((i - 1) / bc.sections, 2, 0, 2), Size = UDim2.new(1 / bc.sections, -4, 1, -4), BackgroundColor3 = Color3.fromRGB(35, 14, 40), ZIndex = 10}, bar)
			barFills[i] = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(190, 80, 255), ZIndex = 11}, seg) -- full at the start
		end
		for i = 1, bc.sections - 1 do -- the lines that divide the bar into its three cycles
			new("Frame", {Position = UDim2.new(i / bc.sections, -1, 0, 0), Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 240, 255), ZIndex = 12}, bar)
		end
		bossBarFill = holder
		holder.Visible = false
	end

	local function damagePlayer(n) -- real Humanoid damage: your normal Roblox health bar goes down
		if invuln > 0 or hum.Health <= 0 then return end
		hum:TakeDamage(n)
		invuln = .9
		hurt.BackgroundTransparency = .55
		TS:Create(hurt, TweenInfo.new(.5), {BackgroundTransparency = 1}):Play()
	end

	-- the sword: a regular Roblox sword (the classic Sword tool when it can be loaded, otherwise one built to look like it), swung with the normal slash animation
	local function buildClassicSword()
		local t = Instance.new("Tool")
		t.Name, t.RequiresHandle, t.CanBeDropped = "Sword", true, false
		t.GripForward, t.GripPos, t.GripRight, t.GripUp = Vector3.new(-1, 0, 0), Vector3.new(0, 0, -1.5), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1)
		local blade = new("Part", {Name = "Handle", Size = Vector3.new(1, .8, 4), Color = Color3.fromRGB(196, 198, 205), Material = Enum.Material.Metal, CanCollide = false, Massless = true}, t)
		local guard = new("Part", {Size = Vector3.new(3.4, .5, .55), Color = Color3.fromRGB(60, 44, 34), Material = Enum.Material.Wood, CanCollide = false, Massless = true}, t)
		local grip = new("Part", {Size = Vector3.new(.55, .55, 1.5), Color = Color3.fromRGB(86, 60, 42), Material = Enum.Material.Wood, CanCollide = false, Massless = true}, t)
		new("Weld", {Part0 = blade, Part1 = guard, C0 = CFrame.new(0, 0, -1.2)}, guard)
		new("Weld", {Part0 = blade, Part1 = grip, C0 = CFrame.new(0, 0, -2.2)}, grip)
		return t
	end
	local tool
	pcall(function() -- the real classic sword model from the catalogue (executors can load it; scripts inside are removed, we do the hits ourselves)
		local objs = game:GetObjects("rbxassetid://47433")
		local found = objs and objs[1]
		if found and found:IsA("Tool") then
			for _, d in ipairs(found:GetDescendants()) do if d:IsA("LuaSourceContainer") then d:Destroy() end end
			if found:FindFirstChild("Handle") then tool = found end
		end
	end)
	tool = tool or buildClassicSword()
	tool.Name, tool.CanBeDropped = "Sword", false
	table.insert(ctx.cleanups, function() tool:Destroy() end)
	local backpack = lp:FindFirstChildOfClass("Backpack")
	if backpack then tool.Parent = backpack end
	task.delay(.3, function() if tool.Parent and hum.Parent then pcall(function() hum:EquipTool(tool) end) end end)

	-- ---------- enemies, rocks ----------
	local orbs, rocks, shots = {}, {}, {}
	local held
	local boss
	local state, wave, queue, spawnT = "intro", 0, 0, 0
	local nextAt, nextFn = os.clock() + 2.5, function() end

	local function burst(pos, color, size)
		local b = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size) * .4, Position = pos, Color = color, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .1}, model)
		TS:Create(b, TweenInfo.new(.4), {Size = Vector3.new(size, size, size), Transparency = 1}):Play()
		Debris:AddItem(b, .5)
	end
	local function spawnOrb(pos)
		local part = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = pos, Color = Color3.fromRGB(150, 60, 230), Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false}, model)
		new("PointLight", {Color = Color3.fromRGB(170, 80, 255), Range = 14, Brightness = 1.2, Shadows = false}, part)
		table.insert(orbs, {part = part, pos = pos, hp = cfg.orbHP, cd = 0, spd = cfg.orbSpeed * (.85 + math.random() * .3), ph = math.random() * 6.28})
	end
	local function killOrb(o)
		burst(o.pos, Color3.fromRGB(190, 110, 255), 9)
		o.part:Destroy()
		local i = table.find(orbs, o)
		if i then table.remove(orbs, i) end
	end
	local function clearOrbs() for i = #orbs, 1, -1 do orbs[i].part:Destroy() orbs[i] = nil end end

	local function newRock()
		local a, r = math.random() * math.pi * 2, 10 + math.random() * 58
		local sz = 2.4 + math.random()
		local rk = new("Part", {Size = Vector3.new(sz, sz * .85, sz * 1.1), CFrame = CFrame.new(A + Vector3.new(math.cos(a) * r, sz * .45, math.sin(a) * r))
			* CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3), Color = Color3.fromRGB(96, 88, 84), Material = Enum.Material.Slate,
			Anchored = true, CanCollide = false, CanTouch = false}, model)
		table.insert(rocks, rk)
	end
	for _ = 1, 12 do newRock() end
	local rockT = 0

	local throwBtn = new("TextButton", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -200), Size = UDim2.fromOffset(92, 92), BackgroundColor3 = Color3.fromRGB(60, 36, 30),
		TextColor3 = Color3.fromRGB(255, 230, 200), Font = Enum.Font.GothamBold, TextSize = 14, Text = "THROW\nROCK (F)", Visible = false, ZIndex = 20}, gui)
	corner(throwBtn, 46)
	new("UIStroke", {Color = Color3.fromRGB(255, 140, 60), Thickness = 2}, throwBtn)

	-- ---------- the giant curse orb ----------
	local bossCore, bossShell, bossLight, bossTag
	local function bossLook(stunned)
		if not boss then return end
		bossCore.Color = stunned and Color3.fromRGB(50, 28, 70) or PURPLE
		bossCore.Material = stunned and Enum.Material.SmoothPlastic or Enum.Material.Neon
		bossShell.Transparency = stunned and 1 or .72
		bossLight.Enabled = not stunned
		bossTag.Enabled = stunned
	end
	local function updateBossBar()
		if not bossBarFill then return end
		for i = 1, bc.sections do
			local drained = math.clamp(boss.hitsDone - (bc.sections - i) * bc.hitsPerSection, 0, bc.hitsPerSection) / bc.hitsPerSection -- the right-hand section drains first
			barFills[i].Size = UDim2.fromScale(1 - drained, 1) -- every sword hit drains the bar
		end
	end
	local function spawnBoss()
		local pos = A + Vector3.new(0, 45, 0)
		bossCore = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), Position = pos, Color = PURPLE, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false}, model)
		bossShell = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(17.5, 17.5, 17.5), Position = pos, Color = Color3.fromRGB(210, 150, 255), Material = Enum.Material.Neon,
			Transparency = .72, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		bossLight = new("PointLight", {Color = PURPLE, Range = 55, Brightness = 2.5, Shadows = false}, bossCore)
		local bb = new("BillboardGui", {Size = UDim2.fromOffset(200, 50), StudsOffset = Vector3.new(0, 11, 0), AlwaysOnTop = true, Enabled = false, Adornee = bossCore}, bossCore)
		bossTag = bb
		new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "STUNNED", TextColor3 = Color3.fromRGB(255, 240, 160), Font = Enum.Font.GothamBold, TextScaled = true}, bb)
		boss = {pos = pos, vel = Vector3.zero, r = 7, rocksHit = 0, hitsDone = 0, stunned = false, stunT = 0, spawnT = 4, ang = -math.pi / 2, t = 0, arrived = false}
		if bossBarFill then bossBarFill.Visible = true end
		updateBossBar()
	end

	local function stunBoss()
		boss.stunned, boss.stunT, boss.rocksHit = true, bc.window, 0
		bossLook(true)
		burst(boss.pos, Color3.fromRGB(255, 255, 255), 26)
		setObjective("STUNNED! Strike it with your sword!")
	end
	local function recoverBoss()
		boss.stunned, boss.rocksHit = false, 0
		bossLook(false)
		burst(boss.pos, PURPLE, 30)
		setObjective(bc.name .. " - throw rocks at it (0/" .. bc.rocks .. ")")
	end
	local function victory()
		state = "victory"
		clearOrbs()
		burst(boss.pos, Color3.fromRGB(255, 255, 255), 60)
		burst(boss.pos, PURPLE, 90)
		bossCore:Destroy() bossShell:Destroy()
		boss = nil
		if bossBarFill then bossBarFill.Visible = false end
		setObjective("The giant curse orb is destroyed.")
		toast("The giant curse orb shatters!", 4)
		nextAt, nextFn = os.clock() + 3, function() ctx.complete() end
	end

	-- ---------- rocks: pick up (walk over), throw (button or F) ----------
	local function throwRock()
		if not held or not boss then return end
		local rp = root.Position + Vector3.new(0, 2, 0)
		local look = workspace.CurrentCamera.CFrame.LookVector
		local dir = look
		if not boss.stunned then
			local dist = (boss.pos - rp).Magnitude
			local t = dist / 95
			local aim = boss.pos + boss.vel * t + Vector3.new(0, 22.5 * t * t, 0) -- lead the target and allow for gravity
			local to = (aim - rp).Unit
			if look:Dot(to) > .8 then dir = look:Lerp(to, .8).Unit end -- gentle aim assist when you are roughly facing it
		end
		held.CFrame = CFrame.new(rp + look * 3)
		table.insert(shots, {part = held, vel = dir * 95, life = 0})
		held = nil
		throwBtn.Visible = false
	end
	throwBtn.MouseButton1Click:Connect(throwRock)
	local inputConn = UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.F then throwRock() end
	end)
	table.insert(ctx.cleanups, function() inputConn:Disconnect() end)

	-- ---------- sword swings ----------
	local lastSwing = 0
	local function swordHit()
		local rp = root.Position
		local look = root.CFrame.LookVector
		for i = #orbs, 1, -1 do
			local o = orbs[i]
			local v = o.pos - rp
			if v.Magnitude < 10.5 and (v.Magnitude < 4.5 or v.Unit:Dot(look) > .1) then
				o.hp -= 1
				if o.hp <= 0 then killOrb(o) else burst(o.pos, Color3.new(1, 1, 1), 6) end
			end
		end
		if boss and boss.stunned and (boss.pos - rp).Magnitude < boss.r + 9 then
			boss.hitsDone += 1
			burst(boss.pos + (rp - boss.pos).Unit * boss.r, Color3.fromRGB(255, 240, 160), 10)
			updateBossBar()
			if boss.hitsDone % bc.hitsPerSection == 0 then -- one more of its cycles is finished
				local done = boss.hitsDone // bc.hitsPerSection
				toast("Cycle " .. done .. "/" .. bc.sections .. " complete", 2.5)
				if done >= bc.sections then victory() else recoverBoss() end
			end
		end
	end
	tool.Activated:Connect(function()
		local now = os.clock()
		if now - lastSwing < .42 then return end
		lastSwing = now
		local anim = Instance.new("StringValue") -- the normal Roblox way to make the default character play the sword slash
		anim.Name, anim.Value = "toolanim", "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 1)
		task.delay(.15, swordHit)
	end)

	-- ---------- start of a stage ----------
	local function startWave(n)
		wave, state = n, "waves"
		queue, spawnT = cfg.waves[n], 0
		setObjective("WAVE " .. n .. "/" .. #cfg.waves .. " - slay the curse orbs with your sword")
	end
	local function startBoss()
		state = "bossIntro"
		spawnBoss()
		setObjective(bc.name)
		toast(bc.name .. " awakens!", 3.5)
	end
	-- ---------- teleport in, then run ----------
	root.CFrame = CFrame.lookAt(A + Vector3.new(0, 4, -60), A + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	setObjective("Arena - prepare yourself")
	toast("Slay the curse orbs. Walk over a rock to pick it up.", 5)

	table.insert(ctx.frameFns, function(dt, rt)
		local now = os.clock()
		if invuln > 0 then invuln -= dt end
		local rp = rt.Position
		if rp.Y < A.Y - 30 then rt.CFrame = CFrame.new(A + Vector3.new(0, 4, -40)) rt.AssemblyLinearVelocity = Vector3.zero end

		if nextFn and now >= nextAt then local f = nextFn nextFn = nil f() end

		-- rocks: pick up, hold, fly
		if not held and boss then
			for i = #rocks, 1, -1 do
				local rk = rocks[i]
				if (rk.Position - rp).Magnitude < 5.5 then
					held = rk
					table.remove(rocks, i)
					throwBtn.Visible = true
					break
				end
			end
		end
		if held then held.CFrame = rt.CFrame * CFrame.new(0, 3.6, -.6) * CFrame.Angles(now * 2, now * 1.3, 0) end
		rockT += dt
		if rockT > 3 and #rocks < 10 then rockT = 0 newRock() end
		for i = #shots, 1, -1 do
			local sh = shots[i]
			sh.life += dt
			sh.vel += Vector3.new(0, -45, 0) * dt
			sh.part.Position += sh.vel * dt
			sh.part.CFrame = CFrame.new(sh.part.Position) * (sh.part.CFrame - sh.part.CFrame.Position) * CFrame.Angles(dt * 6, dt * 4, 0)
			local gone = false
			if boss and not boss.stunned and (sh.part.Position - boss.pos).Magnitude < boss.r + 1.5 then
				gone = true
				boss.rocksHit += 1
				burst(sh.part.Position, Color3.new(1, 1, 1), 12)
				if boss.rocksHit >= bc.rocks then stunBoss()
				else setObjective(bc.name .. " - rock hit " .. boss.rocksHit .. "/" .. bc.rocks) end
			elseif sh.part.Position.Y < A.Y + .6 or sh.life > 5 then
				gone = true
			end
			if gone then
				sh.part:Destroy()
				table.remove(shots, i)
			end
		end

		-- the small curse orbs
		local tt = now
		for _, o in ipairs(orbs) do
			local goal = Vector3.new(rp.X, A.Y + 4 + math.sin(tt * 3 + o.ph) * .8, rp.Z)
			local to = goal - o.pos
			local flat = Vector3.new(to.X, 0, to.Z)
			local dirv = flat.Magnitude > .1 and flat.Unit or Vector3.zero
			local perp = Vector3.new(-dirv.Z, 0, dirv.X)
			if o.cd > 0 then o.cd -= dt dirv = -dirv end -- after a hit it backs off for a moment
			local move = (dirv + perp * math.sin(tt * 2 + o.ph) * .6) * o.spd * dt
			o.pos = Vector3.new(o.pos.X + move.X, o.pos.Y + (goal.Y - o.pos.Y) * math.min(1, dt * 4), o.pos.Z + move.Z)
			o.part.Position = o.pos
			if o.cd <= 0 and (o.pos - rp).Magnitude < 4.6 then
				damagePlayer(cfg.orbDmg)
				o.cd = 1.2
			end
		end

		-- stage logic
		if state == "intro" and nextFn == nil and wave == 0 then
			startWave(1)
		elseif state == "waves" then
			if queue > 0 then
				spawnT -= dt
				if spawnT <= 0 then
					local a = math.random() * math.pi * 2
					spawnOrb(A + Vector3.new(math.cos(a) * 70, 4, math.sin(a) * 70))
					queue -= 1
					spawnT = cfg.spawnGap or .7
				end
			elseif #orbs == 0 then
				hum.Health = math.min(hum.MaxHealth, hum.Health + cfg.healBetweenWaves)
				if wave < #cfg.waves then
					toast("Wave " .. wave .. " cleared", 2.5)
					state = "between"
					nextAt, nextFn = now + 3, function() startWave(wave + 1) end
				else
					state = "between"
					nextAt, nextFn = now + 3, startBoss
				end
			end
		elseif state == "bossIntro" and boss then
			local target = A + Vector3.new(0, 15, 30)
			boss.pos = boss.pos:Lerp(target, math.min(1, dt * 1.6))
			bossCore.Position, bossShell.Position = boss.pos, boss.pos
			if (boss.pos - target).Magnitude < 2 then
				state = "boss"
				recoverBoss()
			end
		elseif state == "boss" and boss then
			boss.t += dt
			local last = boss.pos
			if boss.stunned then
				local rest = Vector3.new(boss.pos.X, A.Y + boss.r, boss.pos.Z)
				boss.pos = boss.pos:Lerp(rest, math.min(1, dt * 3)) -- it sinks to the floor
				boss.stunT -= dt
				setObjective("STUNNED! Strike it! " .. math.max(0, math.ceil(boss.stunT)) .. "s  (" .. (boss.hitsDone % bc.hitsPerSection) .. "/" .. bc.hitsPerSection .. ")")
				if boss.stunT <= 0 then
					toast("It recovers!", 2)
					recoverBoss()
				end
			else
				boss.ang += (bc.speed / 30) * dt
				local target = A + Vector3.new(math.cos(boss.ang) * 30, 15 + math.sin(boss.t * 1.3) * 1.5, math.sin(boss.ang) * 30)
				boss.pos = boss.pos:Lerp(target, math.min(1, dt * 3))
				boss.spawnT -= dt
				if boss.spawnT <= 0 and #orbs < bc.maxMinions then
					spawnOrb(boss.pos - Vector3.new(0, 3, 0))
					boss.spawnT = bc.spawnEvery
				end
			end
			boss.vel = (boss.pos - last) / math.max(dt, 1e-3)
			bossCore.Position, bossShell.Position = boss.pos, boss.pos
		end
	end)
end

for n = 1, 2 do
	V.Trials.arenas[n] = function(ctx)
		table.clear(ctx.frameFns) -- the obby is over: its checkpoint and finish checks stop here
		ctx.killY = -1e9
		task.spawn(function()
			flashTo(0, .3)
			task.wait(.4)
			if V.Trials.active ~= ctx then flashTo(1, .5) return end
			local ok, err = pcall(V.Trials.startFight, ctx, K.TRIAL_ARENAS[n])
			if not ok then -- never leave the screen red: report the error and get out
				warn("[DemonSummon] arena " .. n .. " failed: " .. tostring(err))
				toast("Arena failed: " .. tostring(err), 8)
				V.Trials.leave(false)
			end
			flashTo(1, .7)
		end)
	end
end

-- ===== TRIAL II: the bone ring obby (Part 4) =====
-- A different, harder obby: one big ring of platforms climbing around a hall of bone and fire. Smaller platforms (4-8 studs, a few 14-stud
-- checkpoints), 8-9 stud gaps, sideways zigzags, tiny stepping stones and long jumps. Nothing can be skipped.
V.Trials.builders[2] = function(ctx)
	local model, frameFns, base = ctx.model, ctx.frameFns, ctx.origin
	local BONE, ROCK, EMBER, GOLD = Color3.fromRGB(208, 199, 180), Color3.fromRGB(44, 34, 32), Color3.fromRGB(255, 120, 50), Color3.fromRGB(255, 200, 80)
	local R0 = 90
	local ang, rad, lastW, curY = math.rad(180), R0, 18, base.Y
	local checkpoints = {}
	local minX, maxX, minZ, maxZ, maxY = math.huge, -math.huge, math.huge, -math.huge, -math.huge

	local function place(top, w, opts)
		opts = opts or {}
		minX, maxX = math.min(minX, top.X - w / 2), math.max(maxX, top.X + w / 2)
		minZ, maxZ = math.min(minZ, top.Z - w / 2), math.max(maxZ, top.Z + w / 2)
		maxY = math.max(maxY, top.Y)
		if opts.checkpoint then
			opts.stripe = GOLD
			local up = top + Vector3.new(0, 3, 0)
			local tangent = Vector3.new(-math.sin(ang), 0, math.cos(ang))
			table.insert(checkpoints, {top = top, w = w, cf = CFrame.lookAt(up, up + tangent), hit = false})
		end
		new("Part", {Size = Vector3.new(w, 2, w), CFrame = CFrame.new(top - Vector3.new(0, 1, 0)), Color = BONE, Material = Enum.Material.Marble,
			Anchored = true, CanCollide = true, CanTouch = false}, model)
		local h = 8 + w * .5
		new("Part", {Size = Vector3.new(w * .55, h, w * .55), CFrame = CFrame.new(top - Vector3.new(0, 2 + h / 2, 0)), Color = ROCK, Material = Enum.Material.Basalt,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		if opts.stripe then
			new("Part", {Size = Vector3.new(w * .9, .2, w * .9), CFrame = CFrame.new(top + Vector3.new(0, .1, 0)), Color = opts.stripe,
				Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false}, model)
		end
		lastW = w
	end
	local function arc(gap, dy, w, off, opts) -- next platform along the ring; off = how far in or out of the ring's middle lane it sits
		local dist = gap + lastW / 2 + w / 2
		local newR = R0 + off
		local t = math.sqrt(math.max(dist * dist - (newR - rad) ^ 2, 1))
		ang += t / ((rad + newR) / 2)
		rad, curY = newR, curY + dy
		place(Vector3.new(base.X + math.cos(ang) * rad, curY, base.Z + math.sin(ang) * rad), w, opts)
	end
	local CP, FIN = {checkpoint = true}, {stripe = EMBER}
	local startTop = Vector3.new(base.X + math.cos(ang) * rad, curY, base.Z + math.sin(ang) * rad)
	place(startTop, 18, CP)
	-- A: sideways zigzag
	arc(8, 0, 8, 5); arc(8, 0, 8, -5); arc(8, 1, 8, 5); arc(8, 0, 8, -5); arc(8, 1, 8, 0); arc(8, 0, 14, 0, CP)
	-- B: small stepping stones
	arc(8, 0, 6, 0); arc(8, 1, 6, 5); arc(8, 1, 6, -5); arc(8, 0, 6, 0); arc(8, 1, 6, 0)
	-- C: narrow rising ledges
	arc(7, 3, 5, 0); arc(7, 3, 5, 4); arc(7, 3, 5, -4); arc(7, 3, 5, 0); arc(7, 1, 14, 0, CP)
	-- D: a drop and long jumps
	arc(8, -1, 7, 0); arc(9, -1, 7, 0); arc(8, 0, 6, 6); arc(8, 1, 6, -6); arc(8, 1, 6, 0)
	-- E: tiny stones
	arc(7, 1, 4, 0); arc(7, 1, 4, 3); arc(7, 1, 4, -3); arc(7, 1, 4, 0); arc(7, 1, 14, 0, CP)
	-- F: the long-jump stretch
	arc(9, -1, 7, 0); arc(9, -1, 7, 0); arc(9, 0, 7, 0); arc(8, 1, 6, 0)
	-- G: the final climb, then the ember platform that opens the arena
	arc(8, 3, 5, 0); arc(8, 3, 5, 5); arc(8, 3, 5, -5); arc(8, 3, 5, 0); arc(7, 0, 14, 0, CP)
	arc(8, 3, 30, 0, FIN)
	local finTop = Vector3.new(base.X + math.cos(ang) * rad, curY, base.Z + math.sin(ang) * rad)

	-- the hall: lava floor, walls, a roof, white-hot cracks and bone spires
	local M = 60
	local x0, x1, z0, z1 = minX - M, maxX + M, minZ - M, maxZ + M
	local cx, cz, sx, sz = (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0
	local LAVA_Y, ROOF_Y = base.Y - 50, maxY + 80
	local WALL_B = LAVA_Y - 10
	ctx.killY = LAVA_Y + 3
	local function solid(size, center, color, mat, collide)
		return new("Part", {Size = size, CFrame = CFrame.new(center), Color = color, Material = mat or Enum.Material.Basalt, Anchored = true,
			CanCollide = collide ~= false, CanTouch = false, CanQuery = collide ~= false}, model)
	end
	local lava = solid(Vector3.new(sx, 1, sz), Vector3.new(cx, LAVA_Y - .5, cz), Color3.fromRGB(255, 80, 20), Enum.Material.Neon, false)
	new("ParticleEmitter", {Rate = 40, Lifetime = NumberRange.new(2, 5), Speed = NumberRange.new(3, 10), SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(.8), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 190, 90))}, lava)
	local WH = ROOF_Y - WALL_B
	local WALL_COL = Color3.fromRGB(38, 30, 29)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x1 + 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x0 - 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z1 + 3), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z0 - 3), WALL_COL)
	solid(Vector3.new(sx + 12, 6, sz + 12), Vector3.new(cx, ROOF_Y + 3, cz), WALL_COL)
	for _, y in ipairs({LAVA_Y + 1, ROOF_Y - .6}) do
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x1 - .3, y, cz), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x0 + .3, y, cz), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z1 - .3), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z0 + .3), EMBER, Enum.Material.Neon, false)
	end
	for _ = 1, 26 do
		local len = math.random(14, 46)
		solid(math.random() < .5 and Vector3.new(len, .3, 2) or Vector3.new(2, .3, len),
			Vector3.new(x0 + math.random() * sx, ROOF_Y - .2, z0 + math.random() * sz), Color3.fromRGB(255, 225, 190), Enum.Material.Neon, false)
	end
	for _ = 1, 60 do
		local w, h = math.random(3, 8), math.random(10, 34)
		solid(Vector3.new(w, h, w), Vector3.new(x0 + math.random() * sx, ROOF_Y - h / 2, z0 + math.random() * sz), ROCK, Enum.Material.Basalt, false)
	end
	for _ = 1, 26 do -- pale bone spires standing in the lava
		local w, top = math.random(6, 16), LAVA_Y + math.random(3, 16)
		solid(Vector3.new(w, top - (LAVA_Y - 20), w), Vector3.new(x0 + math.random() * sx, (top + LAVA_Y - 20) / 2, z0 + math.random() * sz), BONE, Enum.Material.Marble, false)
	end

	table.insert(frameFns, function(dt, root)
		lava.Color = Color3.fromRGB(255, 70 + 40 * (.5 + .5 * math.sin(os.clock() * 1.3)), 20)
		local p = root.Position
		if p.Y < ctx.respawnCF.Position.Y - 70 then
			root.CFrame = ctx.respawnCF
			root.AssemblyLinearVelocity = Vector3.zero
		end
		for _, cp in ipairs(checkpoints) do
			if not cp.hit and math.abs(p.Y - (cp.top.Y + 3)) < 4 and Vector3.new(p.X - cp.top.X, 0, p.Z - cp.top.Z).Magnitude < cp.w / 2 + .5 then
				cp.hit = true
				ctx.respawnCF = cp.cf
				toast("Checkpoint", 1.5)
			end
		end
	end)
	local fired = false
	table.insert(frameFns, function(dt, root)
		if fired then return end
		local p = root.Position
		if math.abs(p.Y - (finTop.Y + 3)) < 5 and Vector3.new(p.X - finTop.X, 0, p.Z - finTop.Z).Magnitude < 15 then
			fired = true
			toast("The bone gate opens...", 2.5)
			ctx.toArena()
		end
	end)
	local start = startTop + Vector3.new(0, 3, 0)
	ctx.respawnCF = CFrame.lookAt(start, start + Vector3.new(-math.sin(math.rad(180)), 0, math.cos(math.rad(180))))
	return ctx.respawnCF
end

-- ===== TRIAL III: the final obby (Part 5) =====
-- The longest and hardest: four long lanes joined by three wraparound half-spirals, 65 platforms, and three new obstacles:
-- brown cracked platforms CRUMBLE shortly after you land (and come back), light-blue platforms SLIDE sideways (they carry you), and big
-- platforms have a red SPINNING BAR you must jump over. Gaps up to 8 studs, platforms down to 5 studs. Nothing can be skipped.
V.Trials.builders[3] = function(ctx)
	local model, frameFns, base = ctx.model, ctx.frameFns, ctx.origin
	local OBS, CRACK, ROCK = Color3.fromRGB(62, 50, 50), Color3.fromRGB(150, 100, 84), Color3.fromRGB(34, 26, 26)
	local EMBER, GOLD, RED, ICE = Color3.fromRGB(255, 80, 30), Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 50, 40), Color3.fromRGB(120, 200, 255)
	local cursor, dirDeg, lastW = base + Vector3.new(-115, 0, -135), 0, 16
	local checkpoints, dyn = {}, {}
	local minX, maxX, minZ, maxZ, maxY = math.huge, -math.huge, math.huge, -math.huge, -math.huge

	local function dirVec()
		local d = math.rad(dirDeg)
		return Vector3.new(math.cos(d), 0, math.sin(d))
	end
	local function standing(root, center, w)
		local p = root.Position
		local dy = p.Y - center.Y
		return math.abs(p.X - center.X) < w / 2 + .4 and math.abs(p.Z - center.Z) < w / 2 + .4 and dy > 1.5 and dy < 6
	end
	local function place(top, w, opts)
		opts = opts or {}
		minX, maxX = math.min(minX, top.X - w / 2), math.max(maxX, top.X + w / 2)
		minZ, maxZ = math.min(minZ, top.Z - w / 2), math.max(maxZ, top.Z + w / 2)
		maxY = math.max(maxY, top.Y)
		local kind = opts.kind
		if opts.checkpoint then
			local up = top + Vector3.new(0, 3, 0)
			table.insert(checkpoints, {top = top, w = w, cf = CFrame.lookAt(up, up + dirVec()), hit = false})
		end
		local slab = new("Part", {Size = Vector3.new(w, 2, w), CFrame = CFrame.new(top - Vector3.new(0, 1, 0)), Color = kind == "crumble" and CRACK or OBS,
			Material = kind == "crumble" and Enum.Material.Slate or Enum.Material.Basalt, Anchored = true, CanCollide = true, CanTouch = false}, model)
		local h = 8 + w * .5
		local under = new("Part", {Size = Vector3.new(w * .55, h, w * .55), CFrame = CFrame.new(top - Vector3.new(0, 2 + h / 2, 0)), Color = ROCK, Material = Enum.Material.Basalt,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		local stripeCol = opts.checkpoint and GOLD or opts.stripe or (kind == "slide" and ICE) or nil
		local stripe
		if stripeCol then
			stripe = new("Part", {Size = Vector3.new(w * .9, .2, w * .9), CFrame = CFrame.new(top + Vector3.new(0, .1, 0)), Color = stripeCol, Material = Enum.Material.Neon,
				Anchored = true, CanCollide = false, CanTouch = false}, model)
		end
		if kind == "crumble" then -- falls .7 s after you land, comes back after 3.5 s
			local c = {state = "idle", t = 0}
			table.insert(dyn, function(dt, root, now)
				if c.state == "idle" then
					if standing(root, top, w) then c.state, c.t = "shake", now end
				elseif c.state == "shake" then
					slab.CFrame = CFrame.new(top - Vector3.new(0, 1, 0) + Vector3.new(math.sin(now * 60) * .15, 0, 0))
					if now - c.t > .7 then
						c.state, c.t = "gone", now
						slab.CanCollide = false
						TS:Create(slab, TweenInfo.new(.3), {Transparency = 1}):Play()
					end
				elseif c.state == "gone" and now - c.t > 3.5 then
					slab.CFrame, slab.Transparency, slab.CanCollide, c.state = CFrame.new(top - Vector3.new(0, 1, 0)), 0, true, "idle"
				end
			end)
		elseif kind == "slide" then -- swings sideways and carries you
			local d = dirVec()
			local side = Vector3.new(-d.Z, 0, d.X)
			local ph, last = math.random() * 6, Vector3.zero
			table.insert(dyn, function(dt, root, now)
				local off = side * math.sin(now * 2 * math.pi / 3.6 + ph) * 7
				if standing(root, top + last, w) then root.CFrame += off - last end
				slab.CFrame = CFrame.new(top + off - Vector3.new(0, 1, 0))
				under.CFrame = CFrame.new(top + off - Vector3.new(0, 2 + h / 2, 0))
				if stripe then stripe.CFrame = CFrame.new(top + off + Vector3.new(0, .1, 0)) end
				last = off
			end)
		end
		if opts.spin then -- a red bar sweeps round the platform: jump it
			local spd = opts.spin
			local len = w * .9
			local bar = new("Part", {Size = Vector3.new(len, 1.5, 1.6), CFrame = CFrame.new(top + Vector3.new(0, 1.2, 0)), Color = RED, Material = Enum.Material.Neon,
				Anchored = true, CanCollide = true, CanTouch = false}, model)
			table.insert(dyn, function(dt, root, now)
				bar.CFrame = CFrame.new(top + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, now * spd, 0)
				bar.AssemblyAngularVelocity = Vector3.new(0, spd, 0)
				local rel = bar.CFrame:PointToObjectSpace(root.Position)
				if math.abs(rel.X) < len / 2 + 1 and math.abs(rel.Z) < 2.6 and rel.Y > -1.5 and rel.Y < 2.4 then -- the bar sweeps you off
					root.AssemblyLinearVelocity = bar.CFrame.LookVector * (rel.X >= 0 and 1 or -1) * 45 + Vector3.new(0, 22, 0)
				end
			end)
		end
		cursor, lastW = top, w
	end
	local function step(gap, dy, w, turn, opts)
		dirDeg = (dirDeg + (turn or 0)) % 360
		place(cursor + dirVec() * (gap + lastW / 2 + w / 2) + Vector3.new(0, dy, 0), w, opts)
	end
	local function halfLoop(R, n, rise, w, cpw, sg)
		local d = dirVec()
		local side = Vector3.new(-d.Z, 0, d.X) * sg
		local C = cursor + side * R
		for k = 1, n do
			local th = k * math.pi / n
			local top = C + (-side * math.cos(th) + d * math.sin(th)) * R + Vector3.new(0, rise * k, 0)
			place(top, k == n and cpw or w, {checkpoint = k == n})
		end
		dirDeg = (dirDeg + 180) % 360
	end
	local CP, CR, SL, FIN = {checkpoint = true}, {kind = "crumble"}, {kind = "slide"}, {stripe = EMBER}

	-- LANE 1 (+X): zigzag, crumbling bridge, stones, two sliders
	place(cursor, 16, CP)
	step(7, 0, 9, 25); step(7, 0, 9, -50); step(7, 1, 9, 50); step(7, 0, 9, -25)
	step(6, 0, 10, 0, CR); step(6, 1, 10, 0, CR); step(6, 0, 10, 0, CR)
	step(6, 0, 14, 0, CP)
	step(8, 0, 6, 0); step(8, 1, 6, 0); step(8, 0, 6, 0)
	step(7, 0, 12, 0, SL); step(7, 0, 12, 0, SL)
	step(7, 0, 14, 0, CP)
	halfLoop(34, 6, 6, 10, 14, 1)
	-- LANE 2 (-X): spinner, narrow ledges, crumbling zigzag, long jumps, slider
	step(7, 0, 22, 0, {spin = 2.0})
	step(7, 2, 6, 40); step(7, 2, 6, -80); step(7, 2, 6, 80); step(7, 2, 6, -40)
	step(7, 1, 9, 30, CR); step(7, 1, 9, -60, CR); step(7, 1, 9, 30, CR)
	step(7, 0, 14, 0, CP)
	step(8, -1, 8, 0); step(8, 0, 8, 0); step(8, 1, 8, 0)
	step(7, 0, 12, 0, SL)
	step(7, 0, 14, 0, CP)
	halfLoop(34, 6, 6, 10, 14, -1)
	-- LANE 3 (+X): tiny stones, a faster spinner, crumbling run, two sliders
	step(8, 2, 5, 0); step(8, 2, 5, 0); step(8, 2, 5, 0)
	step(7, 0, 24, 0, {spin = 2.6})
	step(6, 1, 9, 0, CR); step(6, 0, 9, 0, CR); step(6, 1, 9, 0, CR)
	step(7, 0, 14, 0, CP)
	step(7, 0, 10, 0, SL); step(7, 0, 10, 0, SL)
	step(7, 0, 14, 0, CP)
	halfLoop(34, 6, 6, 10, 14, 1)
	-- LANE 4 (-X): the last climb, the fastest spinner, then the ember platform that opens the final arena
	step(8, 2, 6, 0); step(8, 2, 6, 30); step(8, 2, 6, -60); step(8, 2, 6, 30)
	step(7, 0, 22, 0, {spin = 3.2})
	step(7, 0, 14, 0, CP)
	step(8, 3, 36, 0, FIN)
	local finTop = cursor

	-- the hall: lava floor, obsidian walls, a roof
	local M = 60
	local x0, x1, z0, z1 = minX - M, maxX + M, minZ - M, maxZ + M
	local cx, cz, sx, sz = (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0
	local LAVA_Y, ROOF_Y = base.Y - 55, maxY + 90
	local WALL_B = LAVA_Y - 10
	ctx.killY = LAVA_Y + 3
	local function solid(size, center, color, mat, collide)
		return new("Part", {Size = size, CFrame = CFrame.new(center), Color = color, Material = mat or Enum.Material.Basalt, Anchored = true,
			CanCollide = collide ~= false, CanTouch = false, CanQuery = collide ~= false}, model)
	end
	local lava = solid(Vector3.new(sx, 1, sz), Vector3.new(cx, LAVA_Y - .5, cz), Color3.fromRGB(255, 70, 20), Enum.Material.Neon, false)
	new("ParticleEmitter", {Rate = 40, Lifetime = NumberRange.new(2, 5), Speed = NumberRange.new(3, 12), SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(.9), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 170, 60))}, lava)
	local WH = ROOF_Y - WALL_B
	local WALL_COL = Color3.fromRGB(28, 20, 22)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x1 + 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x0 - 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z1 + 3), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z0 - 3), WALL_COL)
	solid(Vector3.new(sx + 12, 6, sz + 12), Vector3.new(cx, ROOF_Y + 3, cz), WALL_COL)
	for _, y in ipairs({LAVA_Y + 1, ROOF_Y - .6}) do
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x1 - .3, y, cz), RED, Enum.Material.Neon, false)
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x0 + .3, y, cz), RED, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z1 - .3), RED, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z0 + .3), RED, Enum.Material.Neon, false)
	end
	for _ = 1, 30 do
		local len = math.random(14, 46)
		solid(math.random() < .5 and Vector3.new(len, .3, 2) or Vector3.new(2, .3, len),
			Vector3.new(x0 + math.random() * sx, ROOF_Y - .2, z0 + math.random() * sz), RED, Enum.Material.Neon, false)
	end
	for _ = 1, 70 do
		local w, h = math.random(3, 9), math.random(10, 38)
		solid(Vector3.new(w, h, w), Vector3.new(x0 + math.random() * sx, ROOF_Y - h / 2, z0 + math.random() * sz), ROCK, Enum.Material.Basalt, false)
	end
	for _ = 1, 28 do
		local w, top = math.random(8, 20), LAVA_Y + math.random(3, 16)
		solid(Vector3.new(w, top - (LAVA_Y - 20), w), Vector3.new(x0 + math.random() * sx, (top + LAVA_Y - 20) / 2, z0 + math.random() * sz), ROCK, Enum.Material.Basalt, false)
	end

	local fired = false
	table.insert(frameFns, function(dt, root)
		local now = os.clock()
		lava.Color = Color3.fromRGB(255, 70 + 40 * (.5 + .5 * math.sin(now * 1.3)), 20)
		local p = root.Position
		if p.Y < ctx.respawnCF.Position.Y - 70 then
			root.CFrame = ctx.respawnCF
			root.AssemblyLinearVelocity = Vector3.zero
		end
		for _, cp in ipairs(checkpoints) do
			if not cp.hit and math.abs(p.Y - (cp.top.Y + 3)) < 4 and Vector3.new(p.X - cp.top.X, 0, p.Z - cp.top.Z).Magnitude < cp.w / 2 + .5 then
				cp.hit = true
				ctx.respawnCF = cp.cf
				toast("Checkpoint", 1.5)
			end
		end
		for _, f in ipairs(dyn) do f(dt, root, now) end
		if not fired and math.abs(p.Y - (finTop.Y + 3)) < 5 and Vector3.new(p.X - finTop.X, 0, p.Z - finTop.Z).Magnitude < 17 then
			fired = true
			toast("The gate of the Demon Orb opens...", 2.5)
			ctx.toArena()
		end
	end)
	local start = Vector3.new(base.X - 115, base.Y + 3, base.Z - 135)
	ctx.respawnCF = CFrame.lookAt(start, start + Vector3.new(1, 0, 0))
	return ctx.respawnCF
end

-- ===== the sword (shared by the fights) =====
function V.Trials.giveSword(ctx, hum, onSwing)
	local lp = V.lp
	local function buildClassicSword()
		local t = Instance.new("Tool")
		t.Name, t.RequiresHandle, t.CanBeDropped = "Sword", true, false
		t.GripForward, t.GripPos, t.GripRight, t.GripUp = Vector3.new(-1, 0, 0), Vector3.new(0, 0, -1.5), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1)
		local blade = new("Part", {Name = "Handle", Size = Vector3.new(1, .8, 4), Color = Color3.fromRGB(196, 198, 205), Material = Enum.Material.Metal, CanCollide = false, Massless = true}, t)
		local guard = new("Part", {Size = Vector3.new(3.4, .5, .55), Color = Color3.fromRGB(60, 44, 34), Material = Enum.Material.Wood, CanCollide = false, Massless = true}, t)
		local grip = new("Part", {Size = Vector3.new(.55, .55, 1.5), Color = Color3.fromRGB(86, 60, 42), Material = Enum.Material.Wood, CanCollide = false, Massless = true}, t)
		new("Weld", {Part0 = blade, Part1 = guard, C0 = CFrame.new(0, 0, -1.2)}, guard)
		new("Weld", {Part0 = blade, Part1 = grip, C0 = CFrame.new(0, 0, -2.2)}, grip)
		return t
	end
	local tool
	pcall(function()
		local objs = game:GetObjects("rbxassetid://47433")
		local found = objs and objs[1]
		if found and found:IsA("Tool") then
			for _, d in ipairs(found:GetDescendants()) do if d:IsA("LuaSourceContainer") then d:Destroy() end end
			if found:FindFirstChild("Handle") then tool = found end
		end
	end)
	tool = tool or buildClassicSword()
	tool.Name, tool.CanBeDropped = "Sword", false
	table.insert(ctx.cleanups, function() tool:Destroy() end)
	local backpack = lp:FindFirstChildOfClass("Backpack")
	if backpack then tool.Parent = backpack end
	task.delay(.3, function() if tool.Parent and hum.Parent then pcall(function() hum:EquipTool(tool) end) end end)
	local last = 0
	tool.Activated:Connect(function()
		local now = os.clock()
		if now - last < .42 then return end
		last = now
		local anim = Instance.new("StringValue")
		anim.Name, anim.Value = "toolanim", "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 1)
		task.delay(.15, onSwing)
	end)
	return tool
end

-- ===== TRIAL III FINAL ARENA: the Demon Orb, phases 1 and 2 (Part 5) =====
-- Phase 1: waves of curse orbs (sword) + medium orbs (2 ROCK hits) -> the demon orb dims -> three stationary red orbs joined to it by lines of
-- fire, 3 sword hits each -> they fly back into it and it relights. Phase 2: meteors fall; a few turn BLUE; walk to one, aim the camera at the demon
-- orb and strike the meteor: it is launched into the demon orb, which dims -> the three red orbs again. PHASE 3 IS NOT BUILT YET (Part 6).
function V.Trials.startDemonFight(ctx, cfg)
	local model, lp = ctx.model, V.lp
	local function noToast() end -- no pop-up messages in this fight
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) then return end
	local A = ctx.origin + Vector3.new(0, 0, 520)       -- arena centre (floor top = A.Y)
	local FLOOR_R, BOSS_R = 75, 30
	local P = A + Vector3.new(0, 2, 150)                -- the demon orb's centre: in a lava pit BEHIND the arena
	local PIT_Y = A.Y - 55
	local EMBER, RED, PURPLE = Color3.fromRGB(255, 90, 30), Color3.fromRGB(255, 45, 25), Color3.fromRGB(170, 60, 255)
	local ROCKC, WALLC = Color3.fromRGB(34, 26, 26), Color3.fromRGB(34, 26, 25)

	-- ---------- arena ----------
	local function solid(size, cf, color, mat, collide, shape) -- accepts a CFrame or a plain position
		if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
		return new("Part", {Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Basalt, Anchored = true,
			CanCollide = collide ~= false, CanTouch = false, Shape = shape or Enum.PartType.Block}, model)
	end
	local function cylY(diam, h, pos, color, mat, collide)
		return solid(Vector3.new(h, diam, diam), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, mat, collide, Enum.PartType.Cylinder)
	end
	cylY(FLOOR_R * 2 + 2, 3.6, A - Vector3.new(0, 2.2, 0), EMBER, Enum.Material.Neon)
	cylY(FLOOR_R * 2, 4, A - Vector3.new(0, 2, 0), Color3.fromRGB(56, 44, 42), Enum.Material.Slate)
	cylY(40, .1, A + Vector3.new(0, .06, 0), EMBER, Enum.Material.Neon, false)
	cylY(37, .12, A + Vector3.new(0, .1, 0), Color3.fromRGB(40, 32, 30), Enum.Material.Slate, false)
	local hx0, hx1, hz0, hz1 = A.X - 125, A.X + 125, A.Z - 100, A.Z + 230
	local yB, yT = PIT_Y - 15, A.Y + 140
	local hcx, hcz, hsx, hsz, hh = (hx0 + hx1) / 2, (hz0 + hz1) / 2, hx1 - hx0, hz1 - hz0, yT - yB
	local lavaP = solid(Vector3.new(hsx, 1, hsz), Vector3.new(hcx, PIT_Y - .5, hcz), Color3.fromRGB(255, 70, 20), Enum.Material.Neon, false)
	new("ParticleEmitter", {Rate = 60, Lifetime = NumberRange.new(2, 5), Speed = NumberRange.new(4, 14), SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(1), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 170, 60))}, lavaP)
	solid(Vector3.new(6, hh, hsz + 12), Vector3.new(hx1 + 3, yB + hh / 2, hcz), WALLC)
	solid(Vector3.new(6, hh, hsz + 12), Vector3.new(hx0 - 3, yB + hh / 2, hcz), WALLC)
	solid(Vector3.new(hsx + 12, hh, 6), Vector3.new(hcx, yB + hh / 2, hz1 + 3), WALLC)
	solid(Vector3.new(hsx + 12, hh, 6), Vector3.new(hcx, yB + hh / 2, hz0 - 3), WALLC)
	solid(Vector3.new(hsx + 12, 6, hsz + 12), Vector3.new(hcx, yT + 3, hcz), WALLC)
	for _ = 1, 40 do
		local w, h = math.random(3, 9), math.random(10, 40)
		solid(Vector3.new(w, h, w), Vector3.new(hx0 + math.random() * hsx, yT - h / 2, hz0 + math.random() * hsz), ROCKC, Enum.Material.Basalt, false)
	end
	for k = 1, 14 do -- rock spires standing in the pit around the demon orb
		local a, r = k / 14 * math.pi * 2, 52 + math.random() * 14
		local w, top = math.random(8, 16), PIT_Y + math.random(6, 30)
		solid(Vector3.new(w, top - (PIT_Y - 20), w), Vector3.new(P.X + math.cos(a) * r, (top + PIT_Y - 20) / 2, P.Z + math.sin(a) * r), ROCKC, Enum.Material.Basalt, false)
	end
	for k = 0, 5 do -- fire bowls around the floor
		local a = k / 6 * math.pi * 2 + math.pi / 6
		local pos = A + Vector3.new(math.cos(a) * 64, 0, math.sin(a) * 64)
		solid(Vector3.new(5, 8, 5), CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.fromRGB(70, 62, 58), Enum.Material.Slate)
		local bowl = solid(Vector3.new(2, 7, 7), CFrame.new(pos + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(50, 44, 42), Enum.Material.Slate, false, Enum.PartType.Cylinder)
		new("Fire", {Size = 9, Heat = 10, Color = Color3.fromRGB(255, 70, 0), SecondaryColor = Color3.fromRGB(255, 170, 40)}, bowl)
		new("PointLight", {Color = Color3.fromRGB(255, 110, 40), Range = 38, Brightness = 1.3, Shadows = false}, bowl)
	end

	-- ---------- the demon orb ----------
	local bossParts, bossFires, eyes = {}, {}, {}
	local function bpart(size, rel, color, mat, shape, transp)
		local part = new("Part", {Size = size, CFrame = CFrame.new(P) * rel, Color = color, Material = mat or Enum.Material.Neon, Anchored = true, CanCollide = false,
			CanTouch = false, CanQuery = false, Transparency = transp or 0, Shape = shape or Enum.PartType.Block}, model)
		table.insert(bossParts, {part = part, rel = rel})
		return part
	end
	-- exactly the look of the summoned demon orb (red core, orange shell, flames, fire sparks), just giant
	local SUMMON_RED, SUMMON_ORANGE = Color3.fromRGB(255, 20, 20), Color3.fromRGB(255, 110, 10)
	local core = bpart(Vector3.new(BOSS_R * 2, BOSS_R * 2, BOSS_R * 2), CFrame.new(), SUMMON_RED, Enum.Material.Neon, Enum.PartType.Ball)
	local shell = bpart(Vector3.new(BOSS_R * 2 + 5, BOSS_R * 2 + 5, BOSS_R * 2 + 5), CFrame.new(), SUMMON_ORANGE, Enum.Material.Neon, Enum.PartType.Ball, .6)
	local bossLightObj = new("PointLight", {Color = Color3.fromRGB(255, 40, 20), Range = 60, Brightness = 4, Shadows = false}, core)
	table.insert(bossFires, new("Fire", {Size = 30, Heat = 25, Color = Color3.fromRGB(255, 40, 0), SecondaryColor = Color3.fromRGB(255, 160, 0)}, core))
	table.insert(bossFires, new("ParticleEmitter", {
		Rate = 160, Lifetime = NumberRange.new(.8, 1.6), Speed = NumberRange.new(8, 20), SpreadAngle = Vector2.new(180, 180), LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 60, 20), Color3.fromRGB(255, 170, 40)),
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 11), NumberSequenceKeypoint.new(1, 0)}),
		Transparency = NumberSequence.new(0, 1), Acceleration = Vector3.new(0, 6, 0), Shape = Enum.ParticleEmitterShape.Sphere}, core))
	for _ = 1, 10 do -- more flames licking over its surface
		local dir = Vector3.new(math.random() * 2 - 1, math.random() * .8 + .1, math.random() * 2 - 1).Unit * (BOSS_R - 2)
		local f = bpart(Vector3.new(1, 1, 1), CFrame.new(dir), SUMMON_RED, Enum.Material.Neon, Enum.PartType.Ball, 1)
		table.insert(bossFires, new("Fire", {Size = 30, Heat = 25, Color = Color3.fromRGB(255, 40, 0), SecondaryColor = Color3.fromRGB(255, 160, 0)}, f))
	end
	local bossLit = true
	local bossPos = P - Vector3.new(0, 90, 0)
	local function setBossPos(pos)
		bossPos = pos
