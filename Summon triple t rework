local function lightningBolt(center)
	local ang, dist = math.random() * math.pi * 2, math.random(20, 80)
	local g = center + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = {V.lp.Character}
	local hit = workspace:Raycast(g + Vector3.new(0, 150, 0), Vector3.new(0, -500, 0), rp)
	local gy = hit and hit.Position.Y or (center.Y - K.FLOAT_HEIGHT)
	local pts = {Vector3.new(g.X + math.random(-25, 25), gy + 220, g.Z + math.random(-25, 25))}
	local bottom = Vector3.new(g.X, gy, g.Z)
	local segs = 9
	for i = 1, segs - 1 do
		pts[#pts + 1] = pts[1]:Lerp(bottom, i / segs) + Vector3.new(math.random(-7, 7), 0, math.random(-7, 7))
	end
	pts[#pts + 1] = bottom
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local p = new("Part", {
			Size = Vector3.new(.8, .8, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b), Color = Color3.fromRGB(255, 30, 30),
			Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, workspace)
		Debris:AddItem(p, .18)
	end
	flash(.25)
	playSound(K.SOUNDS.lightning)
end
-- one enormous red bolt from the sky onto target (the pentagram, the ground, or the orb)
local function hugeBolt(target, sound)
	local top = target + Vector3.new(math.random(-12, 12), 320, math.random(-12, 12))
	local pts, segs = {top}, 14
	for i = 1, segs - 1 do
		pts[#pts + 1] = top:Lerp(target, i / segs) + Vector3.new(math.random(-9, 9), 0, math.random(-9, 9))
	end
	pts[#pts + 1] = target
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local cf, len = CFrame.lookAt((a + b) / 2, b), (b - a).Magnitude
		for _, spec in ipairs({{3.2, Color3.fromRGB(255, 30, 30), .15}, {1.2, Color3.fromRGB(255, 210, 210), 0}}) do
			local p = new("Part", {
				Size = Vector3.new(spec[1], spec[1], len), CFrame = cf, Color = spec[2], Material = Enum.Material.Neon, Transparency = spec[3],
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			}, workspace)
			TS:Create(p, TweenInfo.new(.5), {Transparency = 1}):Play()
			Debris:AddItem(p, .6)
