local BLESS_COLORS = {
	speed   = Color3.fromRGB(255, 220, 40),
	jump    = Color3.fromRGB(60,  120, 255),
	esp     = Color3.fromRGB(170, 80,  255),
	missile = Color3.fromRGB(255, 130, 40),
	mjump   = Color3.fromRGB(60,  230, 230),
	glide   = Color3.fromRGB(235, 245, 255),
	gdur    = Color3.fromRGB(235, 245, 255),
	magnet  = Color3.fromRGB(255, 90,  170),
	multi   = Color3.fromRGB(90,  230, 90),
	drone   = Color3.fromRGB(150, 150, 160),
	dronepark   = Color3.fromRGB(150, 150, 160),
	dronemount  = Color3.fromRGB(150, 150, 160),
	chain   = Color3.fromRGB(255, 30,  30),
}
local CHAIN_RED  = Color3.fromRGB(220, 20, 20)
local fxList, heldSouls = {}, {}

local function recolorSoul(rigid, tail, col)
	local black = Color3.new(0, 0, 0)
	for _, r in ipairs(rigid) do
		if r.part.Color ~= black then r.part.Color = col end
		for _, d in ipairs(r.part:GetChildren()) do if d:IsA("PointLight") then d.Color = col end end
	end
	for _, t in ipairs(tail) do if t.part.Color ~= black then t.part.Color = col end end
end

local function animSoul(s, now)
	s.scale = math.min(1, s.scale + (now - s.born) * 3.5)
	layoutSoul(s, now, s.pos + s.face * 10)
end

local function buildChainLinks(folder, n)
	local links = {}
	for _ = 1, n do
		local lk = new("Part", {Size = Vector3.new(.55, .22, 1.0), Color = CHAIN_RED, Material = Enum.Material.Metal,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = 0}, folder)
		table.insert(links, lk)
	end
	return links
end
local function placeChainLinks(links, a, b, t)
	local d = b - a; local dist = d.Magnitude
	if dist < .1 then for _, l in ipairs(links) do l.Transparency = 1 end return end
	local n = #links
	local linkLen = math.max(1.05, dist / n * 1.1)
	local sag = dist * .07
	local function curve(f)
		return a + d * f - Vector3.new(0, math.sin(math.pi * f) * sag, 0) + Vector3.new(0, math.sin(t * 3 + f * 8) * .08, 0)
	end
	for i = 1, n do
		local f = (i - .5) / n
		local p0 = curve(math.max(0, f - .5/n)); local p1 = curve(math.min(1, f + .5/n))
		local tan = p1 - p0; if tan.Magnitude < .01 then tan = d.Unit end
		links[i].Transparency = 0
		links[i].Size = Vector3.new(.55, .22, linkLen)
		links[i].CFrame = CFrame.lookAt(curve(f), curve(f) + tan) * CFrame.Angles(0, 0, (i % 2 == 0) and 0 or math.pi / 2)
	end
end
local function destroyLinks(links) for _, l in ipairs(links) do if l.Parent then l:Destroy() end end end

RS.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for i = #fxList, 1, -1 do
		local s = fxList[i]
		local age = now - s.born
		if s.state == "pop" then
			s.vel = s.vel + Vector3.new(0, 22, 0) * dt
			s.vel = s.vel * math.max(0, 1 - dt * 1.1)
			s.pos = s.pos + s.vel * dt
			animSoul(s, now)
			if age > .9 then
				if s.mercy then
					s.state = "rise"
				else
					s.state = "escape"
					s.vel = Vector3.new(math.random()-0.5, .3+math.random()*.4, math.random()-0.5).Unit * 55
				end
			end
		elseif s.state == "rise" then
			s.vel = s.vel + Vector3.new(0, 38, 0) * dt
			s.vel = s.vel * math.max(0, 1 - dt * 0.6)
			s.pos = s.pos + s.vel * dt
			animSoul(s, now)
			if s.pos.Y >= s.targetY then
				s.pos = Vector3.new(s.pos.X, s.targetY, s.pos.Z)
				s.state = "held"
				table.insert(heldSouls, s)
				table.remove(fxList, i)
			end
		elseif s.state == "escape" then
			s.vel = s.vel * (1 + dt * 1.8)
			s.pos = s.pos + s.vel * dt
			animSoul(s, now)
			if age > 5 then
				s.model:Destroy()
				table.remove(fxList, i)
			end
		end
	end
	for _, s in ipairs(heldSouls) do
		if s.model.Parent then
			local bob = s.targetY + math.sin(now * 2 + s.phase) * 1.2
			s.pos = Vector3.new(s.pos.X, bob, s.pos.Z)
			animSoul(s, now)
		end
	end
end)

soulFxDeath = function(pos, withMercy)
	local SKY_HEIGHT = pos.Y + 80 + math.random() * 20
	for key, col in pairs(BLESS_COLORS) do
		if (V.lv[key] or 0) > 0 then
			local m, rigid, tail = buildSoul()
			recolorSoul(rigid, tail, col)
			m.Parent = V.coinFolder
			local spread = Vector3.new(math.random()-0.5, 0.1+math.random()*0.3, math.random()-0.5)
			if spread.Magnitude < .01 then spread = Vector3.new(0, 1, 0) end
			spread = spread.Unit
			local s = {model = m, rigid = rigid, tail = tail,
				pos = pos + Vector3.new(0, 1, 0), vel = spread * (20 + math.random()*10),
				scale = .08, born = os.clock(), phase = math.random()*6.28,
				face = Vector3.new(0,0,-1), state = "pop", mercy = withMercy,
				targetY = SKY_HEIGHT, lastSc = 0}
			table.insert(fxList, s)
		end
	end
end

soulFxRespawn = function()
	if #heldSouls == 0 then return end
	local char = V.lp.Character
	local hrp = char and char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then return end
	local list = heldSouls
	heldSouls = {}
	for idx, s in ipairs(list) do
		task.spawn(function()
			local folder = new("Folder", {Name = "ChainFX"}, workspace)
			local N_LINKS = 28
			local links = buildChainLinks(folder, N_LINKS)
			local FLY  = 0.4 + idx * 0.09
			local PULL = 1.4
			local t0 = os.clock()
			local conn
			conn = RS.Heartbeat:Connect(function()
				local now = os.clock()
				local t = now - t0
				local body = hrp.Parent and (hrp.Position + Vector3.new(0, 2, 0)) or s.pos
				if t < FLY then
					local tip = body:Lerp(s.pos, t / FLY)
					placeChainLinks(links, body, tip, now)
				elseif t < FLY + PULL then
					local k = (t - FLY) / PULL
					local eased = 1 - (1 - k) * (1 - k)
					s.pos = s.pos:Lerp(body, eased)
					if s.model.Parent then animSoul(s, now) end
					placeChainLinks(links, body, s.pos, now)
				else
					conn:Disconnect()
					destroyLinks(links)
					folder:Destroy()
					if s.model.Parent then s.model:Destroy() end
				end
			end)
		end)
	end
end

-- watch every OTHER player's death (survival time = time since we saw them spawn)
V.tracked = {}
local function trackPlayer(p)
	if p == V.lp or V.tracked[p] then return end
	local rec = {spawnAt = os.clock()}
	V.tracked[p] = rec
	local function onChar(char)
		rec.spawnAt = os.clock()
		if rec.died then rec.died:Disconnect() rec.died = nil end
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum or V.tracked[p] ~= rec then return end
		rec.died = hum.Died:Connect(function()
			local r = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
			if r then spawnDeathSoul(r.Position, os.clock() - rec.spawnAt) end
		end)
	end
	rec.added = p.CharacterAdded:Connect(onChar)
	if p.Character then task.spawn(onChar, p.Character) end
end
Players.PlayerAdded:Connect(trackPlayer)
for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
Players.PlayerRemoving:Connect(function(p)
	local rec = V.tracked[p]
	if rec then
		if rec.died then rec.died:Disconnect() end
		if rec.added then rec.added:Disconnect() end
		V.tracked[p] = nil
	end
end)

