			local p = root.Position
			if math.abs(p.Y - o.Y) < 8 then
				if (Vector2.new(p.X, p.Z) - Vector2.new(gold.Position.X, gold.Position.Z)).Magnitude < 4.5 then ctx.complete() return end
				if (Vector2.new(p.X, p.Z) - Vector2.new(red.Position.X, red.Position.Z)).Magnitude < 4.5 then ctx.leave() return end
			end
		end)
		local cf = CFrame.lookAt(o + Vector3.new(0, 3, 0), o + Vector3.new(1, 3, 0))
		ctx.respawnCF = cf
		return cf
	end

	function V.Trials.enter(n, force)
		local T = K.TRIALS[n]
		if not T or V.Trials.entering then return end
		if V.Trials.active then toast("You are already inside a trial.", 2.5) return end
		if not force and n > 1 and not V.Trials.done[n - 1] then
			toast("The gate is sealed. Finish the " .. K.TRIALS[n - 1].name .. " first.", 3.5)
			return
		end
		local char = V.lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and root) or hum.Health <= 0 then return end
		if busy or missileBusy or gliding or pilotingDrone or mountedDrone or V.inMaze or V.punishing or V.ritual.active then
			toast("Finish what you are doing first.", 2.5)
			return
		end
		V.Trials.entering = true
		flashTo(0, .4)
		task.wait(.5)
		if hum.Health <= 0 then V.Trials.entering = false flashTo(1, .5) return end

		local origin = Vector3.new(0, K.TRIAL_BASE_Y + (n - 1) * K.TRIAL_STEP_Y, 0)
		local model = Instance.new("Model")
		model.Name = "DemonTrial" .. n
		model.Parent = workspace
		local ctx = {n = n, T = T, origin = origin, model = model, frameFns = {}, cleanups = {}, killY = origin.Y - 120}
		ctx.complete = function() V.Trials.complete(n) end
		-- an obby hands off to its arena here. Arenas are optional: V.Trials.arenas[n] = function(ctx) ... end
		ctx.toArena = function() local a = V.Trials.arenas[n] if a then a(ctx) else V.Trials.complete(n) end end
		ctx.leave = function() V.Trials.leave(true) end
		local ok, spawnCF = pcall(V.Trials.builders[n] or placeholder, ctx)
		if not ok or typeof(spawnCF) ~= "CFrame" then
			warn("[DemonSummon] trial " .. n .. " failed to build: " .. tostring(spawnCF))
			for _, f in ipairs(ctx.cleanups) do pcall(f) end
			model:Destroy()
			V.Trials.entering = false
			flashTo(1, .5)
			toast("The gate would not open.", 3)
			return
		end
		ctx.respawnCF = ctx.respawnCF or spawnCF
		V.Trials.active, V.Trials.entering = ctx, false
		V.inTrial, busy = n, true
		sync()
		root.CFrame = spawnCF
		root.AssemblyLinearVelocity = Vector3.zero
		applyBuffs()
		V.Env.hell(1)
		hum.Died:Connect(function()
			if V.Trials.active == ctx then
				V.Trials.leave(false)
				toast("You fell in the trial. Go back to the shrine to try again.", 4)
			end
		end)
		ctx.conn = RS.Heartbeat:Connect(function(dt)
			if V.Trials.active ~= ctx then return end
			if hum.Health <= 0 or not root.Parent then V.Trials.leave(false) return end
			if root.Position.Y < ctx.killY then -- fell off: back to the last respawn point
				root.CFrame = ctx.respawnCF
				root.AssemblyLinearVelocity = Vector3.zero
			end
			for _, f in ipairs(ctx.frameFns) do
				f(dt, root)
				if V.Trials.active ~= ctx then return end
			end
		end)
		flashTo(1, 1)
		toast(T.name, 3.5)
	end

	-- ===== the stone shrine =====
	local function findGround(rootPos)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {V.lp.Character, V.coinFolder, V.orbFolder}
		params.IgnoreWater = true
		local offs = {Vector3.new(24, 0, 0), Vector3.new(-24, 0, 0), Vector3.new(0, 0, 24), Vector3.new(0, 0, -24)}
		for _ = 1, 60 do -- looks for a flat spot
			local a, d = math.random() * math.pi * 2, math.random(K.SHRINE_MIN, K.SHRINE_MAX)
			local p = rootPos + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			local hit = workspace:Raycast(p + Vector3.new(0, 120, 0), Vector3.new(0, -400, 0), params)
			if hit and hit.Normal.Y > .93 then
				local ok = true
				for _, o in ipairs(offs) do
					local h2 = workspace:Raycast(p + o + Vector3.new(0, 120, 0), Vector3.new(0, -400, 0), params)
					if not h2 or math.abs(h2.Position.Y - hit.Position.Y) > 5 then ok = false break end
				end
				if ok then return hit.Position, false end
			end
		end
		return rootPos + Vector3.new(70, -3.2, 0), true -- nothing flat found: it rises on a stone pedestal instead
	end

	local function buildShrine(groundPos, pedestal)
		local model = Instance.new("Model")
		model.Name = "DemonShrine"
		model.Parent = workspace
		sCF = CFrame.new(groundPos) * CFrame.Angles(0, math.rad(math.random(0, 359)), 0)
		local STONE, DARK, BONE = Color3.fromRGB(98, 92, 88), Color3.fromRGB(50, 46, 45), Color3.fromRGB(206, 199, 184)
		local EMBER = Color3.fromRGB(190, 55, 25)
		local function put(size, lcf, color, mat, collide, shape)
			return new("Part", {Size = size, CFrame = sCF * lcf, Color = color, Material = mat or Enum.Material.Slate, Anchored = true,
				CanCollide = collide ~= false, CanTouch = false, Shape = shape or Enum.PartType.Block}, model)
		end
		local function disc(y, h, diam, color, mat, collide)
			return put(Vector3.new(h, diam, diam), CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)), color, mat, collide, Enum.PartType.Cylinder)
		end
		local NEON, BALL = Enum.Material.Neon, Enum.PartType.Ball
		local TOP = SHRINE_TOP
		local runes, stars, spin = {}, {}, {}
		if pedestal then disc(-34, 68, 72, DARK) end

		-- four stone terraces; each one has a glowing ember rim
		disc(.1, 2.4, 66, DARK)                                  -- top 1.3
		for _, t in ipairs({{1.9, 1.2, 54}, {3.05, 1.1, 42}, {4.15, 1.1, 30}}) do -- tops 2.5, 3.6, 4.7
			disc(t[1] - .15, t[2] - .3, t[3], EMBER, NEON)
			disc(t[1], t[2], t[3] - 1.2, STONE)
		end

		-- the centre: glowing ring, dark plate and a five-pointed sigil. Stand here.
		local ring = disc(TOP + .08, .16, 12, RUNE, NEON, false)
		disc(TOP + .12, .16, 10.4, Color3.fromRGB(38, 32, 32), Enum.Material.Slate, false)
		new("PointLight", {Color = RUNE, Range = 30, Brightness = 1.2, Shadows = false}, ring)
		local verts = {}
		for i = 0, 4 do
			local a = -math.pi / 2 + i * math.pi * 2 / 5
			verts[i] = Vector3.new(math.cos(a) * 4.4, 0, math.sin(a) * 4.4)
		end
		for i = 0, 4 do
			local a, b = verts[i], verts[(i + 2) % 5]
			local d, mid = b - a, (a + b) / 2
			table.insert(stars, put(Vector3.new(d.Magnitude, .06, .22), CFrame.new(mid.X, TOP + .24, mid.Z) * CFrame.Angles(0, math.atan2(-d.Z, d.X), 0), RUNE, NEON, false))
		end
		for k = 0, 23 do -- two circles of carved glyphs around the sigil
			local a = k / 24 * math.pi * 2
			table.insert(runes, put(Vector3.new(.45, .06, k % 2 == 0 and 1.3 or .7), CFrame.new(math.cos(a) * 7.4, TOP + .04, math.sin(a) * 7.4) * CFrame.Angles(0, -a, 0), RUNE, NEON, false))
		end
		for k = 0, 35 do
			local a = k / 36 * math.pi * 2
			table.insert(runes, put(Vector3.new(.4, .06, .6), CFrame.new(math.cos(a) * 13.2, TOP + .04, math.sin(a) * 13.2) * CFrame.Angles(0, -a, 0), RUNE, NEON, false))
		end

		-- eight tall ancient pillars (two of them broken) with glowing runes, horned caps and flames
		local PT, tops = 3.6, {}
		for k = 1, 8 do
			local a = (k - 1) * math.pi / 4 + math.pi / 8
			local broken = k == 3 or k == 8
			local pf = CFrame.new(math.cos(a) * 17.5, 0, math.sin(a) * 17.5) * CFrame.Angles(0, -a, 0)
			put(Vector3.new(6, 2, 6), pf * CFrame.new(0, PT + 1, 0), DARK)
			put(Vector3.new(4.4, 9, 4.4), pf * CFrame.new(0, PT + 6.5, 0), STONE)
			put(Vector3.new(4.9, .9, 4.9), pf * CFrame.new(0, PT + 11.45, 0), DARK)
			table.insert(runes, put(Vector3.new(.2, 6, .6), pf * CFrame.new(-2.3, PT + 6.5, 0), RUNE, NEON, false))
			if broken then
				put(Vector3.new(4.2, 3.4, 4.2), pf * CFrame.new(0, PT + 13.6, 0) * CFrame.Angles(0, .4, .12), STONE) -- jagged stump
				put(Vector3.new(3.2, 2.2, 5), pf * CFrame.new(3.6, PT + 1.1, 2.2) * CFrame.Angles(.1, .6, .2), STONE) -- fallen pieces
				put(Vector3.new(2.2, 1.6, 2.2), pf * CFrame.new(5.4, PT + .8, -1.6) * CFrame.Angles(.3, .9, 0), DARK)
			else
				put(Vector3.new(3.4, 9, 3.4), pf * CFrame.new(0, PT + 16.4, 0), STONE)
				table.insert(runes, put(Vector3.new(.2, 6, .5), pf * CFrame.new(-1.8, PT + 16.4, 0), RUNE, NEON, false))
				put(Vector3.new(5.4, 1.6, 5.4), pf * CFrame.new(0, PT + 21.7, 0), DARK)
				for _, sx in ipairs({-1, 1}) do
					put(Vector3.new(.9, 3.8, .9), pf * CFrame.new(0, PT + 24.2, sx * 2.1) * CFrame.Angles(sx * .35, 0, 0), DARK)
				end
				local flame = put(Vector3.new(1.8, 1.8, 1.8), pf * CFrame.new(0, PT + 24.2, 0), RUNE, NEON, false, BALL)
				if k % 2 == 1 then new("PointLight", {Color = RUNE, Range = 20, Brightness = .9, Shadows = false}, flame) end
				tops[k] = pf.Position + Vector3.new(0, PT + 22.5, 0)
			end
		end
		for _, pr in ipairs({{1, 2}, {4, 5}, {6, 7}}) do -- heavy lintels over the pairs that are still standing
			local a, b = tops[pr[1]], tops[pr[2]]
			if a and b then
				local mid, d = (a + b) / 2 + Vector3.new(0, .8, 0), b - a
				local dir = Vector3.new(d.X, 0, d.Z)
				put(Vector3.new(3, 1.6, dir.Magnitude + 2.5), CFrame.lookAt(mid, mid + dir), STONE)
				table.insert(runes, put(Vector3.new(.3, .15, dir.Magnitude), CFrame.lookAt(mid - Vector3.new(0, .85, 0), mid - Vector3.new(0, .85, 0) + dir), RUNE, NEON, false))
			end
		end

		-- six fire bowls
		for k = 0, 5 do
			local a = math.rad(30 + k * 60)
			local x, z = math.cos(a) * 10.2, math.sin(a) * 10.2
			put(Vector3.new(2.6, 2.6, 2.6), CFrame.new(x, TOP + 1.3, z), DARK)
			local bowl = put(Vector3.new(1.2, 4.2, 4.2), CFrame.new(x, TOP + 3.2, z) * CFrame.Angles(0, 0, math.rad(90)), STONE, nil, false, Enum.PartType.Cylinder)
			new("Fire", {Size = 6, Heat = 9, Color = Color3.fromRGB(255, 70, 0), SecondaryColor = Color3.fromRGB(255, 170, 40)}, bowl)
			new("PointLight", {Color = Color3.fromRGB(255, 110, 40), Range = 18, Brightness = 1, Shadows = false}, bowl)
		end

		-- eight horned skulls on stakes around the outer terrace, red eyes
		for k = 0, 7 do
			local a = k * math.pi / 4
			local at = Vector3.new(math.cos(a) * 24.5, 0, math.sin(a) * 24.5)
			local sf = CFrame.lookAt(at, at + Vector3.new(math.cos(a), 0, math.sin(a)))
			put(Vector3.new(.9, 3.4, .9), sf * CFrame.new(0, 2.5 + 1.7, 0), DARK)
			put(Vector3.new(2.2, 2.1, 2.3), sf * CFrame.new(0, 2.5 + 4.4, 0), BONE, Enum.Material.Marble, nil, BALL)
			put(Vector3.new(1.4, .7, 1.5), sf * CFrame.new(0, 2.5 + 3.3, -.5), BONE, Enum.Material.Marble)
			for _, sx in ipairs({-1, 1}) do
				put(Vector3.new(.7, .7, .7), sf * CFrame.new(sx * .55, 2.5 + 4.6, -.9), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, false, BALL)
				table.insert(runes, put(Vector3.new(.3, .3, .3), sf * CFrame.new(sx * .55, 2.5 + 4.6, -1.05), RUNE, NEON, false, BALL))
				put(Vector3.new(.5, 2.4, .5), sf * CFrame.new(sx * .95, 2.5 + 5.7, .1) * CFrame.Angles(0, 0, -sx * .45), BONE, Enum.Material.Marble)
			end
		end

		-- the great demon gate at the back, with a huge watching eye
		local GZ, GB = -29, 1.3
		for _, sx in ipairs({-1, 1}) do
			put(Vector3.new(8, 2, 8), CFrame.new(sx * 11, GB + 1, GZ), DARK)
			put(Vector3.new(5, 32, 5), CFrame.new(sx * 11, GB + 18, GZ), STONE)
			table.insert(runes, put(Vector3.new(.25, 24, .6), CFrame.new(sx * 8.4, GB + 18, GZ + .2), RUNE, NEON, false))
			put(Vector3.new(1.4, 10, 1.4), CFrame.new(sx * 14.6, GB + 40, GZ) * CFrame.Angles(0, 0, -sx * .5), DARK) -- curved outer horns
		end
		put(Vector3.new(31, 5, 7), CFrame.new(0, GB + 36.5, GZ), STONE)
		for _, x in ipairs({-11, 0, 11}) do put(Vector3.new(2.6, x == 0 and 11 or 8, 2.6), CFrame.new(x, GB + 39 + (x == 0 and 5.5 or 4), GZ), DARK) end
		put(Vector3.new(16, 32, 2), CFrame.new(0, GB + 18, GZ - 1.6), DARK)
		local eye = put(Vector3.new(10, 5.4, .9), CFrame.new(0, GB + 22, GZ - .3), RUNE, NEON, false, BALL)
		put(Vector3.new(1.4, 5, 1), CFrame.new(0, GB + 22, GZ + .2), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, false)
		for _, sy in ipairs({-1, 1}) do put(Vector3.new(11.5, 1.2, 1.6), CFrame.new(0, GB + 22 + sy * 3.4, GZ - .2), DARK) end
		table.insert(runes, eye)

		-- the stone angel orb: just like the guiding orb of the maze (an orb with a halo and wings), carved in stone, floating above a plinth
		-- in front of the gate. Wings light up after Trial I (and start to flap), the halo after Trial II, the orb after Trial III.
		local function ap(size, shape)
			local part = put(size, CFrame.new(), ANGEL, nil, false, shape)
			angelSet[part] = true
			return part
		end
		put(Vector3.new(8, 1.4, 6), CFrame.new(0, 2.5 + .7, -23), DARK)
		put(Vector3.new(5.6, 1, 4.2), CFrame.new(0, 2.5 + 1.9, -23), STONE)
		angel.orb = ap(Vector3.new(4.4, 4.4, 4.4), BALL)
		angel.orbLight = new("PointLight", {Color = GOLD, Range = 32, Brightness = 2.5, Shadows = false, Enabled = false}, angel.orb)
		angel.haloSegs = {}
		for k = 1, 36 do
			local seg = ap(Vector3.new(.9, .3, .32))
			table.insert(angel.halo, seg)
			angel.haloSegs[k] = seg
		end
		local FLEN, FSPREAD = {6.8, 6.2, 5.4, 4.4}, {22, 6, -10, -26}
		angel.featherData = {}
		for _, sx in ipairs({-1, 1}) do
			for i = 1, 4 do
				local f = ap(Vector3.new(FLEN[i], .4, 1.9))
				table.insert(angel.wings, f)
				table.insert(angel.featherData, {part = f, sx = sx, i = i})
			end
		end
		local function animateAngel(t)
			local base = sCF * CFrame.new(0, 2.5 + 2.4 + 5.2 + math.sin(t * 1.4) * .45, -23)
			angel.orb.CFrame = base
			local haloCF = base * CFrame.new(0, 3.6 + math.sin(t * 1.7) * .1, 0) * CFrame.Angles(math.rad(8), 0, 0)
			for k, seg in ipairs(angel.haloSegs) do
				local a = (k - 1) / 36 * math.pi * 2
				seg.CFrame = haloCF * CFrame.new(math.cos(a) * 3.6, 0, math.sin(a) * 3.6) * CFrame.Angles(0, -a - math.pi / 2, 0)
			end
			local flap = V.Trials.done[1] and (math.rad(14) + math.sin(t * 3.2) * math.rad(30)) or math.rad(26) -- stone wings only flap once they are lit
			for _, fd in ipairs(angel.featherData) do
				local pivot = base * CFrame.new(fd.sx * 2.1, .7, .3) * CFrame.Angles(0, 0, fd.sx * flap)
				fd.part.CFrame = pivot * CFrame.Angles(0, 0, fd.sx * math.rad(FSPREAD[fd.i])) * CFrame.new(fd.sx * FLEN[fd.i] / 2, 0, -(fd.i - 1) * .18)
			end
		end

		-- two rings of runes slowly turning above the sigil
		for _, cfg in ipairs({{9.5, TOP + 10, 18, .35}, {6.5, TOP + 14, 12, -.5}}) do
			for k = 0, cfg[3] - 1 do
				local part = put(Vector3.new(1.6, .35, .35), CFrame.new(0, cfg[2], 0), RUNE, NEON, false)
				table.insert(spin, {part = part, a = k / cfg[3] * math.pi * 2, R = cfg[1], y = cfg[2], w = cfg[4]})
			end
		end
		local function animate(t)
			animateAngel(t)
			for _, sp in ipairs(spin) do
				local a = sp.a + t * sp.w
				sp.part.CFrame = sCF * CFrame.new(math.cos(a) * sp.R, sp.y, math.sin(a) * sp.R) * CFrame.Angles(0, -a - math.pi / 2, 0)
			end
		end

		-- a faint beam of red light so the shrine can be found from far away
		local beam = put(Vector3.new(3, 800, 3), CFrame.new(0, TOP + 400, 0), RUNE, NEON, false)
		beam.Transparency = .8

		V.Shrine.built = true
		return model, ring, stars, runes, beam, animate
	end

	-- the little panel shown while you stand in the centre
