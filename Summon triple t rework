	corner(closeBtn, 16)

	-- the closed book: only the cover is shown until you click it
	local closedBtn = new("TextButton", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1),
