-- ===== environment: save the original Lighting/Sky/Atmosphere, darken it, restore it exactly =====
V.Env = {}
K.LIGHT_PROPS = {"Ambient", "Brightness", "ColorShift_Bottom", "ColorShift_Top", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
	"ExposureCompensation", "FogColor", "FogEnd", "FogStart", "OutdoorAmbient", "ClockTime"}
local envSaved, envTweens, envTemp, envToken = nil, {}, {}, 0
local function envCancel()
	for _, t in ipairs(envTweens) do t:Cancel() end
	envTweens = {}
end
local function envTween(obj, t, goal)
	local tw = TS:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Sine), goal)
	tw:Play()
	table.insert(envTweens, tw)
end
function V.Env.darken(t)
	envToken += 1
	if not envSaved then -- only ever saved ONCE, so overlapping calls can never overwrite the real original
		envSaved = {light = {}, skies = {}, atmos = {}}
		for _, p in ipairs(K.LIGHT_PROPS) do pcall(function() envSaved.light[p] = Lighting[p] end) end
		for _, d in ipairs(Lighting:GetChildren()) do
			if d:IsA("Sky") then
				envSaved.skies[d] = {CelestialBodiesShown = d.CelestialBodiesShown}
			elseif d:IsA("Atmosphere") then
				envSaved.atmos[d] = {Density = d.Density, Color = d.Color, Decay = d.Decay, Haze = d.Haze, Glare = d.Glare, Offset = d.Offset}
			end
		end
	end
	envCancel()
	pcall(function()
		envTween(Lighting, t, {
			Ambient = Color3.fromRGB(35, 0, 0), OutdoorAmbient = Color3.fromRGB(25, 0, 0), Brightness = .4, ClockTime = 0,
			ExposureCompensation = -1, FogColor = Color3.fromRGB(40, 0, 0), FogStart = 0, FogEnd = 350, ColorShift_Top = Color3.fromRGB(80, 0, 0),
		})
	end)
	for sky in pairs(envSaved.skies) do if sky.Parent then sky.CelestialBodiesShown = false end end
	for atm in pairs(envSaved.atmos) do
		if atm.Parent then
			envTween(atm, t, {Density = .55, Color = Color3.fromRGB(70, 10, 10), Decay = Color3.fromRGB(40, 0, 0), Haze = 3, Glare = 0})
		end
	end
	if #envTemp == 0 then -- temporary helpers, destroyed on restore
		local atm = new("Atmosphere", {Density = 0, Color = Color3.fromRGB(70, 10, 10), Decay = Color3.fromRGB(40, 0, 0), Haze = 2, Glare = 0}, Lighting)
		local ccx = new("ColorCorrectionEffect", {TintColor = Color3.fromRGB(255, 190, 190), Saturation = 0, Contrast = 0, Brightness = 0}, Lighting)
		envTemp = {atm, ccx}
	end
	envTween(envTemp[1], t, {Density = .5})
	envTween(envTemp[2], t, {Saturation = -.25, Contrast = .15, Brightness = -.05})
end
function V.Env.restore(t, instant)
	if not envSaved then return end
	envToken += 1
	local token, saved = envToken, envSaved
	envCancel()
	local function finish()
		if token ~= envToken then return end -- a newer darken/restore took over
		for p, v in pairs(saved.light) do pcall(function() Lighting[p] = v end) end
		for sky, s in pairs(saved.skies) do if sky.Parent then for k, v in pairs(s) do sky[k] = v end end end
		for atm, s in pairs(saved.atmos) do if atm.Parent then for k, v in pairs(s) do atm[k] = v end end end
		for _, i in ipairs(envTemp) do i:Destroy() end
		envTemp = {}
		if envSaved == saved then envSaved = nil end
	end
	if instant or t <= 0 then finish() return end
	pcall(function() envTween(Lighting, t, saved.light) end)
	for atm, s in pairs(saved.atmos) do if atm.Parent then envTween(atm, t, s) end end
	if envTemp[1] then envTween(envTemp[1], t, {Density = 0}) end
	if envTemp[2] then envTween(envTemp[2], t, {Saturation = 0, Contrast = 0, Brightness = 0}) end
	task.delay(t + .15, finish)
end

