-- the glowing red fireball. returns the model and a destroy function (stops its own loop)
local function spawnOrb(pos)
	local m = Instance.new("Model")
	m.Name = "DemonOrb"
	local function ball(size, color, transp)
		return new("Part", {
			Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = pos, Color = color, Material = Enum.Material.Neon,
			Transparency = transp, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
	end
	local core = ball(.5, Color3.fromRGB(255, 20, 20), 0)
	local shell = ball(.6, Color3.fromRGB(255, 110, 10), .6)
	m.PrimaryPart = core
	new("Fire", {Size = 22, Heat = 15, Color = Color3.fromRGB(255, 40, 0), SecondaryColor = Color3.fromRGB(255, 160, 0)}, core)
	new("PointLight", {Color = Color3.fromRGB(255, 40, 20), Range = 45, Brightness = 4}, core)
	new("ParticleEmitter", {
		Rate = 40, Lifetime = NumberRange.new(.6, 1.2), Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 60, 20), Color3.fromRGB(255, 170, 40)),
		Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0)}),
		Transparency = NumberSequence.new(0, 1), Acceleration = Vector3.new(0, 3, 0),
	}, core)
	m.Parent = workspace
	m:SetAttribute("GlowColor", Color3.fromRGB(255, 50, 30))
	V.CS:AddTag(m, "DemonGlow")
	TS:Create(core, TweenInfo.new(.6, Enum.EasingStyle.Back), {Size = Vector3.new(5, 5, 5)}):Play()
	TS:Create(shell, TweenInfo.new(.6, Enum.EasingStyle.Back), {Size = Vector3.new(6.6, 6.6, 6.6)}):Play()
	local t0 = os.clock()
	local conn = RS.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local p = pos + Vector3.new(0, math.sin(t * 1.8) * .8, 0)
		core.Position, shell.Position = p, p
		shell.Transparency = .55 + math.sin(t * 5) * .1
	end)
	return m, function()
		conn:Disconnect()
		m:Destroy()
	end
end

