	-- the tool in your inventory (client-side; re-created after respawn so you keep it when you die)
	local function removeTool() if Book.tool then Book.tool:Destroy() Book.tool = nil end end
	local function giveTool()
		removeTool()
		if Book.state == "none" then return end
		local backpack = lp:FindFirstChildOfClass("Backpack")
		if not backpack then return end
		local t = Instance.new("Tool")
