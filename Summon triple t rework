	-- ===== the lines on screen (red, see-through, each somewhere else) =====
	local linesGui = new("ScreenGui", {Name = "NecroLines", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4, Enabled = false}, playerGui)
	local POS = {Vector2.new(.62, .22), Vector2.new(.3, .45), Vector2.new(.68, .64)}
