			V.chaos.nextJump = now + (V.chaos.jumpMul == 0 and 1.2 or 2 + math.random()) / (1 + .25 * (u.stacks - 1))
			changed = true
		end
	elseif V.chaos.jumpMul ~= 1 then
		V.chaos.jumpMul, V.chaos.nextJump, changed = 1, 0, true
	end
	if changed and not busy then applyBuffs() end
end)

