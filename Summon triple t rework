					killOrb(o)
				elseif o.kind == "medium" then
					burst(o.pos, Color3.new(1, 1, 1), 6)
					if os.clock() - lastToast > 2 then lastToast = os.clock() noToast("Big orbs need ROCK hits!", 2) end
				elseif o.kind == "green" then
					o.hp -= 1
					o.stun = .6
					o.pos = o.pos + (o.pos - rp).Unit * 2 -- knocked back a little
					burst(o.pos, Color3.fromRGB(180, 255, 200), 10)
					if o.hp <= 0 then
						bossP += 1 / 3
						updateBar()
						killOrb(o)
					end
				elseif o.kind == "shield" and not o.defeated and mode == "shield" then
					o.hp -= 1
					burst(o.pos, Color3.fromRGB(255, 200, 120), 9)
					if o.hp <= 0 then defeatShield(o) end
				end
			end
		end
		local camLook = workspace.CurrentCamera.CFrame.LookVector
		for _, m in ipairs(meteors) do
			if m.state == "landed" and m.blue and (m.pos - rp).Magnitude < 17 then
				if camLook:Dot((P - m.pos).Unit) > .85 then launch(m)
				else noToast("Aim your camera at the demon orb, then strike the meteor!", 2.5) end
				break
			end
		end
	end
	V.Trials.giveSword(ctx, hum, function() swordHit() end)

	-- ---------- THE ANGEL ORB'S LIGHT: angel form, flight, and sealing the demon orb ----------
	local ABILITY_GOLD = Color3.fromRGB(255, 225, 140)
	local abilityBtn = new("TextButton", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -270), Size = UDim2.fromOffset(130, 46),
