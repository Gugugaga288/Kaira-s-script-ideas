-- coinFolder keeps its old name because every raycast filter in the script already ignores it.
V.coinFolder = new("Folder", {Name = "LocalSouls"}, workspace)
local natural, deathSouls, pendingSpawns = {}, {}, {} -- natural souls / souls from player deaths / respawn timers
local function soulMult()
	local m = V.lv.multi >= 2 and 3 or (V.lv.multi == 1 and 2 or 1)
	if V.tmpMulti then m = math.max(m, 2) + 1 end -- stronger Fortune from a broken blessing soul
	return m
end

-- 3D ghost: round head, thin tapering tail, no arms, black oval eyes, open "scream" mouth.
-- Every part is an ellipsoid (a Block with a Sphere mesh), positioned each frame so the tail can sway and lag.
K.MINSZ = .05
local function sz(v, k) return Vector3.new(math.max(K.MINSZ, v.X * k), math.max(K.MINSZ, v.Y * k), math.max(K.MINSZ, v.Z * k)) end
K.TAIL = { -- {size, y offset}
	{Vector3.new(1.9, 2.1, 1.9), -1.5}, {Vector3.new(1.5, 1.8, 1.5), -2.3}, {Vector3.new(1.15, 1.5, 1.15), -2.95},
	{Vector3.new(.85, 1.2, .85), -3.5}, {Vector3.new(.6, .95, .6), -3.95}, {Vector3.new(.4, .8, .4), -4.3},
}
local function buildSoul()
	local m = Instance.new("Model")
	m.Name = "Soul"
	local function blob(size, color, transp, mat)
		local p = new("Part", {
			Size = size, Color = color, Material = mat or Enum.Material.SmoothPlastic, Transparency = transp,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
		new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p)
		return p
	end
	local black = Color3.new(0, 0, 0)
	local rigid, tail = {}, {}
	local function add(part, off, rot, size) table.insert(rigid, {part = part, off = off, rot = rot or CFrame.new(), size = size}) end
	local headSize = Vector3.new(2.4, 2.6, 2.4)
	local head = blob(headSize, Color3.fromRGB(200, 222, 255), .15, Enum.Material.Neon)
	new("PointLight", {Color = Color3.fromRGB(170, 200, 255), Range = 10, Brightness = 1.2}, head)
	add(head, Vector3.zero, nil, headSize)
	for _, sx in ipairs({-1, 1}) do
		local es = Vector3.new(.4, .8, .25)
		add(blob(es, black, 0), Vector3.new(sx * .5, .35, -1.08), nil, es)                                       -- eyes
	end
	local ms = Vector3.new(.7, 1.0, .25)
	add(blob(ms, black, 0), Vector3.new(0, -.55, -1.08), nil, ms)                                                -- screaming mouth
	for i, t in ipairs(K.TAIL) do
		table.insert(tail, {part = blob(t[1], Color3.fromRGB(200, 222, 255), .2 + i * .07, Enum.Material.Neon), size = t[1], y = t[2]})
	end
	return m, rigid, tail
end

local function popScale(age) -- tiny -> overshoot -> normal
	if age >= .45 then return 1 end
	local k = age / .45 - 1
	return math.max(.05, 1 + 2.70158 * k * k * k + 1.70158 * k * k)
end

local function layoutSoul(s, t, lookAt)
	local sc = s.scale
	local d = lookAt - s.pos
	d = Vector3.new(d.X, 0, d.Z)
	if d.Magnitude > .01 then s.face = d.Unit end
	local base = CFrame.lookAt(s.pos, s.pos + s.face)
	local resize = s.lastSc ~= sc
	s.lastSc = sc
	for _, r in ipairs(s.rigid) do
		if resize then r.part.Size = sz(r.size, sc) end
		r.part.CFrame = base * CFrame.new(r.off * sc) * r.rot
	end
	local vl = base:VectorToObjectSpace(s.vel)
	for i, tl in ipairs(s.tail) do
		if resize then tl.part.Size = sz(tl.size, sc) end
		-- each segment swings a little later than the one above it, and trails behind when the soul is moving
		local sway = math.sin(t * 2.6 - i * .7) * .16 * i
		local lagX = math.clamp(-vl.X * .05 * i, -1.2, 1.2)
		local lagZ = math.clamp(-vl.Z * .05 * i, -1.2, 1.2)
		tl.part.CFrame = base * CFrame.new(Vector3.new(sway + lagX, tl.y, lagZ + math.cos(t * 2.1 - i * .7) * .05 * i) * sc)
	end
end

local function makeSoul(kind, pos)
	local m, rigid, tail = buildSoul()
	m.Parent = V.coinFolder
	return {kind = kind, model = m, rigid = rigid, tail = tail, pos = pos, base = pos, vel = Vector3.zero,
		scale = .05, born = os.clock(), phase = math.random() * 6.28, face = Vector3.new(0, 0, -1), amount = 1}
end

-- natural souls: random surface within SOUL_RADIUS
local function spawnNatural()
	local root = V.lp.Character and V.lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local ang, dist = math.random() * math.pi * 2, math.random(K.SOUL_MIN_RADIUS, K.SOUL_RADIUS)
	local origin = root.Position + Vector3.new(math.cos(ang) * dist, 100, math.sin(ang) * dist)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {V.lp.Character, V.coinFolder}
	local hit = workspace:Raycast(origin, Vector3.new(0, -300, 0), params)
	if not hit or hit.Normal.Y < .3 then return false end
	table.insert(natural, makeSoul("natural", hit.Position + Vector3.new(0, 3, 0)))
	return true
end

-- souls from OTHER players' deaths: spawn at the body, pop, then gain momentum toward you
local function spawnDeathSoul(pos, survivedSecs)
	if #deathSouls >= 30 then table.remove(deathSouls, 1).model:Destroy() end -- never let them pile up forever
	local s = makeSoul("death", pos)
	s.amount = 1 + math.floor(survivedSecs / K.DEATH_SOUL_STEP) -- <5min 1, 5-10min 2, 10-15min 3 ...
	s.vel = Vector3.new(math.random(-6, 6), math.random(10, 16), math.random(-6, 6))
	table.insert(deathSouls, s)
end

local function playSound(def)
	if not def or not def.id or def.id == "" then return end
	pcall(function()
		local s = new("Sound", {SoundId = def.id, Volume = def.volume or 1, PlaybackSpeed = def.speed or 1}, V.gui)
		s:Play()
		Debris:AddItem(s, 8)
	end)
end
local function collectEffect(pos)
	playSound(K.SOUNDS.soul)
	local p = new("Part", {
		Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Position = pos, Color = Color3.fromRGB(200, 225, 255), Material = Enum.Material.Neon,
		Transparency = .2, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
	}, workspace)
	TS:Create(p, TweenInfo.new(.4), {Size = Vector3.new(6, 6, 6), Transparency = 1}):Play()
	Debris:AddItem(p, .5)
end
local function collectSoul(s, list, i)
	souls += s.amount * soulMult()
	refresh()
	collectEffect(s.pos)
	s.model:Destroy()
	table.remove(list, i)
	if s.kind == "natural" then table.insert(pendingSpawns, {t = os.clock() + coinRespawn}) end -- replaced no sooner than coinRespawn seconds from now
end

-- keeps ~coinTarget natural souls alive. A collected soul is replaced coinRespawn seconds later, and replacements are
-- spaced coinRespawn seconds apart, so they never pop back instantly. (The first fill and relocations are immediate.)
task.spawn(function()
	local nextAllowed = 0
	while true do
		task.wait(.5)
		local root = V.lp.Character and V.lp.Character:FindFirstChild("HumanoidRootPart")
		if root and not (V.inMaze or V.inTrial) then
			for i = #natural, 1, -1 do
				local s = natural[i]
				if (s.base - root.Position).Magnitude > K.SOUL_RADIUS * 1.6 then -- out of range: relocate near you right away
					s.model:Destroy()
					table.remove(natural, i)
					table.insert(pendingSpawns, {t = 0, immediate = true})
				end
			end
			while #natural > coinTarget do table.remove(natural).model:Destroy() end
			while #natural + #pendingSpawns > coinTarget and #pendingSpawns > 0 do table.remove(pendingSpawns) end
			while #natural + #pendingSpawns < coinTarget do table.insert(pendingSpawns, {t = 0, immediate = true}) end
			for i = #pendingSpawns, 1, -1 do
				local p = pendingSpawns[i]
				local now = os.clock()
				if #natural < coinTarget and (p.immediate or (now >= p.t and now >= nextAllowed)) then
					local ok = false
					for _ = 1, 6 do if spawnNatural() then ok = true break end end
					if ok then
						table.remove(pendingSpawns, i)
						if not p.immediate then nextAllowed = now + coinRespawn end
					end
				end
			end
		end
	end
end)

-- one loop animates + collects everything
RS.Heartbeat:Connect(function(dt)
	local root = V.lp.Character and V.lp.Character:FindFirstChild("HumanoidRootPart")
	-- while piloting the drone, it collects natural souls instead of your (frozen) body
	local orbOn = V.Angel and V.Angel.active and V.Angel.pos or nil -- the angel orb collects too
	local collectPos = (pilotingDrone and droneCF) and droneCF.Position or orbOn or (root and root.Position)
	local canCollect = (not busy or orbOn ~= nil) and not missileBusy
	local deathOK = not missileBusy -- souls from OTHER players' deaths always collect: also inside a trial, the maze or a summon (they used to stick to you there)
	local now = os.clock()
	local faceAt = collectPos
	for i = #natural, 1, -1 do
		local s = natural[i]
		if collectPos and hasMagnet and V.on.magnet then -- Soul Magnet pulls nearby natural souls
			local d = collectPos - s.base
			if d.Magnitude < K.MAGNET_RADIUS * (V.tmpMagnet and 2 or 1) and d.Magnitude > .1 then
				s.base += d.Unit * math.min(d.Magnitude, K.MAGNET_SPEED * (V.tmpMagnet and 1.6 or 1) * dt)
			end
		end
		s.pos = s.base + Vector3.new(0, math.sin(now * 2 + s.phase) * .4, 0)
		s.scale = popScale(now - s.born)
		layoutSoul(s, now, faceAt or s.pos)
		if collectPos and canCollect and (collectPos - s.base).Magnitude < 5 then collectSoul(s, natural, i) end
	end
	for i = #deathSouls, 1, -1 do
		local s = deathSouls[i]
		local age = now - s.born
		if age > 120 then
			s.model:Destroy()
			table.remove(deathSouls, i)
		else
			local chase = orbOn or (root and root.Position)
			if chase and age > .5 then -- after the pop, speed up straight at the player (never overshoots, so it can't orbit)
				local to = chase + Vector3.new(0, 1, 0) - s.pos
				local dist = to.Magnitude
				s.speed = math.min(130, (s.speed or 12) + 170 * dt)
				if dist > .05 then
					s.vel = to.Unit * s.speed
					s.pos += to.Unit * math.min(dist, s.speed * dt)
				end
			else
				s.vel *= math.max(0, 1 - 2 * dt)
				s.pos += s.vel * dt
			end
			s.scale = popScale(age)
			layoutSoul(s, now, chase or s.pos)
			local nearBody = chase and (s.pos - chase).Magnitude < 4
			local nearDrone = pilotingDrone and droneCF and (s.pos - droneCF.Position).Magnitude < 5 -- the drone can grab them too
			if deathOK and age > .5 and (nearBody or nearDrone) then collectSoul(s, deathSouls, i) end
		end
	end
end)

