-- Movement is level with the camera's HEADING (tilting the camera does nothing to the drone).
-- Up/Down only happen when you ask for them: Space / Ctrl, or the UP / DOWN buttons.
local function readFlightInput(hum)
	local c = getCam().CFrame
	local f, r = c.LookVector, c.RightVector
	local fl = Vector3.new(f.X, 0, f.Z)
	if fl.Magnitude < .05 then fl = Vector3.new(c.UpVector.X, 0, c.UpVector.Z) * (f.Y < 0 and 1 or -1) end
	fl = fl.Magnitude > .01 and fl.Unit or Vector3.new(0, 0, -1)
	local rl = Vector3.new(r.X, 0, r.Z)
	rl = rl.Magnitude > .01 and rl.Unit or Vector3.new(1, 0, 0)
	local right, fwd, got = 0, 0, false
	if V.controlModule then
		local ok, v = pcall(function() return V.controlModule:GetMoveVector() end)
		if ok and typeof(v) == "Vector3" then right, fwd, got = v.X, -v.Z, true end
	end
	if not got and hum and hum.MoveDirection.Magnitude > .01 then
		local md = hum.MoveDirection
		fwd, right, got = md:Dot(fl), md:Dot(rl), true
	end
	if not got then
		if UIS:IsKeyDown(Enum.KeyCode.W) then fwd += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.S) then fwd -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.D) then right += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.A) then right -= 1 end
	end
	local vert = ((UIS:IsKeyDown(Enum.KeyCode.Space) or touchUp) and 1 or 0) - ((UIS:IsKeyDown(Enum.KeyCode.LeftControl) or touchDown) and 1 or 0)
	return fl * fwd + rl * right + Vector3.yAxis * vert
end

-- Which way the drone faces. Like a normal character it only turns toward where you MOVE (level), and
-- looking around with the camera never turns it.
V.droneFace = Vector3.new(0, 0, -1)
local function resetFace()
	local l = droneCF and droneCF.LookVector or Vector3.new(0, 0, -1)
	local flat = Vector3.new(l.X, 0, l.Z)
	V.droneFace = flat.Magnitude > .01 and flat.Unit or Vector3.new(0, 0, -1)
end
local function turnToward(mv, dt)
	local flat = Vector3.new(mv.X, 0, mv.Z)
	if flat.Magnitude < .05 then return end
	local mixed = V.droneFace:Lerp(flat.Unit, math.min(1, 10 * dt))
	V.droneFace = mixed.Magnitude > .01 and mixed.Unit or flat.Unit
end

-- Walls and floors BLOCK you while mounted (the piloted drone is the one that phases through everything).
K.MOUNT_RADIUS = 2.4
local function moveSolid(pos, delta, params)
	local dist = delta.Magnitude
	if dist < 1e-4 then return pos end
	local hit = workspace:Spherecast(pos, K.MOUNT_RADIUS, delta.Unit * (dist + .05), params)
	if not hit then return pos + delta end
	local slid = delta - hit.Normal * delta:Dot(hit.Normal) -- slide along what you hit
	if slid.Magnitude < 1e-4 then return pos end
	if workspace:Spherecast(pos, K.MOUNT_RADIUS, slid.Unit * (slid.Magnitude + .05), params) then return pos end
	return pos + slid
end

-- Tap from idle: control the drone directly from its point of view. Noclips through everything.
startPilot = function()
	if pilotingDrone or mountedDrone or busy or missileBusy or gliding then return end
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if not ensureDrone() then return end
	if not droneCF then droneCF = root.CFrame * K.DRONE_FOLLOW_OFFSET end
	resetFace()
	pilotingDrone, droneParked = true, false
	clearPulseGui()
	droneBtn.Text = "RETURN (E)"
	if V.droneHighlight then V.droneHighlight.Enabled = false end
	hum.WalkSpeed, hum.JumpPower = 0, 0
	hum.PlatformStand = true
	root.Anchored = true
	startDroneCam(0)
	showFlightControls(true)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, V.coinFolder}

	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not pilotingDrone then conn:Disconnect() return end
		local ok, err = pcall(function()
			local mv = readFlightInput(hum)
			local pos = droneCF.Position
			local delta = stepDroneVel(mv, K.DRONE_PILOT_SPEED, dt) * dt
			if delta.Magnitude > 1e-3 then
				local hit = workspace:Raycast(pos, delta.Unit * (delta.Magnitude + 1), params)
				if hit then phasePulse(hit.Position, hit.Normal) end -- you phase through it; the pulse just marks where
			end
			if mv.Magnitude > .01 then turnToward(mv, dt) end
			-- level, and turned only by your movement: looking around with the camera leaves the drone alone
			droneCF = CFrame.lookAt(pos + delta, pos + delta + V.droneFace)
			placeDrone(droneCF, dt)
		end)
		if not ok then warn("[TungSahur] pilot tick failed: " .. tostring(err)) end
	end)
end

local function endPilotCommon()
	pilotingDrone = false
	droneBtn.Text = "DRONE (E)"
	showFlightControls(false)
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum then hum.PlatformStand = false; applyBuffs() end
	if root then root.Anchored = false end
	stopDroneCam()
	getCam().CameraSubject = hum
end

-- Tap while piloting: stop, and the drone flies itself back to your side (the idle-follow loop handles the flight).
