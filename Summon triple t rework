local function itemPrice(key, super)
	if key == "djump" or key == "tjump" then key = "mjump" end
	local p = (super and K.SUPER_PRICES[key]) or K.PRICES[key]
	if not p then return 0 end
	return p[1] + p[2] * (V.lv[key] or 0)
end

