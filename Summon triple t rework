	new("UIAspectRatioConstraint", {AspectRatio = .72, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Height}, closedBtn)
	local ct = new("TextLabel", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, .06), Size = UDim2.fromScale(.8, .12), BackgroundTransparency = 1,
		Text = "Necrobloxicon", TextColor3 = Color3.fromRGB(200, 40, 40), Font = Enum.Font.Antique, TextScaled = true, ZIndex = 3}, closedBtn)
	new("UITextSizeConstraint", {MaxTextSize = 26, MinTextSize = 8}, ct)
	local cstar = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .6), Size = UDim2.fromScale(.7, .7), BackgroundTransparency = 1, ZIndex = 3}, closedBtn)
	new("UIAspectRatioConstraint", {AspectRatio = 1, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Width}, cstar)
	local cring = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3}, cstar)
	new("UICorner", {CornerRadius = UDim.new(1, 0)}, cring)
	new("UIStroke", {Color = Color3.fromRGB(200, 40, 40), Thickness = 3}, cring)
	for k = 0, 4 do
		local a1, a2 = math.rad(-90 + 72 * k), math.rad(-90 + 72 * ((k + 2) % 5))
		local p1, p2 = Vector2.new(.5 + .46 * math.cos(a1), .5 + .46 * math.sin(a1)), Vector2.new(.5 + .46 * math.cos(a2), .5 + .46 * math.sin(a2))
		local d = p2 - p1
		rect(cstar, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2), Size = UDim2.fromScale(d.Magnitude, .02),
			Rotation = math.deg(math.atan2(d.Y, d.X)), BackgroundColor3 = Color3.fromRGB(200, 40, 40), ZIndex = 4})
	end
	local function render(full, closed)
		closedBtn.Visible = full and closed
		cover.Visible, inner.Visible = full and not closed, full and not closed
		for _, l in ipairs(layers) do l.Visible = full and not closed end
		soloBack.Visible, solo.Visible = not full, not full
	end
	local function openViewer()
		render(Book.state ~= "page", true) -- equipping always shows the CLOSED book
		viewer.Enabled = true
	end
	closedBtn.MouseButton1Click:Connect(function() render(true, false) end)
	local function closeViewer() viewer.Enabled = false end

	-- the tool in your inventory (client-side; re-created after respawn so you keep it when you die)
	local function removeTool() if Book.tool then Book.tool:Destroy() Book.tool = nil end end
	local function giveTool()
		removeTool()
		if Book.state == "none" then return end
		local backpack = lp:FindFirstChildOfClass("Backpack")
		if not backpack then return end
		local t = Instance.new("Tool")
		t.Name = "Necrobloxicon"
		t.RequiresHandle, t.CanBeDropped, t.ToolTip = false, false, "Opens the book"
		t.Equipped:Connect(openViewer)
		t.Unequipped:Connect(closeViewer)
		t.Parent = backpack
		Book.tool = t
	end
	local function ensureTool() -- the item must always be in your Backpack (or your hand) once you own it
		if Book.state == "none" then return end
		local backpack = lp:FindFirstChildOfClass("Backpack")
		local t = Book.tool
		if not t or not (t.Parent == backpack or t.Parent == lp.Character) then giveTool() end
	end
	closeBtn.MouseButton1Click:Connect(function()
		closeViewer()
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then h:UnequipTools() end
	end)

	-- ===== the lines on screen (red, see-through, each somewhere else) =====
	local linesGui = new("ScreenGui", {Name = "NecroLines", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4, Enabled = false}, playerGui)
	local POS = {Vector2.new(.62, .22), Vector2.new(.3, .45), Vector2.new(.68, .64)}
	local lineLbls, lineState = {}, {}
	for i, text in ipairs(K.RITUAL_LINES) do
		local l = new("TextLabel", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(POS[i].X, POS[i].Y), Size = UDim2.fromScale(.42, .13),
			BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(255, 40, 40), TextTransparency = 1,
			Font = Enum.Font.Antique, TextScaled = true, TextWrapped = true, Active = false,
		}, linesGui)
		new("UITextSizeConstraint", {MaxTextSize = 28, MinTextSize = 10}, l)
		lineLbls[i] = l
	end
	local function setLineStates(stage) -- next line to say = visible, said lines = ghosted, later lines = hidden
		for i, l in ipairs(lineLbls) do
			local want = (i == stage + 1) and .3 or (i <= stage and .88 or 1)
			if lineState[i] ~= want then
				lineState[i] = want
				TS:Create(l, TweenInfo.new(.6), {TextTransparency = want}):Play()
			end
		end
	end

	-- ===== pentagram on the ground =====
	local pentParts, pentLit, pentModel = {}, 0, nil -- pentLit = how many star lines are lit (0-5); the ring lights with the first one
	local LINE_UNLIT, LINE_LIT = Color3.fromRGB(70, 14, 14), Color3.fromRGB(255, 50, 40)
	local function buildPentagram(center)
		pentLit = 0
		pentModel = new("Model", {Name = "DemonPentagram"}, workspace)
		pentModel:SetAttribute("GlowColor", Color3.fromRGB(255, 40, 30))
		pentModel:SetAttribute("GlowFill", .55)
		V.CS:AddTag(pentModel, "DemonGlow")
		local function part(kind, idx, shape, size, cf, color, mat, transp)
			local p = new("Part", {Shape = shape, Size = size, CFrame = cf, Color = color, Material = mat, Transparency = 1,
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, pentModel)
			table.insert(pentParts, {part = p, target = transp, kind = kind, idx = idx})
		end
		-- every layer has its own height with a clear gap, so no faces overlap and nothing flickers when the camera moves
		local g = center + Vector3.new(0, .1, 0)
		local flat = CFrame.Angles(0, 0, math.pi / 2)
		part("ring", 0, Enum.PartType.Cylinder, Vector3.new(.06, 19, 19), CFrame.new(g) * flat, LINE_UNLIT, Enum.Material.SmoothPlastic, .3)
		part("disc", 0, Enum.PartType.Cylinder, Vector3.new(.04, 17.4, 17.4), CFrame.new(g + Vector3.new(0, .07, 0)) * flat, Color3.fromRGB(12, 0, 0), Enum.Material.SmoothPlastic, .2)
		local pt = {}
		for k = 0, 4 do
			local a = math.rad(-90 + 72 * k)
			pt[k] = g + Vector3.new(math.cos(a) * 8, .17, math.sin(a) * 8)
		end
		for k = 0, 4 do
			local a, b = pt[k], pt[(k + 2) % 5]
			local lift = Vector3.new(0, k * .015, 0) -- the five lines cross each other, so each sits a hair higher than the last
			part("line", k + 1, Enum.PartType.Block, Vector3.new(.5, .06, (b - a).Magnitude), CFrame.lookAt((a + b) / 2 + lift, b + lift), LINE_UNLIT, Enum.Material.SmoothPlastic, .3)
		end
		for _, e in ipairs(pentParts) do TS:Create(e.part, TweenInfo.new(1.2), {Transparency = e.target}):Play() end
	end
	-- lights the star line by line. Each line flashes white-hot, then settles to a glowing red. Fewer lines = back to dark.
	local function setPentLit(count)
		if count == pentLit then return end
		for _, e in ipairs(pentParts) do
			if e.kind == "line" then
				if e.idx <= count and e.idx > pentLit then
					e.part.Material = Enum.Material.Neon
					e.part.Color = Color3.fromRGB(255, 235, 210)
					TS:Create(e.part, TweenInfo.new(.8), {Color = LINE_LIT, Transparency = .05}):Play()
				elseif e.idx > count and e.idx <= pentLit then
					e.part.Material = Enum.Material.SmoothPlastic
					e.part.Color, e.part.Transparency = LINE_UNLIT, .3
				end
			elseif e.kind == "ring" then
				if count > 0 and pentLit == 0 then
					e.part.Material = Enum.Material.Neon
					TS:Create(e.part, TweenInfo.new(.8), {Color = LINE_LIT, Transparency = .15}):Play()
				elseif count == 0 then
					e.part.Material = Enum.Material.SmoothPlastic
					e.part.Color, e.part.Transparency = LINE_UNLIT, .3
				end
			end
		end
		pentLit = count
	end
	local function clearPentagram()
		local old = pentParts
		pentParts = {}
		pentLit = 0
		if pentModel then Debris:AddItem(pentModel, .9) pentModel = nil end
		for _, e in ipairs(old) do
			TS:Create(e.part, TweenInfo.new(.8), {Transparency = 1}):Play()
			Debris:AddItem(e.part, .9)
		end
	end
	local function disarm(restoreTool)
		armed, Book.armed, Book.pentagramPos = nil, nil, nil
		clearPentagram()
		linesGui.Enabled = false
		for i, l in ipairs(lineLbls) do lineState[i] = nil l.TextTransparency = 1 end
		if restoreTool and not Book.tool then giveTool() end
	end
	local function arm() -- the pentagram on the book's second page was clicked
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if Book.state ~= "full" or armed or not (hum and root) or hum.Health <= 0 then return end
		if busy or missileBusy or pilotingDrone or mountedDrone or V.punishing or V.ritual.active then
			toast("Finish what you are doing first.", 2.5)
			return
		end
		if os.clock() < lockoutUntil then
			toast(string.format("The seal is still dark: %d:%02d left.", math.floor((lockoutUntil - os.clock()) / 60), math.ceil(lockoutUntil - os.clock()) % 60), 3)
			return
		end
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {char, V.coinFolder}
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -50, 0), rp)
		if not hit then toast("Stand on solid ground first.", 2.5) return end
		closeViewer()
		hum:UnequipTools() -- the book stays in your inventory
		local center = hit.Position
		armed = {t0 = os.clock(), center = center}
		Book.armed, Book.pentagramPos = armed, center
		buildPentagram(center)
		linesGui.Enabled = true
		setLineStates(0)
	end
	sealBtn.MouseButton1Click:Connect(arm)

	-- ===== the book lying in the world =====
	local function removeWorld()
		if W then
			if W.dark and not V.ritual.active and not V.punishing then V.Env.restore(1.5) end
			W.model:Destroy()
			W = nil
		end
	end
	local function spawnWorld(root)
		local ang, dist = math.random() * math.pi * 2, math.random(K.BOOK_SPAWN_MIN, K.BOOK_SPAWN_MAX)
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {lp.Character, V.coinFolder}
		local hit = workspace:Raycast(root.Position + Vector3.new(math.cos(ang) * dist, 150, math.sin(ang) * dist), Vector3.new(0, -400, 0), rp)
		if not hit or hit.Normal.Y < .6 then return false end
		local m, parts = buildBookModel()
		m.Parent = workspace
		W = {model = m, parts = parts, pos = hit.Position, upright = 0, open = 0, hover = .45, dark = false}
		placeBook(parts, CFrame.new(hit.Position + Vector3.new(0, .45, 0)), 0)
		return true
	end
	local function pickup()
		removeWorld()
		Book.state = "full"
		giveTool()
		openViewer() -- the page pops up on your screen
		toast("You found the Necrobloxicon. It is in your inventory.", 5)
	end
	local function updateWorld(dt, root)
		local flat = Vector3.new(root.Position.X - W.pos.X, 0, root.Position.Z - W.pos.Z)
		local d = flat.Magnitude
		local stage = d > K.BOOK_DARK_DIST and 0 or (d > K.BOOK_FLOAT_DIST and 1 or (d > K.BOOK_OPEN_DIST and 2 or 3))
		local wantDark = stage >= 1
		if wantDark ~= W.dark and not V.ritual.active and not V.punishing then -- near it, the sky turns dark
			W.dark = wantDark
			if wantDark then V.Env.darken(2) else V.Env.restore(2) end
		end
		W.upright += ((stage >= 2 and 1 or 0) - W.upright) * math.min(1, 2.2 * dt)
		W.open += ((stage == 3 and 1 or 0) - W.open) * math.min(1, 2.5 * dt)
		W.hover += ((stage >= 2 and 4.5 or .45) - W.hover) * math.min(1, 2.2 * dt)
		if stage == 3 and d > .1 then W.pos += flat.Unit * math.min(d, 12 * dt) end -- floats toward you
		local base = W.pos + Vector3.new(0, W.hover + math.sin(os.clock() * 2) * .15 * W.upright, 0)
		local u = d > .1 and flat.Unit or Vector3.new(0, 0, 1)
		local standing = CFrame.fromMatrix(base, u:Cross(Vector3.yAxis), u, Vector3.yAxis) -- upright, cover facing you
		placeBook(W.parts, CFrame.new(base):Lerp(standing, W.upright), W.open)
		local glow = math.clamp(1 - d / K.BOOK_DARK_DIST, 0, 1)
		local light = W.parts.pages:FindFirstChildOfClass("PointLight")
		light.Range, light.Brightness = 6 + 22 * glow, glow * 6
		if stage == 3 and d < 4 then pickup() end
	end

	-- the seal on the right page is dark while you are on cooldown and slowly lights up until you can summon again
	local function updateSeal()
		local remain = math.max(0, lockoutUntil - os.clock())
		local total = math.max(V.cooldownTotal or K.SUMMON_COOLDOWN, remain, 1)
		local lit = remain > 0 and (1 - remain / total) or 1
		local col = Color3.fromRGB(95, 30, 30):Lerp(Color3.fromRGB(255, 45, 45), lit)
		for _, l in ipairs(sealLines) do
			l.BackgroundColor3 = col
			l.BackgroundTransparency = .45 * (1 - lit)
		end
		ringStroke.Color = col
		local s = math.ceil(remain)
		sealTimer.Text = remain > 0 and string.format("%d:%02d", math.floor(s / 60), s % 60) or ""
	end

	-- no pentagram: a faint pentagram fades in slowly on your screen, shaking, while you float
	local omenGui = new("ScreenGui", {Name = "NecroOmen", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5, Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global}, playerGui)
	local omen = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.6, .6), BackgroundTransparency = 1, ZIndex = 1}, omenGui)
	new("UIAspectRatioConstraint", {AspectRatio = 1, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Width}, omen)
	local omenRing = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1}, omen)
	new("UICorner", {CornerRadius = UDim.new(1, 0)}, omenRing)
	local omenStroke = new("UIStroke", {Color = Color3.fromRGB(255, 40, 40), Thickness = 5, Transparency = 1}, omenRing)
	local omenLines, omenAlpha = {}, 0
	for k = 0, 4 do
		local a1, a2 = math.rad(-90 + 72 * k), math.rad(-90 + 72 * ((k + 2) % 5))
		local p1, p2 = Vector2.new(.5 + .46 * math.cos(a1), .5 + .46 * math.sin(a1)), Vector2.new(.5 + .46 * math.cos(a2), .5 + .46 * math.sin(a2))
		local d = p2 - p1
		omenLines[#omenLines + 1] = rect(omen, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2),
			Size = UDim2.fromScale(d.Magnitude, .014), Rotation = math.deg(math.atan2(d.Y, d.X)), BackgroundColor3 = Color3.fromRGB(255, 40, 40),
			BackgroundTransparency = 1, ZIndex = 2})
	end
	local function updateOmen(dt)
		local want = V.ritual.active and V.ritual.locked and not Book.pentagramPos -- only once the third line has been spoken
		omenAlpha = want and math.min(1, omenAlpha + dt / 8) or math.max(0, omenAlpha - dt / 1.5) -- 8 seconds to fade in
		omenGui.Enabled = omenAlpha > 0
		if omenAlpha > 0 then
			local tr = 1 - .3 * omenAlpha -- never more than 30% opaque
			for i, l in ipairs(omenLines) do l.BackgroundTransparency = 1 - .3 * math.clamp(omenAlpha * 5 - (i - 1), 0, 1) end -- one line after another
			omenStroke.Transparency = tr
			omen.Position = UDim2.new(.5, math.random(-6, 6), .5, math.random(-6, 6)) -- shaking
			omen.Rotation = (math.random() - .5) * 2.4
		end
	end

	-- one loop for everything
	RS.Heartbeat:Connect(function(dt)
		updateOmen(dt)
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		if os.clock() - (Book.lastCheck or 0) > 1 then Book.lastCheck = os.clock() ensureTool() end
		if viewer.Enabled then updateSeal() end
		if Book.state == "none" then
			if W then
				if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(W.pos.X, 0, W.pos.Z)).Magnitude > K.BOOK_SPAWN_MAX * 2 then
					removeWorld() -- you wandered far away: it will reappear near you
				else
					updateWorld(dt, root)
				end
			elseif os.clock() - startClock > 8 and os.clock() - (Book.lastTry or 0) > 2 then
				Book.lastTry = os.clock()
				spawnWorld(root)
			end
		elseif W then
			removeWorld()
		end
		if armed then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then
				disarm(true)
			else
				setLineStates(V.ritual.stage)
				local stage = V.ritual.active and V.ritual.stage or 0
				setPentLit(stage == 0 and 0 or math.floor(stage / 3 * 5 + .5)) -- the pentagram lights up as you speak
				if not V.ritual.active and not V.ritual.locked
					and (os.clock() - armed.t0 > K.BOOK_ARMED_TIMEOUT or (root.Position - armed.center).Magnitude > 70) then
					disarm(true)
					toast("The ritual fades. The book returns to you.", 3)
				end
			end
		end
	end)

	-- called by the summon when it ends: a finished summon turns the book into just the page with the three lines
	Book.onSummonEnd = function(finished)
		if armed then disarm(false) end -- (the book is no longer turned into a page; it stays the full Necrobloxicon)
		if finished then startCooldown(K.SUMMON_COOLDOWN) end -- the seal goes dark and relights during the cooldown
		ensureTool()
	end
	lp.CharacterAdded:Connect(function() -- you keep it when you die
		task.wait(.6)
		if not armed then giveTool() end
	end)
end
