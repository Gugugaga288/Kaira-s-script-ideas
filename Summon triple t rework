		table.insert(extras, part(Enum.PartType.Ball, Vector3.new(.22, .22, .22), base * CFrame.new(sx * .28, .6, -.68), black, Enum.Material.SmoothPlastic))
		table.insert(extras, part(Enum.PartType.Cylinder, Vector3.new(1, .22, .22), base * CFrame.new(sx * .25, -1.6, 0) * CFrame.Angles(0, 0, math.pi / 2), dark, Enum.Material.Wood))
