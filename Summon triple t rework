	local base = CFrame.new(pos)
	local body = part(Enum.PartType.Cylinder, Vector3.new(2.4, 1.1, 1.1), base * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(150, 100, 50), Enum.Material.Wood, true)
	body.CanQuery = true
