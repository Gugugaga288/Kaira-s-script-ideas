---------------------------------------------------------------- Soul Keeper rework (dropped blessing souls + inventory + throwable shards)
-- (the old baby Tung Tungs are gone)
-- With Soul Keeper: when you die your blessings are lost, but each one falls somewhere on the map as a coloured soul.
--   Abilities (glide, missile, drone, drone park/mount, multi jump, chain, missile phase) come straight back when you touch their soul.
--   Every other blessing soul goes into your Roblox inventory (hotbar). Equip it, then:
--     * tap / click the screen = get the blessing back for good
--     * THROW button (or T) = it breaks on the ground and leaves a pool for K.POOL_LIFETIME seconds; stand in it for a STRONGER
--       version of the blessing that lasts K.POOL_BUFF_TIME seconds after you step out.
-- Without Soul Keeper your blessings just vanish (they fly off), exactly like before.
do
	local Keeper = {souls = {}, stacks = {}, tmp = {}, pools = {}, equipped = nil, lastThrow = 0, lastUse = 0}
	V.Keeper = Keeper
	K.POOL_BUFF_TIME = 30      -- seconds the stronger blessing lasts
	K.POOL_LIFETIME = 120      -- seconds the broken soul lingers on the ground (2 minutes)
	K.POOL_RADIUS = 5.5        -- how wide the puddle is
	K.KEEPER_FALL_HEIGHT = 170 -- the dropped souls fall from this high above their spot
	K.KEEPER_RANGE = 1500      -- souls are never dropped further than this from where you died
	K.KEEPER_ABILITIES = {glide = true, missile = true, mphase = true, drone = true, dronepark = true, dronemount = true, mjump = true, chain = true}
	K.KEEPER_NAMES = {
		speed = "Swift", jump = "Jump", esp = "ESP", missile = "Missile", mdur = "Missile Time", mspeed = "Missile Speed",
		mcd = "Missile Cooldown", mphase = "Missile Phase", mjump = "Multi Jump", glide = "Glide", gdur = "Glide Time",
		magnet = "Soul Magnet", multi = "Fortune", drone = "Drone", dronepark = "Drone Park", dronemount = "Drone Mount",
		chain = "Chain of a Million Miles",
	}
	K.KEEPER_EXTRA = {esp = 2, mdur = 2, mspeed = 2, mcd = 2, gdur = 2, magnet = 1} -- extra levels a pool gives (speed/jump get double, fortune +1 multiplier)
	local FALLBACK_COLOR = Color3.fromRGB(255, 130, 40)

	local function nameOf(key, super)
		local n = K.KEEPER_NAMES[key] or key
		if super and (key == "speed" or key == "jump") then n = "Super " .. n end
		return n
	end
	local function colorOf(key) return BLESS_COLORS[key] or FALLBACK_COLOR end
	local function blocked() return V.inMaze or V.inTrial end

	-- ---------- giving a blessing back ----------
	local function regrant(key, super) -- no prerequisites are granted for free (a Drone Park soul does not give you the Drone)
		if V.lv[key] == nil then return end
		V.lv[key] += 1
		if key == "speed" then table.insert(speedSteps, super and K.SUPER_SPEED or K.SPEED_STEP)
		elseif key == "jump" then table.insert(jumpSteps, super and K.SUPER_JUMP or K.JUMP_STEP) end
		if V.on[key] ~= nil then V.on[key] = true end
		sync()
	end

	-- ---------- HUD ----------
	Keeper.hud = new("TextLabel", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 100), Size = UDim2.fromOffset(250, 22),
		BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 200, 120), TextStrokeTransparency = .5, Font = Enum.Font.GothamBold,
		TextSize = 13, Visible = false}, V.gui)
	Keeper.boostLbl = new("TextLabel", {Position = UDim2.new(0, 10, .4, 0), Size = UDim2.fromOffset(190, 20), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = .5, TextColor3 = Color3.fromRGB(180, 255, 200), Font = Enum.Font.GothamBold,
		TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Visible = false}, V.gui)
	corner(Keeper.boostLbl, 8)
	new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}, Keeper.boostLbl)
	local function updateHud()
		local n = #Keeper.souls
		Keeper.hud.Visible = n > 0
		Keeper.hud.Text = "Lost blessings on the map: " .. n
	end

	-- ---------- temporary (pool) blessings: stronger, 30 seconds ----------
	local function applyTemp(key, super)
		local untilT = os.clock() + K.POOL_BUFF_TIME
		local rec = Keeper.tmp[key]
		if rec then rec.untilT = untilT return end
		rec = {untilT = untilT, key = key}
		if key == "speed" then
			rec.amt = (super and K.SUPER_SPEED or K.SPEED_STEP) * 2
			table.insert(speedSteps, rec.amt)
			V.on.speed = true
		elseif key == "jump" then
			rec.amt = (super and K.SUPER_JUMP or K.JUMP_STEP) * 2
			table.insert(jumpSteps, rec.amt)
			V.on.jump = true
		elseif key == "multi" then
			V.tmpMulti = true
		else
			rec.extra = K.KEEPER_EXTRA[key] or 1
			if key == "esp" then rec.extra = math.min(rec.extra, 4 - V.lv.esp) end
			V.lv[key] += rec.extra
			if V.on[key] ~= nil then V.on[key] = true end
			if key == "magnet" then V.tmpMagnet = true end
		end
		Keeper.tmp[key] = rec
		sync()
		toast("Stronger " .. nameOf(key, super) .. " for " .. K.POOL_BUFF_TIME .. "s", 3)
	end
	local function endTemp(key)
		local rec = Keeper.tmp[key]
		if not rec then return end
		Keeper.tmp[key] = nil
		if key == "speed" then
			local i = table.find(speedSteps, rec.amt) if i then table.remove(speedSteps, i) end
		elseif key == "jump" then
			local i = table.find(jumpSteps, rec.amt) if i then table.remove(jumpSteps, i) end
		elseif key == "multi" then
			V.tmpMulti = nil
		else
			V.lv[key] = math.max(0, V.lv[key] - (rec.extra or 0))
			if key == "magnet" then V.tmpMagnet = nil end
		end
		if V.on[key] ~= nil and (V.lv[key] or 0) == 0 then V.on[key] = false end
		sync()
	end
	V.keeperEndTemps = function() for key in pairs(table.clone(Keeper.tmp)) do endTemp(key) end end

	-- ---------- inventory (real Roblox Tools in your Backpack) ----------
	local makeTool
	local function toolName(st) return nameOf(st.key, st.super) .. " Soul" .. (st.count > 1 and (" x" .. st.count) or "") end
	local function updateThrow()
		Keeper.throwBtn.Visible = Keeper.equipped ~= nil
		Keeper.hint.Visible = Keeper.equipped ~= nil
	end
	local function consume(st)
		st.count -= 1
		if st.count <= 0 then
			Keeper.stacks[st.id] = nil
			if Keeper.equipped == st then Keeper.equipped = nil end
			if st.tool then st.tool:Destroy() st.tool = nil end
			updateThrow()
		elseif st.tool then
			st.tool.Name = toolName(st)
		end
	end
	local function useStack(st)
		if os.clock() - Keeper.lastUse < .35 or st.count <= 0 then return end
		Keeper.lastUse = os.clock()
		local hum = V.lp.Character and V.lp.Character:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		if blocked() then toast("Blessings can't be restored in here.", 2) return end
		consume(st)
		regrant(st.key, st.super)
		toast(nameOf(st.key, st.super) .. " is yours again!", 3)
	end
	makeTool = function(st)
		local backpack = V.lp:FindFirstChildOfClass("Backpack")
		if not backpack then return end
		if st.tool then st.tool:Destroy() end
		local t = Instance.new("Tool")
		t.Name = toolName(st)
		t.RequiresHandle, t.CanBeDropped = false, false
		t.ToolTip = "Tap the screen to get it back, or THROW it on the ground"
		t.Equipped:Connect(function() Keeper.equipped = st updateThrow() end)
		t.Unequipped:Connect(function() if Keeper.equipped == st then Keeper.equipped = nil end updateThrow() end)
		t.Activated:Connect(function() useStack(st) end)
		t.Parent = backpack
		st.tool = t
	end
	local function addToInventory(key, super)
		local id = key .. (super and "_S" or "")
		local st = Keeper.stacks[id]
		if st then
			st.count += 1
			if st.tool then st.tool.Name = toolName(st) end
		else
			st = {id = id, key = key, super = super, count = 1}
			Keeper.stacks[id] = st
			makeTool(st)
		end
	end
	task.spawn(function() -- the Backpack is wiped when you respawn, so the tools are rebuilt from the saved stacks
		while true do
			task.wait(1)
			local backpack = V.lp:FindFirstChildOfClass("Backpack")
			if backpack then
				for _, st in pairs(Keeper.stacks) do
					if not st.tool or not (st.tool.Parent == backpack or st.tool.Parent == V.lp.Character) then makeTool(st) end
				end
			end
		end
	end)

	-- ---------- the THROW button ----------
	Keeper.throwBtn = new("TextButton", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -100), Size = UDim2.fromOffset(150, 44),
		BackgroundColor3 = Color3.fromRGB(130, 40, 40), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBlack, TextSize = 15,
		Text = "THROW (T)", Visible = false}, V.gui)
	corner(Keeper.throwBtn, 10)
	Keeper.hint = new("TextLabel", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -148), Size = UDim2.fromOffset(280, 20),
		BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = .4, Font = Enum.Font.GothamBold, TextSize = 13,
		Text = "Tap the screen = get it back for good", Visible = false}, V.gui)

	local function createPool(key, super, pos, normal)
		local col = colorOf(key)
		local disc = new("Part", {Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, K.POOL_RADIUS * 2, K.POOL_RADIUS * 2),
			CFrame = CFrame.lookAt(pos + normal * .15, pos + normal * 2) * CFrame.Angles(0, math.pi / 2, 0),
			Color = col, Material = Enum.Material.Neon, Transparency = .55, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, workspace)
		new("PointLight", {Color = col, Range = 16, Brightness = 2}, disc)
		local em = new("ParticleEmitter", {Color = ColorSequence.new(col), Rate = 14, Lifetime = NumberRange.new(1.2, 2), Speed = NumberRange.new(2, 4),
			SpreadAngle = Vector2.new(25, 25), Size = NumberSequence.new({NumberSequenceKeypoint.new(0, .6), NumberSequenceKeypoint.new(1, 0)}),
			LightEmission = 1, Transparency = NumberSequence.new(.2, 1), EmissionDirection = Enum.NormalId.Right}, disc)
		local bb = new("BillboardGui", {Size = UDim2.fromOffset(200, 34), StudsOffset = Vector3.new(0, 4, 0), AlwaysOnTop = true, Adornee = disc}, disc)
		local lbl = new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, TextColor3 = col, TextStrokeTransparency = .3,
			Font = Enum.Font.GothamBold, TextScaled = true}, bb)
		table.insert(Keeper.pools, {key = key, super = super, pos = pos, born = os.clock(), disc = disc, lbl = lbl, em = em, inside = false})
	end

	local function breakAt(key, super, pos, normal)
		playSound(K.SOUNDS.stinger)
		local col = colorOf(key)
		for _ = 1, 10 do
			local sh = new("Part", {Size = Vector3.new(.4, .4, .4), Color = col, Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
				CanTouch = false, CanQuery = false, Position = pos + Vector3.new(0, .5, 0)}, workspace)
			local dir = Vector3.new(math.random() - .5, math.random() * .8 + .2, math.random() - .5).Unit
			TS:Create(sh, TweenInfo.new(.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = pos + dir * math.random(4, 8), Transparency = 1}):Play()
			Debris:AddItem(sh, .7)
		end
		createPool(key, super, pos, normal)
	end

	local function throwEquipped()
		local st = Keeper.equipped
		local char = V.lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not st or st.count <= 0 or not root or os.clock() - Keeper.lastThrow < .5 then return end
		if blocked() then toast("Can't throw it in here.", 2) return end
		Keeper.lastThrow = os.clock()
		local key, super = st.key, st.super
		consume(st)
		local ball = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Color = colorOf(key), Material = Enum.Material.Neon, Transparency = .15,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Position = root.Position + Vector3.new(0, 1.5, 0) + cam.CFrame.LookVector * 2}, workspace)
		new("PointLight", {Color = colorOf(key), Range = 12, Brightness = 2}, ball)
		local vel = cam.CFrame.LookVector * 60 + Vector3.new(0, 28, 0)
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = {char, V.coinFolder, ball}
		local t0, conn = os.clock(), nil
		local function finish(hit, fallbackPos)
			conn:Disconnect()
			local pos, normal = fallbackPos, Vector3.new(0, 1, 0)
			if hit then
				pos, normal = hit.Position, hit.Normal
				if normal.Y < .5 then -- hit a wall: drop to the floor below it
					local down = workspace:Raycast(hit.Position + normal * 1.5 + Vector3.new(0, 2, 0), Vector3.new(0, -80, 0), params)
					if down then pos, normal = down.Position, down.Normal end
				end
			else
				local down = workspace:Raycast(fallbackPos, Vector3.new(0, -400, 0), params)
				if down then pos, normal = down.Position, down.Normal end
			end
			ball:Destroy()
			breakAt(key, super, pos, normal)
		end
		conn = RS.Heartbeat:Connect(function(dt)
			vel += Vector3.new(0, -workspace.Gravity * .6 * dt, 0)
			local step = vel * dt
			local hit = workspace:Raycast(ball.Position, step, params)
			if hit then finish(hit, hit.Position) return end
			ball.Position += step
			if os.clock() - t0 > 4 then finish(nil, ball.Position) end
		end)
	end
	Keeper.throwBtn.MouseButton1Click:Connect(throwEquipped)
	UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.T then throwEquipped() end
	end)

	-- ---------- dropping the souls across the map ----------
	local function mapBounds(center)
		if Keeper.bounds and os.clock() - Keeper.boundsT < 120 then return Keeper.bounds end
		local b = {minX = math.huge, maxX = -math.huge, minZ = math.huge, maxZ = -math.huge, maxY = center.Y}
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			n += 1
			if n % 3000 == 0 then task.wait() end
			if d:IsA("BasePart") and d.Anchored and d.CanCollide and d.Size.Magnitude > 4 then
				local p = d.Position
				if (Vector3.new(p.X, 0, p.Z) - Vector3.new(center.X, 0, center.Z)).Magnitude < K.KEEPER_RANGE then
					b.minX, b.maxX = math.min(b.minX, p.X), math.max(b.maxX, p.X)
					b.minZ, b.maxZ = math.min(b.minZ, p.Z), math.max(b.maxZ, p.Z)
					b.maxY = math.max(b.maxY, p.Y + d.Size.Y / 2)
				end
			end
		end
		if b.minX > b.maxX then b.minX, b.maxX, b.minZ, b.maxZ = center.X - 150, center.X + 150, center.Z - 150, center.Z + 150 end
		Keeper.bounds, Keeper.boundsT = b, os.clock()
		return b
	end
	local function pickSpots(count, center)
		local b = mapBounds(center)
		local params = RaycastParams.new()
		local ignore = {V.coinFolder}
		if V.lp.Character then table.insert(ignore, V.lp.Character) end
		params.FilterDescendantsInstances = ignore
		local spots = {}
		for i = 1, count do
			local spot
			for a = 1, 50 do
				local x = b.minX + (b.maxX - b.minX) * math.random()
				local z = b.minZ + (b.maxZ - b.minZ) * math.random()
				local hit = workspace:Raycast(Vector3.new(x, b.maxY + 60, z), Vector3.new(0, -(b.maxY - center.Y + 1500), 0), params)
				if hit and hit.Normal.Y > .6 and hit.Material ~= Enum.Material.Water and (hit.Position - center).Magnitude > 20 then
					spot = hit.Position + Vector3.new(0, 3, 0)
					break
				end
				if a % 15 == 0 then task.wait() end
			end
			spots[i] = spot or (center + Vector3.new(math.random(-80, 80), 3, math.random(-80, 80)))
		end
		return spots
	end

	local function newKeeperSoul(key, super, target)
		local m, rigid, tail = buildSoul()
		recolorSoul(rigid, tail, colorOf(key))
		m.Parent = V.coinFolder
		table.insert(Keeper.souls, {kind = "keeper", key = key, super = super, model = m, rigid = rigid, tail = tail,
			pos = target + Vector3.new(0, K.KEEPER_FALL_HEIGHT, 0), target = target, vel = Vector3.zero, vy = 0, scale = .05, born = os.clock(),
			phase = math.random() * 6.28, face = Vector3.new(0, 0, -1), lastSc = 0, state = "fall"})
		updateHud()
	end

	-- what you currently own, one entry per level (speed/jump remember if they were Super)
	V.keeperSnapshot = function()
		local list = {}
		for key, n in pairs(V.lv) do
			if key ~= "mercy" and key ~= "speed" and key ~= "jump" and n > 0 then
				for _ = 1, n do table.insert(list, {key = key}) end
			end
		end
		for _, a in ipairs(speedSteps) do table.insert(list, {key = "speed", super = a == K.SUPER_SPEED}) end
		for _, a in ipairs(jumpSteps) do table.insert(list, {key = "jump", super = a == K.SUPER_JUMP}) end
		return list
	end
	V.keeperDrop = function(list, deathPos)
		if #list == 0 then return end
		task.spawn(function()
			local spots = pickSpots(#list, deathPos)
			toast("Your blessings scattered across the map! Find your souls.", 5)
			for i, item in ipairs(list) do
				newKeeperSoul(item.key, item.super, spots[i])
				task.wait(.05)
			end
		end)
	end

	local function collectKeeper(i)
		local s = Keeper.souls[i]
		collectEffect(s.pos)
		s.model:Destroy()
		table.remove(Keeper.souls, i)
		if K.KEEPER_ABILITIES[s.key] then
			regrant(s.key, s.super)
			toast(nameOf(s.key, s.super) .. " returned to you!", 3)
		else
			addToInventory(s.key, s.super)
			toast(nameOf(s.key, s.super) .. " soul added to your inventory", 3)
		end
		updateHud()
	end

	-- ---------- one loop: souls fall/bob/get collected, pools tick, temp buffs expire ----------
	local boostTick = 0
	RS.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local root = V.lp.Character and V.lp.Character:FindFirstChild("HumanoidRootPart")
		local hum = V.lp.Character and V.lp.Character:FindFirstChildOfClass("Humanoid")
		local alive = hum and hum.Health > 0
		local orb = V.Angel and V.Angel.active and V.Angel.pos or nil
		local who = orb or (root and root.Position)
		local canCollect = who and alive and not blocked() and not missileBusy and (not busy or orb ~= nil)
		local camPos = cam.CFrame.Position
		for i = #Keeper.souls, 1, -1 do
			local s = Keeper.souls[i]
			if s.state == "fall" then
				s.vy = math.min(120, s.vy + 150 * dt)
				s.vel = Vector3.new(0, -s.vy, 0)
				s.pos = s.pos - Vector3.new(0, s.vy * dt, 0)
				if s.pos.Y <= s.target.Y then s.pos, s.state, s.landed, s.vel = s.target, "rest", now, Vector3.zero end
				s.scale = popScale(now - s.born)
			else
				s.pos = s.target + Vector3.new(0, math.sin(now * 2 + s.phase) * .5, 0)
				s.scale = popScale(now - s.landed)
			end
			if (s.pos - camPos).Magnitude < 400 then layoutSoul(s, now, who or s.pos) end
			if s.state == "rest" and canCollect and (who - s.target).Magnitude < 5 then collectKeeper(i) end
		end
		for i = #Keeper.pools, 1, -1 do
			local p = Keeper.pools[i]
			local age = now - p.born
			if age >= K.POOL_LIFETIME then
				p.disc:Destroy()
				table.remove(Keeper.pools, i)
			else
				local left = K.POOL_LIFETIME - age
				p.lbl.Text = nameOf(p.key, p.super) .. " (stronger)  " .. string.format("%d:%02d", math.floor(left / 60), math.floor(left % 60))
				p.disc.Transparency = left < 10 and (.55 + .3 * math.abs(math.sin(now * 6))) or .55
				if root and alive and not blocked() then
					local d = root.Position - p.pos
					local inside = Vector3.new(d.X, 0, d.Z).Magnitude < K.POOL_RADIUS and d.Y > -4 and d.Y < 9
					if inside then applyTemp(p.key, p.super) end -- standing in it keeps refreshing the timer
					p.inside = inside
				end
			end
		end
		if now - boostTick > .25 then
			boostTick = now
			local lines = {}
			for key, rec in pairs(Keeper.tmp) do
				if now >= rec.untilT then endTemp(key)
				else table.insert(lines, nameOf(key, false) .. " (stronger)  " .. math.ceil(rec.untilT - now) .. "s") end
			end
			Keeper.boostLbl.Visible = #lines > 0
			Keeper.boostLbl.Text = table.concat(lines, "\n")
		end
	end)
end

