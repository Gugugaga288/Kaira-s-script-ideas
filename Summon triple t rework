-- ===== ritual: three chat lines make you float higher =====
V.ritual = {stage = 0, lastLine = 0, h = 0, target = 0, bp = nil, conn = nil, start = nil, locked = false, active = false}

ritualStop = function() -- safe to call any number of times
	if V.ritual.conn then V.ritual.conn:Disconnect() V.ritual.conn = nil end
	if V.ritual.bp then V.ritual.bp:Destroy() V.ritual.bp = nil end
	local hum = V.lp.Character and V.lp.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
	end
	if V.ritual.animate then pcall(function() V.ritual.animate.Disabled = false end) V.ritual.animate = nil end -- animations come back
	if V.ritual.active then
		V.ritual.active = false
		busy = false
		applyBuffs()
	end
	V.ritual.stage, V.ritual.locked, V.ritual.h, V.ritual.target = 0, false, 0, 0
end

local function ritualStart(root, hum)
	V.ritual.active, busy = true, true
	V.ritual.start = root.Position
	if V.Book.pentagramPos then -- Necrobloxicon ritual: you float above the pentagram
		local p = V.Book.pentagramPos + Vector3.new(0, hum.HipHeight + root.Size.Y / 2 + .2, 0)
		root.CFrame = CFrame.new(p) * (root.CFrame - root.CFrame.Position)
		V.ritual.start = p
	end
	V.ritual.bp = new("BodyPosition", {MaxForce = Vector3.new(1e6, 1e6, 1e6), P = 3000, D = 500, Position = root.Position}, root)
	hum.WalkSpeed, hum.UseJumpPower, hum.JumpPower = 0, true, 0
	-- no character animations while floating: turn the Animate script off and keep every track stopped
	local animate = root.Parent and root.Parent:FindFirstChild("Animate")
	if animate then animate.Disabled = true V.ritual.animate = animate end
	local animator = hum:FindFirstChildOfClass("Animator")
	local function freeze()
		for _, t in ipairs((animator or hum):GetPlayingAnimationTracks()) do t:Stop(0) end
	end
	freeze()
	pcall(function() -- no falling pose while floating
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	V.ritual.conn = RS.Heartbeat:Connect(function(dt)
		if hum.Health <= 0 or not root.Parent or not V.ritual.bp then ritualStop() return end
		freeze()
		local sinking = not V.ritual.locked and os.clock() - V.ritual.lastLine > K.RITUAL_IDLE
		if sinking then V.ritual.target = math.max(0, V.ritual.target - K.RITUAL_SINK * dt) end
		V.ritual.h += (V.ritual.target - V.ritual.h) * math.min(1, 2.5 * dt)
		if sinking and V.ritual.target <= 0 and V.ritual.h < .15 then ritualStop() return end -- back on the ground: ritual resets
		local bob = math.sin(os.clock() * 2.5) * K.BOB_AMOUNT * math.min(1, V.ritual.h / 4)
		V.ritual.bp.Position = V.ritual.start + Vector3.new(0, V.ritual.h + bob, 0)
	end)
end

---------------------------------------------------------------- Punishment (6th summon within 3 minutes)
-- ===== TWEAKS for the lava obby =====
K.LAVA_DELAY, K.LAVA_SPEED = 6, 2.1  -- seconds before the lava starts rising / how fast it rises (studs per second)
K.OBBY_STEPS = 42                    -- number of platforms (more = longer)
K.OBBY_CRUMBLE_EVERY = 5             -- every Nth platform (orange) crumbles about 1 second after you land on it
K.ARENA_Y = 3000

local HAND_SKIN, HAND_CLAW = Color3.fromRGB(78, 10, 10), Color3.fromRGB(255, 50, 30)
local ARM_SEGS = 7

-- a clawed demon hand: origin at the wrist, fingers along +Y, palm facing -Z, fingers curled into a grip
local function buildHand()
	local m = Instance.new("Model")
	m.Name = "DemonHand"
	local function blob(size, cf, color, mat)
		local p = new("Part", {
			Size = size, CFrame = cf, Color = color or HAND_SKIN, Material = mat or Enum.Material.SmoothPlastic,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
		new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p)
		return p
	end
	local function seg(len, r, cf, color, mat) -- a rounded finger bone along +Y from cf
		blob(Vector3.new(2 * r, len + r, 2 * r), cf * CFrame.new(0, len / 2, 0), color, mat)
	end
	blob(Vector3.new(.95, .95, .95), CFrame.new(0, 0, 0))     -- wrist
	blob(Vector3.new(1.7, 1.6, .8), CFrame.new(0, .85, 0))    -- palm
	blob(Vector3.new(1.5, .6, .6), CFrame.new(0, .3, -.12))   -- heel of the hand
	local function finger(x, y, lens, r, tilt, curls)
		local cf = CFrame.new(x, y, -.15) * CFrame.Angles(0, 0, tilt)
		for i = 1, 3 do
			cf = cf * CFrame.Angles(-curls[i], 0, 0)
			local rr = r * (1 - (i - 1) * .17)
			seg(lens[i], rr, cf)
			blob(Vector3.new(rr * 2.2, rr * 2.2, rr * 2.2), cf)                   -- knuckle
			cf = cf * CFrame.new(0, lens[i], 0)
		end
		seg(.55, r * .38, cf * CFrame.Angles(-.4, 0, 0), HAND_CLAW, Enum.Material.Neon) -- glowing claw
	end
	finger(-.58, 1.5, {.55, .42, .34}, .17, .06, {.35, .95, .9})   -- pinky
	finger(-.2, 1.55, {.78, .6, .46}, .19, .02, {.35, .95, .9})    -- ring
	finger(.2, 1.55, {.85, .65, .5}, .19, -.02, {.35, .95, .9})    -- middle
	finger(.58, 1.5, {.75, .58, .44}, .18, -.06, {.35, .95, .9})   -- index
	-- thumb, off to the side
	local tcf = CFrame.new(.82, .5, -.2) * CFrame.Angles(0, 0, -.95)
	for i, spec in ipairs({{.6, .35}, {.5, .8}}) do
		tcf = tcf * CFrame.Angles(-spec[2], 0, 0)
		seg(spec[1], .21 * (1 - (i - 1) * .15), tcf)
		tcf = tcf * CFrame.new(0, spec[1], 0)
	end
	seg(.5, .08, tcf * CFrame.Angles(-.4, 0, 0), HAND_CLAW, Enum.Material.Neon)
	m.WorldPivot = CFrame.new()
	return m
end

-- each hand grips a DIFFERENT part of the body
local GRIP = {
	{"LeftFoot", "Left Leg"}, {"RightFoot", "Right Leg"}, {"LeftLowerLeg", "Left Leg"}, {"RightUpperLeg", "Right Leg"},
	{"LowerTorso", "Torso"}, {"LeftUpperArm", "Left Arm"}, {"RightUpperArm", "Right Arm"},
}

local function buildArm()
	local armModel = Instance.new("Model")
	armModel.Name = "DemonArm"
	local parts = {}
	for i = 1, ARM_SEGS do -- overlapping ellipsoids make a smooth, muscular arm that can bend
		local p = new("Part", {
			Size = Vector3.new(1, 1, 1), Color = HAND_SKIN, Material = Enum.Material.Slate,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, armModel)
		new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p)
		parts[i] = p
	end
	armModel.Parent = workspace
	return armModel, parts
end

-- reach k: 0 = just emerging from the portal, 1 = gripping its target
local function updateHand(h, root, ground, k)
	local T = root.Position + h.off
	local base = ground + Vector3.new(math.cos(h.ang) * 7, 0, math.sin(h.ang) * 7)
	local d = Vector3.new(base.X - T.X, 0, base.Z - T.Z)
	d = d.Magnitude > .1 and d.Unit or Vector3.new(math.cos(h.ang), 0, math.sin(h.ang))
	local W = (base + Vector3.new(0, 1.5, 0)):Lerp(T + d * 1.0 + Vector3.new(0, -1.0, 0), k)
	local ctrl = (base + W) / 2 + d * 3 + Vector3.new(0, 2, 0)
	local pts = {}
	for i = 0, ARM_SEGS do
		local t = i / ARM_SEGS
		pts[i] = base:Lerp(ctrl, t):Lerp(ctrl:Lerp(W, t), t)
	end
	for i = 1, ARM_SEGS do
		local p1, p2 = pts[i - 1], pts[i]
		local len = (p2 - p1).Magnitude
		if len > .001 then
			local th = 1.2 - .65 * ((i - .5) / ARM_SEGS) -- thick at the shoulder, slim at the wrist
			h.armParts[i].Size = Vector3.new(th, th, len * 1.45)
			h.armParts[i].CFrame = CFrame.lookAt((p1 + p2) / 2, p2)
		end
	end
	local up = pts[ARM_SEGS] - pts[ARM_SEGS - 1]
	up = up.Magnitude > .001 and up.Unit or Vector3.yAxis
	local n = T - (W + up * .85) -- palm faces the body part it grips
	n = n - up * n:Dot(up)
	n = n.Magnitude > .05 and n.Unit or -d
	local back = -n
	h.model:PivotTo(CFrame.fromMatrix(W, up:Cross(back), up, back))
end

-- the lava pit: a disc, a long winding climb of shrinking platforms with growing gaps, crumbling platforms, rising lava
local function buildArena(center)
	local m = Instance.new("Model")
	m.Name = "DemonArena"
	local function part(shape, size, cf, color, mat, collide)
		return new("Part", {
			Shape = shape, Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Slate,
			Anchored = true, CanCollide = collide or false, CanTouch = false, CanQuery = false,
		}, m)
	end
	part(Enum.PartType.Cylinder, Vector3.new(2, 26, 26), CFrame.new(center - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(45, 12, 12), nil, true)
	local crumbles = {}
	local N = K.OBBY_STEPS
	local topY, ang, prevR, prevW, lastTop = center.Y, math.random() * math.pi * 2, 0, 26, nil
	for i = 1, N do
		local f = i / N
		local w = 8 - 3.5 * f + (math.random() - .5)               -- platforms shrink as you climb
		topY += 2.4 + math.random()                                  -- each step up is 2.4 to 3.4 studs
		local gap = 2.5 + 2.8 * f + math.random() * .5              -- gaps grow from ~2.5 to ~5.8 studs
		local r, pos
		if i == 1 then
			r = 20.5
			pos = Vector3.new(center.X + math.cos(ang) * r, 0, center.Z + math.sin(ang) * r)
		else
			r = math.clamp(prevR + (math.random() - .5) * 5, 16, 22)
			local dist = prevW / 2 + w / 2 + gap
			local cosd = (prevR * prevR + r * r - dist * dist) / (2 * prevR * r)
			ang += math.acos(math.clamp(cosd, -1, 1))
			pos = Vector3.new(center.X + math.cos(ang) * r, 0, center.Z + math.sin(ang) * r)
		end
		local crumble = i % K.OBBY_CRUMBLE_EVERY == 0 and i < N
		local p = part(Enum.PartType.Block, Vector3.new(w, 1.5, w), CFrame.new(pos.X, topY - .75, pos.Z) * CFrame.Angles(0, -ang, 0),
			crumble and Color3.fromRGB(170, 85, 30) or Color3.fromRGB(60, 18, 18), nil, true)
		if crumble then table.insert(crumbles, {part = p, x = pos.X, z = pos.Z, top = topY, half = w / 2}) end
		prevR, prevW = r, w
		lastTop = Vector3.new(pos.X, topY, pos.Z)
	end
	local exitPos = lastTop + Vector3.new(0, 4, 0)
	part(Enum.PartType.Ball, Vector3.new(5, 5, 5), CFrame.new(exitPos), Color3.fromRGB(255, 80, 80), Enum.Material.Neon).Transparency = .3
	part(Enum.PartType.Cylinder, Vector3.new(500, 4, 4), CFrame.new(exitPos + Vector3.new(0, 240, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(255, 70, 70), Enum.Material.Neon).Transparency = .5 -- tall beam so you can always see where to go
	local lava = part(Enum.PartType.Block, Vector3.new(160, 2, 160), CFrame.new(center), Color3.fromRGB(255, 80, 0), Enum.Material.Neon)
	new("PointLight", {Color = Color3.fromRGB(255, 90, 0), Range = 60, Brightness = 3}, lava)
	m.Parent = workspace
	return m, exitPos, lava, crumbles
end

local function runPunishment()
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or not V.ritual.bp then ritualStop() return end
	local cleanups = {}
	local function onCleanup(f) table.insert(cleanups, f) end
	local function alive() return hum.Health > 0 and root.Parent ~= nil end
	local fade = function(a, t) TS:Create(V.flashFrame, TweenInfo.new(t), {BackgroundTransparency = a}):Play() end

	local solidParts, collideOff = {}, false
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then table.insert(solidParts, d) end
	end
	local function setCollide(on_)
		collideOff = not on_
		for _, d in ipairs(solidParts) do if d.Parent then d.CanCollide = on_ end end
	end
	onCleanup(function() if collideOff then setCollide(true) end end)

	V.punishing = true
	applyBuffs()
	local ok, err = pcall(function()
		local floorPos = V.ritual.start
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {char, V.coinFolder}
		local hit = workspace:Raycast(floorPos + Vector3.new(0, 5, 0), Vector3.new(0, -800, 0), rp)
		local gy = hit and hit.Position.Y or floorPos.Y - 3
		local ground = Vector3.new(floorPos.X, gy + .15, floorPos.Z)
		local feetOff = hum.HipHeight + root.Size.Y / 2

		V.Env.darken(2)
		onCleanup(function() V.Env.restore(0, true) end)
		toast("You called too often. The demon is angry.", 4)

		-- red portal opens beneath you, with a demon scream
		local portal = new("Part", {
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 1, 1), CFrame = CFrame.new(ground) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(200, 10, 10), Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, workspace)
		new("PointLight", {Color = Color3.fromRGB(255, 20, 20), Range = 40, Brightness = 4}, portal)
		onCleanup(function() portal:Destroy() end)
		playSound(K.SOUNDS.scream)
		TS:Create(portal, TweenInfo.new(.9, Enum.EasingStyle.Back), {Size = Vector3.new(.3, 22, 22)}):Play()
		task.wait(1)
		if not alive() then return end

		-- seven hands spread around the portal, each reaching for a different part of your body
		local hands = {}
		for i, names in ipairs(GRIP) do
			local tp
			for _, nm in ipairs(names) do
				local c = char:FindFirstChild(nm)
				if c and c:IsA("BasePart") then tp = c break end
			end
			local off = tp and (tp.Position - root.Position) or Vector3.new(math.random(-1, 1), -math.random(0, 3), 0)
			local armModel, armParts = buildArm()
			local hm = buildHand()
			hm.Parent = workspace
			table.insert(hands, {model = hm, armModel = armModel, armParts = armParts, off = off, ang = i / #GRIP * math.pi * 2 + math.random() * .3})
		end
		onCleanup(function() for _, h in ipairs(hands) do h.model:Destroy() h.armModel:Destroy() end end)
		local function updateAll(k) for _, h in ipairs(hands) do updateHand(h, root, ground, k) end end
		local function setHandsParent(p) for _, h in ipairs(hands) do h.model.Parent = p h.armModel.Parent = p end end
		local function tween(from, to, dur, fn)
			local t0 = os.clock()
			while alive() do
				local k = math.min(1, (os.clock() - t0) / dur)
				fn(from + (to - from) * (k * k * (3 - 2 * k)))
				if k >= 1 then break end
				RS.Heartbeat:Wait()
			end
		end
		tween(0, 1, 1.6, updateAll) -- reach and grab
		if not alive() then return end

		-- drag: stop the float loop, drive the body ourselves and let it sink through the ground
		if V.ritual.conn then V.ritual.conn:Disconnect() V.ritual.conn = nil end
		setCollide(false)
		local bp = V.ritual.bp
		local startY = bp.Position.Y
		fade(.2, 1.8)
		tween(startY, gy - 10, 2.2, function(y)
			bp.Position = Vector3.new(floorPos.X, y, floorPos.Z)
			updateAll(1)
		end)
		if not alive() then return end
		fade(0, .3)
		task.wait(.3)

		-- the pit
		local center = Vector3.new(ground.X, K.ARENA_Y, ground.Z)
		local arena, exitPos, lava, crumbles = buildArena(center)
		onCleanup(function() arena:Destroy() end)
		V.ritual.bp = nil
		bp:Destroy()
		setHandsParent(nil)
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
		setCollide(true)
		root.CFrame = CFrame.new(center + Vector3.new(0, feetOff + .5, 0))
		root.AssemblyLinearVelocity = Vector3.zero
		applyBuffs() -- punishing = true: base speed/jump, curses ignored
		fade(1, 1)
		toast("Climb! Orange platforms crumble. Reach the red beam before the lava gets you.", 6)

		local lavaStart = center.Y - 4
		local t0, escaped = os.clock(), false
		while true do
			RS.Heartbeat:Wait()
			if not alive() then return end
			local el = os.clock() - t0
			local lavaTop = lavaStart + math.max(0, el - K.LAVA_DELAY) * K.LAVA_SPEED
			lava.Position = Vector3.new(center.X, lavaTop - 1, center.Z)
			local feetY = root.Position.Y - feetOff
			if feetY < lavaTop or el > 240 then hum.Health = 0 return end -- failed: you die
			for _, c in ipairs(crumbles) do
				if not c.t then
					if math.abs(root.Position.X - c.x) < c.half + .3 and math.abs(root.Position.Z - c.z) < c.half + .3 and math.abs(feetY - c.top) < 1.5 then
						c.t = el
					end
				elseif not c.gone and el - c.t > .9 then
					c.gone = true
					c.part.CanCollide = false
					TS:Create(c.part, TweenInfo.new(.3), {Transparency = 1}):Play()
				end
			end
			if (root.Position - exitPos).Magnitude < 7 then escaped = true break end
		end
		if not escaped then return end

		-- escaped: back to the first portal, rise out, get launched
		fade(0, .4)
		task.wait(.5)
		arena:Destroy()
		setCollide(false)
		setHandsParent(workspace)
		local bp2 = new("BodyPosition", {MaxForce = Vector3.new(1e6, 1e6, 1e6), P = 3000, D = 500, Position = Vector3.new(ground.X, gy - 10, ground.Z)}, root)
		onCleanup(function() bp2:Destroy() end)
		root.CFrame = CFrame.new(ground.X, gy - 10, ground.Z)
		root.AssemblyLinearVelocity = Vector3.zero
		fade(1, .6)
		tween(gy - 10, gy + 3, 1.6, function(y)
			bp2.Position = Vector3.new(ground.X, y, ground.Z)
			updateAll(1)
		end)
		bp2:Destroy()
		setCollide(true)
		for _, h in ipairs(hands) do h.model:Destroy() h.armModel:Destroy() end
		hands = {}
		bigExplosion(ground)
		lockoutUntil = os.clock() + K.LOCKOUT
		root.AssemblyLinearVelocity = Vector3.new(0, 170, 0) -- launched high
		task.spawn(function() -- one bounce when you land
			local t1, wasAir = os.clock(), false
			while os.clock() - t1 < 12 do
				task.wait(.1)
				if not alive() then return end
				if hum.FloorMaterial == Enum.Material.Air then wasAir = true
				elseif wasAir then root.AssemblyLinearVelocity = Vector3.new(0, 70, 0) return end
			end
		end)
		task.wait(.5)
	end)
	if not ok then warn("[Demon] punishment error: " .. tostring(err)) end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	TS:Create(V.flashFrame, TweenInfo.new(.5), {BackgroundTransparency = 1}):Play()
	V.punishing = false
	ritualStop()
	summonCount, windowStart = 0, 0
end

-- paying: the souls physically leave your body, fly into the orb, and only then does the blessing arrive
local function paySoulsToOrb(count, orbPos, root, hum)
	if count <= 0 then return true end
	local n = math.min(count, 12) -- at most 12 visible souls; each one carries its share of the price
	local per, extra = math.floor(count / n), count % n
	local live, spawned, taken = {}, 0, 0
	local t0 = os.clock()
	while (spawned < n or #live > 0) and hum.Health > 0 and root.Parent do
		local dt = RS.Heartbeat:Wait()
		local now = os.clock()
		if spawned < n and now - t0 >= spawned * .12 then
			spawned += 1
			local a = spawned / n * math.pi * 2
			local s = makeSoul("fx", root.Position + Vector3.new(0, 1, 0))
			s.vel = Vector3.new(math.cos(a) * 10, 12, math.sin(a) * 10)
			local take = per + (spawned <= extra and 1 or 0)
			souls -= take -- leaves your counter the moment it leaves your body
			taken += take
			refresh()
			table.insert(live, s)
		end
		for i = #live, 1, -1 do
			local s = live[i]
			local age = now - s.born
			local to = orbPos - s.pos
			if age > .35 and to.Magnitude < 3 then
				s.model:Destroy()
				table.remove(live, i)
				flash(.1)
			else
				if age > .35 then -- after the pop, get pulled into the orb
					s.vel += to.Unit * 130 * dt
					if s.vel.Magnitude > 95 then s.vel = s.vel.Unit * 95 end
				else
					s.vel *= math.max(0, 1 - 2 * dt)
				end
				s.pos += s.vel * dt
				s.scale = popScale(age) * math.clamp(to.Magnitude / 12, .15, 1) -- shrinks as it is swallowed
				layoutSoul(s, now, orbPos)
			end
		end
	end
	local done = #live == 0 and spawned >= n and hum.Health > 0
	for _, s in ipairs(live) do s.model:Destroy() end
	if not done then souls += taken refresh() end -- interrupted (e.g. you died): everything is refunded
	return done
end

-- the whole cinematic. Everything it creates registers a cleanup, so errors/death can't leave anything behind.
local function beginSummon()
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 or not V.ritual.bp then ritualStop() return end
	-- summon limit: more than SUMMON_LIMIT summons inside SUMMON_WINDOW seconds -> punishment instead
	local now = os.clock()
	if summonCount == 0 or now - windowStart > K.SUMMON_WINDOW then windowStart, summonCount = now, 0 end
	if forcePunish or summonCount >= K.SUMMON_LIMIT then
		forcePunish = false
		summonTotal += 1
		if V.Book.onSummonEnd then pcall(V.Book.onSummonEnd, false) end
		runPunishment()
		return
	end
	summonCount += 1
	summonTotal += 1
	local cleanups = {}
	local function onCleanup(f) table.insert(cleanups, f) end
	local function alive() return hum.Health > 0 and root.Parent ~= nil end
	local restored, finished = false, false

	local ok, err = pcall(function()
		local floorPos = V.ritual.start
		local top = floorPos + Vector3.new(0, K.FLOAT_HEIGHT, 0)

		-- you are floating fully and the sky is still normal for a moment
		task.wait(1.2)
		if not alive() then return end

		-- then the sky darkens and red lightning starts
		V.Env.darken(2.5)
		onCleanup(function() if not restored then V.Env.restore(0, true) end end)
		local stopStorm = startStorm(top)
		onCleanup(stopStorm)
		task.wait(2.8)
		if not alive() then return end

		-- a HUGE bolt hits the pentagram (or the ground under you); the red strikes stop, the explosion happens, the orb appears
		local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		look = look.Magnitude > .01 and look.Unit or Vector3.new(0, 0, -1)
		local orbPos = top + look * 14 + Vector3.new(0, 1, 0)
		hugeBolt(V.Book.pentagramPos or (floorPos - Vector3.new(0, 3, 0)), K.SOUNDS.lightning)
		task.wait(.35)
		stopStorm()
		bigExplosion(orbPos)
		local _, destroyOrb = spawnOrb(orbPos)
		onCleanup(destroyOrb)
		onCleanup(startMusic())

		-- first summon ever: Mercy
		if not V.gotFirstSummon then
			V.gotFirstSummon = true
			V.lv.mercy += K.MERCY_BONUS
			sync()
			toast("The demon grants you " .. K.MERCY_BONUS .. " Mercy.", 4)
		end
		task.wait(1)
		if not alive() then return end

		-- slot machine: pick ONE blessing or curse
		showPicker()
		V.menu.Visible = true
		onCleanup(function() V.pickerToken += 1 V.menu.Visible = false V.cancelBtn.Visible = false end)
		local died = hum.Died:Connect(function() V.choiceEvt:Fire(nil) end)
		local chosen = V.choiceEvt.Event:Wait()
		died:Disconnect()
		V.pickerToken += 1
		V.menu.Visible = false
		V.cancelBtn.Visible = false
		if not chosen or chosen == "cancel" or not alive() then chosen = nil end

		-- payment (blessing) or reward (curse)
		if chosen then
			if chosen.family then
				souls += chosen.reward
				addCurse(chosen)
			else
				local price = blessingPrice(chosen)
				if souls >= price and paySoulsToOrb(price, orbPos, root, hum) then
					grant(chosen.key, chosen.greater)
				else
					chosen = nil
				end
			end
			if chosen then summons += 1 end
			refresh()
			sync()
			if chosen and chosen.key == "glide" then V.glideEnergy = V.glideMax end
			task.wait(.8)
		end

		-- a big red lightning strike (with a stinger) takes the orb away, then the explosion, then the sky comes back
		finished = true
		hugeBolt(orbPos, K.SOUNDS.stinger)
		task.wait(.3)
		bigExplosion(orbPos)
		destroyOrb()
		restored = true
		V.Env.restore(2.5)
		task.wait(2.8)
		if not alive() then return end

		-- float gently back down
		if V.ritual.conn then V.ritual.conn:Disconnect() V.ritual.conn = nil end
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {char, V.coinFolder}
		local bp = V.ritual.bp
		local ground = bp and workspace:Raycast(bp.Position, Vector3.new(0, -800, 0), rp)
		if ground then
			local destY = ground.Position.Y + hum.HipHeight + root.Size.Y / 2 + 1
			local dist = math.max(0, bp.Position.Y - destY)
			local tw = TS:Create(bp, TweenInfo.new(math.clamp(dist / 5, 1.5, 7), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{Position = Vector3.new(bp.Position.X, destY, bp.Position.Z)})
			tw:Play()
			tw.Completed:Wait()
		end
	end)
	if not ok then warn("[Demon] summon error: " .. tostring(err)) end
	for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
	if V.Book.onSummonEnd then pcall(V.Book.onSummonEnd, finished) end
	ritualStop()
end

local function normalize(text)
	local s = text:lower():gsub("[^%a%s]", ""):gsub("%s+", " ")
	return (s:match("^%s*(.-)%s*$"))
end
local function onChat(text)
	local s = normalize(text)
	if s == K.COIN_PHRASE and (table.find(K.OWNER_USER_IDS, V.lp.UserId) or RS:IsStudio()) then
		souls += K.COIN_AMOUNT
		refresh()
		return
	end
	local idx = table.find(K.RITUAL_LINES, s)
	if not idx or V.ritual.locked or idx ~= V.ritual.stage + 1 then return end -- lines must come in order (this also ignores duplicate chat events)
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if idx == 1 then
		if os.clock() < lockoutUntil then
			local left = math.ceil(lockoutUntil - os.clock())
			toast(string.format("The demon will not answer for %d:%02d.", math.floor(left / 60), left % 60), 3)
			return
		end
		if gliding then stopGlide() end
		if busy or missileBusy or pilotingDrone or mountedDrone then
			toast("Finish what you are doing first.", 2.5)
			return
		end
		ritualStart(root, hum)
	end
	V.ritual.stage, V.ritual.lastLine, V.ritual.target = idx, os.clock(), K.RITUAL_HEIGHTS[idx]
	if idx == #K.RITUAL_LINES then
		V.ritual.locked = true
		task.spawn(beginSummon)
	end
end
V.lp.Chatted:Connect(onChat)
pcall(function()
	TCS.MessageReceived:Connect(function(m)
		if m.TextSource and m.TextSource.UserId == V.lp.UserId then onChat(m.Text) end
	end)
end)

---------------------------------------------------------------- The Necrobloxicon
-- ===== TWEAKS =====
K.BOOK_SPAWN_MIN, K.BOOK_SPAWN_MAX = 150, 260  -- how far from you the book appears (it only spawns while you don't own it)
K.BOOK_DARK_DIST = 90      -- closer than this: the sky turns dark and the book glows red
K.BOOK_FLOAT_DIST = 45     -- closer than this: it floats upright
K.BOOK_OPEN_DIST = 20      -- closer than this: it opens and floats to you
K.BOOK_ARMED_TIMEOUT = 180 -- seconds you can wait at the pentagram before the ritual fades (you keep the book)

local function initBook()
	local Book, lp = V.Book, V.lp
	local playerGui = lp:WaitForChild("PlayerGui")
	local PAPER, INK, BLOOD = Color3.fromRGB(214, 186, 138), Color3.fromRGB(70, 40, 24), Color3.fromRGB(120, 20, 20)
	local startClock = os.clock()
	local W, armed -- W = the book lying in the world; armed = the pentagram ritual in progress

	-- ===== the book as 3D parts (also used for the dropped book) =====
	local function buildBookModel()
		local m = Instance.new("Model")
		m.Name = "NecroBook"
		local function p(size, color, mat, name)
			return new("Part", {Name = name, Size = size, Color = color, Material = mat or Enum.Material.SmoothPlastic,
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, m)
		end
		local parts = {
			bottom = p(Vector3.new(3, .25, 4), Color3.fromRGB(14, 10, 10), nil, "Bottom"),
			pages = p(Vector3.new(2.8, .8, 3.8), Color3.fromRGB(205, 178, 130), nil, "Pages"),
			top = p(Vector3.new(3, .25, 4), Color3.fromRGB(14, 10, 10), nil, "Top"),
			sigil = p(Vector3.new(1.1, .06, 1.1), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, "Sigil"),
		}
		new("PointLight", {Color = Color3.fromRGB(255, 40, 40), Range = 6, Brightness = 0}, parts.pages)
		return m, parts
	end
	local function placeBook(parts, cf, openT)
		local ang = math.pi * .92 * openT
		local topRel = CFrame.new(-1.5, .2, 0) * CFrame.Angles(0, 0, ang) * CFrame.new(1.5, .85, 0) -- hinged at the spine
		parts.bottom.CFrame = cf
		parts.pages.CFrame = cf * CFrame.new(0, .525, 0)
		parts.top.CFrame = cf * topRel
		parts.sigil.CFrame = cf * topRel * CFrame.new(0, .16, 0)
	end

	-- ===== the book viewer: an old two-page spread. Lines on the LEFT page, the seal on the RIGHT, a spine between =====
	-- Every element gets an explicit ZIndex (Global mode) so nothing can end up hidden behind a page.
	local viewer = new("ScreenGui", {Name = "NecroBook", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 6, Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global}, playerGui)
	local frame = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.94, .8), BackgroundTransparency = 1}, viewer)
	new("UISizeConstraint", {MaxSize = Vector2.new(780, 540), MinSize = Vector2.new(300, 200)}, frame)
	new("UIAspectRatioConstraint", {AspectRatio = 1.45, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Width}, frame)
	local function rect(parent, props)
		props.BorderSizePixel = 0
		return new("Frame", props, parent)
	end
	local COVER = Color3.fromRGB(14, 10, 10)
	local cover = rect(frame, {Size = UDim2.fromScale(1, 1), BackgroundColor3 = COVER, ZIndex = 1})
	corner(cover, 18)
	new("UIStroke", {Color = Color3.fromRGB(90, 15, 15), Thickness = 2}, cover)
	local layers = {} -- the stack of pages behind the open spread
	for i = 1, 4 do
		layers[i] = rect(frame, {
			Position = UDim2.new(0, 14 + i * 3, 0, 14 + i * 3), Size = UDim2.new(1, -28, 1, -28), ZIndex = 1 + i,
			BackgroundColor3 = Color3.fromRGB(176 - i * 6, 146 - i * 6, 100 - i * 5),
		})
		corner(layers[i], 4)
	end
	local inner = rect(frame, {Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(1, -28, 1, -28), BackgroundTransparency = 1, ZIndex = 6})

	-- an old sheet of paper: stained gradient, ragged bitten edges, age spots
	local function makePage(parent, pos, size, seed, edges) -- edges = which sides are torn: top/bottom/left/right
		local pg = rect(parent, {Position = pos, Size = size, BackgroundColor3 = PAPER, ZIndex = 8})
		new("UIGradient", {
			Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(226, 198, 150)), ColorSequenceKeypoint.new(.5, Color3.fromRGB(206, 176, 126)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 146, 98))}), Rotation = 25 + seed * 40,
		}, pg)
		new("UIStroke", {Color = Color3.fromRGB(110, 78, 44), Thickness = 1.5, Transparency = .3}, pg)
		local rng = Random.new(seed * 101)
		for side, torn in pairs(edges) do
			if torn then
				for _ = 1, 26 do
					local t, w, depth = rng:NextNumber(), rng:NextInteger(3, 12), rng:NextInteger(2, 7)
					local n = rect(pg, {BackgroundColor3 = COVER, ZIndex = 9, Rotation = rng:NextInteger(-25, 25)})
					if side == "top" then n.AnchorPoint, n.Position, n.Size = Vector2.new(.5, 0), UDim2.new(t, 0, 0, -1), UDim2.fromOffset(w, depth)
					elseif side == "bottom" then n.AnchorPoint, n.Position, n.Size = Vector2.new(.5, 1), UDim2.new(t, 0, 1, 1), UDim2.fromOffset(w, depth)
					elseif side == "left" then n.AnchorPoint, n.Position, n.Size = Vector2.new(0, .5), UDim2.new(0, -1, t, 0), UDim2.fromOffset(depth, w)
					else n.AnchorPoint, n.Position, n.Size = Vector2.new(1, .5), UDim2.new(1, 1, t, 0), UDim2.fromOffset(depth, w) end
				end
			end
		end
		for _ = 1, 12 do -- age spots
			local s = rng:NextInteger(5, 18)
			local spot = rect(pg, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber()), Size = UDim2.fromOffset(s, s),
				BackgroundColor3 = Color3.fromRGB(140, 100, 55), BackgroundTransparency = .78, ZIndex = 9})
			new("UICorner", {CornerRadius = UDim.new(1, 0)}, spot)
		end
		return pg
	end
	local function label(parent, text, y, h, color, maxSize)
		local t = new("TextLabel", {
			AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, y), Size = UDim2.fromScale(.86, h), BackgroundTransparency = 1,
			Text = text, TextColor3 = color, Font = Enum.Font.Antique, TextScaled = true, TextWrapped = true, ZIndex = 12,
		}, parent)
		new("UITextSizeConstraint", {MaxTextSize = maxSize, MinTextSize = 6}, t)
		return t
	end
	local function fillLines(pg)
		label(pg, "The Necrobloxicon", .06, .11, INK, 28)
		label(pg, "Speak these words aloud, in order:", .19, .09, INK, 17)
		for i, line in ipairs(K.RITUAL_LINES) do label(pg, line, .31 + (i - 1) * .17, .14, BLOOD, 24) end
		label(pg, "Type them in the chat.", .84, .07, INK, 14)
	end

	-- left page (lines), spine, right page (the seal)
	local left = makePage(inner, UDim2.new(0, 0, 0, 0), UDim2.new(.5, -2, 1, 0), 1, {top = true, bottom = true, left = true})
	local right = makePage(inner, UDim2.new(.5, 2, 0, 0), UDim2.new(.5, -2, 1, 0), 2, {top = true, bottom = true, right = true})
	fillLines(left)
	rect(inner, {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 0), Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Color3.fromRGB(60, 38, 22), ZIndex = 11})
	for _, side in ipairs({-1, 1}) do -- soft shadow either side of the spine
		local sh = rect(inner, {AnchorPoint = Vector2.new(side == -1 and 1 or 0, 0), Position = UDim2.new(.5, side * 2, 0, 0), Size = UDim2.new(0, 18, 1, 0),
			BackgroundColor3 = Color3.fromRGB(60, 38, 22), ZIndex = 10})
		new("UIGradient", {Transparency = side == -1 and NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, .5)})
			or NumberSequence.new({NumberSequenceKeypoint.new(0, .5), NumberSequenceKeypoint.new(1, 1)})}, sh)
	end
	label(right, "The Seal", .06, .11, INK, 28)
	label(right, "Touch it to begin.", .86, .07, INK, 14)
	local seal = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.74, .64), BackgroundTransparency = 1, ZIndex = 12}, right)
	new("UIAspectRatioConstraint", {AspectRatio = 1, AspectType = Enum.AspectType.ScaleWithParentSize, DominantAxis = Enum.DominantAxis.Width}, seal)
	local ring = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 12}, seal)
	new("UICorner", {CornerRadius = UDim.new(1, 0)}, ring)
	local ringStroke = new("UIStroke", {Color = Color3.fromRGB(255, 45, 45), Thickness = 4}, ring)
	TS:Create(ringStroke, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Transparency = .75}):Play() -- glow pulse
	local pts = {}
	for k = 0, 4 do
		local a = math.rad(-90 + 72 * k)
		pts[k] = Vector2.new(.5 + .46 * math.cos(a), .5 + .46 * math.sin(a))
	end
	for k = 0, 4 do
		local a, b = pts[k], pts[(k + 2) % 5]
		local d = b - a
		rect(seal, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale((a.X + b.X) / 2, (a.Y + b.Y) / 2), Size = UDim2.fromScale(d.Magnitude, .02),
			Rotation = math.deg(math.atan2(d.Y, d.X)), BackgroundColor3 = Color3.fromRGB(255, 45, 45), ZIndex = 13})
	end
	local sealBtn = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 15}, seal)

	-- after a finished summon the book is only the single page with the three lines
	local soloBack = rect(frame, {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.6, 1), BackgroundColor3 = COVER, BackgroundTransparency = .35, ZIndex = 1})
	corner(soloBack, 18)
	local solo = makePage(frame, UDim2.fromScale(.2, .04), UDim2.fromScale(.6, .92), 3, {top = true, bottom = true, left = true, right = true})
	solo.ZIndex = 8
	fillLines(solo)
	local closeBtn = new("TextButton", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -2, 0, 2), Size = UDim2.fromOffset(32, 32),
		Text = "X", Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(90, 15, 15), ZIndex = 30}, frame)
	corner(closeBtn, 16)

	local function render(full)
		cover.Visible, inner.Visible = full, full
		for _, l in ipairs(layers) do l.Visible = full end
		soloBack.Visible, solo.Visible = not full, not full
	end
	local function openViewer()
		render(Book.state ~= "page")
		viewer.Enabled = true
