		AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -130), Size = UDim2.fromOffset(340, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(15, 8, 8), BackgroundTransparency = .25, TextColor3 = Color3.fromRGB(235, 220, 210), RichText = true,
