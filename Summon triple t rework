---------------------------------------------------------------- Glide
-- Press GLIDE (or G) in the air. Camera pitch steers: look down = dive and speed up,
-- look up = climb and slow down. Too slow, out of meter, or touching ground/walls = cancel.
local glideModel, glideConn, glideDir, glideSpeed = nil, nil, Vector3.new(0, 0, -1), K.GLIDE_START

local function buildGlider(char, root)
	local m = Instance.new("Model")
	m.Name = "TungGlider"
	-- all white. root-local: back = +Z (the glider sits there), head = +Y, wide = X
	local function part(size, cf)
		local p = new("Part", {
			Size = size, CFrame = root.CFrame * cf, Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
			Massless = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
		new("WeldConstraint", {Part0 = root, Part1 = p}, p)
		return p
	end
	part(Vector3.new(2.2, 7, .3), CFrame.new(0, .6, 2.4))                       -- centre body
	part(Vector3.new(1.4, 1.8, .2), CFrame.new(0, -3.6, 2.4))                   -- tail
	part(Vector3.new(.35, .35, 2), CFrame.new(0, 3, 1.5))                       -- brace to your back
	for _, s in ipairs({-1, 1}) do
		part(Vector3.new(6, 5.5, .2), CFrame.new(s * 3.6, 0, 2.4) * CFrame.Angles(0, 0, -s * .3))     -- swept wings
		part(Vector3.new(3.2, 3, .2), CFrame.new(s * 7, -1.6, 2.4) * CFrame.Angles(0, 0, -s * .5))   -- wing tips
		part(Vector3.new(.3, .3, 2.2), CFrame.new(s * 1.1, .8, 1.4))                                  -- struts
	end
	m.Parent = char
	return m
end

stopGlide = function()
	if not gliding then return end
	gliding = false
	if glideConn then glideConn:Disconnect() glideConn = nil end
	if glideModel then glideModel:Destroy() glideModel = nil end
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		local flat = Vector3.new(glideDir.X, 0, glideDir.Z)
		if flat.Magnitude < .01 then flat = Vector3.new(0, 0, -1) end
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat) -- stand upright again
		root.AssemblyLinearVelocity = flat.Unit * math.min(glideSpeed, 40)
		hum.PlatformStand = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)
	end
end

startGlide = function()
	if gliding then stopGlide() return end
	if not (hasGlide and V.on.glide) or busy or missileBusy then return end
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if hum.FloorMaterial ~= Enum.Material.Air or V.glideEnergy < 1 then return end -- must be airborne

	gliding = true
	local look = cam.CFrame.LookVector
	glideDir = Vector3.new(look.X, math.clamp(look.Y, -.6, .2), look.Z).Unit
	local v = root.AssemblyLinearVelocity
	glideSpeed = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude, K.GLIDE_START, K.GLIDE_MAX)
	hum.PlatformStand = true
	glideModel = buildGlider(char, root)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, V.coinFolder}

	glideConn = RS.Heartbeat:Connect(function(dt)
		if hum.Health <= 0 or not root.Parent then stopGlide() return end
		local l = cam.CFrame.LookVector
		local target = Vector3.new(l.X, math.clamp(l.Y, -.85, .45), l.Z).Unit
		glideDir = glideDir:Lerp(target, math.min(1, 3 * dt)).Unit
		-- dive = faster, climb = slower
		glideSpeed = math.min(K.GLIDE_MAX, glideSpeed + (-glideDir.Y * K.GLIDE_ACCEL - K.GLIDE_DRAG) * dt)
		V.glideEnergy -= dt
		if glideSpeed < K.GLIDE_MIN or V.glideEnergy <= 0 then stopGlide() return end

		local pos = root.Position
		local ahead = workspace:Raycast(pos, glideDir * (glideSpeed * dt + 3), params)
		local below = glideDir.Y <= .05 and workspace:Raycast(pos, Vector3.new(0, -5, 0), params)
		if ahead or below then stopGlide() return end

		-- lie flat like the missile, glider on your back
		root.CFrame = CFrame.lookAt(pos, pos + glideDir) * CFrame.Angles(-math.pi / 2, 0, 0)
		root.AssemblyLinearVelocity = glideDir * glideSpeed + Vector3.new(0, -K.GLIDE_SINK, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end)
end

