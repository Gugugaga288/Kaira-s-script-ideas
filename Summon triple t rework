		}, linesGui)
		new("UITextSizeConstraint", {MaxTextSize = 28, MinTextSize = 10}, l)
		lineLbls[i] = l
	end
	local function setLineStates(stage) -- next line to say = visible, said lines = ghosted, later lines = hidden
		for i, l in ipairs(lineLbls) do
			local want = (i == stage + 1) and .3 or (i <= stage and .88 or 1)
			if lineState[i] ~= want then
				lineState[i] = want
				TS:Create(l, TweenInfo.new(.6), {TextTransparency = want}):Play()
			end
