	riseBtn.MouseButton1Up:Connect(function() riseHeld = false end)
	diveBtn.MouseButton1Down:Connect(function() diveHeld = true end)
	diveBtn.MouseButton1Up:Connect(function() diveHeld = false end)
	local flashF = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 240, 190), BackgroundTransparency = 1, ZIndex = 40}, gui)
	local flight, transforming = false, false
	local vel = Vector3.zero
	local formAll, formBody, formHalo, formFeathers = {}, nil, {}, {}
	local charSaved = {}
	local NF = 7 -- feathers per wing: a smooth overlapping fan, longest at the top
	local function FLf(i) return 6.6 - (i - 1) * .5 end
	local function FAf(i) return 46 - (i - 1) * 13 end
	table.insert(ctx.cleanups, function()
		for _, p in ipairs(formAll) do if p.Parent then p:Destroy() end end
		for part, cc in pairs(charSaved) do if part.Parent then part.LocalTransparencyModifier = 0 part.CanCollide = cc end end
		if hum.Parent then hum.PlatformStand = false hum.AutoRotate = true end
		if root.Parent then root.Anchored = false end
	end)

	local function buildForm()
		local ch = lp.Character
		if ch then
			for _, d in ipairs(ch:GetDescendants()) do
				if d:IsA("BasePart") then
					charSaved[d] = d.CanCollide
					d.LocalTransparencyModifier = 1 -- you can't see your body any more: only the angel orb
					d.CanCollide = false
				end
			end
		end
		local function fp(size, shape, color)
			local p = new("Part", {Size = size, Shape = shape, Color = color, Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
				CanTouch = false, CanQuery = false}, model)
			table.insert(formAll, p)
			return p
		end
		formBody = fp(Vector3.new(3.4, 3.4, 3.4), Enum.PartType.Ball, Color3.fromRGB(255, 250, 235))
		new("PointLight", {Color = ABILITY_GOLD, Range = 18, Brightness = 2, Shadows = false}, formBody)
		for k = 1, 36 do formHalo[k] = fp(Vector3.new(.6, .22, .22), nil, ABILITY_GOLD) end
		for _, sx in ipairs({-1, 1}) do
			for i = 1, NF do table.insert(formFeathers, {part = fp(Vector3.new(FLf(i), .3, 1.2), nil, Color3.fromRGB(255, 240, 200)), sx = sx, i = i}) end
		end
	end
	local function updateForm(t)
		if not formBody then return end
		local base = CFrame.new(root.Position) * CFrame.new(0, .6, 0) -- always upright: the angel orb never tips over
		formBody.CFrame = base
		for k, seg in ipairs(formHalo) do
			local a = (k - 1) / 36 * math.pi * 2
			seg.CFrame = base * CFrame.new(0, 3.2, 0) * CFrame.new(math.cos(a) * 2.6, 0, math.sin(a) * 2.6) * CFrame.Angles(0, -a - math.pi / 2, 0)
		end
		local flap = flight and (.2 + math.sin(t * 6) * .3) or (.3 + math.sin(t * 3) * .12) -- slow, smooth beats
		for _, f in ipairs(formFeathers) do
			local pivot = base * CFrame.new(f.sx * 1.4, .3, 0) * CFrame.Angles(0, 0, f.sx * flap)
			f.part.CFrame = pivot * CFrame.Angles(0, 0, f.sx * math.rad(FAf(f.i))) * CFrame.new(f.sx * FLf(f.i) / 2, 0, -(f.i - 1) * .12)
		end
	end

	grantAbility = function()
		mode = "ability"
		clearMeteors()
		for i = #orbs, 1, -1 do orbs[i].part:Destroy() table.remove(orbs, i) end
		for i = #shocks, 1, -1 do killShock(shocks[i]) table.remove(shocks, i) end
		bossOn(true)
		hum.Health = math.min(hum.MaxHealth, hum.Health + cfg.heal)
		abilityBtn.Visible = true
		setObjective("THE ANGEL ORB'S LIGHT IS YOURS - press ANGEL FORM (G)")
		noToast("The angel orb grants you its light!", 5)
	end

	local function activateForm()
		if mode ~= "ability" or transforming or flight then return end
		transforming = true
		abilityBtn.Visible = false
		-- a bright golden beam comes down on you
		local beam = new("Part", {Shape = Enum.PartType.Cylinder, Size = Vector3.new(420, 6, 6), CFrame = CFrame.new(root.Position + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = ABILITY_GOLD, Material = Enum.Material.Neon, Transparency = .05, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		TS:Create(beam, TweenInfo.new(1.4), {Size = Vector3.new(420, 22, 22), Transparency = 1}):Play()
		Debris:AddItem(beam, 1.6)
		local burstBall = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = root.Position, Color = Color3.fromRGB(255, 250, 230),
			Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		TS:Create(burstBall, TweenInfo.new(1.2), {Size = Vector3.new(30, 30, 30), Transparency = 1}):Play()
		Debris:AddItem(burstBall, 1.4)
		TS:Create(flashF, TweenInfo.new(.5), {BackgroundTransparency = .05}):Play()
		task.delay(.8, function()
			if not root.Parent then transforming = false return end
			buildForm()
			flight, vel = true, Vector3.zero
			hum.PlatformStand = true
			hum.AutoRotate = false
			riseBtn.Visible, diveBtn.Visible = true, true
			TS:Create(flashF, TweenInfo.new(1.4), {BackgroundTransparency = 1}):Play()
			setObjective("SEAL THE DEMON ORB - fly into it!")
			noToast("You are the angel orb! Fly into the demon orb to seal it.", 4.5)
			transforming = false
		end)
	end
	abilityBtn.MouseButton1Click:Connect(activateForm)
	local keyConn = UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.G then activateForm() end
	end)
	table.insert(ctx.cleanups, function() keyConn:Disconnect() end)

	-- flight: the joystick moves you where the camera looks; Space / RISE climbs, Shift / DIVE drops
	local function flightStep(dt)
		local cam = workspace.CurrentCamera.CFrame
		local look = cam.LookVector
		local fwdFlat = Vector3.new(look.X, 0, look.Z)
		fwdFlat = fwdFlat.Magnitude > .01 and fwdFlat.Unit or Vector3.zero
		local rightFlat = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
		rightFlat = rightFlat.Magnitude > .01 and rightFlat.Unit or Vector3.zero
		local md = hum.MoveDirection
		local move = look * md:Dot(fwdFlat) + rightFlat * md:Dot(rightFlat)
		local up = 0
		if riseHeld or UIS:IsKeyDown(Enum.KeyCode.Space) then up += 1 end
		if diveHeld or UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then up -= 1 end
		local want = (move + Vector3.new(0, up, 0)) * 60
		vel = vel:Lerp(want, math.min(1, dt * 8))
		root.Anchored = true -- anchored flight: you hover perfectly, rise/dive works, gravity can never pull you down
		root.CFrame = CFrame.new(root.Position + vel * dt) -- stay upright
		root.AssemblyLinearVelocity = Vector3.zero
	end

	-- the seal: the demon orb cracks, red light shines out, then it shatters and the trial is complete
	local function sealStart()
		mode, flight, vel = "sealing", false, Vector3.zero
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true -- you stay floating where you touched the orb (no more falling into the pit)
		riseBtn.Visible, diveBtn.Visible = false, false
		setObjective("THE DEMON ORB CRACKS!")
		noToast("The demon orb cracks... red light pours out!", 4)
		for k = 1, 24 do
			local a, b = math.random() * math.pi * 2, math.random() * math.pi - math.pi / 2
			local dirv = Vector3.new(math.cos(a) * math.cos(b), math.sin(b), math.sin(a) * math.cos(b))
			local tang = dirv:Cross(Vector3.new(0, 1, 0))
			if tang.Magnitude < .1 then tang = Vector3.new(1, 0, 0) end
			local center = P + dirv * (BOSS_R + .3)
			local crack = new("Part", {Size = Vector3.new(.45, .45, 9 + math.random() * 12), CFrame = CFrame.lookAt(center, center + tang.Unit),
				Color = Color3.fromRGB(255, 60, 30), Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = 1}, model)
			TS:Create(crack, TweenInfo.new(.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, k * .05), {Transparency = 0}):Play()
		end
		for k = 1, 12 do -- red light shining out through the cracks
			local a = k / 12 * math.pi * 2
			local dirv = Vector3.new(math.cos(a), .25 * math.sin(a * 3), math.sin(a)).Unit
			local ray = new("Part", {Size = Vector3.new(1.2, 1.2, 260), CFrame = CFrame.lookAt(P + dirv * (BOSS_R + 130), P + dirv * (BOSS_R + 131)),
				Color = Color3.fromRGB(255, 50, 30), Material = Enum.Material.Neon, Transparency = 1, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
			TS:Create(ray, TweenInfo.new(1.2), {Transparency = .35}):Play()
		end
		local glow = new("PointLight", {Color = Color3.fromRGB(255, 60, 30), Range = 160, Brightness = 0, Shadows = false}, core)
		TS:Create(glow, TweenInfo.new(2), {Brightness = 9}):Play()
		TS:Create(core, TweenInfo.new(2), {Color = Color3.fromRGB(255, 40, 20)}):Play()
		task.delay(3.4, function()
			burst(P, Color3.fromRGB(255, 80, 40), 90)
			TS:Create(core, TweenInfo.new(1.2), {Transparency = 1}):Play()
			TS:Create(shell, TweenInfo.new(1.2), {Transparency = 1}):Play()
			task.delay(1.4, function() ctx.complete() end)
		end)
	end

	-- ---------- go ----------
	root.CFrame = CFrame.lookAt(A + Vector3.new(0, 4, -60), A + Vector3.new(0, 4, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	setObjective("Something enormous stirs behind the arena...")
	noToast("The demon orb awakens!", 4)
	local t0 = os.clock()
	nextFn = function() barHolder.Visible = true updateBar() startWave(1) end

	table.insert(ctx.frameFns, function(dt, rt)
		local now = os.clock()
		if invuln > 0 then invuln -= dt end
		local rp = rt.Position
		if formBody then updateForm(now) end
		if flight then
			flightStep(dt)
			if (root.Position - P).Magnitude < BOSS_R + 6 then sealStart() end
		end
		if rp.Y < A.Y - 25 and not flight and mode ~= "sealing" then -- fell into the pit
			rt.CFrame = CFrame.new(A + Vector3.new(0, 4, -40))
			rt.AssemblyLinearVelocity = Vector3.zero
			damagePlayer(15)
		end
		if nextFn and now >= nextAt then local f = nextFn nextFn = nil f() end
		if mode == "intro" then -- it rises out of the pit
			local k = math.clamp((now - t0) / 4, 0, 1)
			setBossPos(P - Vector3.new(0, 90 * (1 - k * k * (3 - 2 * k)), 0))
		end

		if bossLit then shell.Transparency = .55 + math.sin(now * 5) * .1 end -- the shell pulses like the summon orb's
		-- rocks
		if not held then
			for i = #rocks, 1, -1 do
				if (rocks[i].Position - rp).Magnitude < 5.5 then
					held = rocks[i]
					table.remove(rocks, i)
					throwBtn.Visible = true
					break
				end
			end
		end
		if held then held.CFrame = rt.CFrame * CFrame.new(0, 3.6, -.6) * CFrame.Angles(now * 2, now * 1.3, 0) end
		rockT += dt
		if rockT > 3 and #rocks < 12 then rockT = 0 newRock() end
		for i = #shots, 1, -1 do
			local sh = shots[i]
			sh.life += dt
			sh.vel += Vector3.new(0, -45, 0) * dt
			sh.part.Position += sh.vel * dt
			local gone = false
			for oi = #orbs, 1, -1 do
				local o = orbs[oi]
				if o.kind == "medium" and (sh.part.Position - o.pos).Magnitude < 5 then
					o.hp -= 1
					burst(sh.part.Position, Color3.new(1, 1, 1), 10)
					if o.hp <= 0 then killOrb(o) end
					gone = true
					break
				end
			end
			if not gone and (sh.part.Position.Y < A.Y + .6 or sh.life > 5) then gone = true end
			if gone then sh.part:Destroy() table.remove(shots, i) end
		end

		-- the orbs
		for _, o in ipairs(orbs) do
			if o.kind == "shield" then
				if not o.defeated and mode == "shield" then o.part.Position = o.pos + Vector3.new(0, math.sin(now * 2 + o.ph) * .5, 0) end
			elseif o.kind == "green" then
				greenMove(o, dt, now, rp)
			else
				local goal = Vector3.new(rp.X, A.Y + (o.kind == "medium" and 5 or 4) + math.sin(now * 3 + o.ph) * .8, rp.Z)
				local to = goal - o.pos
				local flat = Vector3.new(to.X, 0, to.Z)
				local dirv = flat.Magnitude > .1 and flat.Unit or Vector3.zero
				local perp = Vector3.new(-dirv.Z, 0, dirv.X)
				if o.cd > 0 then o.cd -= dt dirv = -dirv end
				local move = (dirv + perp * math.sin(now * 2 + o.ph) * .6) * o.spd * dt
				o.pos = Vector3.new(o.pos.X + move.X, o.pos.Y + (goal.Y - o.pos.Y) * math.min(1, dt * 4), o.pos.Z + move.Z)
				o.part.Position = o.pos
				if o.cd <= 0 and (o.pos - rp).Magnitude < o.r + 2.4 then
					damagePlayer(o.kind == "medium" and cfg.mediumDmg or cfg.curseDmg)
					o.cd = 1.3
				end
			end
		end

		-- the shockwave rings: jump over them (touching one hurts a little and pushes you back)
		for i = #shocks, 1, -1 do
			local sh = shocks[i]
			sh.r += 34 * dt
			local circ = 2 * math.pi * sh.r / SEG
			for k, seg in ipairs(sh.segs) do
				local a = (k - 1) / SEG * math.pi * 2
				seg.Size = Vector3.new(circ * 1.15, .5, .6)
				seg.CFrame = CFrame.new(sh.c.X + math.cos(a) * sh.r, sh.c.Y + .4, sh.c.Z + math.sin(a) * sh.r) * CFrame.Angles(0, -a - math.pi / 2, 0)
			end
			local away = Vector3.new(rp.X - sh.c.X, 0, rp.Z - sh.c.Z)
			if not sh.hit and math.abs(away.Magnitude - sh.r) < 2.2 and rp.Y < A.Y + 5 then
				sh.hit = true
				damagePlayer(sh.dmg)
				if away.Magnitude > .1 then root.AssemblyLinearVelocity = away.Unit * sh.push + Vector3.new(0, 14, 0) end
			end
			if sh.r > FLOOR_R + 14 then killShock(sh) table.remove(shocks, i) end
		end

		-- meteors
		for i = #meteors, 1, -1 do
			local m = meteors[i]
			if m.state == "warn" then
				m.t -= dt
				m.ring.Transparency = .3 + .3 * math.sin(now * 14)
				if m.t <= 0 then m.state = "fall" end
			elseif m.state == "fall" then
				moveMet(m, m.pos - Vector3.new(0, 260 * dt, 0)) -- falls fast
				if m.pos.Y <= A.Y + (m.blue and 1 or -3) then
					-- sinks into the ground (blue ones sink less, so they stay easy to see)
					moveMet(m, Vector3.new(m.gp.X, A.Y + (m.blue and 1 or -3), m.gp.Z))
					m.state = "landed"
					m.ring:Destroy()
					burst(m.gp + Vector3.new(0, 3, 0), Color3.fromRGB(255, 160, 60), 26)
					shockwave(Vector3.new(m.gp.X, A.Y, m.gp.Z), METEOR_SHOCK, cfg.meteorShockDmg, 52)
					if Vector3.new(rp.X - m.gp.X, 0, rp.Z - m.gp.Z).Magnitude < 13 and rp.Y < A.Y + 9 then damagePlayer(cfg.meteorDmg) end
					local fire = m.part:FindFirstChildOfClass("Fire")
					if m.blue then -- a few meteors light up blue: these are the ones you can strike
						paintMet(m, Color3.fromRGB(80, 170, 255), Enum.Material.Neon)
						if fire then fire.Color, fire.SecondaryColor = Color3.fromRGB(100, 190, 255), Color3.fromRGB(200, 240, 255) end
						new("PointLight", {Color = Color3.fromRGB(100, 190, 255), Range = 30, Brightness = 2, Shadows = false}, m.part)
					elseif fire then
						fire.Enabled = false
					end
				end
			elseif m.state == "landed" then
				if not m.blue then
					m.life -= dt
					if m.life <= 0 then destroyMet(m) table.remove(meteors, i) end
				end
			elseif m.state == "flying" then
				local to = P - m.pos
				if to.Magnitude < BOSS_R + 6 then
					meteorHitBoss(m)
					break
				end
				moveMet(m, m.pos + to.Unit * 170 * dt)
			end
		end

		-- stage logic
		if mode == "wave" then
			if #queue > 0 then
				spawnT -= dt
				if spawnT <= 0 then
					local kind = table.remove(queue)
					local a = math.pi / 2 + (math.random() - .5) * 1.6 -- they come out of the pit side
					spawnOrb(kind, A + Vector3.new(math.cos(a) * 72, kind == "medium" and 5 or 4, math.sin(a) * 72))
					spawnT = .8
				end
			elseif #orbs == 0 then
				hum.Health = math.min(hum.MaxHealth, hum.Health + cfg.heal)
				mode = "between"
				if wave < #cfg.p1waves then
					noToast("Wave " .. wave .. " cleared", 2.5)
					nextAt, nextFn = now + 3, function() startWave(wave + 1) end
				else
					nextAt, nextFn = now + 2.5, function() startShield(function() startGreen() end) end
				end
			end
		elseif mode == "green" then
			if not anyKind("green") then greenDone() end
		elseif mode == "meteor" then
			metT -= dt
			if metT <= 0 and #meteors < 7 then
				metT = cfg.meteorEvery
				spawnMeteor((blueCount == 0 and now - lastBlue > cfg.blueGap) or (blueCount < 2 and math.random() < cfg.blueChance))
			end
		end
	end)
end

for _, n in ipairs({3}) do
	V.Trials.arenas[n] = function(ctx)
		table.clear(ctx.frameFns)
		ctx.killY = -1e9
		task.spawn(function()
			flashTo(0, .3)
			task.wait(.4)
			if V.Trials.active ~= ctx then flashTo(1, .5) return end
			local ok, err = pcall(V.Trials.startDemonFight, ctx, K.TRIAL_ARENAS[n])
			if not ok then -- never leave the screen red: report the error and get out
				warn("[DemonSummon] arena " .. n .. " failed: " .. tostring(err))
				toast("Arena failed: " .. tostring(err), 8)
				V.Trials.leave(false)
			end
			flashTo(1, .7)
		end)
	end
end

