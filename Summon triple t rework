local function getCam() return workspace.CurrentCamera end

-- Smooth, rounded drone: puck body + dome + camera eye, four arms ending in motor balls with spinning propellers.
local function buildDrone()
	local k = K.DRONE_SCALE
	local m = Instance.new("Model")
	m.Name = "SoulDrone"
	droneProps = {}
	local Cyl, Ball, Block = Enum.PartType.Cylinder, Enum.PartType.Ball, Enum.PartType.Block
	local up = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder upright
	local fwd = CFrame.Angles(0, math.pi / 2, 0) -- lays a cylinder along the front/back axis
	local function part(shape, size, cf, transparency, color)
		return new("Part", { -- every single part is translucent blue
			Shape = shape, Size = size, CFrame = cf, Color = color or K.DRONE_BLUE, Material = Enum.Material.SmoothPlastic, Reflectance = .08,
			Transparency = transparency or .4, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
	end
	m.PrimaryPart = part(Block, Vector3.new(.5, .5, .5), CFrame.new(), 1) -- invisible pivot
	-- softened-box body: two overlapping slabs + four round corner posts (no sharp edges, not a sphere)
	local W, H, D, r = 3.2 * k, 1.2 * k, 3.2 * k, .55 * k
	part(Block, Vector3.new(W - 2 * r, H, D), CFrame.new(), .4)
	part(Block, Vector3.new(W, H, D - 2 * r), CFrame.new(), .4)
	for _, o in ipairs({Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1)}) do
		part(Cyl, Vector3.new(H, 2 * r, 2 * r), CFrame.new(o.X * (W / 2 - r), 0, o.Z * (D / 2 - r)) * up, .4)
	end
	-- camera bump on the front (-Z) with a darker blue lens
	part(Cyl, Vector3.new(.6 * k, 1.5 * k, 1.5 * k), CFrame.new(0, .05 * k, -(D / 2) - .1 * k) * fwd, .35)
	part(Cyl, Vector3.new(.3 * k, 1.0 * k, 1.0 * k), CFrame.new(0, .05 * k, -(D / 2) - .42 * k) * fwd, .12, Color3.fromRGB(12, 40, 130))
	part(Ball, Vector3.new(.3 * k, .3 * k, .3 * k), CFrame.new(.2 * k, .25 * k, -(D / 2) - .58 * k), .1, Color3.fromRGB(160, 210, 255))
	-- four arms going diagonally UP from the body corners, a propeller on each
	for _, o in ipairs({Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1)}) do
		local near = Vector3.new(o.X * (W / 2 - r * .6), H / 2 - .1 * k, o.Z * (D / 2 - r * .6))
		local hub = near + Vector3.new(o.X * 1.1 * k, 1.2 * k, o.Z * 1.1 * k)
		local dir, mid = hub - near, (hub + near) / 2
		part(Cyl, Vector3.new(dir.Magnitude, .34 * k, .34 * k), CFrame.lookAt(mid, mid + dir.Unit) * CFrame.Angles(0, math.pi / 2, 0), .45) -- arm
		part(Ball, Vector3.new(.8 * k, .8 * k, .8 * k), CFrame.new(hub), .35)                                                                 -- motor
		local top = hub + Vector3.new(0, .5 * k, 0)
		part(Cyl, Vector3.new(.08 * k, 3.1 * k, 3.1 * k), CFrame.new(top) * up, .85)                                                          -- soft rotor disc
		for i = 0, 1 do
			local rel = CFrame.new(top) * CFrame.Angles(0, i * math.pi / 2, 0)
			local blade = part(Cyl, Vector3.new(3.0 * k, .18 * k, .18 * k), rel, .5, Color3.fromRGB(70, 120, 230))
			table.insert(droneProps, {part = blade, rel = rel, dir = (o.X * o.Z > 0) and 1 or -1})
		end
	end
	local glow = new("Highlight", {
		Adornee = m, FillColor = Color3.fromRGB(40, 100, 255), OutlineColor = K.RING_BLUE,
		FillTransparency = .5, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
	}, m)
	return m, glow
end

V.droneHighlight = nil
ensureDrone = function()
	if droneModel then return true end
	local ok, mOrErr, glow = pcall(function()
		local m, g = buildDrone()
		return m, g
	end)
	if not ok then
		warn("[TungSahur] Drone failed to build: " .. tostring(mOrErr))
		return false
	end
	droneModel = mOrErr
	V.droneHighlight = glow
	return true
end

-- every place that moves the drone goes through this, so the propellers always spin
local function placeDrone(cf, dt)
	dt = dt or 1 / 60
	local lvl = cf:VectorToObjectSpace(V.dronePhys.vel)
	local tp = math.clamp(lvl.Z / K.DRONE_PILOT_SPEED, -1, 1) * K.DRONE_TILT   -- flying forward (-Z) -> nose down
	local tr = math.clamp(-lvl.X / K.DRONE_PILOT_SPEED, -1, 1) * K.DRONE_TILT  -- flying right -> bank right
	local a = 1 - math.exp(-8 * dt)
	V.dronePhys.tiltP += (tp - V.dronePhys.tiltP) * a
	V.dronePhys.tiltR += (tr - V.dronePhys.tiltR) * a
	local full = cf * CFrame.Angles(V.dronePhys.tiltP, 0, V.dronePhys.tiltR)
	droneModel:PivotTo(full)
	droneSpin += dt * K.PROP_SPIN
	for _, p in ipairs(droneProps) do
		p.part.CFrame = full * p.rel * CFrame.Angles(0, droneSpin * p.dir, 0)
	end
end

-- acceleration + momentum: the velocity eases toward what you ask for, and eases to a stop (a little drift) when you let go
local function stepDroneVel(mv, speed, dt)
	local input = mv.Magnitude > .01
	local target = input and mv.Unit * speed * math.min(1, mv.Magnitude) or Vector3.zero
	local v = V.dronePhys.vel
	local ah = 1 - math.exp(-(input and K.DRONE_ACCEL or K.DRONE_BRAKE) * dt)
	local av = 1 - math.exp(-(input and K.DRONE_VACCEL or K.DRONE_VBRAKE) * dt)
	local nv = Vector3.new(v.X + (target.X - v.X) * ah, v.Y + (target.Y - v.Y) * av, v.Z + (target.Z - v.Z) * ah)
	if not input and nv.Magnitude < .3 then nv = Vector3.zero end
	V.dronePhys.vel = nv
	return nv
end

-- the camera follows an invisible point that lags behind the drone (the drone moves first, the camera catches up)
local function stopDroneCam()
	if V.dronePhys.camConn then V.dronePhys.camConn:Disconnect() V.dronePhys.camConn = nil end
	if V.dronePhys.cam then V.dronePhys.cam:Destroy() V.dronePhys.cam = nil end
end
local function startDroneCam(yOff)
	stopDroneCam()
	local p0 = droneCF.Position + Vector3.new(0, yOff, 0)
	V.dronePhys.camPos = p0
	local f = new("Part", {Name = "DroneCam", Size = Vector3.new(.5, .5, .5), Transparency = 1, Anchored = true,
		CanCollide = false, CanTouch = false, CanQuery = false, Position = p0}, workspace)
	V.dronePhys.cam = f
	getCam().CameraSubject = f
	V.dronePhys.camConn = RS.RenderStepped:Connect(function(dt)
		if not droneCF then return end
		local target = droneCF.Position + Vector3.new(0, yOff, 0)
		local ah, av = 1 - math.exp(-K.DRONE_CAM_LAG * dt), 1 - math.exp(-K.DRONE_CAM_LAG_V * dt)
		local p = V.dronePhys.camPos
		p = Vector3.new(p.X + (target.X - p.X) * ah, p.Y + (target.Y - p.Y) * av, p.Z + (target.Z - p.Z) * ah)
		V.dronePhys.camPos = p
		f.Position = p
	end)
end

-- a ring that pulses outward at the point a phasing drone passes through something
V.lastPhasePulse = 0
local function phasePulse(pos, norm)
	if os.clock() - V.lastPhasePulse < .12 then return end -- don't spawn one every single frame
	V.lastPhasePulse = os.clock()
	local ok, err = pcall(function()
		norm = (norm and norm.Magnitude > 0) and norm.Unit or Vector3.yAxis
		local upGuess = (math.abs(norm.Y) > .9) and Vector3.xAxis or Vector3.yAxis
		local tangent = norm:Cross(upGuess).Unit
		local okCf, cf = pcall(function() return CFrame.fromMatrix(pos, norm, tangent) end)
		if not okCf then cf = CFrame.new(pos) end
		local r = new("Part", {
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(.1, .6, .6), Color = K.RING_BLUE, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .1, CFrame = cf,
		}, workspace)
		TS:Create(r, TweenInfo.new(.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(.06, 8, 8), Transparency = 1}):Play()
		Debris:AddItem(r, .6)
	end)
	if not ok then warn("[TungSahur] phasePulse failed: " .. tostring(err)) end
end

-- idle behaviour: when nobody is piloting/mounting it, the drone hovers at your right side (or stays put if parked)
RS.Heartbeat:Connect(function(dt)
