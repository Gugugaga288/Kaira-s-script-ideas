	local function greenMove(o, dt, now, rp)
		if o.stun > 0 then o.stun -= dt end
		local away = Vector3.new(o.pos.X - rp.X, 0, o.pos.Z - rp.Z)
		local dirv
		if away.Magnitude < 34 then -- it runs from you
			dirv = away.Magnitude > .1 and away.Unit or Vector3.new(1, 0, 0)
		else -- it wanders when you are far
			dirv = Vector3.new(math.cos(now * .6 + o.ph), 0, math.sin(now * .6 + o.ph))
		end
		local speed = o.stun > 0 and 0 or cfg.greenSpeed
		local np = o.pos + dirv * speed * dt
		local flat = Vector3.new(np.X - A.X, 0, np.Z - A.Z)
		if flat.Magnitude > FLOOR_R - 9 then np = A + flat.Unit * (FLOOR_R - 9) end
		o.pos = Vector3.new(np.X, o.pos.Y, np.Z)
		-- it springs up, lands, and sends out a shockwave along the floor
		o.hopT -= dt
		if o.vy == 0 and o.y <= A.Y + 6.01 and o.hopT <= 0 then o.vy = 30 o.hopT = 1.4 + math.random() * 1.2 end
		o.vy -= 62 * dt
		o.y += o.vy * dt
		if o.y <= A.Y + 6 then
			if o.vy < -8 then shockwave(Vector3.new(o.pos.X, A.Y, o.pos.Z), GREEN_SHOCK, cfg.shockDmg, 42) end
			o.y, o.vy = A.Y + 6, 0
		end
		o.part.Position = Vector3.new(o.pos.X, o.y, o.pos.Z)
	end
