	local SEG = 30
	local function killShock(sh) for _, seg in ipairs(sh.segs) do seg:Destroy() end end
	-- an outline ring (not filled): segments on a circle that grows outwards
	local function shockwave(center, col, dmg, push)
		local segs = {}
		for k = 1, SEG do
			segs[k] = new("Part", {Size = Vector3.new(1, .5, .6), Color = col, Material = Enum.Material.Neon, Transparency = .1, Anchored = true,
