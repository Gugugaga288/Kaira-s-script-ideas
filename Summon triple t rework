local function grant(key, super)
	if key == "djump" or key == "tjump" then key = "mjump" end
	if key == "multi" and super then -- Greater Fortune
		if V.lv.multi >= 2 then return false end
		V.lv.multi = 2
		return true
	end
	if V.lv[key] == nil or V.lv[key] >= (K.CAP[key] or 99) then return false end
	if (key == "mdur" or key == "mspeed" or key == "mcd" or key == "mphase") and V.lv.missile == 0 then V.lv.missile = 1 end
	if key == "gdur" and V.lv.glide == 0 then V.lv.glide = 1 end
	if (key == "dronepark" or key == "dronemount") and V.lv.drone == 0 then V.lv.drone = 1 end
	V.lv[key] += 1
	if key == "speed" then table.insert(speedSteps, super and K.SUPER_SPEED or K.SPEED_STEP)
	elseif key == "jump" then table.insert(jumpSteps, super and K.SUPER_JUMP or K.JUMP_STEP) end
	if V.on[key] ~= nil then V.on[key] = true end
	return true
end

local function revoke(key)
	if V.lv[key] == nil or V.lv[key] <= 0 then return false end
	V.lv[key] -= 1
	if key == "speed" then table.remove(speedSteps) elseif key == "jump" then table.remove(jumpSteps) end
	return true
end

