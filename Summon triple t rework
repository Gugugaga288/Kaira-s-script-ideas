K.TRIAL_ARENAS[3] = { -- Trial III: the Demon Orb (inspired by the Eternal Bob fight from Slap Battles)
	demon = true, name = "THE DEMON ORB", heal = 30,
	curseDmg = 12, mediumDmg = 18, curseSpeed = 13, mediumSpeed = 7,
	p1waves = {{curse = 5, medium = 1}, {curse = 6, medium = 2}}, -- phase 1: waves of curse orbs (sword) and medium orbs (2 rock hits)
