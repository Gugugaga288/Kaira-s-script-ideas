-- recompute every buff variable from the levels, then refresh all the UI
sync = function()
	speedBonus, jumpBonus = 0, 0
	for _, v in ipairs(speedSteps) do speedBonus += v end
	for _, v in ipairs(jumpSteps) do jumpBonus += v end
	espTier = V.lv.esp
	hasMissile, hasPhase = V.lv.missile > 0, V.lv.mphase > 0
	missileTime = K.BASE_MTIME + K.DUR_STEP * V.lv.mdur
	missileSpeed = K.BASE_MSPEED + K.MSPEED_STEP * V.lv.mspeed
	missileCd = math.max(K.MIN_CD, K.BASE_MCD - K.CD_STEP * V.lv.mcd)
	hasDouble, hasTriple = V.lv.mjump >= 1, V.lv.mjump >= 2
	hasGlide, hasMulti, hasMagnet = V.lv.glide > 0, V.lv.multi > 0, V.lv.magnet > 0
	hasDrone, hasDronePark, hasDroneMount = V.lv.drone > 0, V.lv.dronepark > 0, V.lv.dronemount > 0
	if V.inMaze or V.inTrial then -- blessings are switched off inside the maze and the trials (nothing is lost, they return when you leave)
		hasMissile, hasPhase, hasDouble, hasTriple, hasGlide, hasMulti, hasMagnet, hasDrone, hasDronePark, hasDroneMount = false, false, false, false, false, false, false, false, false, false
	end
	if hasDrone and ensureDrone then ensureDrone() end -- the idle-hover loop then parents/positions it automatically
	mercy = V.lv.mercy
	V.glideMax = K.GLIDE_TIME + (V.on.gdur and K.GDUR_STEP * V.lv.gdur or 0)
	V.glideEnergy = math.min(V.glideEnergy, V.glideMax)
	refresh()
	refreshPanel()
	applyBuffs()
	refreshCurses()
	refreshAdmin()
end

local function resetAll()
	if pilotingDrone and stopPilotReturn then stopPilotReturn() end
	if mountedDrone and unmountDrone then unmountDrone() end
	droneParked = false
	if droneModel then droneModel:Destroy(); droneModel = nil end
	summons = 0
	for k in pairs(V.lv) do V.lv[k] = 0 end
	speedSteps, jumpSteps = {}, {}
	for k in pairs(V.on) do V.on[k] = false end
	V.panelOpen = false
	sync()
end

local killedByTung = false
local soulFxDeath, soulFxRespawn -- Soul Keeper animation (defined with the soul code below)
local function onDeath()
	if ritualStop then ritualStop() end -- a half-finished ritual ends when you die
	local dChar = V.lp.Character
	local dRoot = dChar and dChar:FindFirstChild("HumanoidRootPart")
	local wipes = K.DEATH_WIPES_ALL or killedByTung
	if wipes and V.keeperEndTemps then V.keeperEndTemps() end -- pool boosts are temporary and never count as owned blessings
	local drops = nil
	if wipes and V.lv.mercy > 0 and V.keeperSnapshot then drops = V.keeperSnapshot() end -- Soul Keeper: remember what you owned
	if wipes and dRoot and soulFxDeath then
		soulFxDeath(dRoot.Position, false) -- your blessings leave as coloured souls (with Soul Keeper they land again somewhere on the map)
	end
	pilotingDrone = false -- stop any drone control immediately
	mountedDrone = false
	if V.droneSeat then V.droneSeat:Destroy(); V.droneSeat = nil end
	if wipes then
		local keepMercy = V.lv.mercy - (drops and 1 or 0) -- one Soul Keeper is used up per death, the rest stay
		resetAll() -- lose every buff, summon fee back to 5
		if keepMercy > 0 then V.lv.mercy = keepMercy sync() end
		if drops and V.keeperDrop then V.keeperDrop(drops, dRoot and dRoot.Position or Vector3.new(0, 10, 0)) end
	end
	killedByTung = false
end
local function hookDeath(char)
	local h = char:WaitForChild("Humanoid", 10)
	if h then h.Died:Connect(onDeath) end
