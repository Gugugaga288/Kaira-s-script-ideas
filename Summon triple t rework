	-- ===== pentagram on the ground =====
	local pentParts = {}
	local function buildPentagram(center)
		local function part(shape, size, cf, color, mat, transp)
			local p = new("Part", {Shape = shape, Size = size, CFrame = cf, Color = color, Material = mat, Transparency = 1,
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, workspace)
			table.insert(pentParts, {part = p, target = transp})
		end
		local c = center + Vector3.new(0, .12, 0)
		part(Enum.PartType.Cylinder, Vector3.new(.2, 19, 19), CFrame.new(c) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(255, 30, 30), Enum.Material.Neon, .2)
		part(Enum.PartType.Cylinder, Vector3.new(.22, 17.4, 17.4), CFrame.new(c + Vector3.new(0, .02, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(20, 0, 0), Enum.Material.SmoothPlastic, .25)
		local R, pt = 8, {}
		for k = 0, 4 do
			local a = math.rad(-90 + 72 * k)
			pt[k] = c + Vector3.new(math.cos(a) * R, .15, math.sin(a) * R)
		end
		for k = 0, 4 do
			local a, b = pt[k], pt[(k + 2) % 5]
			part(Enum.PartType.Block, Vector3.new(.5, .15, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, .1)
		end
		for _, e in ipairs(pentParts) do TS:Create(e.part, TweenInfo.new(1.2), {Transparency = e.target}):Play() end
	end
	local function clearPentagram()
		local old = pentParts
		pentParts = {}
		for _, e in ipairs(old) do
			TS:Create(e.part, TweenInfo.new(.8), {Transparency = 1}):Play()
			Debris:AddItem(e.part, .9)
		end
	end
	local function disarm(restoreTool)
		armed, Book.armed, Book.pentagramPos = nil, nil, nil
		clearPentagram()
		linesGui.Enabled = false
		for i, l in ipairs(lineLbls) do lineState[i] = nil l.TextTransparency = 1 end
		if restoreTool then giveTool() end
	end
	local function arm() -- the pentagram on the book's second page was clicked
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if Book.state ~= "full" or armed or not (hum and root) or hum.Health <= 0 then return end
		if busy or missileBusy or pilotingDrone or mountedDrone or V.punishing or V.ritual.active then
			toast("Finish what you are doing first.", 2.5)
			return
		end
		if os.clock() < lockoutUntil then
			toast("The demon will not answer yet.", 3)
			return
		end
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {char, V.coinFolder}
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -50, 0), rp)
		if not hit then toast("Stand on solid ground first.", 2.5) return end
		closeViewer()
		hum:UnequipTools()
		removeTool() -- the book leaves your inventory...
		local center = hit.Position
		armed = {t0 = os.clock(), center = center}
		Book.armed, Book.pentagramPos = armed, center
		local m, parts = buildBookModel() -- ...falls to the ground, sinks, and leaves a pentagram
		m.Parent = workspace
		task.spawn(function()
			local top, bottom = center + Vector3.new(0, 10, 0), center + Vector3.new(0, .45, 0)
			local t0 = os.clock()
			while os.clock() - t0 < .55 do
				local k = (os.clock() - t0) / .55
				placeBook(parts, CFrame.new(top:Lerp(bottom, k * k)) * CFrame.Angles(0, k * 4, 0), 0)
				RS.Heartbeat:Wait()
			end
			t0 = os.clock()
			while os.clock() - t0 < 1.3 do
				local k = (os.clock() - t0) / 1.3
				placeBook(parts, CFrame.new(bottom - Vector3.new(0, 1.9 * k, 0)), 0)
				for _, pp in pairs(parts) do pp.Transparency = k end
				RS.Heartbeat:Wait()
			end
			m:Destroy()
			if armed and armed.center == center then
				buildPentagram(center)
				linesGui.Enabled = true
				setLineStates(0)
			end
		end)
	end
	sealBtn.MouseButton1Click:Connect(arm)

	-- ===== the book lying in the world =====
	local function removeWorld()
		if W then
			if W.dark and not V.ritual.active and not V.punishing then V.Env.restore(1.5) end
			W.model:Destroy()
			W = nil
		end
	end
	local function spawnWorld(root)
		local ang, dist = math.random() * math.pi * 2, math.random(K.BOOK_SPAWN_MIN, K.BOOK_SPAWN_MAX)
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {lp.Character, V.coinFolder}
		local hit = workspace:Raycast(root.Position + Vector3.new(math.cos(ang) * dist, 150, math.sin(ang) * dist), Vector3.new(0, -400, 0), rp)
		if not hit or hit.Normal.Y < .6 then return false end
		local m, parts = buildBookModel()
		m.Parent = workspace
		W = {model = m, parts = parts, pos = hit.Position, upright = 0, open = 0, hover = .45, dark = false}
		placeBook(parts, CFrame.new(hit.Position + Vector3.new(0, .45, 0)), 0)
		return true
	end
	local function pickup()
		removeWorld()
		Book.state = "full"
		giveTool()
		openViewer() -- the page pops up on your screen
		toast("You found the Necrobloxicon. It is in your inventory.", 5)
	end
	local function updateWorld(dt, root)
		local flat = Vector3.new(root.Position.X - W.pos.X, 0, root.Position.Z - W.pos.Z)
		local d = flat.Magnitude
		local stage = d > K.BOOK_DARK_DIST and 0 or (d > K.BOOK_FLOAT_DIST and 1 or (d > K.BOOK_OPEN_DIST and 2 or 3))
		local wantDark = stage >= 1
		if wantDark ~= W.dark and not V.ritual.active and not V.punishing then -- near it, the sky turns dark
			W.dark = wantDark
			if wantDark then V.Env.darken(2) else V.Env.restore(2) end
		end
		W.upright += ((stage >= 2 and 1 or 0) - W.upright) * math.min(1, 2.2 * dt)
		W.open += ((stage == 3 and 1 or 0) - W.open) * math.min(1, 2.5 * dt)
		W.hover += ((stage >= 2 and 4.5 or .45) - W.hover) * math.min(1, 2.2 * dt)
		if stage == 3 and d > .1 then W.pos += flat.Unit * math.min(d, 12 * dt) end -- floats toward you
		local base = W.pos + Vector3.new(0, W.hover + math.sin(os.clock() * 2) * .15 * W.upright, 0)
		local u = d > .1 and flat.Unit or Vector3.new(0, 0, 1)
		local standing = CFrame.fromMatrix(base, u:Cross(Vector3.yAxis), u, Vector3.yAxis) -- upright, cover facing you
		placeBook(W.parts, CFrame.new(base):Lerp(standing, W.upright), W.open)
		local glow = math.clamp(1 - d / K.BOOK_DARK_DIST, 0, 1)
		local light = W.parts.pages:FindFirstChildOfClass("PointLight")
		light.Range, light.Brightness = 6 + 22 * glow, glow * 6
		if stage == 3 and d < 4 then pickup() end
	end

	-- one loop for everything
	RS.Heartbeat:Connect(function(dt)
		local char = lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		if Book.state == "none" then
			if W then
				if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(W.pos.X, 0, W.pos.Z)).Magnitude > K.BOOK_SPAWN_MAX * 2 then
					removeWorld() -- you wandered far away: it will reappear near you
				else
					updateWorld(dt, root)
				end
			elseif os.clock() - startClock > 8 and os.clock() - (Book.lastTry or 0) > 2 then
				Book.lastTry = os.clock()
				spawnWorld(root)
			end
		elseif W then
			removeWorld()
		end
		if armed then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then
				disarm(true)
			else
				setLineStates(V.ritual.stage)
				if not V.ritual.active and not V.ritual.locked
					and (os.clock() - armed.t0 > K.BOOK_ARMED_TIMEOUT or (root.Position - armed.center).Magnitude > 70) then
					disarm(true)
					toast("The ritual fades. The book returns to you.", 3)
				end
			end
		end
	end)

	-- called by the summon when it ends: a finished summon turns the book into just the page with the three lines
	Book.onSummonEnd = function(finished)
		if finished and Book.state == "full" then Book.state = "page" end
		if armed then disarm(false) end
		giveTool()
	end
	lp.CharacterAdded:Connect(function() -- you keep it when you die
		task.wait(.6)
		if not armed then giveTool() end
	end)
end
