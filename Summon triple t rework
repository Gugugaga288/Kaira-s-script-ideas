local function blessingPrice(def)
	if def.id == "fortuneG" then return K.FORTUNE_G_PRICE end
	return itemPrice(def.key, def.greater)
end
local function blessingAvailable(def)
	local id = def.id
	if id == "magnet" then return not hasMagnet end
	if id == "fortune" then return V.lv.multi == 0 end
	if id == "fortuneG" then return V.lv.multi < 2 end
	if id == "djump" then return not hasDouble end
	if id == "tjump" then return hasDouble and not hasTriple end
	if id == "glide" then return not hasGlide end
	if id == "missile" then return not hasMissile end
	if id == "drone" then return not hasDrone end
	if id == "dronepark" then return hasDrone and not hasDronePark end
	if id == "dronemount" then return hasDrone and not hasDroneMount end
	return true
end

local function weightedPick(list, taken)
	local total = 0
	for _, d in ipairs(list) do if not taken[d.id] then total += d.weight end end
	if total <= 0 then return nil end
	local r = math.random() * total
	for _, d in ipairs(list) do
		if not taken[d.id] then
			r -= d.weight
			if r <= 0 then return d end
		end
	end
end
local function rollSet(list, n)
	local taken, out = {}, {}
	for _ = 1, n do
		local d = weightedPick(list, taken)
		if not d then break end
		taken[d.id] = true
		table.insert(out, d)
	end
	return out
end

-- Slot-machine picker: 3 blessings + 3 curses spin at once, lock one after another, then you may pick ONE.
V.menuButtons = {}
V.pickerToken = 0
K.REEL_LOCK = 1.0 -- seconds before the first reel stops; each next one stops .3s later
local function showPicker()
	V.pickerToken += 1
	local token = V.pickerToken
	for _, b in ipairs(V.menuButtons) do b:Destroy() end
	V.menuButtons = {}
	V.scroll.CanvasPosition = Vector2.zero
	V.cancelBtn.Visible = true
	V.menu.BackgroundColor3 = Color3.fromRGB(20, 12, 16)
	stroke.Enabled = true
	stroke.Color = Color3.fromRGB(190, 30, 30)
	V.title.Text = "The demon offers...  Souls: " .. souls
	V.title.TextColor3 = Color3.fromRGB(255, 120, 120)

	local avail = {}
	for _, d in ipairs(K.BLESSINGS) do if blessingAvailable(d) then table.insert(avail, d) end end
	local bl, cu = rollSet(avail, 3), rollSet(K.CURSES, 3)
	local order, picked = 0, false
	local function header(text, color)
		order += 1
		local l = new("TextLabel", {
			Size = UDim2.new(1, -44, 0, 24), LayoutOrder = order, BackgroundTransparency = 1, Text = text, TextColor3 = color,
			Font = Enum.Font.GothamBlack, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
		}, V.scroll)
		table.insert(V.menuButtons, l)
	end
	local function card(def, isCurse, list, lockAt)
		order += 1
		local price = isCurse and 0 or blessingPrice(def)
		local affordable = isCurse or souls >= price
		local final = def.name .. "\n" .. def.desc .. (isCurse
			and ("  (5 min)  -  earn " .. def.reward .. " souls")
			or ("  -  costs " .. price .. " souls"))
		local base = isCurse and (def.greater and Color3.fromRGB(95, 30, 120) or Color3.fromRGB(80, 25, 25))
			or (def.greater and Color3.fromRGB(190, 150, 20) or Color3.fromRGB(35, 60, 95))
		local b = new("TextButton", {
			Size = UDim2.new(1, -44, 0, 60), LayoutOrder = order, Text = "...", Font = Enum.Font.GothamBold, TextSize = 13,
			TextWrapped = true, BackgroundColor3 = base, TextColor3 = Color3.new(1, 1, 1),
			Active = false, AutoButtonColor = false,
		}, V.scroll)
		corner(b)
		table.insert(V.menuButtons, b)
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < lockAt and token == V.pickerToken do
				b.Text = list[math.random(#list)].name
				task.wait(.07)
			end
			if token ~= V.pickerToken then return end
			b.Text = final
			if not affordable then
				b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				b.TextColor3 = Color3.fromRGB(150, 150, 150)
				return
			end
			b.Active, b.AutoButtonColor = true, true
			b.MouseButton1Click:Connect(function()
				if picked or token ~= V.pickerToken then return end -- only ONE option per summon
				picked = true
				for _, x in ipairs(V.menuButtons) do
					if x:IsA("TextButton") then x.Active = false x.AutoButtonColor = false end
				end
				b.BackgroundColor3 = K.GOLD
				b.TextColor3 = Color3.new(0, 0, 0)
				V.choiceEvt:Fire(def)
			end)
		end)
	end
	header("BLESSINGS  (cost souls)", Color3.fromRGB(120, 200, 255))
	for i, d in ipairs(bl) do card(d, false, K.BLESSINGS, K.REEL_LOCK + (i - 1) * .3) end
	header("CURSES  (earn souls)", Color3.fromRGB(255, 110, 110))
	for i, d in ipairs(cu) do card(d, true, K.CURSES, K.REEL_LOCK + (i + 2) * .3) end
end

