local function droneParkGlowLoop()
	task.spawn(function()
		while droneParked and droneModel and droneModel.Parent do
			local ok, err = pcall(spawnRing)
			if not ok then warn("[TungSahur] park pulse failed: " .. tostring(err)) end
			if V.droneHighlight then
				pcall(function()
					V.droneHighlight.FillTransparency, V.droneHighlight.OutlineTransparency = .2, 0
					TS:Create(V.droneHighlight, TweenInfo.new(.9), {FillTransparency = .85, OutlineTransparency = .5}):Play()
				end)
			end
			task.wait(.9)
		end
		clearPulseGui()
	end)
end

