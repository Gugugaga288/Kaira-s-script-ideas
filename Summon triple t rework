	}, V.gui)
	corner(panel, 10)
	new("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, panel)
	new("UIStroke", {Color = Color3.fromRGB(200, 50, 30), Thickness = 1.5}, panel)
	local function panelText()
		local out = {'<font color="#ff6a3c"><b>THE SHRINE LISTENS</b></font>', "Say a line out loud (or with Silent Chant) to enter its trial:"}
		for i, T in ipairs(K.TRIALS) do
			if V.Trials.done[i] then
				table.insert(out, string.format('<font color="#7dff8a">%s  %s  (done, can be repeated)</font>\n"%s"', ROMAN[i], T.name, T.line))
			elseif i == 1 or V.Trials.done[i - 1] then
				table.insert(out, string.format('<font color="#ffd27a">%s  %s</font>\n"%s"', ROMAN[i], T.name, T.line))
			else
				table.insert(out, string.format('<font color="#8a8a8a">%s  ???  (finish the %s first)</font>', ROMAN[i], K.TRIALS[i - 1].name))
			end
		end
		return table.concat(out, "\n")
	end

	-- the angel's lights follow trial progress (stone while locked, gold when lit)
	local function paint(p, lit)
		if not (p and p.Parent) then return end
		p.Material = lit and Enum.Material.Neon or Enum.Material.Slate
		p.Color = lit and GOLD or ANGEL
	end
	local lastKey = ""
	local function paintAngel()
		local d = V.Trials.done
		local key = (d[1] and "1" or "0") .. (d[2] and "1" or "0") .. (d[3] and "1" or "0")
		if key == lastKey then return end
		lastKey = key
		for _, f in ipairs(angel.wings) do paint(f, d[1]) end
		for _, h in ipairs(angel.halo) do paint(h, d[2]) end
		paint(angel.orb, d[3])
		if angel.orbLight then angel.orbLight.Enabled = d[3] and true or false end
	end

	-- after Trial III: a huge golden beam of light swallows the WHOLE shrine, the stone crumbles inside it, then the light fades
	local function finale(model)
		shrineGone, V.Shrine.gone, V.Shrine.inCenter = true, true, false
		panel.Visible = false
		local center = sCF.Position
		local function cyl(diam, height, y, color, transp)
			return new("Part", {Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, diam, diam),
				CFrame = CFrame.new(center + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = Enum.Material.Neon,
				Transparency = transp, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, workspace)
		end
		local outer = cyl(6, 1000, 450, GOLD, .2)               -- wide golden column (grows to 96 studs: wider than the whole shrine)
		local core = cyl(3, 1000, 450, Color3.new(1, 1, 1), 0)   -- white-hot core
		local wave = cyl(10, .5, 1, GOLD, .15)                   -- shockwave along the ground
		local grow = TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TS:Create(outer, grow, {Size = Vector3.new(1000, 96, 96)}):Play()
		TS:Create(core, grow, {Size = Vector3.new(1000, 44, 44)}):Play()
		TS:Create(wave, TweenInfo.new(2.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(.5, 190, 190), Transparency = 1}):Play()
		new("PointLight", {Color = GOLD, Range = 60, Brightness = 6, Shadows = false}, core)
		new("ParticleEmitter", {Rate = 120, Lifetime = NumberRange.new(2, 4), Speed = NumberRange.new(12, 30), SpreadAngle = Vector2.new(8, 8),
			EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(1.4), LightEmission = 1, Color = ColorSequence.new(GOLD)}, core)
		toast("A golden light swallows the shrine.", 4)
		task.delay(1.5, function() -- inside the light, every stone sinks and fades
			for _, d in ipairs(model:GetChildren()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					TS:Create(d, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, math.random() * 1.4),
						{Transparency = 1, Position = d.Position - Vector3.new(0, 12, 0)}):Play()
				end
			end
		end)
		task.delay(5.3, function()
			model:Destroy()
			TS:Create(outer, TweenInfo.new(1.6), {Transparency = 1}):Play()
			TS:Create(core, TweenInfo.new(1.6), {Transparency = 1}):Play()
			Debris:AddItem(outer, 2)
			Debris:AddItem(core, 2)
			Debris:AddItem(wave, 2)
		end)
		-- once the shrine is gone, the angel orb floats to you and goes into your torso (waits until you are back in the open world)
		task.delay(7.5, function() if V.Angel and V.Angel.grantScene then V.Angel.grantScene(center + Vector3.new(0, 35, 0)) end end)
	end

	task.spawn(function()
		local char = V.lp.Character or V.lp.CharacterAdded:Wait()
		local root = char:WaitForChild("HumanoidRootPart", 15)
		if not root then return end
		task.wait(2) -- let the world load around you
		local groundPos, pedestal = findGround(root.Position)
		local model, ring, stars, runes, beam, animate = buildShrine(groundPos, pedestal)
		toast("A stone shrine has risen somewhere nearby. Find the red light.", 5)
		local hinted, lastText = false, ""
		local hb = RS.Heartbeat:Connect(function() if model.Parent and not shrineGone then animate(os.clock()) end end)
		while model.Parent do
			task.wait(.1)
			paintAngel()
			if V.Trials.done[3] and not shrineGone then finale(model) end
			if not shrineGone then
			local c = V.lp.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			local inC = false
			if r and not (V.inMaze or V.inTrial) then
				local rel = sCF:PointToObjectSpace(r.Position)
				inC = math.sqrt(rel.X * rel.X + rel.Z * rel.Z) < K.SHRINE_RADIUS and rel.Y > SHRINE_TOP - 1 and rel.Y < SHRINE_TOP + 10
				if not hinted and (r.Position - sCF.Position).Magnitude < 45 then
					hinted = true
					toast("An ancient shrine. Step into the center of its sigil to listen.", 4.5)
				end
			end
			V.Shrine.inCenter = inC
			local t = os.clock()
			for i, rn in ipairs(runes) do rn.Transparency = .1 + .3 * (.5 + .5 * math.sin(t * 2 + i)) end
			ring.Color = inC and Color3.fromRGB(255, 150, 80) or RUNE
			beam.Transparency = V.Trials.active and 1 or .8
			for _, st in ipairs(stars) do st.Transparency = inC and 0 or .35 end
			panel.Visible = inC
			if inC then
				local txt = panelText()
				if txt ~= lastText then panel.Text, lastText = txt, txt end
			end
			end
		end
		hb:Disconnect()
	end)
end

---------------------------------------------------------------- The Necrobloxicon
-- ===== TWEAKS =====
K.BOOK_SPAWN_MIN, K.BOOK_SPAWN_MAX = 150, 260  -- how far from you the book appears (it only spawns while you don't own it)
K.BOOK_DARK_DIST = 50      -- closer than this: the sky turns dark and the book glows red
K.BOOK_FLOAT_DIST = 30     -- closer than this: it floats upright
K.BOOK_OPEN_DIST = 14      -- closer than this: it opens and floats to you
K.BOOK_ARMED_TIMEOUT = 180 -- seconds you can wait at the pentagram before the ritual fades (you keep the book)

local function initBook()

---------------------------------------------------------------- Total Blindness (the Greater Blind Spot curse)
-- (Lasts 5 minutes like every other curse; NOTHING glows while it is on.)
-- The world goes almost black. You stay outlined in white (so does the drone). Everything else is found by sound and movement:
--   objects within ~10 studs get a solid white outline, objects 15-25 studs away a very faint slowly pulsing one;
--   sounds, footsteps, jumps, landings and explosions send out a white shockwave ring and light up a few nearby objects.
K.TB_NEAR, K.TB_FAR = 10, 25
local function initTotalBlind()

---------------------------------------------------------------- The Maze (stage 2)
-- A black maze far above the map. You FALL into a big open arena: the demon orb floats in the middle with 4 curse orbs circling it,
-- all of them glowing so you can see them light up. There is an opening on your LEFT (the arena's east wall) that leads into the real maze.
-- After 10 seconds the demon wakes (fire, "WHO DARE AWAKEN ME") and chases you; the orbs follow you and curse you when they get close.
-- Reach the red exit at the far end of the maze to escape. Lava strips on the way must be jumped. Blessings are off.
K.MAZE_N, K.MAZE_CELL, K.MAZE_WALL_H, K.MAZE_Y = 9, 14, 18, 4200 -- (was 13 x 13: now 9 x 9, a much shorter way out)
K.MAZE_LOOPS = .22  -- chance that each inner wall is knocked down: fewer dead ends, several ways to the exit
K.MAZE_LAVA = 3     -- lava strips you have to jump (was 6)
K.GUIDE_SPEED = 24  -- how fast the guiding orb flies (it always waits one cell ahead of you, on the way to the exit)
K.ARENA_W, K.ARENA_D, K.ARENA_H = 126, 126, 44  -- the free space you fall into (width, depth, height in studs)
K.DEMON_SPEED, K.ORB_SPEED, K.AWAKEN_TIME = 15, 12, 10  -- faster demon orb and curse orbs (was 10 and 7)
-- each curse orb has its OWN orbit around you, its own speed, its own weaving flight (they fly, they do not share one path)
K.ORB_RADII = {6, 8.5, 11, 13.5}       -- how far from you each orb circles (it breathes in and out by +-2.5)
K.ORB_SPEED_MULS = {.8, 1, 1.15, 1.3}  -- each orb's speed = ORB_SPEED x this
K.ORB_SPINS = {1, -.75, 1.25, -1}      -- how fast each one circles you (negative = the other way round)
K.ORB_HEIGHTS = {3.5, 5, 6.5, 4.2}
K.ORB_CURSE_RANGE = 6.5                -- an orb only curses you while it is this close
local function initMaze()
	local lp = V.lp
	local N, C, T, H = K.MAZE_N, K.MAZE_CELL, 2, K.MAZE_WALL_H
	local running = false
	V.Maze = {}
	local DIRS = {{"n", 0, -1, "s"}, {"s", 0, 1, "n"}, {"e", 1, 0, "w"}, {"w", -1, 0, "e"}}

	local function generate() -- perfect maze (depth-first); the arena sits outside it, to the west
		local open, seen = {}, {}
		for x = 0, N - 1 do
			open[x], seen[x] = {}, {}
			for y = 0, N - 1 do open[x][y], seen[x][y] = {}, false end
		end
		local stack = {{0, 0}}
		seen[0][0] = true
		while #stack > 0 do
			local cx, cy = stack[#stack][1], stack[#stack][2]
			local opts = {}
			for _, d in ipairs(DIRS) do
				local nx, ny = cx + d[2], cy + d[3]
				if nx >= 0 and ny >= 0 and nx < N and ny < N and not seen[nx][ny] then table.insert(opts, {d, nx, ny}) end
			end
			if #opts == 0 then
				table.remove(stack)
			else
				local o = opts[math.random(#opts)]
				open[cx][cy][o[1][1]], open[o[2]][o[3]][o[1][4]] = true, true
				seen[o[2]][o[3]] = true
				table.insert(stack, {o[2], o[3]})
			end
		end
		for x = 0, N - 1 do -- knock down some walls: dead ends turn into loops, so it is much harder to get truly lost
			for y = 0, N - 1 do
				if x < N - 1 and not open[x][y].e and math.random() < K.MAZE_LOOPS then open[x][y].e, open[x + 1][y].w = true, true end
				if y < N - 1 and not open[x][y].s and math.random() < K.MAZE_LOOPS then open[x][y].s, open[x][y + 1].n = true, true end
			end
		end
		return open, math.floor(N / 2) -- (the second value is the row where the arena door is)
	end
	local function bfs(open, fx, fy, tx, ty) -- returns the list of cells from (fx,fy) to (tx,ty)
		local prev, queue, head = {[fx * 100 + fy] = false}, {{fx, fy}}, 1
		while head <= #queue do
			local c = queue[head]
			head += 1
			if c[1] == tx and c[2] == ty then break end
			for _, d in ipairs(DIRS) do
				if open[c[1]][c[2]][d[1]] then
					local nx, ny = c[1] + d[2], c[2] + d[3]
					if prev[nx * 100 + ny] == nil then
						prev[nx * 100 + ny] = c
						table.insert(queue, {nx, ny})
					end
				end
			end
		end
		local path, cur = {}, {tx, ty}
		while cur do
			table.insert(path, 1, cur)
			cur = prev[cur[1] * 100 + cur[2]]
		end
		return path
	end

	function V.Maze.enter(returnCF)
		if running then return end
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and root) or hum.Health <= 0 then return end
		if pilotingDrone or mountedDrone or V.ritual.active then toast("Finish what you are doing first.", 2.5) return end
		running = true
		returnCF = returnCF or root.CFrame
		V.inMaze, busy = true, true
		sync() -- switches blessings off
		local feetOff = hum.HipHeight + root.Size.Y / 2

		local origin = Vector3.new(0, K.MAZE_Y, 0) -- the (0,0) corner of the maze, at floor level
		local open, m = generate()
		local cleanups, conn = {}, nil
		local model = Instance.new("Model")
		model.Name = "DemonMaze"
		model.Parent = workspace
		table.insert(cleanups, function() model:Destroy() end)

		local function block(size, cf, color, mat, collide)
			return new("Part", {Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Slate, Anchored = true, CanCollide = collide ~= false, CanTouch = false}, model)
		end
		local function cellCenter(x, y) return Vector3.new(origin.X + (x + .5) * C, origin.Y, origin.Z + (y + .5) * C) end
		local function cellOf(p)
			return math.clamp(math.floor((p.X - origin.X) / C), 0, N - 1), math.clamp(math.floor((p.Z - origin.Z) / C), 0, N - 1)
		end

		local DARK = Color3.fromRGB(100, 62, 62) -- stone colour of the walls, floor and ceiling (light enough to see now that the maze is lit)
		local DR = m                                   -- the maze row whose west wall is open: the door out of the arena
		local AW, AD, AH = K.ARENA_W, K.ARENA_D, K.ARENA_H
		local midZ = origin.Z + (DR + .5) * C          -- the arena is centred on the door's line
		local aZ0, aZ1 = midZ - AD / 2, midZ + AD / 2
		local fx0, fx1 = origin.X - AW - 20, origin.X + N * C + 20
		block(Vector3.new(fx1 - fx0, 2, N * C + 40), CFrame.new((fx0 + fx1) / 2, origin.Y - 1, origin.Z + N * C / 2), DARK) -- one floor under arena + maze
		block(Vector3.new(N * C + 2 * T, 2, N * C + 2 * T), CFrame.new(origin.X + N * C / 2, origin.Y + H + 1, origin.Z + N * C / 2), DARK) -- maze ceiling: no sky, nobody jumps out
		block(Vector3.new(AW, 2, AD), CFrame.new(origin.X - AW / 2, origin.Y + AH + 1, midZ), DARK)                                      -- arena ceiling
		local walls = {}
		for i = 0, N do
			for y = 0, N - 1 do -- vertical walls (the door: no wall at the west edge of row DR)
				if not (i == 0 and y == DR) and (i == 0 or i == N or not open[i][y].w) then
					table.insert(walls, block(Vector3.new(T, H, C + T), CFrame.new(origin.X + i * C, origin.Y + H / 2, origin.Z + (y + .5) * C), DARK))
				end
			end
			for x = 0, N - 1 do -- horizontal walls (a gap is left in the far outer wall: the exit)
				local exitGap = i == N and x == N - 1
				if not exitGap and (i == 0 or i == N or not open[x][i].n) then
					table.insert(walls, block(Vector3.new(C + T, H, T), CFrame.new(origin.X + (x + .5) * C, origin.Y + H / 2, origin.Z + i * C), DARK))
				end
			end
		end
		-- the arena: completely free inside. Its east wall is the maze's west wall, raised up to the arena ceiling.
		local function arenaWall(size, cf) table.insert(walls, block(size, cf, DARK)) end
		arenaWall(Vector3.new(T, AH, AD + T), CFrame.new(origin.X - AW, origin.Y + AH / 2, midZ))                       -- far west wall
		arenaWall(Vector3.new(AW + T, AH, T), CFrame.new(origin.X - AW / 2, origin.Y + AH / 2, aZ0))                    -- south wall
		arenaWall(Vector3.new(AW + T, AH, T), CFrame.new(origin.X - AW / 2, origin.Y + AH / 2, aZ1))                    -- north wall
		arenaWall(Vector3.new(T, AH - H, AD), CFrame.new(origin.X, origin.Y + H + (AH - H) / 2, midZ))                  -- east wall above the maze wall + over the door
		for _, dz in ipairs({-5.6, 5.6}) do -- two glowing posts mark the door
			local post = block(Vector3.new(1, H, 1), CFrame.new(origin.X - 1.4, origin.Y + H / 2, midZ + dz), Color3.fromRGB(255, 90, 20), Enum.Material.Neon, false)
			new("PointLight", {Color = Color3.fromRGB(255, 110, 40), Range = 24, Brightness = 1.6}, post)
		end
		local exitPos = cellCenter(N - 1, N - 1) + Vector3.new(0, 3, C / 2 + 12)
		block(Vector3.new(C, 2, 26), CFrame.new(exitPos.X, origin.Y - 1, exitPos.Z - 6), DARK)
		block(Vector3.new(5, 300, 5), CFrame.new(exitPos.X, origin.Y + 150, exitPos.Z), Color3.fromRGB(255, 70, 70), Enum.Material.Neon, false).Transparency = .5

		-- lava strips on straight corridor cells of the solution: you have to jump them
		local path = bfs(open, 0, DR, N - 1, N - 1)
		local lavas, idx = {}, 5
		while idx < #path - 3 and #lavas < K.MAZE_LAVA do
			local c, p, nx = path[idx], path[idx - 1], path[idx + 1]
			if (p[1] == c[1] and nx[1] == c[1]) or (p[2] == c[2] and nx[2] == c[2]) then
				local along = p[1] == c[1] and "z" or "x"
				local ctr = cellCenter(c[1], c[2])
				local sz = along == "z" and Vector3.new(C - T - .4, .4, 6) or Vector3.new(6, .4, C - T - .4)
				local part = block(sz, CFrame.new(ctr.X, origin.Y + .2, ctr.Z), Color3.fromRGB(150, 50, 10), Enum.Material.SmoothPlastic, false)
				table.insert(lavas, {part = part, x = ctr.X, z = ctr.Z, hx = sz.X / 2, hz = sz.Z / 2})
				idx += 7
			else
				idx += 1
			end
		end

		-- the demon and its 4 curse orbs
		local function makeOrb(sz, color)
			local core = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz, sz), Color = color, Material = Enum.Material.Neon,
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
			local fire = new("Fire", {Size = sz * 4, Heat = 10, Enabled = false, Color = Color3.fromRGB(255, 60, 0), SecondaryColor = Color3.fromRGB(255, 160, 0)}, core)
			local light = new("PointLight", {Color = color, Range = 0, Brightness = 0}, core)
			core:SetAttribute("GlowColor", color)
			V.CS:AddTag(core, "DemonGlow") -- keeps glowing even through Total Blindness
			return core, fire, light
		end
		local dCore, dFire, dLight = makeOrb(6, Color3.fromRGB(255, 25, 25))
		dCore.Name = "MazeDemon"
		dLight.Range, dLight.Brightness = 55, 3 -- already lit while it sleeps, so you can see it in the dark
		local demon = {part = dCore, pos = Vector3.new(origin.X - AW / 2, origin.Y + 6, midZ)} -- dead centre of the arena
		local function curseDef(id) for _, d in ipairs(K.CURSES) do if d.id == id then return d end end end
		local orbs = {}
		for i, id in ipairs({"heavy", "unsteady", "nausea", "blindG"}) do -- Speed curse, Jump curse, Nausea, Total Blindness
			local core, fire, light = makeOrb(1.8, Color3.fromRGB(150, 60, 230))
			core.Name = "MazeCurseOrb"
			light.Range, light.Brightness = 16, 2 -- the curse orbs glow too
			orbs[i] = {part = core, fire = fire, light = light, def = curseDef(id), pos = demon.pos, cd = 0,
				radius = K.ORB_RADII[i], speedMul = K.ORB_SPEED_MULS[i], spin = K.ORB_SPINS[i], height = K.ORB_HEIGHTS[i],
				phase = (i - 1) * math.pi / 2 + math.random() * .5, weaveRate = .8 + i * .25}
		end

		-- the guiding orb: a white orb with a halo and flapping wings. It waits in the doorway while you are in the arena, then floats one cell
		-- ahead of you along the shortest way to the exit (it is recalculated every time you change cell, so wrong turns are fine).
		local gm = Instance.new("Model")
		gm.Name = "MazeGuide"
		gm.Parent = model
		local function gpart(size, shape, transp)
			return new("Part", {Size = size, Shape = shape or Enum.PartType.Block, Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Transparency = transp or 0,
				Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, gm)
		end
		local gcore = gpart(Vector3.new(1.8, 1.8, 1.8), Enum.PartType.Ball)
		new("PointLight", {Color = Color3.new(1, 1, 1), Range = 22, Brightness = 1.4}, gcore)
		local HALO_N, HALO_R = 14, 1.25
		local halo = {}
		for k = 1, HALO_N do
			local seg = gpart(Vector3.new(2 * math.pi * HALO_R / HALO_N * 1.1, .14, .14))
			seg.Color = Color3.fromRGB(255, 232, 150)
			halo[k] = seg
		end
		local FEATHER_SPREAD = {22, 6, -10, -26} -- each feather fans out a little lower than the one before
		local FEATHER_LEN = {2.4, 2.3, 2.0, 1.6}
		local wings = {{sx = 1, feathers = {}}, {sx = -1, feathers = {}}}
		for _, w in ipairs(wings) do
			for i = 1, #FEATHER_LEN do
				local f = gpart(Vector3.new(FEATHER_LEN[i], .16, .85), nil, .12)
				new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, f) -- soft, rounded feathers
				w.feathers[i] = f
			end
		end
		local guide = {pos = Vector3.new(origin.X - 2, origin.Y + 5, midZ), face = Vector3.new(1, 0, 0), key = nil, path = nil}
		local function updateGuide(now, dt, rp)
			local tgt
			if rp.X < origin.X then -- you are still in the arena: it waits in the doorway
				tgt = Vector3.new(origin.X - 2, origin.Y + 5, midZ)
			else
				local cx, cy = cellOf(rp)
				local key = cx * 100 + cy
				if guide.key ~= key then guide.key, guide.path = key, bfs(open, cx, cy, N - 1, N - 1) end
				local pth = guide.path
				if #pth <= 2 then
					tgt = Vector3.new(exitPos.X, origin.Y + 5, exitPos.Z) -- last cell: lead you out through the gap
				else
					local c = pth[2]
					tgt = cellCenter(c[1], c[2]) + Vector3.new(0, 5, 0)
				end
			end
			tgt += Vector3.new(0, math.sin(now * 2.2) * .6, 0)
			local to = tgt - guide.pos
			local d = to.Magnitude
			local moving = d > 1
			if d > .05 then
				local flat = Vector3.new(to.X, 0, to.Z)
				if flat.Magnitude > .5 then guide.face = guide.face:Lerp(flat.Unit, math.min(1, dt * 6)) end
				guide.pos += to.Unit * math.min(d, K.GUIDE_SPEED * dt * (d > 30 and 2 or 1))
			end
			local fl = guide.face.Magnitude > .01 and guide.face.Unit or Vector3.new(1, 0, 0)
			local base = CFrame.lookAt(guide.pos, guide.pos + fl)
			gcore.CFrame = base
			-- halo floats above the orb
			local haloCF = base * CFrame.new(0, 1.7 + math.sin(now * 3) * .08, 0) * CFrame.Angles(math.rad(8), 0, 0)
			for k, seg in ipairs(halo) do
				local a = (k - 1) / HALO_N * math.pi * 2
				seg.CFrame = haloCF * CFrame.new(math.cos(a) * HALO_R, 0, math.sin(a) * HALO_R) * CFrame.Angles(0, -a - math.pi / 2, 0)
			end
			-- wings flap (faster while it is flying)
			local flap = math.rad(12) + math.sin(now * (moving and 11 or 6)) * math.rad(38)
			for _, w in ipairs(wings) do
				local pivot = base * CFrame.new(w.sx * .75, .25, .15) * CFrame.Angles(0, 0, w.sx * flap)
				for i, f in ipairs(w.feathers) do
					f.CFrame = pivot * CFrame.Angles(0, 0, w.sx * math.rad(FEATHER_SPREAD[i])) * CFrame.new(w.sx * FEATHER_LEN[i] / 2, 0, -(i - 1) * .12)
				end
			end
		end

		-- messages
		local function bigText(text)
			local g = new("ScreenGui", {Name = "MazeText", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 9}, lp:WaitForChild("PlayerGui"))
			local l = new("TextLabel", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .4), Size = UDim2.fromScale(.9, .2),
				BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(255, 40, 40), TextTransparency = 1, Font = Enum.Font.Antique, TextScaled = true}, g)
			new("UITextSizeConstraint", {MaxTextSize = 64, MinTextSize = 12}, l)
			TS:Create(l, TweenInfo.new(.6), {TextTransparency = .15}):Play()
			task.delay(3.6, function() TS:Create(l, TweenInfo.new(.9), {TextTransparency = 1}):Play() end)
			Debris:AddItem(g, 5.5)
		end

		local function finish(escaped)
			if not running then return end
			running = false
			if conn then conn:Disconnect() end
			for _, f in ipairs(cleanups) do pcall(f) end
			V.inMaze, busy = false, false
			if V.TotalBlindOn and V.TotalBlindOn() then V.Env.blackout(2) -- the curse is still on: the world stays black
			else
				V.Env.black = false
				V.Env.restore(2)
			end
			sync() -- blessings back on
			if escaped and root.Parent then
				root.CFrame = returnCF
				root.AssemblyLinearVelocity = Vector3.zero
			end
			TS:Create(V.flashFrame, TweenInfo.new(.6), {BackgroundTransparency = 1}):Play()
		end

		-- go in: flash to red, teleport, the maze is black
		TS:Create(V.flashFrame, TweenInfo.new(.4), {BackgroundTransparency = 0}):Play()
		task.wait(.5)
		if hum.Health <= 0 then finish(false) return end
		V.Env.maze(.5) -- the maze is lit (everything but the orbs), even before the demon wakes and even with Total Blindness
		-- you FALL in: dropped from near the arena ceiling, facing the orb. The door to the maze is on your left.
		local spawn = Vector3.new(origin.X - AW / 2, origin.Y + AH - 6, aZ0 + 14)
		root.CFrame = CFrame.lookAt(spawn, spawn + Vector3.new(0, 0, 1))
		root.AssemblyLinearVelocity = Vector3.zero
		applyBuffs()
		toast("Follow the white orb with the halo: it shows you the way out.", 5)
		TS:Create(V.flashFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
		hum.Died:Connect(function() finish(false) end)

		-- chase helper: flies straight inside the arena, leaves/enters through the door, and follows the corridors inside the maze
		local function cellGoal(e, tx, ty, fallback) -- next waypoint toward cell (tx, ty)
			local cx, cy = cellOf(e.pos)
			if cx == tx and cy == ty then return fallback end
			local key = cx .. "," .. cy .. ">" .. tx .. "," .. ty
			if e.key ~= key then
				e.key = key
				local p = bfs(open, cx, cy, tx, ty)
				e.nextCell = p[2] or p[1]
			end
			return cellCenter(e.nextCell[1], e.nextCell[2])
		end
		local outsideDoor = Vector3.new(origin.X - 8, 0, midZ)
		local function chase(e, target, speed, dt, height)
			local eIn, tIn = e.pos.X < origin.X, target.X < origin.X -- true = inside the arena
			local goal
			if eIn and tIn then
				goal = target
			elseif eIn then -- you are in the maze: line up with the door, then go through it
				if e.pos.X < origin.X - 8 or math.abs(e.pos.Z - midZ) > 3 then goal = outsideDoor else goal = cellCenter(0, DR) end
			elseif tIn then -- you are in the arena: walk back to the door cell, then out through the door
				goal = cellGoal(e, 0, DR, outsideDoor)
			else
				local tx, ty = cellOf(target)
				goal = cellGoal(e, tx, ty, target)
			end
			goal = Vector3.new(goal.X, origin.Y + height, goal.Z)
			local to = goal - e.pos
			if to.Magnitude > .05 then e.pos += to.Unit * math.min(to.Magnitude, speed * dt) end
		end

		local t0, awake, angle = os.clock(), false, 0
		local function awaken()
			awake = true
			for _, w in ipairs(walls) do w.Material, w.Color = Enum.Material.Neon, Color3.fromRGB(190, 32, 14) end
			for _, l in ipairs(lavas) do l.part.Material, l.part.Color = Enum.Material.Neon, Color3.fromRGB(255, 100, 0) end
			dFire.Enabled, dLight.Range, dLight.Brightness = true, 60, 4
			for _, o in ipairs(orbs) do o.fire.Enabled, o.light.Range, o.light.Brightness = true, 14, 2 end
			if not (V.TotalBlindOn and V.TotalBlindOn()) then V.Env.maze(2) end -- (still lit; the walls and lava turn red on their own)
			if V.TotalBlindDim then V.TotalBlindDim() end -- Total Blindness: nothing is allowed to glow, not even an awake maze
			bigText("WHO DARE AWAKEN ME")
		end
		conn = RS.Heartbeat:Connect(function(dt)
			if hum.Health <= 0 or not root.Parent then finish(false) return end
			local now = os.clock() - t0
			if not awake and now >= K.AWAKEN_TIME then awaken() end
			angle += dt * 1.2
			local rp = root.Position
			if awake then
				chase(demon, rp, K.DEMON_SPEED, dt, 5)
				if (demon.pos - rp).Magnitude < 4.5 then hum.Health = 0 return end -- it touched you
			else
				demon.pos = Vector3.new(demon.pos.X, origin.Y + 6 + math.sin(now * 1.5) * .6, demon.pos.Z)
				dLight.Brightness = 2.6 + math.sin(now * 3) * .9 -- breathing glow while it sleeps
			end
			dCore.Position = demon.pos
			updateGuide(now, dt, rp)
			for i, o in ipairs(orbs) do
				if awake then
					-- the orb flies to its own spot on its own circle around you, weaving from side to side on the way
					local ang = o.phase + now * o.spin
					local rad = o.radius + math.sin(now * .6 + o.phase) * 2.5
					local slot = Vector3.new(rp.X + math.cos(ang) * rad, origin.Y + o.height + math.sin(now * 1.7 + o.phase) * 1.2, rp.Z + math.sin(ang) * rad)
					local to = slot - o.pos
					local dist = to.Magnitude
					if dist > .05 then
						local dir = to.Unit
						local side = Vector3.new(-dir.Z, 0, dir.X)
						local weave = math.sin(now * o.weaveRate + o.phase) * math.min(dist * .35, 12)
						local aim = slot + side * weave - o.pos
						local spd = K.ORB_SPEED * o.speedMul * (dist > 60 and 2 or 1) -- (far behind: it catches up)
						if aim.Magnitude > .05 then o.pos += aim.Unit * math.min(aim.Magnitude, spd * dt) end
					end
					if (o.pos - rp).Magnitude < K.ORB_CURSE_RANGE and now >= o.cd then
						o.cd = now + 12
						addCurse(o.def)
						sync()
						toast(o.def.name .. "!", 2)
					end
				else
					local a = angle + i * math.pi / 2
					o.pos = demon.pos + Vector3.new(math.cos(a) * 9, -1 + math.sin(now * 2 + i), math.sin(a) * 9)
				end
				o.part.Position = o.pos
			end
			local feetY = rp.Y - feetOff
			for _, l in ipairs(lavas) do
				if math.abs(rp.X - l.x) < l.hx and math.abs(rp.Z - l.z) < l.hz and feetY < origin.Y + 1.6 then hum.Health = 0 return end -- lava
			end
			if (rp - exitPos).Magnitude < 9 then finish(true) end -- you made it out
		end)
	end
end
initMaze()
	local lp = V.lp
	local WHITE = Color3.new(1, 1, 1)
	local on, folder, conns = false, nil, {}
	local boxes, humList, soundList, humRec = {}, {}, {}, {}
	local lastSound, fxHighlights, budget = {}, {}, 40
	local dimmed = {} -- instance -> what it looked like before Total Blindness switched its glow off
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude

	local function ownRoot() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
	local function okPart(p)
		if not p:IsA("BasePart") or p.Transparency >= 1 then return false end
		local s = p.Size
		local m = math.max(s.X, s.Y, s.Z)
		if m > 80 or m < .4 then return false end -- skip huge floors and tiny specks
		local model = p:FindFirstAncestorOfClass("Model")
		return not (model and model:FindFirstChildOfClass("Humanoid")) -- characters get their own outline
	end
	local function setFilter()
		local list = {folder, V.coinFolder}
		if lp.Character then table.insert(list, lp.Character) end
		overlap.FilterDescendantsInstances = list
	end
	local function boxFor(p)
		local e = boxes[p]
		if not e then
			e = {box = new("SelectionBox", {Adornee = p, Color3 = WHITE, LineThickness = .04, SurfaceTransparency = 1, Transparency = 1}, folder), flashUntil = 0, flashLen = 1}
			boxes[p] = e
		end
		return e
	end
	local function outlineModel(model, dur)
		local h = model:FindFirstChild("TBOutline")
		if not h then
			h = new("Highlight", {Name = "TBOutline", FillTransparency = 1, OutlineColor = WHITE, OutlineTransparency = 1,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, model)
			table.insert(fxHighlights, h)
		end
		h.OutlineTransparency = 0
		TS:Create(h, TweenInfo.new(dur or .8), {OutlineTransparency = 1}):Play()
	end
	-- a white shockwave ring at pos, and a few objects near it light up so you can tell where it came from
	local function pulse(pos, radius, count)
		if budget < 1 then return end
		budget -= 1
		local ring = new("Part", {
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(.15, 1, 1), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2),
			Color = WHITE, Material = Enum.Material.Neon, Transparency = .3, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, folder)
		TS:Create(ring, TweenInfo.new(.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(.15, radius * 2, radius * 2), Transparency = 1}):Play()
		Debris:AddItem(ring, 1)
		setFilter()
		local c = 0
		for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, radius, overlap)) do
			if c >= count then break end
			if okPart(p) then
				c += 1
				local e = boxFor(p)
				e.flashUntil, e.flashLen = os.clock() + 1.4, 1.4
			end
		end
	end

	local function scan() -- which objects near you get an outline box
		local root = ownRoot()
		if not root then return end
		setFilter()
		local keep, n = {}, 0
		for _, p in ipairs(workspace:GetPartBoundsInRadius(root.Position, K.TB_FAR + 3, overlap)) do
			if n >= 40 then break end
			if okPart(p) then
				n += 1
				keep[p] = true
				boxFor(p)
			end
		end
		for p, e in pairs(boxes) do
			if not keep[p] and e.flashUntil < os.clock() then e.box:Destroy() boxes[p] = nil end
		end
	end
	local function updateBoxes(t)
		local root = ownRoot()
		if not root then return end
		for p, e in pairs(boxes) do
			if not p.Parent then
				e.box:Destroy()
				boxes[p] = nil
			else
				local s = p.Size
				local d = math.max(0, (p.Position - root.Position).Magnitude - math.max(s.X, s.Y, s.Z) / 2)
				local tr = 1
				if d <= K.TB_NEAR then tr = .05                                                                  -- close: solid white outline
				elseif d >= 15 and d <= K.TB_FAR then tr = .86 + .08 * math.sin(t * 1.3 + p.Position.X + p.Position.Z) end -- far: faint, slow pulse
				if e.flashUntil > t then tr = math.min(tr, 1 - ((e.flashUntil - t) / e.flashLen) * .95) end   -- a pulse lit it up
				e.box.Transparency = tr
			end
		end
	end

	-- steps, jumps and landings of players and NPCs (and your own, as a ring only)
	local function watch(h, outline, dt)
		local model, rec = h.Parent, humRec[h]
		local r = model and model:FindFirstChild("HumanoidRootPart")
		if not r or h.Health <= 0 then return end
		if not rec then rec = {step = 0, last = h:GetState()} humRec[h] = rec end
		local st = h:GetState()
		local feet = r.Position - Vector3.new(0, h.HipHeight + r.Size.Y / 2, 0)
		if st == Enum.HumanoidStateType.Jumping and rec.last ~= Enum.HumanoidStateType.Jumping then
			pulse(feet, 8, 2)
			if outline then outlineModel(model, .9) end
		elseif rec.last == Enum.HumanoidStateType.Freefall and (st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.Running) then
			pulse(feet, 14, 3)
			if outline then outlineModel(model, 1.1) end
		end
		rec.last = st
		if h.MoveDirection.Magnitude > .1 and h.FloorMaterial ~= Enum.Material.Air then
			rec.step -= dt
			if rec.step <= 0 then
				rec.step = math.clamp(.55 * 16 / math.max(h.WalkSpeed, 4), .22, .8)
				pulse(feet, 6, 1)
				if outline then outlineModel(model, .6) end
			end
		else
			rec.step = 0
		end
	end
	local function pollHumans(dt)
		local root = ownRoot()
		if not root then return end
		local mine = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if mine then watch(mine, false, dt) end
		for h in pairs(humList) do
			local r = h.Parent and h.Parent:FindFirstChild("HumanoidRootPart")
			if not h.Parent then humList[h] = nil humRec[h] = nil
			elseif r and (r.Position - root.Position).Magnitude <= 90 then watch(h, true, dt) end
		end
	end
	local function pollSounds(t) -- positional sounds that are playing send out a pulse from where they are
		local root = ownRoot()
		if not root then return end
		for s in pairs(soundList) do
			if not s.Parent then
				soundList[s] = nil
			elseif s.IsPlaying and s.Volume > .05 and not s:FindFirstAncestorOfClass("Model") then -- (character sounds are covered by the step pulses)
				local par = s.Parent
				local pos = par:IsA("BasePart") and par.Position or (par:IsA("Attachment") and par.WorldPosition)
				if pos and (pos - root.Position).Magnitude <= math.min(200, s.RollOffMaxDistance > 0 and s.RollOffMaxDistance or 200) and t - (lastSound[s] or 0) > 1.6 then
					lastSound[s] = t
					pulse(pos, 22, 5)
				end
			end
		end
	end

	local function upkeep() -- white outline on you and on the drone
		local c = lp.Character
		if c and not c:FindFirstChild("TBSelf") then
			table.insert(fxHighlights, new("Highlight", {Name = "TBSelf", FillTransparency = 1, OutlineColor = WHITE, OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, c))
		end
		local drone = workspace:FindFirstChild("SoulDrone")
		if drone and not drone:FindFirstChild("TBDrone") then
			table.insert(fxHighlights, new("Highlight", {Name = "TBDrone", FillTransparency = 1, OutlineColor = WHITE, OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, drone))
		end
	end

	-- Total Blindness: NOTHING glows. Souls, curse orbs, the pentagram, the demon orb and the maze orbs lose their neon, lights and flames.
	local function dimOne(d)
		if dimmed[d] then return end
		local isPart = d:IsA("BasePart") and d.Material == Enum.Material.Neon
		local isFx = not isPart and (d:IsA("Light") or d:IsA("Fire") or d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Beam") or d:IsA("Trail")) and d.Enabled
		if not (isPart or isFx) then return end
		if d:FindFirstAncestor("MazeGuide") then return end -- the guiding orb is the one thing allowed to shine
		if folder and d:IsDescendantOf(folder) then return end -- (only the blindness effects themselves are allowed to glow)
		if isPart and d:IsDescendantOf(V.coinFolder) then return end -- souls keep their normal body; only their light is switched off (below)
		if isPart then
			dimmed[d] = {mat = d.Material, color = d.Color}
			d.Material = Enum.Material.SmoothPlastic
			local mz = workspace:FindFirstChild("DemonMaze")
			if d.Name == "MazeCurseOrb" or d:IsDescendantOf(V.orbFolder) then
				d.Color = Color3.fromRGB(150, 150, 150) -- curse orbs turn plain grey
			elseif mz and d.Name ~= "MazeDemon" and d:IsDescendantOf(mz) then
				-- the maze itself keeps its colour (it is lit, so you can see it); it just does not glow
			else
				d.Color = d.Color:Lerp(Color3.new(0, 0, 0), .85)
			end
		else
			dimmed[d] = {enabled = true}
			d.Enabled = false
		end
	end
	-- anything the game turns back into a glow while you are blind (orbs waking up, walls turning to neon, the pentagram lighting...) is switched off again
	local function enforce()
		for inst, rec in pairs(dimmed) do
			if not inst.Parent then
				dimmed[inst] = nil
			elseif rec.mat then
				if inst.Material == Enum.Material.Neon then
					rec.mat, rec.color = inst.Material, inst.Color -- remember the new look for when the curse ends
					inst.Material = Enum.Material.SmoothPlastic
					inst.Color = inst.Color:Lerp(Color3.new(0, 0, 0), .85)
				end
			elseif inst.Enabled then
				inst.Enabled = false
			end
		end
	end
	local function dimTree(root)
		dimOne(root)
		for _, d in ipairs(root:GetDescendants()) do dimOne(d) end
	end
	-- curse orbs do not glow, but they stay visible as flat grey shapes (souls keep their normal body)
	local GREY = Color3.fromRGB(150, 150, 150)
	local function greyUp(inst)
		if inst:FindFirstChild("TBGrey") then return end
		table.insert(fxHighlights, new("Highlight", {Name = "TBGrey", Adornee = inst, FillColor = GREY, FillTransparency = .1,
			OutlineTransparency = 1, DepthMode = Enum.HighlightDepthMode.Occluded}, inst))
	end
	local function glowTick() -- (name kept) runs every 0.25 s so new souls/orbs are dimmed too
		enforce()
		for _, orb in ipairs(V.orbFolder:GetChildren()) do greyUp(orb) end
		for _, t in ipairs(V.CS:GetTagged("DemonGlow")) do if t.Name == "MazeCurseOrb" then greyUp(t) end end
		for _, soul in ipairs(V.coinFolder:GetChildren()) do dimTree(soul) end
		for _, orb in ipairs(V.orbFolder:GetChildren()) do dimTree(orb) end
		for _, t in ipairs(V.CS:GetTagged("DemonGlow")) do dimTree(t) end
	end
	local function fullScan() -- catches every other glowing thing in the world (maze walls, lava, book, missiles, lightning...)
		for _, d in ipairs(workspace:GetDescendants()) do dimOne(d) end
	end

	-- LIDAR: tiny white dots appear where rays from you hit surfaces (walls, floors, big objects) and slowly float and fade out again
	local dots, dotIdx, sweep = {}, 0, 0
	local DOTS = 220
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local function makeMarks()
		for i = 1, DOTS do
			dots[i] = {part = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(.28, .28, .28), Color = WHITE, Material = Enum.Material.Neon,
				Transparency = 1, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, folder),
				born = -10, life = 1.4, base = 1, drift = Vector3.zero, hidden = true}
		end
	end
	local function scanSurfaces(dt)
		local root = ownRoot()
		if not root then return end
		local list = {folder, V.coinFolder}
		if lp.Character then table.insert(list, lp.Character) end
		rayParams.FilterDescendantsInstances = list
		sweep += dt * 6
		for i = 1, 12 do -- a sweeping fan of rays, like a lidar
			local az = sweep + i * (math.pi * 2 / 12) + math.random() * .3
			local pitch = (math.random() - .65) * 1.6
			local dir = Vector3.new(math.cos(az) * math.cos(pitch), math.sin(pitch), math.sin(az) * math.cos(pitch))
			local hit = workspace:Raycast(root.Position, dir * K.TB_FAR, rayParams)
			if hit then
				local d, base = hit.Distance, nil
				if d <= K.TB_NEAR then base = .1 elseif d >= 15 then base = .8 end -- close: bright, 15-25: faint, in between: nothing
				local model = hit.Instance:FindFirstAncestorOfClass("Model")
				if base and not (model and model:FindFirstChildOfClass("Humanoid")) then
					dotIdx = dotIdx % DOTS + 1
					local m = dots[dotIdx]
					m.part.Position = hit.Position + hit.Normal * .08
					m.born, m.base, m.hidden = os.clock(), base, false
					m.drift = Vector3.new(math.random() - .5, math.random() - .5, math.random() - .5) * .25
				end
			end
		end
	end
	local function updateMarks(t, dt)
		for _, m in ipairs(dots) do
			if not m.hidden then
				local k = (t - m.born) / m.life
				if k >= 1 then
					m.part.Transparency, m.hidden = 1, true
				else
					m.part.Transparency = m.base + (1 - m.base) * k * k
					m.part.Position += m.drift * dt
				end
			end
		end
	end

	-- name tags would give everything away, so they are hidden while you are blind (and restored afterwards)
	local tagRestore = {}
	local function hideTags()
		local function hum(h)
			if not tagRestore[h] then tagRestore[h] = {h.DisplayDistanceType} end
			h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			local model = h.Parent
			if model then
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BillboardGui") and d.Enabled then
						tagRestore[d] = {true}
						d.Enabled = false
					end
				end
			end
		end
		local mine = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if mine then hum(mine) end
		for h in pairs(humList) do if h.Parent then hum(h) end end
	end
	local function restoreTags()
		for inst, v in pairs(tagRestore) do
			if inst.Parent then
				if inst:IsA("Humanoid") then inst.DisplayDistanceType = v[1] else inst.Enabled = true end
			end
		end
		tagRestore = {}
	end

	local function track(d)
		if on then dimOne(d) end -- new glowing things are switched off the moment they appear
		if d:IsA("Humanoid") then
			if d.Parent ~= lp.Character then humList[d] = true end
		elseif d:IsA("Sound") then
			soundList[d] = true
		elseif d:IsA("Explosion") then
			task.defer(function() if on and d.Parent then pulse(d.Position, math.max(10, math.min(40, d.BlastRadius)), 6) end end)
		end
	end
	local function start()
		if on then return end
		on = true
		folder = new("Folder", {Name = "TotalBlindnessFx"}, workspace)
		makeMarks()
		V.Env.blackout(1.5)
		for _, d in ipairs(workspace:GetDescendants()) do track(d) end
		table.insert(conns, workspace.DescendantAdded:Connect(track))
		local a1, a2, a3, a4, a5, a6 = 0, 0, 0, 0, 0, 0
		local a7, a8 = 0, 0
		table.insert(conns, RS.Heartbeat:Connect(function(dt)
			budget = math.min(40, budget + dt * 40)
			a1, a2, a3, a4, a5, a6 = a1 + dt, a2 + dt, a3 + dt, a4 + dt, a5 + dt, a6 + dt
			a7, a8 = a7 + dt, a8 + dt
			if a7 >= .1 then a7 = 0 enforce() end
			if a8 >= 1 then a8 = 0 fullScan() end
			if a6 >= .25 then a6 = 0 glowTick() end
			updateBoxes(os.clock())
			updateMarks(os.clock(), dt)
			if a5 >= .08 then scanSurfaces(a5) a5 = 0 end
			if a1 >= .25 then a1 = 0 scan() end
			if a2 >= .1 then pollHumans(a2) a2 = 0 end
			if a3 >= .5 then a3 = 0 pollSounds(os.clock()) end
			if a4 >= 1 then a4 = 0 upkeep() hideTags() end
		end))
		upkeep()
		hideTags()
		fullScan()
		glowTick()
	end
	local function stop()
		if not on then return end
		on = false
		for _, c in ipairs(conns) do c:Disconnect() end
		conns = {}
		for _, h in ipairs(fxHighlights) do if h.Parent then h:Destroy() end end
		fxHighlights = {}
		for inst, rec in pairs(dimmed) do -- everything glows again
			if inst.Parent then
				if rec.mat then inst.Material, inst.Color = rec.mat, rec.color else inst.Enabled = true end
			end
		end
		dimmed = {}
		if folder then folder:Destroy() folder = nil end
		restoreTags()
		dots, dotIdx = {}, 0
		boxes, humList, soundList, humRec, lastSound = {}, {}, {}, {}, {}
		V.Env.black = false
		if V.inMaze then V.Env.maze(1.5) -- inside the maze the lighting goes back to the maze's own
		elseif not V.ritual.active then V.Env.restore(1.5) end -- (a running summon restores the sky itself when it ends)
	end
	V.TotalBlind = function(flag) if flag then start() else stop() end end
	V.TotalBlindOn = function() return on end
	V.TotalBlindDim = function() if on then fullScan() enforce() end end
end
initTotalBlind()
	local Book, lp = V.Book, V.lp
