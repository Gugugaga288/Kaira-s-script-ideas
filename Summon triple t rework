		if c and not o then makeOrb(f, c) o = V.orbs[f] end
		if o then
			o.angle += dt * K.ORBIT_SPEED * (o.held and K.HELD_SLOW or 1)
			if root then
				local a = o.angle + (idx - 1) * (math.pi * 2 / #K.CURSE_ORDER)
				o.part.Position = root.Position + Vector3.new(math.cos(a) * K.ORBIT_R, 1 + math.sin(o.angle * 1.7 + idx) * .6, math.sin(a) * K.ORBIT_R)
			end
			if o.held or os.clock() < o.showUntil then
				o.lbl.Visible = true
				if c.expires == math.huge then
					o.lbl.Text = string.format("%s%s\nonly dying cures it", c.name, c.stacks > 1 and (" x" .. c.stacks) or "")
				else
					local left = math.max(0, math.ceil(c.expires - os.clock()))
					o.lbl.Text = string.format("%s%s\n%d:%02d left", c.name, c.stacks > 1 and (" x" .. c.stacks) or "", math.floor(left / 60), left % 60)
				end
			else
				o.lbl.Visible = false
			end
		end
	end
end)
local function addCurse(def)
	local old = curseOn(def.family) -- picking the same curse again STACKS it and refreshes the 5 minutes
	local stacks = old and old.stacks + 1 or 1
	local greater = def.greater or (old and old.greater) or false
	V.curses[def.family] = {expires = os.clock() + K.CURSE_TIME, greater = greater, stacks = stacks, name = def.greater and def.name or ((old and old.greater) and old.name or def.name)}
	if def.family == "trip" then V.nextTrip = os.clock() + (greater and 5 or 9) / stacks end
end

