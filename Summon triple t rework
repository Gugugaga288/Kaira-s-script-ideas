--     NOT STARTED (user asked to hold): the angel following you, clicking it to ask a question, a timed car ride, and the
--     "become the orb" transformation idea. Those go in a later part.
--   V.inTrial = n while inside (blessings are off, souls do not spawn, like the maze). `busy` is true while inside.
K.SHRINE_MIN, K.SHRINE_MAX, K.SHRINE_RADIUS = 70, 120, 5.5 -- how far from you the shrine rises, and how close to its centre you must stand
K.TRIAL_BASE_Y, K.TRIAL_STEP_Y = 6000, 400                  -- trial n is built at height BASE + (n-1)*STEP (the maze is at 4200)
K.TRIALS = {
	{name = "Trial of Stone", line = "stone of the first gate awake and rise"},
	{name = "Trial of Bone",  line = "bone of the second gate break and bleed"},
	{name = "Trial of Flame", line = "flame of the last gate burn the skies"},
}
V.Trials = {done = {false, false, false}, builders = {}, rewards = {}, arenas = {}, active = nil, entering = false}
V.Shrine = {built = false, inCenter = false}
V.inTrial = nil
do
	local sCF -- the shrine's centre frame (nil until it has risen)
	local ROMAN = {"I", "II", "III"}
	local RUNE = Color3.fromRGB(255, 70, 30)
	local GOLD = Color3.fromRGB(255, 215, 110)
	local ANGEL = Color3.fromRGB(150, 146, 140)
	local angel, angelSet = {wings = {}, halo = {}}, {}   -- the stone angel orb's parts (lit up by trial progress)
	local shrineGone = false
	local SHRINE_TOP = 4.7 -- height of the centre plate above the ground

	function V.Shrine.isLine(n)
		for i, T in ipairs(K.TRIALS) do if T.line == n then return i end end
		return nil
	end
	function V.Shrine.onLine(n) -- called by onChat with the normalised text; returns true when the line was one of the trial lines
		local idx = V.Shrine.isLine(n)
		if not idx then return false end
		if V.Shrine.gone then toast("The shrine has already been broken.", 2.5) return true end
		if not V.Shrine.built then toast("The shrine has not risen yet.", 2.5) return true end
		if not V.Shrine.inCenter then toast("Stand in the center of the shrine, then say it.", 3) return true end
		task.spawn(V.Trials.enter, idx)
		return true
	end

	-- ===== trials =====
	local function flashTo(a, t) TS:Create(V.flashFrame, TweenInfo.new(t), {BackgroundTransparency = a}):Play() end

	function V.Trials.leave(survived)
		local ctx = V.Trials.active
		if not ctx then return end
		V.Trials.active = nil
		if ctx.conn then ctx.conn:Disconnect() end
		for _, f in ipairs(ctx.cleanups) do pcall(f) end
		if ctx.model then ctx.model:Destroy() end
		V.inTrial, busy = nil, false
		sync()
		if V.Env.black then V.Env.blackout(1) else V.Env.restore(1) end -- back to the normal (or Total Blindness) lighting
		local char = V.lp.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if survived and root and sCF then -- back on the shrine (if you died, the game respawns you as usual)
			root.CFrame = CFrame.new(sCF.Position + Vector3.new(0, SHRINE_TOP + 4, 0))
			root.AssemblyLinearVelocity = Vector3.zero
		end
		applyBuffs()
		flashTo(1, .6)
	end

	function V.Trials.complete(n)
		local ctx = V.Trials.active
		if not ctx or ctx.n ~= n or ctx.finished then return end
		ctx.finished = true
		V.Trials.done[n] = true
		toast(K.TRIALS[n].name .. " complete!", 4)
		local reward = V.Trials.rewards[n]
		if reward then
			local ok = pcall(reward, function() V.Trials.leave(true) end) -- the reward menu calls this when the player has chosen
			if not ok then V.Trials.leave(true) end
		else
			V.Trials.leave(true)
		end
	end

	-- ===== TRIAL I: the stone obby (remade) =====
-- A hellish hall: a sea of lava far below, scorched basalt walls and a roof. The course is three long lanes joined by two wraparound
-- half-spirals. Platforms are big, and every lane sits 60+ studs sideways and 30+ studs up from the one below it, so nothing can be skipped.
V.Trials.builders[1] = function(ctx)
	local model, frameFns, base = ctx.model, ctx.frameFns, ctx.origin
	local STONE, ROCK, EMBER, GOLD = Color3.fromRGB(100, 86, 80), Color3.fromRGB(40, 30, 28), Color3.fromRGB(255, 90, 30), Color3.fromRGB(255, 200, 80)
	local cursor, dirDeg, lastW = base + Vector3.new(-115, 0, -100), 0, 18
	local checkpoints = {}
	local minX, maxX, minZ, maxZ, maxY = math.huge, -math.huge, math.huge, -math.huge, -math.huge

	local function dirVec()
		local d = math.rad(dirDeg)
		return Vector3.new(math.cos(d), 0, math.sin(d))
	end
	local function place(top, w, opts) -- one platform whose top surface is at top.Y
		opts = opts or {}
		minX, maxX = math.min(minX, top.X - w / 2), math.max(maxX, top.X + w / 2)
		minZ, maxZ = math.min(minZ, top.Z - w / 2), math.max(maxZ, top.Z + w / 2)
		maxY = math.max(maxY, top.Y)
		if opts.checkpoint then
			opts.stripe = GOLD
			local up = top + Vector3.new(0, 3, 0)
			table.insert(checkpoints, {top = top, w = w, cf = CFrame.lookAt(up, up + dirVec()), hit = false})
		end
		new("Part", {Size = Vector3.new(w, 2, w), CFrame = CFrame.new(top - Vector3.new(0, 1, 0)), Color = STONE, Material = Enum.Material.Slate,
			Anchored = true, CanCollide = true, CanTouch = false}, model)
		local h = 8 + w * .5 -- the rock this island hangs from
		new("Part", {Size = Vector3.new(w * .55, h, w * .55), CFrame = CFrame.new(top - Vector3.new(0, 2 + h / 2, 0)), Color = ROCK, Material = Enum.Material.Basalt,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false}, model)
		if opts.stripe then
			new("Part", {Size = Vector3.new(w * .9, .2, w * .9), CFrame = CFrame.new(top + Vector3.new(0, .1, 0)), Color = opts.stripe,
				Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false}, model)
		end
		cursor, lastW = top, w
	end
	local function step(gap, dy, w, turn, opts) -- walk on from the last platform: gap = empty space between the two edges
		dirDeg = (dirDeg + (turn or 0)) % 360
		place(cursor + dirVec() * (gap + lastW / 2 + w / 2) + Vector3.new(0, dy, 0), w, opts)
	end
	local function halfLoop(R, n, rise, w, cpw, sg) -- wraparound: n platforms climb half a circle, you come out heading back the other way
		local d = dirVec()
		local side = Vector3.new(-d.Z, 0, d.X) * sg
		local C = cursor + side * R
		for k = 1, n do
			local th = k * math.pi / n
			local top = C + (-side * math.cos(th) + d * math.sin(th)) * R + Vector3.new(0, rise * k, 0) -- (C is at the height of the platform you started from)
			place(top, k == n and cpw or w, {checkpoint = k == n})
		end
		dirDeg = (dirDeg + 180) % 360
	end

	-- LANE 1 (heading +X): start pad, zigzag, stepping stones, a long jump
	place(cursor, 18, {checkpoint = true})
	step(6, 0, 13, 20); step(6, 0, 12, -40); step(6, 1, 12, 40); step(6, 0, 12, -40); step(6, 1, 12, 20)
	step(7, 0, 10, 0); step(7, 1, 9, 0); step(7, 0, 10, 0); step(7, 1, 9, 0)
	step(6, 0, 16, 0, {checkpoint = true})
	step(8, 0, 12, 0)
	step(6, 0, 14, 0, {checkpoint = true})
	halfLoop(34, 6, 5, 11, 14, 1)
	-- LANE 2 (heading -X): a climbing zigzag tower, narrow ledges, a long jump
	step(6, 3, 10, 30); step(6, 3, 10, -60); step(6, 3, 10, 60); step(6, 3, 10, -30)
	step(7, 0, 8, 0); step(7, 1, 8, 0); step(7, 1, 8, 0)
	step(6, 0, 16, 0, {checkpoint = true})
	step(8, 0, 11, 0); step(8, 1, 11, 0)
	step(6, 0, 14, 0, {checkpoint = true})
	halfLoop(34, 6, 5, 11, 14, -1)
	-- LANE 3 (heading +X): the hardest one, then the ember platform that opens the arena
	step(7, 2, 10, 35); step(7, 2, 10, -70); step(7, 2, 9, 70); step(7, 2, 9, -70); step(7, 2, 10, 35)
	step(7, 2, 8, 0); step(7, 2, 8, 0); step(8, 0, 9, 0)
	step(6, 0, 16, 0, {checkpoint = true})
	step(8, 3, 32, 0, {stripe = EMBER})
	local fin = cursor

	-- the hall around it: lava floor, four basalt walls, a roof
	local M = 60
	local x0, x1, z0, z1 = minX - M, maxX + M, minZ - M, maxZ + M
	local cx, cz, sx, sz = (x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0
	local LAVA_Y, ROOF_Y = base.Y - 50, maxY + 75
	local WALL_B = LAVA_Y - 10
	ctx.killY = LAVA_Y + 3
	local function solid(size, center, color, mat, collide)
		return new("Part", {Size = size, CFrame = CFrame.new(center), Color = color, Material = mat or Enum.Material.Basalt, Anchored = true,
			CanCollide = collide ~= false, CanTouch = false, CanQuery = collide ~= false}, model)
	end
	local lava = solid(Vector3.new(sx, 1, sz), Vector3.new(cx, LAVA_Y - .5, cz), Color3.fromRGB(255, 80, 20), Enum.Material.Neon, false)
	new("ParticleEmitter", {Rate = 40, Lifetime = NumberRange.new(2, 5), Speed = NumberRange.new(3, 10), SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(.8), LightEmission = 1, Color = ColorSequence.new(Color3.fromRGB(255, 170, 60))}, lava)
	local WH = ROOF_Y - WALL_B
	local WALL_COL = Color3.fromRGB(34, 26, 25)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x1 + 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(6, WH, sz + 12), Vector3.new(x0 - 3, WALL_B + WH / 2, cz), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z1 + 3), WALL_COL)
	solid(Vector3.new(sx + 12, WH, 6), Vector3.new(cx, WALL_B + WH / 2, z0 - 3), WALL_COL)
	solid(Vector3.new(sx + 12, 6, sz + 12), Vector3.new(cx, ROOF_Y + 3, cz), WALL_COL) -- the roof
	-- glowing ember bands where the walls meet the lava and the roof
	for _, y in ipairs({LAVA_Y + 1, ROOF_Y - .6}) do
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x1 - .3, y, cz), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(.6, 1.2, sz), Vector3.new(x0 + .3, y, cz), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z1 - .3), EMBER, Enum.Material.Neon, false)
		solid(Vector3.new(sx, 1.2, .6), Vector3.new(cx, y, z0 + .3), EMBER, Enum.Material.Neon, false)
	end
	for _ = 1, 26 do -- cracks of fire in the roof
		local len = math.random(14, 46)
		solid(math.random() < .5 and Vector3.new(len, .3, 2) or Vector3.new(2, .3, len),
			Vector3.new(x0 + math.random() * sx, ROOF_Y - .2, z0 + math.random() * sz), EMBER, Enum.Material.Neon, false)
	end
	for _ = 1, 60 do -- stalactites hanging from the roof
		local w, h = math.random(3, 8), math.random(10, 34)
		solid(Vector3.new(w, h, w), Vector3.new(x0 + math.random() * sx, ROOF_Y - h / 2, z0 + math.random() * sz), ROCK, Enum.Material.Basalt, false)
	end
	for _ = 1, 24 do -- rock spires standing in the lava
		local w, top = math.random(8, 20), LAVA_Y + math.random(2, 12)
		solid(Vector3.new(w, top - (LAVA_Y - 20), w), Vector3.new(x0 + math.random() * sx, (top + LAVA_Y - 20) / 2, z0 + math.random() * sz), ROCK, Enum.Material.Basalt, false)
	end

	table.insert(frameFns, function(dt, root)
		lava.Color = Color3.fromRGB(255, 70 + 40 * (.5 + .5 * math.sin(os.clock() * 1.3)), 20) -- the lava breathes
		local p = root.Position
		if p.Y < ctx.respawnCF.Position.Y - 70 then -- fell a long way: back to the last checkpoint at once
			root.CFrame = ctx.respawnCF
			root.AssemblyLinearVelocity = Vector3.zero
		end
		for _, cp in ipairs(checkpoints) do
			if not cp.hit and math.abs(p.Y - (cp.top.Y + 3)) < 4 and Vector3.new(p.X - cp.top.X, 0, p.Z - cp.top.Z).Magnitude < cp.w / 2 + .5 then
				cp.hit = true
				ctx.respawnCF = cp.cf
				toast("Checkpoint", 1.5)
			end
		end
	end)
	local fired = false
	table.insert(frameFns, function(dt, root) -- reaching the ember platform opens the arena
		if fired then return end
		local p = root.Position
		if math.abs(p.Y - (fin.Y + 3)) < 5 and Vector3.new(p.X - fin.X, 0, p.Z - fin.Z).Magnitude < 15 then
			fired = true
			toast("The stone gate opens...", 2.5)
			ctx.toArena()
		end
	end)
	local start = base + Vector3.new(-115, 3, -100)
	ctx.respawnCF = CFrame.lookAt(start, start + Vector3.new(1, 0, 0))
	return ctx.respawnCF
end

-- ===== TRIAL ARENAS (Part 3) =====
