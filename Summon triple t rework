local function afterimage(missile)
	local g = missile:Clone()
	for _, d in ipairs(g:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = .35
			TS:Create(d, TweenInfo.new(.7), {Transparency = 1}):Play()
		end
	end
	g.Parent = workspace
	Debris:AddItem(g, .8)
end

useMissile = function()
	if missileBusy then
		-- press again while steering to stop early
		if planning and os.clock() - planStart > .4 then stopRequested = true end
		return
	end
	if busy or not hasMissile then return end
	if os.clock() - V.lastMissile < eCd() then return end
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if gliding then stopGlide() end
	missileBusy = true
	local duration, speed, phase = eTime(), eSpeed(), ePhase()

	-- freeze everyone else (on your screen) and tint the world blue
	local frozen, tracks = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl ~= V.lp and pl.Character
		if c then
			local r = c:FindFirstChild("HumanoidRootPart")
			if r then table.insert(frozen, {root = r, cf = r.CFrame}) end
			local h = c:FindFirstChildOfClass("Humanoid")
			local an = h and h:FindFirstChildOfClass("Animator")
			if an then
				for _, t in ipairs(an:GetPlayingAnimationTracks()) do
					t:AdjustSpeed(0)
					table.insert(tracks, t)
				end
			end
		end
	end
	local freezeConn = RS.Heartbeat:Connect(function()
		for _, f in ipairs(frozen) do
			if f.root.Parent then
				f.root.CFrame = f.cf
				f.root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
	root.Anchored = true
	tint(true)

	-- planning phase: steer a ghost missile with the camera
	local missile = buildMissile()
	local dir = cam.CFrame.LookVector
	local pos = root.Position + Vector3.new(0, 1.5, 0)
	missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
	missile.Parent = workspace
	cam.CameraSubject = missile.PrimaryPart

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, V.coinFolder}
	local path = {}
	local elapsed, acc, lastGhost, hit = 0, 0, 0, false
	planning, stopRequested, planStart = true, false, os.clock()
	while elapsed < duration and not hit and not stopRequested do
		local dt = RS.Heartbeat:Wait()
		if hum.Health <= 0 then break end
		elapsed += dt
		acc += dt
		setFlight("PLAN", duration - elapsed)
		while acc >= K.STEP and not hit do
			acc -= K.STEP
			dir = dir:Lerp(cam.CFrame.LookVector, math.min(1, K.MISSILE_TURN * K.STEP)).Unit
			local move = dir * speed * K.STEP
			if not phase and workspace:Raycast(pos, move + dir * 1.5, params) then
				hit = true
			else
				pos += move
				table.insert(path, {pos = pos, dir = dir})
			end
		end
		missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
		if os.clock() - lastGhost > .04 then
			lastGhost = os.clock()
			afterimage(missile)
		end
	end

	-- back to normal
	planning = false
	missile:Destroy()
	cam.CameraSubject = hum
	freezeConn:Disconnect()
	for _, t in ipairs(tracks) do pcall(function() t:AdjustSpeed(1) end) end
	tint(false)

	-- your real body flies the exact path you planned
	if hum.Health > 0 and #path > 1 then
		hum.PlatformStand = true
		-- NOT anchored: the client owns an unanchored character, so its movement replicates and other players see it fly
		root.Anchored = false
		local parts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then table.insert(parts, d) end
		end
		local a0 = new("Attachment", {Position = Vector3.new(1.5, 0, 0)}, root)
		local a1 = new("Attachment", {Position = Vector3.new(-1.5, 0, 0)}, root)
		local trail = new("Trail", {
			Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(K.BLUE), LightEmission = 1,
			Lifetime = .8, Transparency = NumberSequence.new(.2, 1),
		}, root)
		local i, acc2 = 1, 0
		while i <= #path and hum.Health > 0 do
			acc2 += RS.Heartbeat:Wait()
			setFlight("FLY", (#path - i + 1) * K.STEP)
			for _, d in ipairs(parts) do d.CanCollide = false end
			while acc2 >= K.STEP and i <= #path do
				acc2 -= K.STEP
				local e = path[i]
				i += 1
				-- lie flat like a missile: head points along the flight direction
				root.CFrame = CFrame.lookAt(e.pos, e.pos + e.dir) * CFrame.Angles(-math.pi / 2, 0, 0)
				root.AssemblyLinearVelocity = e.dir * speed -- real velocity so it replicates smoothly
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
		local last = path[#path]
		local flat = Vector3.new(last.dir.X, 0, last.dir.Z)
		if flat.Magnitude < .01 then flat = Vector3.new(0, 0, -1) end
		local landing = last.pos + Vector3.new(0, 2, 0)
		if phase then
			-- if you ended inside something, pop up to the first free spot
			local op = OverlapParams.new()
			op.FilterDescendantsInstances = {char, V.coinFolder}
			for _ = 1, 60 do
				if #workspace:GetPartBoundsInBox(CFrame.new(landing), Vector3.new(4, 6, 4), op) == 0 then break end
				landing += Vector3.new(0, 4, 0)
			end
		end
		root.CFrame = CFrame.lookAt(landing, landing + flat)
		root.AssemblyLinearVelocity = Vector3.zero
		for _, d in ipairs(parts) do d.CanCollide = true end
		hum.PlatformStand = false
		task.delay(1, function() trail:Destroy() a0:Destroy() a1:Destroy() end)
	end
	V.flightLbl.Visible = false
	root.Anchored = false
	V.lastMissile = os.clock()
	missileBusy = false
end

