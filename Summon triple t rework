	for i, text in ipairs(K.RITUAL_LINES) do
		local l = new("TextLabel", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(POS[i].X, POS[i].Y), Size = UDim2.fromScale(.42, .13),
			BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(255, 40, 40), TextTransparency = 1,
