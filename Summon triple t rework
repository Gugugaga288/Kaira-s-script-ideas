-- Hold from idle (needs Drone Mount): sit on the drone and fly it with your own body, in Roblox's default sit pose.
-- (No Seat weld: your body is carried directly each frame, the same way the missile flight carries it.)
mountDrone = function()
	if mountedDrone or pilotingDrone or busy or missileBusy or gliding then return end
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if not ensureDrone() then return end
	if droneParked then -- mounting a parked drone: call it to you first
		droneParked = false
		clearPulseGui()
		if V.droneHighlight then V.droneHighlight.Enabled = false end
		droneCF = root.CFrame * K.DRONE_FOLLOW_OFFSET
	end
	if not droneCF then droneCF = root.CFrame * K.DRONE_FOLLOW_OFFSET end
	resetFace()
	local solidParams = RaycastParams.new()
	solidParams.FilterDescendantsInstances = {char, droneModel, V.coinFolder}

	local ok, err = pcall(function()
		V.mountCollideParts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then table.insert(V.mountCollideParts, d); d.CanCollide = false end
		end
		hum.WalkSpeed, hum.JumpPower = 0, 0
		hum.PlatformStand = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		root.Anchored = false
		hum.Sit = true -- Roblox's own sit state: the default Animate script plays the default sit animation (R6 or R15)
		-- belt and braces: also play the default sit animation directly, in case the game's Animate script doesn't
		local animate = char:FindFirstChild("Animate")
		local sitAnim = animate and animate:FindFirstChild("sit") and animate.sit:FindFirstChild("SitAnim")
		local id = sitAnim and sitAnim.AnimationId
			or ((hum.RigType == Enum.HumanoidRigType.R15) and "rbxassetid://2506281703" or "rbxassetid://178130996")
		local a = Instance.new("Animation")
		a.AnimationId = id
		local animator = hum:FindFirstChildOfClass("Animator")
		V.mountSitTrack = animator and animator:LoadAnimation(a) or hum:LoadAnimation(a)
		V.mountSitTrack.Priority = Enum.AnimationPriority.Action
		V.mountSitTrack.Looped = true
		V.mountSitTrack:Play()
	end)
	if not ok then
		warn("[TungSahur] Mount setup hit an error (continuing anyway): " .. tostring(err))
	end

	mountedDrone = true
	startDroneCam(1.5)
	droneBtn.Text = "DISMOUNT (E)"
	showFlightControls(true)

	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not mountedDrone then conn:Disconnect() return end
		local ok2, err2 = pcall(function()
			local mv = readFlightInput(hum)
			local pos = droneCF.Position
			local want = stepDroneVel(mv, K.DRONE_MOUNT_SPEED, dt) * dt
			local newPos = moveSolid(pos, want, solidParams) -- walls and floors stop you
			local vel = (newPos - pos) / math.max(dt, 1 / 240)
			if vel.Magnitude < V.dronePhys.vel.Magnitude - 1 then V.dronePhys.vel = vel end -- bumped into something: momentum stops
			pos = newPos
			if mv.Magnitude > .01 then turnToward(mv, dt) end
			droneCF = CFrame.lookAt(pos, pos + V.droneFace) -- level so you sit upright; the camera never turns it
			placeDrone(droneCF, dt)
			root.CFrame = droneCF * K.DRONE_SIT_OFFSET
			root.AssemblyLinearVelocity = vel
			root.AssemblyAngularVelocity = Vector3.zero
			hum.Sit = true
		end)
		if not ok2 then warn("[TungSahur] mount tick failed: " .. tostring(err2)) end
	end)
end

-- Tap while mounted: unmount. The drone resumes idle hover at your side on its own.
unmountDrone = function()
	if not mountedDrone then return end
	mountedDrone = false
	droneBtn.Text = "DRONE (E)"
	showFlightControls(false)
	local char = V.lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	stopDroneCam()
	if hum then getCam().CameraSubject = hum end
	if V.mountSitTrack then pcall(function() V.mountSitTrack:Stop() end); V.mountSitTrack = nil end
	if hum then
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
		hum.Sit = false
	end
	for _, d in ipairs(V.mountCollideParts) do
		if d and d.Parent then d.CanCollide = true end
	end
	V.mountCollideParts = {}
	if root then root.AssemblyLinearVelocity = Vector3.zero end
	if hum and hum.Health > 0 then applyBuffs() end
end

---------------------------------------------------------------- The Angel Orb ability (earned at the end of Trial III)
-- After the shrine is destroyed the angel orb floats to you, sinks into your torso (a golden ring stays there) and the ability is yours.
-- H / the ANGEL ORB button: you become the angel orb and fly anywhere. YOUR BODY STAYS EXACTLY WHERE IT WAS (so nobody sees you flying),
-- joined to the orb by a golden chain. Press H / RETURN and the orb flies back along the chain and joins your body again.
-- The boss fight (Trial III) uses the same system through V.Angel.start / stop / hold.
-- (its own function, so its ~30 local variables do not count against the main chunk's 200-local limit)
local function initAngelOrb()
	local ang = V.Angel
	local fx = new("Folder", {Name = "AngelFX"}, workspace) -- every angel orb / chain / spear part lives here (the grapple raycast ignores it)
	local GOLDA, WHITEA = Color3.fromRGB(255, 225, 140), Color3.fromRGB(255, 250, 235)
	local NFa = 7 -- feathers per wing: a smooth overlapping fan, longest at the top
	local function FLa(i) return 6.6 - (i - 1) * .5 end
	local function FAa(i) return 46 - (i - 1) * 13 end

	local rig = nil          -- {all, body, halo, feathers}
	local links = {}         -- the chain
	local camPart, stepConn, camConn
	local cfgA = {}
	local vel = Vector3.zero
	local dragging, ropeA1, ropeC, lockLen = false, nil, nil, 0 -- Chain of a Million Miles: chain locked, your body is dropped and dragged on the rope
	local wasBusy = false
	ang.holding, ang.returning, ang.scene = false, false, false

	local function ap(size, shape, color, parent)
		return new("Part", {Size = size, Shape = shape or Enum.PartType.Block, Color = color, Material = Enum.Material.Neon, Anchored = true,
			CanCollide = false, CanTouch = false, CanQuery = false}, parent or fx)
	end

	-- ---------- the angel orb's body: a white orb, a halo and two fans of feathers ----------
	local function buildRig()
		local r = {all = {}, halo = {}, feathers = {}}
		local function mk(size, shape, color)
			local p = ap(size, shape, color)
			table.insert(r.all, p)
			return p
		end
		r.body = mk(Vector3.new(3.4, 3.4, 3.4), Enum.PartType.Ball, WHITEA)
		new("PointLight", {Color = GOLDA, Range = 22, Brightness = 2, Shadows = false}, r.body)
		for k = 1, 36 do r.halo[k] = mk(Vector3.new(.6, .22, .22), nil, GOLDA) end
		for _, sx in ipairs({-1, 1}) do
			for i = 1, NFa do table.insert(r.feathers, {part = mk(Vector3.new(FLa(i), .3, 1.2), nil, Color3.fromRGB(255, 240, 200)), sx = sx, i = i}) end
		end
		return r
	end
	-- k = scale (1 = full size); the orb never tips over
	local function placeRig(rg, pos, t, flying, k)
		if not rg then return end
		k = math.max(k or 1, .08)
		local base = CFrame.new(pos)
		local ccam = workspace.CurrentCamera -- the orb turns with your camera: wings always spread to the left and right of the screen
		if ccam then
			local lk = ccam.CFrame.LookVector
			local flat = Vector3.new(lk.X, 0, lk.Z)
			if flat.Magnitude > .01 then base = CFrame.lookAt(pos, pos + flat) end
		end
		rg.body.Size = Vector3.new(3.4, 3.4, 3.4) * k
		rg.body.CFrame = base
		for i, seg in ipairs(rg.halo) do
			local a = (i - 1) / 36 * math.pi * 2
			seg.Size = Vector3.new(.6, .22, .22) * k
			seg.CFrame = base * CFrame.new(0, 3.2 * k, 0) * CFrame.new(math.cos(a) * 2.6 * k, 0, math.sin(a) * 2.6 * k) * CFrame.Angles(0, -a - math.pi / 2, 0)
		end
		local flap = flying and (.2 + math.sin(t * 6) * .3) or (.3 + math.sin(t * 3) * .12)
		for _, f in ipairs(rg.feathers) do
			local len = FLa(f.i) * k
			f.part.Size = Vector3.new(len, .3 * k, 1.2 * k)
			local pivot = base * CFrame.new(f.sx * 1.4 * k, .3 * k, 0) * CFrame.Angles(0, 0, f.sx * flap)
			f.part.CFrame = pivot * CFrame.Angles(0, 0, f.sx * math.rad(FAa(f.i))) * CFrame.new(f.sx * len / 2, 0, -(f.i - 1) * .12 * k)
		end
	end
	local function destroyRig(rg)
		if not rg then return end
		for _, p in ipairs(rg.all) do if p.Parent then p:Destroy() end end
		table.clear(rg.all)
	end
	-- exposed so the shrine scene and the boss fight can reuse the look
	ang.buildRig, ang.placeRig, ang.destroyRig = buildRig, placeRig, destroyRig

	-- ---------- the golden chain between the body and the orb (it stretches as far as it needs to) ----------
	local function updateChain(a, b, t, taut)
		local d = b - a
		local dist = d.Magnitude
		local n = math.clamp(math.floor(dist / 1.4), 4, 120)
		local linkLen = math.max(1.45, dist / n * 1.12) -- far away: the links get longer instead of the chain ending
		local sag = taut and 0 or math.min(dist * .1, 7)
		while #links < n do
			table.insert(links, ap(Vector3.new(.85, .3, 1.45), nil, GOLDA))
		end
		local function curve(f)
			return a + d * f - Vector3.new(0, math.sin(math.pi * f) * sag, 0) + Vector3.new(0, taut and 0 or math.sin(t * 3 + f * 9) * .12, 0)
		end
		for i = 1, #links do
			local l = links[i]
			if i <= n then
				local f = i / (n + 1)
				local p0, p1 = curve(f), curve(math.min(1, f + 1 / (n + 1)))
				local tan = p1 - p0
				if tan.Magnitude < .01 then tan = d.Magnitude > .01 and d.Unit or Vector3.new(0, 0, 1) end
				l.Transparency = 0
				l.Size = Vector3.new(.85, .3, linkLen)
				l.CFrame = CFrame.lookAt(p0, p0 + tan) * CFrame.Angles(0, 0, (i % 2 == 0) and 0 or math.pi / 2) -- links alternate, like a real chain
			else
				l.Transparency = 1
			end
		end
	end
	local function clearChain()
		for _, l in ipairs(links) do if l.Parent then l:Destroy() end end
		table.clear(links)
	end

	local function curChar()
		local c = V.lp.Character
		return c, c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
	end

	-- ---------- finishing / leaving the orb form ----------
	local function finishStop()
		local wasActive = ang.active
		dragging = false
		if ropeA1 then ropeA1:Destroy() ropeA1 = nil end
		ang.active, ang.returning, ang.holding = false, false, false
		if stepConn then stepConn:Disconnect() stepConn = nil end
		if camConn then camConn:Disconnect() camConn = nil end
		destroyRig(rig) rig = nil
		clearChain()
		if camPart then camPart:Destroy() camPart = nil end
		showFlightControls(false)
		local _, hum, root = curChar()
		if root then root.Anchored = false end
		if hum and hum.Health > 0 then
			hum.PlatformStand = false
			getCam().CameraSubject = hum
		end
		if wasActive then busy = wasBusy end
		ang.pos = nil
		pcall(applyBuffs)
	end

	function ang.stop(instant)
		if not ang.active then return end
		if instant or ang.returning then finishStop() return end
		ang.returning, ang.holding = true, true -- the orb reels itself back along the chain
	end
	function ang.hold(on) ang.holding = on and true or false end

	local function step(dt)
		if not ang.active then return end
		local _, hum, root = curChar()
		if not (hum and root and hum.Parent) or hum.Health <= 0 then finishStop() return end
		local now = os.clock()
		local bodyPos = root.Position + Vector3.new(0, .3, 0)
		if ang.returning then
			local to = bodyPos + Vector3.new(0, 1, 0) - ang.pos
			if to.Magnitude < 2.5 then
				local b = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = bodyPos, Color = WHITEA, Material = Enum.Material.Neon,
					Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .1}, workspace)
				TS:Create(b, TweenInfo.new(.5), {Size = Vector3.new(14, 14, 14), Transparency = 1}):Play()
				Debris:AddItem(b, .6)
				finishStop()
				return
			end
			ang.pos += to.Unit * math.min(to.Magnitude, 95 * dt)
			placeRig(rig, ang.pos, now, true, 1)
			updateChain(bodyPos, ang.pos, now)
			return
		end
		if ang.holding then
			vel = vel * math.max(0, 1 - 6 * dt)
		else
			local mv = readFlightInput(hum)
			if mv.Magnitude > 1 then mv = mv.Unit end
			vel = vel:Lerp(mv * (cfgA.speed or 55), math.min(1, dt * 8))
		end
		local np = ang.pos + vel * dt
		if dragging then -- chain locked: the orb flies freely and drags your body behind it
			local off = np - bodyPos
			if off.Magnitude > lockLen * 1.25 then -- body snagged on something: pull it along
				root.CFrame = CFrame.new(np - off.Unit * lockLen)
				root.AssemblyLinearVelocity = vel
			end
		elseif cfgA.maxRange then -- the chain only reaches so far
			local off = np - bodyPos
			if off.Magnitude > cfgA.maxRange then
				np = bodyPos + off.Unit * cfgA.maxRange
				vel *= .3
			end
		end
		if cfgA.clamp then np = cfgA.clamp(np) end
		ang.pos = np
		placeRig(rig, ang.pos, now, vel.Magnitude > 3, 1)
		updateChain(bodyPos, ang.pos, now)
		if cfgA.onTick then cfgA.onTick(dt, ang.pos) end
	end

	-- opts: speed, maxRange, clamp(pos)->pos, onTick(dt,pos), noReturn
	function ang.start(opts)
		if ang.active then return false end
		local _, hum, root = curChar()
		if not (hum and root) or hum.Health <= 0 then return false end
		cfgA = opts or {}
		ang.active, ang.returning, ang.holding = true, false, false
		dragging = false
		ang.noReturn = cfgA.noReturn and true or false
		wasBusy = busy
		busy = true
		hum.WalkSpeed, hum.JumpPower = 0, 0
		hum.PlatformStand = true
		root.Anchored = true -- THE BODY STAYS HERE
		root.AssemblyLinearVelocity = Vector3.zero
		ang.pos = root.Position + Vector3.new(0, 3, 0)
		vel = Vector3.zero
		rig = buildRig()
		placeRig(rig, ang.pos, os.clock(), false, .3)
		camPart = new("Part", {Name = "AngelCam", Size = Vector3.new(.5, .5, .5), Transparency = 1, Anchored = true, CanCollide = false,
			CanTouch = false, CanQuery = false, Position = ang.pos}, workspace)
		getCam().CameraSubject = camPart
		showFlightControls(true)
		local b = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = ang.pos, Color = WHITEA, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .1}, workspace)
		TS:Create(b, TweenInfo.new(.6), {Size = Vector3.new(20, 20, 20), Transparency = 1}):Play()
		Debris:AddItem(b, .7)
		stepConn = RS.Heartbeat:Connect(step)
		camConn = RS.RenderStepped:Connect(function()
			if camPart and ang.pos then camPart.Position = ang.pos end
			if rig and ang.pos then placeRig(rig, ang.pos, os.clock(), vel.Magnitude > 3, 1) end -- re-aim the wings every frame with the camera
		end)
		return true
	end

	-- ---------- Chain of a Million Miles: hold the button to LOCK the chain at its current length (the orb can fly on and drags your body), hold again to UNLOCK ----------
	function ang.toggleLock()
		if not ang.active or ang.returning or cfgA.noReturn or not rig then return end
		if V.lv.chain <= 0 then toast("Locking the chain needs the Chain of a Million Miles blessing.", 3) return end
		local _, hum, root = curChar()
		if not (hum and root) then return end
		if dragging then
			dragging = false
			if ropeC then ropeC:Destroy() ropeC = nil end
			if ropeA1 then ropeA1:Destroy() ropeA1 = nil end
			root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			root.CFrame = CFrame.new(root.Position) -- upright again
			root.Anchored = true
			toast("Chain unlocked.", 2)
		else
			lockLen = math.max(6, (ang.pos - root.Position).Magnitude)
			dragging = true
			root.Anchored = false
			hum.PlatformStand = true
			local a0 = new("Attachment", {}, rig.body)
			ropeA1 = new("Attachment", {}, root)
			ropeC = new("RopeConstraint", {Attachment0 = a0, Attachment1 = ropeA1, Length = lockLen, Visible = false, Restitution = 0}, rig.body)
			toast("Chain locked: fly on and your body is dragged behind you. Hold again to unlock.", 3.5)
		end
	end

	-- ---------- the golden circle on your chest (vertical, like a painted circle on the front of your torso) ----------
	local ringSegs, ringConn = {}, nil
	local RING_N = 28
	local function removeRing()
		if ringConn then ringConn:Disconnect() ringConn = nil end
		for _, s in ipairs(ringSegs) do if s.part.Parent then s.part:Destroy() end end
		table.clear(ringSegs)
	end
	local function attachRing(fadeIn)
		removeRing()
		local char = V.lp.Character
		local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
		if not torso then return end
		local sz = torso.Size
		local R = math.min(sz.X, sz.Y) * .4
		local yOff = sz.Y * .08
		local zFront = -(sz.Z / 2 + .06) -- the front face of the torso
		local chord = 2 * math.pi * R / RING_N * 1.3
		for k = 1, RING_N do
			local a = (k - 1) / RING_N * math.pi * 2
			local seg = new("Part", {Size = Vector3.new(.17, .1, chord), Color = GOLDA, Material = Enum.Material.Neon, Massless = true, CanCollide = false,
				CanTouch = false, CanQuery = false, Anchored = false, Transparency = fadeIn and 1 or .05}, char)
			local p = Vector3.new(math.cos(a) * R, math.sin(a) * R + yOff, zFront)
			local tan = Vector3.new(-math.sin(a), math.cos(a), 0)
			new("Weld", {Part0 = torso, Part1 = seg, C0 = CFrame.lookAt(p, p + tan, Vector3.new(0, 0, -1))}, seg)
			table.insert(ringSegs, {part = seg, a = a})
			if k == 1 then new("PointLight", {Color = GOLDA, Range = 7, Brightness = 1, Shadows = false}, seg) end
		end
		local t0 = os.clock()
		ringConn = RS.Heartbeat:Connect(function()
			local t = os.clock() - t0
			for _, s in ipairs(ringSegs) do
				if s.part.Parent and (fadeIn == nil or t > 1) then s.part.Transparency = .05 + .1 * (.5 + .5 * math.sin(t * 2 + s.a)) end
			end
		end)
		if fadeIn then
			for _, s in ipairs(ringSegs) do TS:Create(s.part, TweenInfo.new(1), {Transparency = .05}):Play() end
		end
	end
	ang.attachRing = attachRing
	V.lp.CharacterAdded:Connect(function(char) -- the ring comes back after you respawn
		if not ang.owned then return end
		task.wait(1.5)
		if V.lp.Character == char then attachRing() end
	end)

	-- ---------- a little dialogue box (tap to skip the typing, tap again to go on) ----------
	local function say(lines, onDone)
		local panel = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -150), Size = UDim2.fromOffset(460, 124),
			BackgroundColor3 = Color3.fromRGB(255, 250, 235), BackgroundTransparency = .05, ZIndex = 30}, V.gui)
		corner(panel, 12)
		new("UIStroke", {Color = Color3.fromRGB(255, 215, 110), Thickness = 2}, panel)
		local body = new("TextLabel", {Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 1, -34), BackgroundTransparency = 1, Text = "",
			TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Color3.fromRGB(60, 40, 30),
			Font = Enum.Font.GothamMedium, TextSize = 18, ZIndex = 31}, panel)
		new("TextLabel", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -6), Size = UDim2.fromOffset(120, 16), BackgroundTransparency = 1,
			Text = "tap to close", TextColor3 = Color3.fromRGB(190, 140, 40), Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 31}, panel)
		local clicker = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 32}, panel)
		local idx, shown, typing, finished = 0, 0, false, false
		local function show(i)
			idx, shown, typing = i, 0, true
			local my = i
			task.spawn(function()
				local s = lines[my]
				for n = 1, #s do
					if idx ~= my or not typing then return end
					shown = n
					body.Text = s:sub(1, n)
					task.wait(.03)
				end
				if idx == my then typing = false end
			end)
		end
		local function advance()
			if finished then return end
			finished = true -- one tap and the box is gone
			typing = false
			panel:Destroy()
			onDone()
		end
		clicker.MouseButton1Click:Connect(advance)
		show(1)
	end

	-- ---------- the scene: the angel orb floats to you and goes into your torso ----------
	local function sceneFree()
		local _, hum, root = curChar()
		if not (hum and root) or hum.Health <= 0 then return false end
		if busy or missileBusy or gliding or pilotingDrone or mountedDrone then return false end
		if V.inMaze or V.inTrial or V.punishing or V.ritual.active or V.Trials.entering or V.Trials.active then return false end
		return true
	end
	function ang.grantScene(fromPos)
		if ang.owned or ang.scene then return end
		ang.scene = true
		task.spawn(function()
			while not sceneFree() do -- wait until you are back in the open world
				task.wait(.5)
				if not V.lp.Parent then return end
			end
			local _, hum, root = curChar()
			local torso = root.Parent:FindFirstChild("UpperTorso") or root.Parent:FindFirstChild("Torso") or root
			local start = fromPos or (root.Position + Vector3.new(60, 40, 0))
			if (start - root.Position).Magnitude > 260 then -- keep the trip short
				local dir = (start - root.Position)
				dir = Vector3.new(dir.X, 0, dir.Z)
				dir = dir.Magnitude > .1 and dir.Unit or Vector3.new(1, 0, 0)
				start = root.Position + dir * 150 + Vector3.new(0, 45, 0)
			end
			local wasB = busy
			busy = true
			root.Anchored = true
			toast("A golden light drifts toward you...", 4)
			local orb = buildRig()
			local pos = start
			local t0, lastP = os.clock(), os.clock()
			local conn
			local phaseEnter = false
			local enterT = 0
			local function finishScene()
				if conn then conn:Disconnect() end
				destroyRig(orb)
				local b = new("Part", {Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = torso.Position, Color = WHITEA, Material = Enum.Material.Neon,
					Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .05}, workspace)
				TS:Create(b, TweenInfo.new(.9), {Size = Vector3.new(26, 26, 26), Transparency = 1}):Play()
				Debris:AddItem(b, 1)
				playSound(K.SOUNDS.soul)
				attachRing(true) -- the golden ring appears on your torso
				task.delay(1.1, function()
					say({
						"You feel your soul shining with power.\n\nABILITY GAINED: ANGEL ORB",
					}, function()
						ang.owned = true
						ang.scene = false
						local _, h2, r2 = curChar()
						if r2 then r2.Anchored = false end
						busy = wasB
						pcall(applyBuffs)
						toast("Angel Orb unlocked", 4)
					end)
				end)
			end
			conn = RS.Heartbeat:Connect(function(dt)
				local _, h2, r2 = curChar()
				if not (h2 and r2) or h2.Health <= 0 then -- you died during the scene: it plays again later
					conn:Disconnect()
					destroyRig(orb)
					busy = wasB
					ang.scene = false
					task.delay(3, function() ang.grantScene() end)
					return
				end
				local now = os.clock()
				local target = torso.Position
				if not phaseEnter then
					local to = target - pos
					local dist = to.Magnitude
					local speed = math.clamp(dist * .7, 14, 44)
					local sway = Vector3.new(math.sin(now * 2) * .5, math.cos(now * 2.6) * .5, math.cos(now * 1.7) * .5)
					pos += to.Unit * math.min(dist, speed * dt) + sway * dt * 4
					if now - t0 > 16 and dist > 8 then pos = target + (pos - target).Unit * 8 end -- never take forever
					placeRig(orb, pos, now, true, 1)
					if dist < 3.2 then phaseEnter, enterT = true, now end
				else
					local k = math.clamp((now - enterT) / .9, 0, 1)
					local e = k * k * (3 - 2 * k)
					pos = pos:Lerp(target, e)
					placeRig(orb, pos, now, false, 1 - .85 * e)
					if k >= 1 then finishScene() end
				end
			end)
		end)
	end

	-- ---------- hold to aim, let go to fire the spear chain (grapple) ----------
	K.ANGEL_RANGE = 400                                     -- how far the orb can fly from your body (the Chain of a Million Miles buff removes the limit by dragging your body along)
	K.LOCK_HOLD = .3                                     -- seconds you must hold the button to lock/unlock the chain (a quick tap = start flight / return)
	-- ---------- the button + the key ----------
	ang.btn = new("TextButton", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, .5, 70), Size = UDim2.fromOffset(130, 52),
		BackgroundColor3 = Color3.fromRGB(255, 220, 120), TextColor3 = Color3.fromRGB(70, 40, 10), Font = Enum.Font.GothamBlack, TextSize = 14,
		Text = "ANGEL ORB (H)", Visible = false}, V.gui)
	corner(ang.btn, 10)
	local function canUse()
		if not ang.owned or ang.active or ang.scene then return false end
		local _, hum, root = curChar()
		if not (hum and root) or hum.Health <= 0 then return false end
		if busy or missileBusy or gliding or pilotingDrone or mountedDrone then return false end
		if V.inMaze or V.inTrial or V.punishing or V.ritual.active or V.Trials.entering then return false end
		return true
	end
	local function toggle()
		if ang.active then
			if not ang.noReturn then ang.stop(false) end
		elseif canUse() then
			ang.start({speed = 55, maxRange = K.ANGEL_RANGE})
		end
	end
	-- quick tap = become the orb (or return). Hold (while flying) = lock / unlock the chain.
	local pressing, holdFired, pressId = false, false, 0
	local function pressBegin()
		pressing, holdFired = true, false
		pressId += 1
		local my = pressId
		task.delay(K.LOCK_HOLD, function()
			if pressing and pressId == my and ang.active and not ang.returning and not ang.noReturn then
				holdFired = true
				ang.toggleLock()
			end
		end)
	end
	local function pressEnd()
		if not pressing then return end
		pressing = false
		if not holdFired then toggle() end
	end
	local heldInput = nil
	ang.btn.InputBegan:Connect(function(input)
		if input.UserInputState == Enum.UserInputState.Begin and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
			heldInput = input
			pressBegin()
		end
	end)
	UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.H then pressBegin() end
	end)
	UIS.InputEnded:Connect(function(input)
		if input == heldInput then heldInput = nil pressEnd() -- only the finger that is on the button counts (the other finger can keep turning the camera)
		elseif input.KeyCode == Enum.KeyCode.H then pressEnd() end
	end)
	RS.Heartbeat:Connect(function()
		local show = ang.owned and ((ang.active and not ang.noReturn and not ang.returning) or canUse())
		ang.btn.Visible = show and true or false
		ang.btn.Text = ang.active and "RETURN (H)" or "ANGEL ORB (H)"
	end)
end
