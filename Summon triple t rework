-- chaotic curses: every 2-3 seconds a new random level. {multiplier, weight}
V.chaos = {speedMul = 1, jumpMul = 1, nextSpeed = 0, nextJump = 0}
K.SPEED_STEPS = {{0, 6}, {.1, 14}, {.55, 22}, {1, 20}, {1.6, 20}, {3.4, 18}} -- frozen / turtle / a bit slow / normal / a bit fast / The Flash
K.JUMP_STEPS = {{0, 6}, {.2, 14}, {.65, 22}, {1, 20}, {1.6, 20}, {2.8, 18}}  -- none / tiny / lower / normal / higher / enormous
local function pickStep(steps, greater)
	local total = 0
	for _, s in ipairs(steps) do total += s[2] end
	local r, mul = math.random() * total, 1
	for _, s in ipairs(steps) do
		r -= s[2]
		if r <= 0 then mul = s[1] break end
	end
	if greater then mul = mul > 1 and mul * 1.4 or (mul > 0 and mul * .6 or 0) end -- Greater = more extreme
	return mul
end

local function applyBuffs()
	local hum = V.lp.Character and V.lp.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local speed = (V.on.speed and not (V.inMaze or V.inTrial)) and (K.BASE_SPEED + speedBonus) or K.BASE_SPEED -- no blessings inside the maze
	local jump = (V.on.jump and not (V.inMaze or V.inTrial)) and (K.BASE_JUMP + jumpBonus) or K.BASE_JUMP
	if not V.punishing then
		local h, u = curseOn("heavy"), curseOn("unsteady")
		if h then speed = speed * V.chaos.speedMul end -- can be 0 (frozen) up to The Flash
		if u then jump = jump * V.chaos.jumpMul end   -- can be 0 up to enormous
	end
	hum.UseJumpPower = true
	hum.WalkSpeed = speed
	hum.JumpPower = jump
end

RS.Heartbeat:Connect(function()
	local now = os.clock()
	local changed = false
	local h, u = curseOn("heavy"), curseOn("unsteady")
	if h then
		if now >= V.chaos.nextSpeed then
			V.chaos.speedMul = pickStep(K.SPEED_STEPS, h.greater)
			V.chaos.nextSpeed = now + (V.chaos.speedMul == 0 and 1.2 or 2 + math.random()) / (1 + .25 * (h.stacks - 1)) -- frozen only for a moment
			changed = true
		end
	elseif V.chaos.speedMul ~= 1 then
