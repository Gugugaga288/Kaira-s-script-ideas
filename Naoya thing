local function buildGhosts()
	character.Archivable = true
	local clone = character:Clone()
	if not clone then return end

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Humanoid") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Decal")
			or d:IsA("Texture") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic")
			or d:IsA("BodyColors") or d:IsA("Sound") or d:IsA("ParticleEmitter")
			or d:IsA("BillboardGui") or d:IsA("Tool") or d:IsA("Highlight") then
			pcall(function() d:Destroy() end)
		end
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			local isRoot = d.Name == "HumanoidRootPart"
			d.Anchored = isRoot
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			d.CastShadow = false
			d.Material = Enum.Material.Neon
			d.Color = CFG.GHOST_COLOR
			d.Transparency = isRoot and 1 or CFG.GHOST_TRANSPARENCY
			if d:IsA("MeshPart") then d.TextureID = "" end
		elseif d:IsA("SpecialMesh") then
			d.TextureId = ""
		end
	end
	local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
	if not cloneRoot then clone:Destroy() return end
	clone.PrimaryPart = cloneRoot
	ghostTemplate = clone

	local realMotors = {}
	for _, m in ipairs(character:GetDescendants()) do
		if m:IsA("Motor6D") then realMotors[m.Name] = m end
	end

	for i = 1, CFG.GHOST_COUNT do
		local model = ghostTemplate:Clone()
		model.Name = "Projection" .. i
		local pairsList = {}
		for _, m in ipairs(model:GetDescendants()) do
			if m:IsA("Motor6D") and realMotors[m.Name] then
				table.insert(pairsList, { real = realMotors[m.Name], ghost = m })
			end
		end
		table.insert(ghosts, { model = model, pairs = pairsList, active = false, arrive = 0, pos = Vector3.zero, dir = Vector3.zero })
	end
end

local function hideGhosts()
	for _, g in ipairs(ghosts) do
		g.active = false
		g.model.Parent = nil
	end
end

local function spawnGhost(pos, dir, arrive)
	local g
	for _, x in ipairs(ghosts) do
		if not x.active then g = x break end
	end
	if not g then return end
	g.model.Parent = ghostFolder
	g.model:PivotTo(CFrame.lookAt(pos, pos + dir))
	for _, p in ipairs(g.pairs) do p.ghost.Transform = p.real.Transform end
	g.active, g.arrive, g.pos, g.dir = true, arrive, pos, dir
end

-- Simulates the same physics as the main loop for `t` seconds, so the frame
-- sits where you will REALLY be (on the curve), not on a straight line.
local function predict(t)
	local pos, dir, spd, hd = root.Position, velDir, speed, heading
	local steps = math.max(1, math.ceil(t / 0.05))
	local h = t / steps
	for _ = 1, steps do
		local turnRate = CFG.TURN_BASE / (1 + spd / CFG.GRIP)
		local ang = angleBetween(dir, hd)
		if ang > 0.001 then
			local alpha = math.clamp(turnRate * h / ang, 0, 1)
			local nd = dir:Lerp(hd, alpha)
			if nd.Magnitude < 0.001 then nd = Vector3.new(-dir.Z, 0, dir.X) end
			dir = nd.Unit
		end
		local drift = angleBetween(dir, hd)
		if drift > CFG.DRIFT_START then
			spd -= drift * spd * CFG.DRIFT_DRAG * h
		else
			spd += (CFG.ACCEL_BASE + spd * CFG.ACCEL_SCALE) * h
		end
		spd = math.clamp(spd, CFG.MIN_SPEED, CFG.MAX_SPEED)
		pos += dir * spd * h
	end
	return pos, dir
end

