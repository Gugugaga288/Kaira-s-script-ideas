local function pinkPulse(d)
	if not tintEffect then return end
	TweenService:Create(tintEffect, TweenInfo.new(d * 0.3), { TintColor = CFG.TINT_COLOR }):Play()
	task.delay(d * 0.3, function()
		if tintEffect then
			TweenService:Create(tintEffect, TweenInfo.new(d * 0.7), { TintColor = Color3.new(1, 1, 1) }):Play()
		end
	end)
end

local function tripleTint()
	for i = 0, CFG.TINT_PULSES - 1 do
		task.delay(i * 0.35, function() pinkPulse(0.3) end)
	end
end

------------------------------------------------------------------
-- WALL BREAK (pink box closes in, faster each hit, then the wall breaks)
------------------------------------------------------------------
local function wallVolume(part)
	return part.Size.X * part.Size.Y * part.Size.Z
end

-- small things take fewer hits
local function hitsFor(part)
	local v = wallVolume(part)
	if v < 8 then return 1 end
	if v < 40 then return 2 end
	if v < 200 then return 3 end
	return 5
end

local function shatterWall(part, box)
	if box then box:Destroy() end
	playShatterSound()
	tripleTint()

	local origCF, origSize = part.CFrame, part.Size
	local color, material = part.Color, part.Material
	local origTrans, origCollide, origQuery = part.Transparency, part.CanCollide, part.CanQuery

	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1

	-- break into pieces, scaled by how big the wall is
	local count = math.clamp(math.floor(wallVolume(part) / 12), 6, 16)
	for _ = 1, count do
		local px = (math.random() - 0.5) * origSize.X
		local py = (math.random() - 0.5) * origSize.Y
		local pz = (math.random() - 0.5) * origSize.Z
		local piece = Instance.new("Part")
		piece.Size = Vector3.new(
			math.max(0.4, origSize.X * (0.15 + math.random() * 0.25)),
			math.max(0.4, origSize.Y * (0.15 + math.random() * 0.25)),
			math.max(0.4, origSize.Z * (0.15 + math.random() * 0.25)))
		piece.CFrame = origCF * CFrame.new(px, py, pz)
			* CFrame.Angles(math.random() * 2, math.random() * 2, math.random() * 2)
		piece.Color = color
		piece.Material = material
		piece.CanCollide = false
		piece.CanQuery = false
		piece.CanTouch = false
		piece.CastShadow = false
		piece.Anchored = false
		piece.Parent = ghostFolder
		local outward = (piece.Position - origCF.Position)
		piece.AssemblyLinearVelocity = outward.Unit * (10 + math.random() * 12) + Vector3.new(0, 8 + math.random() * 8, 0)
		piece.AssemblyAngularVelocity = Vector3.new(
			(math.random() - 0.5) * 16, (math.random() - 0.5) * 16, (math.random() - 0.5) * 16)
		TweenService:Create(piece, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Transparency = 1 }):Play()
		Debris:AddItem(piece, 1.5)
	end

	-- fade back in after RESPAWN_TIME seconds
	task.delay(CFG.RESPAWN_TIME, function()
		if part.Parent then
			TweenService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Transparency = origTrans }):Play()
		end
		task.delay(0.8, function()
			if part.Parent then
				part.CanCollide = origCollide
				part.CanQuery = origQuery
			end
			smashed[part] = nil
		end)
	end)
end

local function smashWall(part)
	if smashed[part] then return end
	smashed[part] = true
	smashBusy += 1

	task.spawn(function()
		local hits = hitsFor(part)
		local box = Instance.new("Part")
		box.Name = "NaoyaBreakBox"
		box.Anchored = false
		box.Massless = true
		box.CanCollide = false
		box.CanQuery = false
		box.CanTouch = false
		box.CastShadow = false
		box.Material = Enum.Material.Neon
		box.Color = CFG.SMASH_COLOR
		box.Transparency = 0.25
		local sel = Instance.new("SelectionBox")
		sel.Color3 = CFG.SMASH_OUTLINE
		sel.LineThickness = 0.08
		sel.SurfaceTransparency = 1
		sel.Adornee = box
		sel.Parent = box
		box.Parent = ghostFolder

		-- the box sits on the object being broken
		box.CFrame = part.CFrame
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = box
		weld.Parent = box

		-- full leg kick animation while the wall is being broken
		local kickTrack
		pcall(function()
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://" .. CFG.KICK_ANIM_ID
			kickTrack = animator:LoadAnimation(a)
			kickTrack.Priority = Enum.AnimationPriority.Action4
			kickTrack.Looped = false
			kickTrack:Play(0.05)
		end)

		local dur = CFG.SMASH_FIRST
		for _ = 1, hits do
			if not part.Parent then break end
			-- box starts big and closes in onto the wall
			box.Size = part.Size * 1.6
			local tw = TweenService:Create(box,
				TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Size = part.Size * 1.02 })
			tw:Play()
			tw.Completed:Wait()
			playImpactSound(2 + math.random())
			hitStopUntil = os.clock() + CFG.HIT_STOP
			pinkPulse(0.15)
			dur *= CFG.SMASH_SPEEDUP
		end

		if kickTrack then kickTrack:Stop(0.1) end
		if part.Parent then
			shatterWall(part, box)
		else
			box:Destroy()
		end
		smashBusy = math.max(0, smashBusy - 1)
		if active then
			speed = math.min(CFG.MAX_SPEED, speed + CFG.BREAK_BOOST)
		end
	end)
end

------------------------------------------------------------------
-- ACTIVATE / DEACTIVATE
------------------------------------------------------------------
local function deactivate()
	active = false
	if hum and hum.Parent then
		hum.WalkSpeed = baseWalkSpeed
		hum.AutoRotate = true
		hum:Move(Vector3.zero, false)
	end
	if runTrack and runTrack.IsPlaying then runTrack:Stop(0.2) end
	hideGhosts()
	if dust then dust.Rate = 0 end
	local cam = Workspace.CurrentCamera
	if cam then cam.FieldOfView = baseFov end
end

local function activate()
	local cam = Workspace.CurrentCamera
	active = true
	speed = CFG.MIN_SPEED
	baseWalkSpeed = hum.WalkSpeed
	baseFov = cam and cam.FieldOfView or 70
	local look = flat(root.CFrame.LookVector)
	velDir = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	heading = velDir
	driftSmooth, offCourse, spawnTimer = 0, 0, 0
	hum.AutoRotate = false
end

local function toggle()
	if frozen or not hum or hum.Health <= 0 then return end
	if os.clock() < cooldownEnd then return end
	if active then deactivate() else activate() end
end

