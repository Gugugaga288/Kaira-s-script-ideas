local function buildFrame(cam)
	local W, H = CFG.FRAME_W, CFG.FRAME_H
	local center = root.Position
	local camPos = cam and cam.CFrame.Position or (center - root.CFrame.LookVector * 10)
	local toCam = flat(camPos - center)
	toCam = toCam.Magnitude > 0.01 and toCam.Unit or -flat(root.CFrame.LookVector)

	local panePos = center + toCam * CFG.FRAME_OFFSET + Vector3.new(0, 1.2, 0)
	local paneCF = CFrame.lookAt(panePos, panePos + toCam)

	local model = Instance.new("Model")
	model.Name = "NaoyaFrame"

	local function mk(name, size, offset)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = paneCF * CFrame.new(offset)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = model
		return p
	end

	local glass = mk("Glass", Vector3.new(W, H, 0.25), Vector3.zero)
	glass.Material = Enum.Material.Glass
	glass.Color = Color3.fromRGB(190, 225, 255)
	glass.Transparency = 0.6
	glass.Reflectance = 0.15

	local t = 0.45
	for _, spec in ipairs({
		{ "Top",    Vector3.new(W + t, t, 0.5), Vector3.new(0,  H / 2, 0) },
		{ "Bottom", Vector3.new(W + t, t, 0.5), Vector3.new(0, -H / 2, 0) },
		{ "Left",   Vector3.new(t, H, 0.5),     Vector3.new(-W / 2, 0, 0) },
		{ "Right",  Vector3.new(t, H, 0.5),     Vector3.new( W / 2, 0, 0) },
	}) do
		local b = mk(spec[1], spec[2], spec[3])
		b.Material = Enum.Material.Neon
		b.Color = CFG.FRAME_COLOR
		b.Transparency = 0.1
	end

	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.Parent = glass

	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundTransparency = 1
	vp.ImageTransparency = 0.12
	vp.Ambient = Color3.fromRGB(190, 190, 190)
	vp.LightColor = Color3.new(1, 1, 1)
	vp.Parent = sg

	pcall(function()
		character.Archivable = true
		local snap = character:Clone()
		for _, d in ipairs(snap:GetDescendants()) do
			if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("ParticleEmitter")
				or d:IsA("BillboardGui") or d:IsA("Tool") or d:IsA("Highlight") then
				pcall(function() d:Destroy() end)
			end
		end
		local real = {}
		for _, m in ipairs(character:GetDescendants()) do
			if m:IsA("Motor6D") then real[m.Name] = m end
		end
		for _, m in ipairs(snap:GetDescendants()) do
			if m:IsA("Motor6D") and real[m.Name] then m.Transform = real[m.Name].Transform end
		end
		local sh = snap:FindFirstChildOfClass("Humanoid")
		if sh then sh.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
		snap.Parent = vp

		local vcam = Instance.new("Camera")
		vcam.FieldOfView = 40
		vcam.CFrame = CFrame.lookAt(center + toCam * 10 + Vector3.new(0, 0.7, 0), center + Vector3.new(0, 0.3, 0))
		vcam.Parent = vp
		vp.CurrentCamera = vcam
	end)

	model.PrimaryPart = glass
	model.Parent = ghostFolder
	freezeFrame, freezeGlass, freezeGui = model, glass, sg
end

local function endFreeze(withShatter)
	frozen = false
	if withShatter and freezeGlass and freezeGlass.Parent then
		pcall(shatterGlass, freezeGlass.CFrame)
	end
	if freezeHighlight then freezeHighlight:Destroy() freezeHighlight = nil end
	if freezeFrame then freezeFrame:Destroy() freezeFrame = nil end
	freezeGlass, freezeGui = nil, nil
	if root then root.Anchored = false end
	if hum then
		hum.WalkSpeed = baseWalkSpeed
		hum.AutoRotate = true
	end
	if animator then
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
	end
	if animateScript then animateScript.Disabled = false end
end

local function startFreeze()
	frozen, active = true, false
	local now = os.clock()
	freezeEnd = now + CFG.FREEZE_TIME
	cooldownEnd = now + CFG.COOLDOWN
	cracked = false

	hum:Move(Vector3.zero, false)
	hum.WalkSpeed = 0
	hideGhosts()
	if dust then dust.Rate = 0 end
	local cam = Workspace.CurrentCamera
	if cam then cam.FieldOfView = baseFov end

	buildFrame(cam)

	if animateScript then animateScript.Disabled = true end
	for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:AdjustSpeed(0) end
	root.Anchored = true

	freezeHighlight = Instance.new("Highlight")
	freezeHighlight.Adornee = character
	freezeHighlight.FillColor = Color3.fromRGB(255, 200, 60)
	freezeHighlight.OutlineColor = Color3.new(1, 1, 1)
	freezeHighlight.FillTransparency = 0.55
	freezeHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	freezeHighlight.Parent = character

	playFreezeSound()
end

