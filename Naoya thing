------------------------------------------------------------------
-- MAIN LOOP
------------------------------------------------------------------
local function isPlayerPart(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function step(dt)
	local now = os.clock()
	updateGui(now)
	if not (hum and hum.Parent and root and root.Parent) or hum.Health <= 0 then return end

	if frozen then
		if freezeHighlight then
			local on = math.floor(now * 24) % 2 == 0
			freezeHighlight.FillColor = on and Color3.fromRGB(255, 200, 60) or Color3.new(0, 0, 0)
		end
		if not cracked and freezeEnd - now < 0.7 then
			cracked = true
			addCracks()
		end
		if now >= freezeEnd then endFreeze(true) end
		return
	end
	if not active then return end

	-- hit-stop: body stops dead on a wall hit, then resumes
	if now < hitStopUntil or smashBusy > 0 then
		hum:Move(Vector3.zero, false)
		hum.WalkSpeed = 0
		return
	end

	local cam = Workspace.CurrentCamera
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	if grounded then groundOffset = math.max(1, hum.HipHeight + root.Size.Y / 2) end

	-- steering input (camera relative), smoothed + deadzone
	local input = flat(hum.MoveDirection)
	if input.Magnitude > 0.1 then
		local target = input.Unit
		if angleBetween(heading, target) > CFG.STICK_DEADZONE then
			local nh = heading:Lerp(target, math.min(1, dt * CFG.STEER_SMOOTH))
			if nh.Magnitude < 0.001 then nh = Vector3.new(-heading.Z, 0, heading.X) end
			heading = nh.Unit
		end
	end

	-- momentum turns slowly at high speed = drift
	local turnRate = CFG.TURN_BASE / (1 + speed / CFG.GRIP)
	local ang = angleBetween(velDir, heading)
	if ang > 0.001 then
		local alpha = math.clamp(turnRate * dt / ang, 0, 1)
		local nd = velDir:Lerp(heading, alpha)
		if nd.Magnitude < 0.001 then nd = Vector3.new(-velDir.Z, 0, velDir.X) end
		velDir = nd.Unit
	end
	local drift = angleBetween(velDir, heading)
	driftSmooth += (drift - driftSmooth) * math.min(1, dt * 8)

	-- speed
	local accel = CFG.ACCEL_BASE + speed * CFG.ACCEL_SCALE
	if drift > CFG.DRIFT_START then
		speed -= drift * speed * CFG.DRIFT_DRAG * dt
		accel = 0
	else
		speed += accel * dt
	end
	speed -= offCourse * CFG.OFF_BRAKE * dt
	offCourse *= (1 - math.min(1, dt * 1.5))
	speed = math.clamp(speed, CFG.MIN_SPEED, CFG.MAX_SPEED)

	-- apply movement
	hum.WalkSpeed = speed
	hum:Move(velDir, false)
	local look = flat(root.CFrame.LookVector)
	local newLook = look:Lerp(heading, math.min(1, dt * 12))
	if newLook.Magnitude > 0.01 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + newLook.Unit)
	end

	-- run animation
	if runTrack then
		if grounded and speed > 20 then
			if not runTrack.IsPlaying then runTrack:Play(0.15) end
			runTrack:AdjustSpeed(math.clamp(speed / CFG.RUN_ANIM_REF, 0.8, 2.2))
		elseif runTrack.IsPlaying then
			runTrack:Stop(0.15)
		end
	end

	-- wall check: something solid right in front of you at speed -> smash it
	if speed > CFG.SMASH_MIN_SPEED then
		local reach = speed * dt + 2.5
		local hit = Workspace:Raycast(root.Position, velDir * reach, rayParams)
		if hit and hit.Instance:IsA("BasePart") and not hit.Instance:IsA("Terrain")
			and hit.Instance.CanCollide and not smashed[hit.Instance] and not isPlayerPart(hit.Instance) then
			smashWall(hit.Instance)
		end
	end

	-- prediction frames (closer, fewer, snap in front of you)
	spawnTimer += dt
	if speed >= CFG.GHOST_MIN_SPEED and spawnTimer >= CFG.GHOST_INTERVAL then
		spawnTimer = 0
		local t = CFG.GHOST_LEAD
		local p, d = predict(t)
		local hitDown = Workspace:Raycast(p + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rayParams)
		local y = hitDown and (hitDown.Position.Y + groundOffset) or root.Position.Y
		spawnGhost(Vector3.new(p.X, y, p.Z), d, now + t)
	end

	for _, g in ipairs(ghosts) do
		if g.active and now >= g.arrive then
			g.active = false
			g.model.Parent = nil
			-- while you are busy breaking a wall you are stuck, so don't punish that
			if smashBusy == 0 then
				local d = flat(root.Position - g.pos)
				local lon = d:Dot(g.dir)
				local lat = (d - g.dir * lon).Magnitude
				local err = math.sqrt(lat * lat + (lon * 0.5) ^ 2)
				err = math.max(0, err - CFG.ERROR_TOLERANCE)
				offCourse = math.max(offCourse, err)
				-- missing a frame now gives you a speed boost instead of freezing you
				if err > CFG.FREEZE_ERROR then
					speed = math.min(CFG.MAX_SPEED, speed + CFG.FRAME_MISS_BOOST)
					offCourse = 0
				end
			end
		end
	end

	-- dust trail
	local s = math.clamp(speed / CFG.MAX_SPEED, 0, 1)
	local turn = math.clamp(driftSmooth / 1.2, 0, 1)
	if dust and grounded and speed > 25 then
		local size = (1.2 + 3.5 * s) * (1 + turn * 1.2)
		dust.Rate = 20 + 140 * s * (1 + turn * 1.5)
		dust.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size * 0.5),
			NumberSequenceKeypoint.new(1, size * 2),
		})
		dust.Lifetime = NumberRange.new(0.5 + 0.5 * s, 0.9 + 0.9 * s)
		dust.Speed = NumberRange.new(2 + 4 * turn, 6 + 10 * turn)
		if turn > 0.4 then dust:Emit(math.floor(3 + 8 * s * turn)) end
	elseif dust then
		dust.Rate = 0
	end

	-- speed FOV
	if cam then
		local target = baseFov + CFG.FOV_BOOST * ((speed - CFG.MIN_SPEED) / (CFG.MAX_SPEED - CFG.MIN_SPEED))
		cam.FieldOfView += (target - cam.FieldOfView) * math.min(1, dt * 4)
	end
end

RunService:BindToRenderStep("NaoyaProjection", Enum.RenderPriority.Character.Value + 1, step)

------------------------------------------------------------------
-- CHARACTER SETUP / RESPAWN
------------------------------------------------------------------
local charConn

local function resetCharacterState()
	if active then deactivate() end
	if frozen then endFreeze(false) end
	for _, g in ipairs(ghosts) do g.model:Destroy() end
	ghosts = {}
	if ghostTemplate then ghostTemplate:Destroy() ghostTemplate = nil end
	if dust then dust:Destroy() dust = nil end
	if dustAttachment then dustAttachment:Destroy() dustAttachment = nil end
	if runTrack then runTrack:Stop(0) runTrack = nil end
	if charConn then charConn:Disconnect() charConn = nil end
	smashBusy = 0
end

local function setupCharacter(char)
	resetCharacterState()
	character = char
	hum = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
	if not animator then animator = Instance.new("Animator") animator.Parent = hum end
	baseWalkSpeed = hum.WalkSpeed
	rayParams.FilterDescendantsInstances = { char, ghostFolder }
	applyAnimations()
	buildGhosts()
	buildDust()
	charConn = hum.Died:Connect(function()
		if active then deactivate() end
		if frozen then endFreeze(false) end
	end)
end

buildFX()

track(player.CharacterAdded:Connect(function(c) task.spawn(setupCharacter, c) end))
if player.Character then task.spawn(setupCharacter, player.Character) end

------------------------------------------------------------------
-- CLEANUP HOOK
------------------------------------------------------------------
env.NaoyaCleanup = function()
	pcall(function() RunService:UnbindFromRenderStep("NaoyaProjection") end)
	pcall(resetCharacterState)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
	pcall(function() ghostFolder:Destroy() end)
	pcall(function() if tintEffect then tintEffect:Destroy() end end)
end
