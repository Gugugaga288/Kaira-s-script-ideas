-- recompute every buff variable from the levels, then refresh all the UI
sync = function()
	speedBonus, jumpBonus = 0, 0
	for _, v in ipairs(speedSteps) do speedBonus += v end
	for _, v in ipairs(jumpSteps) do jumpBonus += v end
	espTier = lv.esp
	hasMissile, hasPhase = lv.missile > 0, lv.mphase > 0
	missileTime = BASE_MTIME + DUR_STEP * lv.mdur
	missileSpeed = BASE_MSPEED + MSPEED_STEP * lv.mspeed
	missileCd = math.max(MIN_CD, BASE_MCD - CD_STEP * lv.mcd)
	hasDouble, hasTriple = lv.mjump >= 1, lv.mjump >= 2
	hasGlide, hasMulti, hasMagnet = lv.glide > 0, lv.multi > 0, lv.magnet > 0
	hasDrone, hasDronePark, hasDroneMount = lv.drone > 0, lv.dronepark > 0, lv.dronemount > 0
	if hasDrone and ensureDrone then ensureDrone() end -- the idle-hover loop then parents/positions it automatically
	mercy = lv.mercy
	glideMax = GLIDE_TIME + (on.gdur and GDUR_STEP * lv.gdur or 0)
	glideEnergy = math.min(glideEnergy, glideMax)
	refresh()
	refreshPanel()
	applyBuffs()
	refreshAdmin()
end

local function resetAll()
	if pilotingDrone and stopPilotReturn then stopPilotReturn() end
	if mountedDrone and unmountDrone then unmountDrone() end
	droneParked = false
	if droneModel then droneModel:Destroy(); droneModel = nil end
	summons = 0
	for k in pairs(lv) do lv[k] = 0 end
	speedSteps, jumpSteps = {}, {}
	for k in pairs(on) do on[k] = false end
	panelOpen = false
	sync()
end

local killedByTung, pendingBabies = false, false
local function onDeath()
	pilotingDrone = false -- stop any drone control immediately; resetAll()/mercy below decide if you keep the drone itself
	mountedDrone = false
	if droneSeat then droneSeat:Destroy(); droneSeat = nil end
	if DEATH_WIPES_ALL or killedByTung then
		if lv.mercy > 0 then
			lv.mercy -= 1 -- Mercy: keep everything, baby Tungs rain down when you respawn
			pendingBabies = true
			sync()
		else
			resetAll() -- lose every buff, summon fee back to 5
		end
	end
	killedByTung = false
end
local function hookDeath(char)
	local h = char:WaitForChild("Humanoid", 10)
	if h then h.Died:Connect(onDeath) end
end
if lp.Character then task.spawn(hookDeath, lp.Character) end
lp.CharacterAdded:Connect(function(char)
	task.spawn(hookDeath, char)
	if gliding then stopGlide() end
	task.wait(.5)
	applyBuffs()
	local h = char:FindFirstChildOfClass("Humanoid")
	if h then cam.CameraSubject = h end
	if pendingBabies then
		pendingBabies = false
		char:WaitForChild("HumanoidRootPart", 5)
		task.wait(1)
		spawnBabies()
	end
end)
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Q then useMissile() end
	if input.KeyCode == Enum.KeyCode.G then startGlide() end
end)

---------------------------------------------------------------- map coins (client-side)
local coinFolder = new("Folder", {Name = "LocalCoins"}, workspace)
local coinList = {}

local function spawnCoin()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local origin = root.Position + Vector3.new(math.random(-150, 150), 100, math.random(-150, 150))
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {lp.Character, coinFolder}
	local hit = workspace:Raycast(origin, Vector3.new(0, -300, 0), params)
	if not hit then return false end
	local c = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 2, 2), Color = GOLD, Material = Enum.Material.Metal,
		Anchored = true, CanCollide = false, CanTouch = false,
	}, coinFolder)
	c:SetAttribute("base", hit.Position + Vector3.new(0, 3, 0))
	table.insert(coinList, c)
	return true
end
