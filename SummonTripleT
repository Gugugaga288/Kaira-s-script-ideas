	if gliding then stopGlide() end
	task.wait(.5)
	applyBuffs()
	if pendingBabies then
		pendingBabies = false
		char:WaitForChild("HumanoidRootPart", 5)
		task.wait(1)
		spawnBabies()
	end
end)
