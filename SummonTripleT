-- Movement is level with the camera's HEADING (tilting the camera does nothing to the drone).
-- Up/Down only happen when you ask for them: Space / Ctrl, or the UP / DOWN buttons.
local function readFlightInput(hum)
	local c = getCam().CFrame
	local f, r = c.LookVector, c.RightVector
	local fl = Vector3.new(f.X, 0, f.Z)
	if fl.Magnitude < .05 then fl = Vector3.new(c.UpVector.X, 0, c.UpVector.Z) * (f.Y < 0 and 1 or -1) end
	fl = fl.Magnitude > .01 and fl.Unit or Vector3.new(0, 0, -1)
	local rl = Vector3.new(r.X, 0, r.Z)
	rl = rl.Magnitude > .01 and rl.Unit or Vector3.new(1, 0, 0)
	local right, fwd, got = 0, 0, false
	if controlModule then
		local ok, v = pcall(function() return controlModule:GetMoveVector() end)
		if ok and typeof(v) == "Vector3" then right, fwd, got = v.X, -v.Z, true end
	end
	if not got and hum and hum.MoveDirection.Magnitude > .01 then
		local md = hum.MoveDirection
		fwd, right, got = md:Dot(fl), md:Dot(rl), true
	end
	if not got then
		if UIS:IsKeyDown(Enum.KeyCode.W) then fwd += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.S) then fwd -= 1 end
		if UIS:IsKeyDown(Enum.KeyCode.D) then right += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.A) then right -= 1 end
	end
	local vert = ((UIS:IsKeyDown(Enum.KeyCode.Space) or touchUp) and 1 or 0) - ((UIS:IsKeyDown(Enum.KeyCode.LeftControl) or touchDown) and 1 or 0)
	return fl * fwd + rl * right + Vector3.yAxis * vert
end

-- Which way the drone faces. Like a normal character it only turns toward where you MOVE (level), and
-- looking around with the camera never turns it.
local droneFace = Vector3.new(0, 0, -1)
local function resetFace()
	local l = droneCF and droneCF.LookVector or Vector3.new(0, 0, -1)
	local flat = Vector3.new(l.X, 0, l.Z)
	droneFace = flat.Magnitude > .01 and flat.Unit or Vector3.new(0, 0, -1)
end
local function turnToward(mv, dt)
	local flat = Vector3.new(mv.X, 0, mv.Z)
	if flat.Magnitude < .05 then return end
	local mixed = droneFace:Lerp(flat.Unit, math.min(1, 10 * dt))
	droneFace = mixed.Magnitude > .01 and mixed.Unit or flat.Unit
end

-- Walls and floors BLOCK you while mounted (the piloted drone is the one that phases through everything).
local MOUNT_RADIUS = 2.4
local function moveSolid(pos, delta, params)
	local dist = delta.Magnitude
	if dist < 1e-4 then return pos end
	local hit = workspace:Spherecast(pos, MOUNT_RADIUS, delta.Unit * (dist + .05), params)
	if not hit then return pos + delta end
	local slid = delta - hit.Normal * delta:Dot(hit.Normal) -- slide along what you hit
	if slid.Magnitude < 1e-4 then return pos end
	if workspace:Spherecast(pos, MOUNT_RADIUS, slid.Unit * (slid.Magnitude + .05), params) then return pos end
	return pos + slid
end

-- Tap from idle: control the drone directly from its point of view. Noclips through everything.
startPilot = function()
	if pilotingDrone or mountedDrone or busy or missileBusy or gliding then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if not ensureDrone() then return end
	if not droneCF then droneCF = root.CFrame * DRONE_FOLLOW_OFFSET end
	resetFace()
	pilotingDrone, droneParked = true, false
	clearPulseGui()
	droneBtn.Text = "RETURN (E)"
	if droneHighlight then droneHighlight.Enabled = false end
	hum.WalkSpeed, hum.JumpPower = 0, 0
	hum.PlatformStand = true
	root.Anchored = true
	getCam().CameraSubject = droneModel.PrimaryPart
	showFlightControls(true)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, coinFolder}

	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not pilotingDrone then conn:Disconnect() return end
		local ok, err = pcall(function()
			local mv = readFlightInput(hum)
			local pos = droneCF.Position
			local delta = Vector3.zero
			if mv.Magnitude > .01 then
				delta = mv.Unit * DRONE_PILOT_SPEED * math.min(1, mv.Magnitude) * dt
				local hit = workspace:Raycast(pos, delta.Unit * (delta.Magnitude + 1), params)
				if hit then phasePulse(hit.Position, hit.Normal) end -- you phase through it; the pulse just marks where
				turnToward(mv, dt)
			end
			-- level, and turned only by your movement: looking around with the camera leaves the drone alone
			droneCF = CFrame.lookAt(pos + delta, pos + delta + droneFace)
			placeDrone(droneCF, dt)
		end)
		if not ok then warn("[TungSahur] pilot tick failed: " .. tostring(err)) end
	end)
end

local function endPilotCommon()
	pilotingDrone = false
	droneBtn.Text = "DRONE (E)"
	showFlightControls(false)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum then hum.PlatformStand = false; hum.WalkSpeed = on.speed and (BASE_SPEED + speedBonus) or BASE_SPEED; hum.JumpPower = on.jump and (BASE_JUMP + jumpBonus) or BASE_JUMP end
	if root then root.Anchored = false end
	getCam().CameraSubject = hum
end

-- Tap while piloting: stop, and the drone flies itself back to your side (the idle-follow loop handles the flight).
stopPilotReturn = function()
	if not pilotingDrone then return end
	droneParked = false
	endPilotCommon()
end

-- Hold while piloting (needs Drone Park): stop, but leave the drone exactly where it is, with a sonar pulse that
-- shows through walls. Tapping again later re-enters piloting it from right where you left it.
stopPilotPark = function()
	if not pilotingDrone then return end
	droneParked = true
	endPilotCommon()
	droneBtn.Text = "DRONE (parked)"
	if droneHighlight then droneHighlight.Enabled = true end
	droneParkGlowLoop()
end

-- Hold from idle (needs Drone Mount): sit on the drone and fly it with your own body, in Roblox's default sit pose.
-- (No Seat weld: your body is carried directly each frame, the same way the missile flight carries it.)
mountDrone = function()
	if mountedDrone or pilotingDrone or busy or missileBusy or gliding then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if not ensureDrone() then return end
	if droneParked then -- mounting a parked drone: call it to you first
		droneParked = false
		clearPulseGui()
		if droneHighlight then droneHighlight.Enabled = false end
		droneCF = root.CFrame * DRONE_FOLLOW_OFFSET
	end
	if not droneCF then droneCF = root.CFrame * DRONE_FOLLOW_OFFSET end
	resetFace()
	local solidParams = RaycastParams.new()
	solidParams.FilterDescendantsInstances = {char, droneModel, coinFolder}

	local ok, err = pcall(function()
		mountCollideParts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then table.insert(mountCollideParts, d); d.CanCollide = false end
		end
		hum.WalkSpeed, hum.JumpPower = 0, 0
		hum.PlatformStand = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		root.Anchored = false
		hum.Sit = true -- Roblox's own sit state: the default Animate script plays the default sit animation (R6 or R15)
		-- belt and braces: also play the default sit animation directly, in case the game's Animate script doesn't
		local animate = char:FindFirstChild("Animate")
		local sitAnim = animate and animate:FindFirstChild("sit") and animate.sit:FindFirstChild("SitAnim")
		local id = sitAnim and sitAnim.AnimationId
			or ((hum.RigType == Enum.HumanoidRigType.R15) and "rbxassetid://2506281703" or "rbxassetid://178130996")
		local a = Instance.new("Animation")
		a.AnimationId = id
		local animator = hum:FindFirstChildOfClass("Animator")
		mountSitTrack = animator and animator:LoadAnimation(a) or hum:LoadAnimation(a)
		mountSitTrack.Priority = Enum.AnimationPriority.Action
		mountSitTrack.Looped = true
		mountSitTrack:Play()
	end)
	if not ok then
		warn("[TungSahur] Mount setup hit an error (continuing anyway): " .. tostring(err))
	end

	mountedDrone = true
	droneBtn.Text = "DISMOUNT (E)"
	showFlightControls(true)

	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not mountedDrone then conn:Disconnect() return end
		local ok2, err2 = pcall(function()
			local mv = readFlightInput(hum)
			local pos, vel = droneCF.Position, Vector3.zero
			if mv.Magnitude > .01 then
				local want = mv.Unit * DRONE_MOUNT_SPEED * math.min(1, mv.Magnitude) * dt
				local newPos = moveSolid(pos, want, solidParams) -- walls and floors stop you
				vel = (newPos - pos) / math.max(dt, 1 / 240)
				pos = newPos
				turnToward(mv, dt)
			end
			droneCF = CFrame.lookAt(pos, pos + droneFace) -- level so you sit upright; the camera never turns it
			placeDrone(droneCF, dt)
			root.CFrame = droneCF * DRONE_SIT_OFFSET
			root.AssemblyLinearVelocity = vel
			root.AssemblyAngularVelocity = Vector3.zero
			hum.Sit = true
		end)
		if not ok2 then warn("[TungSahur] mount tick failed: " .. tostring(err2)) end
	end)
end

-- Tap while mounted: unmount. The drone resumes idle hover at your side on its own.
unmountDrone = function()
	if not mountedDrone then return end
	mountedDrone = false
	droneBtn.Text = "DRONE (E)"
	showFlightControls(false)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if mountSitTrack then pcall(function() mountSitTrack:Stop() end); mountSitTrack = nil end
	if hum then
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
		hum.Sit = false
	end
	for _, d in ipairs(mountCollideParts) do
		if d and d.Parent then d.CanCollide = true end
	end
	mountCollideParts = {}
	if root then root.AssemblyLinearVelocity = Vector3.zero end
	if hum and hum.Health > 0 then applyBuffs() end
end

---------------------------------------------------------------- ESP (blue)
local esp = {}
local function destroyRec(rec)
	if rec then rec.hl:Destroy() rec.bill:Destroy() rec.arrow:Destroy() end
end

local function build(p, c)
	local hl = new("Highlight", {
		Adornee = c, OutlineColor = BLUE, FillColor = BLUE,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
	}, c)
	local bill = new("BillboardGui", {
		Adornee = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"),
		Size = UDim2.fromOffset(120, 24), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Enabled = false,
	}, c)
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = p.DisplayName, TextColor3 = BLUE,
		TextStrokeTransparency = 0, TextScaled = true, Font = Enum.Font.GothamBold,
	}, bill)
	local arrow = new("Frame", {
		Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = BLUE, Visible = false,
	}, gui)
	corner(arrow, 11)
	new("Frame", {Size = UDim2.fromOffset(8, 14), Position = UDim2.new(.5, -4, 0, -10), BackgroundColor3 = BLUE, BorderSizePixel = 0}, arrow)
	return {hl = hl, bill = bill, arrow = arrow, char = c}
end

Players.PlayerRemoving:Connect(function(p) destroyRec(esp[p]) esp[p] = nil end)

RS.RenderStepped:Connect(function()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local c = p.Character
			local rec = esp[p]
			if rec and rec.char ~= c then destroyRec(rec) rec = nil esp[p] = nil end
			if c and not rec and c:FindFirstChild("HumanoidRootPart") then
				rec = build(p, c)
				esp[p] = rec
			end
			if rec then
				local show = on.esp and espTier >= 1
				rec.hl.Enabled = show
				rec.hl.FillTransparency = espTier >= 3 and .5 or 1 -- chams at tier 3
				rec.bill.Enabled = show and espTier >= 2         -- names at tier 2
				local arrowShow = false
				if show and espTier >= 4 then                     -- offscreen arrows at tier 4
					local v, onScreen = cam:WorldToViewportPoint(c.HumanoidRootPart.Position)
					if not onScreen then
						local vs = cam.ViewportSize
						local center = vs / 2
						local d = Vector2.new(v.X, v.Y) - center
						if v.Z < 0 then d = -d end
						if d.Magnitude > 0 then
							d = d.Unit
							local r = math.min(vs.X, vs.Y) / 2 - 40
							rec.arrow.Position = UDim2.fromOffset(center.X + d.X * r, center.Y + d.Y * r)
							rec.arrow.Rotation = math.deg(math.atan2(d.Y, d.X)) + 90
							arrowShow = true
						end
					end
				end
				rec.arrow.Visible = arrowShow
			end
		end
	end
end)

