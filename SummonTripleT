---------------------------------------------------------------- map coins (client-side)
local coinFolder = new("Folder", {Name = "LocalCoins"}, workspace)
local coinList = {}

local function spawnCoin()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	local origin = root.Position + Vector3.new(math.random(-150, 150), 100, math.random(-150, 150))
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {lp.Character, coinFolder}
	local hit = workspace:Raycast(origin, Vector3.new(0, -300, 0), params)
	if not hit then return false end
	local c = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 2, 2), Color = GOLD, Material = Enum.Material.Metal,
		Anchored = true, CanCollide = false, CanTouch = false,
	}, coinFolder)
	c:SetAttribute("base", hit.Position + Vector3.new(0, 3, 0))
	table.insert(coinList, c)
	return true
end
for _ = 1, coinTarget do spawnCoin() end
-- keeps topping the map back up to coinTarget, one coin every coinRespawn seconds
task.spawn(function()
	while true do
		task.wait(math.max(.2, coinRespawn))
		if #coinList < coinTarget then spawnCoin() end
	end
end)

RS.Heartbeat:Connect(function(dt)
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local t = os.clock() * 2
	for i = #coinList, 1, -1 do
		local c = coinList[i]
		local base = c:GetAttribute("base")
		if root and hasMagnet and on.magnet then -- magnet pulls nearby coins to you
			local d = root.Position - base
			if d.Magnitude < MAGNET_RADIUS and d.Magnitude > .1 then
				base += d.Unit * math.min(d.Magnitude, MAGNET_SPEED * dt)
				c:SetAttribute("base", base)
			end
		end
		c.CFrame = CFrame.new(base + Vector3.new(0, math.sin(t) * .3, 0)) * CFrame.Angles(0, t, 0)
		if root and not busy and not missileBusy and (root.Position - base).Magnitude < 5 then
			coins += hasMulti and 2 or 1
			refresh()
			c:Destroy()
			table.remove(coinList, i)
		end
	end
end)

