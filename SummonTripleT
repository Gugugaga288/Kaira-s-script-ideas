---------------------------------------------------------------- Drone ability
local DRONE_SCALE = .7                           -- overall drone size (1 = the old, bigger one)
local DRONE_FOLLOW_OFFSET = CFrame.new(4, .8, 0) -- relative to your HumanoidRootPart: sticks to your right side
local DRONE_FOLLOW_LERP = 6                      -- how snappily the idle drone catches up to you / flies back
local DRONE_PILOT_SPEED = 55
local DRONE_MOUNT_SPEED = 45
local DRONE_SIT_OFFSET = CFrame.new(0, 1.7, 0)   -- where your root sits relative to the drone while mounted (tweak if you float/sink)
local PROP_SPIN = 45                             -- propeller spin speed (radians/second)
local DRONE_BLUE = Color3.fromRGB(35, 105, 225)   -- the drone's blue
local DRONE_FADE = .12                       -- extra transparency added to every drone part
local RING_BLUE = Color3.fromRGB(60, 140, 255)   -- brighter blue for pulses so they read clearly
local mountCollideParts = {}
local droneProps, droneSpin = {}, 0
local mountSitTrack = nil

local function getCam() return workspace.CurrentCamera end

-- Smooth, rounded drone: puck body + dome + camera eye, four arms ending in motor balls with spinning propellers.
local function buildDrone()
	local k = DRONE_SCALE
	local m = Instance.new("Model")
	m.Name = "TungDrone"
	droneProps = {}
	local Cyl, Ball, Block = Enum.PartType.Cylinder, Enum.PartType.Ball, Enum.PartType.Block
	local up = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder upright
	local function part(shape, size, cf, transparency, color)
		return new("Part", {
			Shape = shape, Size = size, CFrame = cf, Color = color or DRONE_BLUE, Material = Enum.Material.Neon,
			Transparency = math.min(1, (transparency or .25) + DRONE_FADE), Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
	end
	m.PrimaryPart = part(Block, Vector3.new(.5, .5, .5), CFrame.new(), 1)               -- invisible pivot + camera anchor
	part(Cyl, Vector3.new(1.1 * k, 3.4 * k, 3.4 * k), up, .2)                           -- round body
	part(Ball, Vector3.new(2.3 * k, 2.3 * k, 2.3 * k), CFrame.new(0, .45 * k, 0), .3)   -- dome
	part(Ball, Vector3.new(.7 * k, .7 * k, .7 * k), CFrame.new(0, .1 * k, -1.65 * k), .05, Color3.fromRGB(120, 190, 255)) -- camera eye (front)
	for _, o in ipairs({Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1)}) do
		local near = Vector3.new(o.X * 1.15 * k, 0, o.Z * 1.15 * k)
		local hub = Vector3.new(o.X * 2.7 * k, .9 * k, o.Z * 2.7 * k)
		local dir, mid = hub - near, (hub + near) / 2
		part(Cyl, Vector3.new(dir.Magnitude, .32 * k, .32 * k), CFrame.lookAt(mid, mid + dir.Unit) * CFrame.Angles(0, math.pi / 2, 0), .3) -- arm
		part(Ball, Vector3.new(.9 * k, .9 * k, .9 * k), CFrame.new(hub), .2)                                                              -- motor
		local top = hub + Vector3.new(0, .6 * k, 0)
		part(Cyl, Vector3.new(.08 * k, 3.3 * k, 3.3 * k), CFrame.new(top) * up, .82)                                                      -- soft rotor disc
		for i = 0, 1 do                                                                                                                    -- two crossed spinning blades
			local rel = CFrame.new(top) * CFrame.Angles(0, i * math.pi / 2, 0)
			local blade = part(Cyl, Vector3.new(3.1 * k, .2 * k, .2 * k), rel, .35, Color3.fromRGB(70, 120, 230))
			table.insert(droneProps, {part = blade, rel = rel, dir = (o.X * o.Z > 0) and 1 or -1})
		end
	end
	local glow = new("Highlight", {
		Adornee = m, FillColor = Color3.fromRGB(40, 100, 255), OutlineColor = RING_BLUE,
		FillTransparency = .5, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
	}, m)
	return m, glow
end

local droneHighlight = nil
ensureDrone = function()
	if droneModel then return true end
	local ok, mOrErr, glow = pcall(function()
		local m, g = buildDrone()
		return m, g
	end)
	if not ok then
		warn("[TungSahur] Drone failed to build: " .. tostring(mOrErr))
		return false
	end
	droneModel = mOrErr
	droneHighlight = glow
	return true
end

-- every place that moves the drone goes through this, so the propellers always spin
local function placeDrone(cf, dt)
	droneModel:PivotTo(cf)
	droneSpin += (dt or 1 / 60) * PROP_SPIN
	for _, p in ipairs(droneProps) do
		p.part.CFrame = cf * p.rel * CFrame.Angles(0, droneSpin * p.dir, 0)
	end
end

-- a ring that pulses outward at the point a phasing drone passes through something
local lastPhasePulse = 0
local function phasePulse(pos, norm)
	if os.clock() - lastPhasePulse < .12 then return end -- don't spawn one every single frame
	lastPhasePulse = os.clock()
	local ok, err = pcall(function()
		norm = (norm and norm.Magnitude > 0) and norm.Unit or Vector3.yAxis
		local upGuess = (math.abs(norm.Y) > .9) and Vector3.xAxis or Vector3.yAxis
		local tangent = norm:Cross(upGuess).Unit
		local okCf, cf = pcall(function() return CFrame.fromMatrix(pos, norm, tangent) end)
		if not okCf then cf = CFrame.new(pos) end
		local r = new("Part", {
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(.1, .6, .6), Color = RING_BLUE, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = .1, CFrame = cf,
		}, workspace)
		TS:Create(r, TweenInfo.new(.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(.06, 8, 8), Transparency = 1}):Play()
		Debris:AddItem(r, .6)
	end)
	if not ok then warn("[TungSahur] phasePulse failed: " .. tostring(err)) end
end

-- idle behaviour: when nobody is piloting/mounting it, the drone hovers at your right side (or stays put if parked)
RS.Heartbeat:Connect(function(dt)
