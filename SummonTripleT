local function afterimage(missile)
	local g = missile:Clone()
	for _, d in ipairs(g:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = .35
			TS:Create(d, TweenInfo.new(.7), {Transparency = 1}):Play()
		end
	end
	g.Parent = workspace
	Debris:AddItem(g, .8)
end

useMissile = function()
	if missileBusy then
		-- press again while steering to stop early
		if planning and os.clock() - planStart > .4 then stopRequested = true end
		return
	end
	if busy or not hasMissile then return end
	if os.clock() - lastMissile < eCd() then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if gliding then stopGlide() end
	missileBusy = true
	local duration, speed, phase = eTime(), eSpeed(), ePhase()

	-- freeze everyone else (on your screen) and tint the world blue
	local frozen, tracks = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl ~= lp and pl.Character
		if c then
			local r = c:FindFirstChild("HumanoidRootPart")
			if r then table.insert(frozen, {root = r, cf = r.CFrame}) end
			local h = c:FindFirstChildOfClass("Humanoid")
			local an = h and h:FindFirstChildOfClass("Animator")
			if an then
				for _, t in ipairs(an:GetPlayingAnimationTracks()) do
					t:AdjustSpeed(0)
					table.insert(tracks, t)
				end
			end
		end
	end
	local freezeConn = RS.Heartbeat:Connect(function()
		for _, f in ipairs(frozen) do
			if f.root.Parent then
				f.root.CFrame = f.cf
				f.root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
	root.Anchored = true
	tint(true)

	-- planning phase: steer a ghost missile with the camera
	local missile = buildMissile()
	local dir = cam.CFrame.LookVector
	local pos = root.Position + Vector3.new(0, 1.5, 0)
	missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
	missile.Parent = workspace
	cam.CameraSubject = missile.PrimaryPart

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, coinFolder}
	local path = {}
	local elapsed, acc, lastGhost, hit = 0, 0, 0, false
	planning, stopRequested, planStart = true, false, os.clock()
	while elapsed < duration and not hit and not stopRequested do
		local dt = RS.Heartbeat:Wait()
		if hum.Health <= 0 then break end
		elapsed += dt
		acc += dt
		setFlight("PLAN", duration - elapsed)
		while acc >= STEP and not hit do
			acc -= STEP
			dir = dir:Lerp(cam.CFrame.LookVector, math.min(1, MISSILE_TURN * STEP)).Unit
			local move = dir * speed * STEP
			if not phase and workspace:Raycast(pos, move + dir * 1.5, params) then
				hit = true
			else
				pos += move
				table.insert(path, {pos = pos, dir = dir})
			end
		end
		missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
		if os.clock() - lastGhost > .04 then
			lastGhost = os.clock()
			afterimage(missile)
		end
	end

	-- back to normal
	planning = false
	missile:Destroy()
	cam.CameraSubject = hum
	freezeConn:Disconnect()
	for _, t in ipairs(tracks) do pcall(function() t:AdjustSpeed(1) end) end
	tint(false)

	-- your real body flies the exact path you planned
	if hum.Health > 0 and #path > 1 then
		hum.PlatformStand = true
		-- NOT anchored: the client owns an unanchored character, so its movement replicates and other players see it fly
		root.Anchored = false
		local parts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then table.insert(parts, d) end
		end
		local a0 = new("Attachment", {Position = Vector3.new(1.5, 0, 0)}, root)
		local a1 = new("Attachment", {Position = Vector3.new(-1.5, 0, 0)}, root)
		local trail = new("Trail", {
			Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(BLUE), LightEmission = 1,
			Lifetime = .8, Transparency = NumberSequence.new(.2, 1),
		}, root)
		local i, acc2 = 1, 0
		while i <= #path and hum.Health > 0 do
			acc2 += RS.Heartbeat:Wait()
			setFlight("FLY", (#path - i + 1) * STEP)
			for _, d in ipairs(parts) do d.CanCollide = false end
			while acc2 >= STEP and i <= #path do
				acc2 -= STEP
				local e = path[i]
				i += 1
				-- lie flat like a missile: head points along the flight direction
				root.CFrame = CFrame.lookAt(e.pos, e.pos + e.dir) * CFrame.Angles(-math.pi / 2, 0, 0)
				root.AssemblyLinearVelocity = e.dir * speed -- real velocity so it replicates smoothly
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
		local last = path[#path]
		local flat = Vector3.new(last.dir.X, 0, last.dir.Z)
		if flat.Magnitude < .01 then flat = Vector3.new(0, 0, -1) end
		local landing = last.pos + Vector3.new(0, 2, 0)
		if phase then
			-- if you ended inside something, pop up to the first free spot
			local op = OverlapParams.new()
			op.FilterDescendantsInstances = {char, coinFolder}
			for _ = 1, 60 do
				if #workspace:GetPartBoundsInBox(CFrame.new(landing), Vector3.new(4, 6, 4), op) == 0 then break end
				landing += Vector3.new(0, 4, 0)
			end
		end
		root.CFrame = CFrame.lookAt(landing, landing + flat)
		root.AssemblyLinearVelocity = Vector3.zero
		for _, d in ipairs(parts) do d.CanCollide = true end
		hum.PlatformStand = false
		task.delay(1, function() trail:Destroy() a0:Destroy() a1:Destroy() end)
	end
	flightLbl.Visible = false
	root.Anchored = false
	lastMissile = os.clock()
	missileBusy = false
end

---------------------------------------------------------------- Double / triple jump
UIS.JumpRequest:Connect(function()
	if gliding then stopGlide() return end
	local mj = maxJumps()
	if mj < 2 or busy or missileBusy then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if hum.FloorMaterial ~= Enum.Material.Air then return end
	if airTime < .15 or os.clock() - lastExtraJump < .25 or jumpsUsed >= mj - 1 then return end
	jumpsUsed += 1
	lastExtraJump = os.clock()
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, hum.JumpPower, v.Z)
	hum:ChangeState(Enum.HumanoidStateType.Jumping)
end)

---------------------------------------------------------------- Glide
-- Press GLIDE (or G) in the air. Camera pitch steers: look down = dive and speed up,
-- look up = climb and slow down. Too slow, out of meter, or touching ground/walls = cancel.
local glideModel, glideConn, glideDir, glideSpeed = nil, nil, Vector3.new(0, 0, -1), GLIDE_START

local function buildGlider(char, root)
	local m = Instance.new("Model")
	m.Name = "TungGlider"
	-- all white. root-local: back = +Z (the glider sits there), head = +Y, wide = X
	local function part(size, cf)
		local p = new("Part", {
			Size = size, CFrame = root.CFrame * cf, Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
			Massless = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
		new("WeldConstraint", {Part0 = root, Part1 = p}, p)
		return p
	end
	part(Vector3.new(2.2, 7, .3), CFrame.new(0, .6, 2.4))                       -- centre body
	part(Vector3.new(1.4, 1.8, .2), CFrame.new(0, -3.6, 2.4))                   -- tail
	part(Vector3.new(.35, .35, 2), CFrame.new(0, 3, 1.5))                       -- brace to your back
	for _, s in ipairs({-1, 1}) do
		part(Vector3.new(6, 5.5, .2), CFrame.new(s * 3.6, 0, 2.4) * CFrame.Angles(0, 0, -s * .3))     -- swept wings
		part(Vector3.new(3.2, 3, .2), CFrame.new(s * 7, -1.6, 2.4) * CFrame.Angles(0, 0, -s * .5))   -- wing tips
		part(Vector3.new(.3, .3, 2.2), CFrame.new(s * 1.1, .8, 1.4))                                  -- struts
	end
	m.Parent = char
	return m
end

stopGlide = function()
	if not gliding then return end
	gliding = false
	if glideConn then glideConn:Disconnect() glideConn = nil end
	if glideModel then glideModel:Destroy() glideModel = nil end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		local flat = Vector3.new(glideDir.X, 0, glideDir.Z)
		if flat.Magnitude < .01 then flat = Vector3.new(0, 0, -1) end
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat) -- stand upright again
		root.AssemblyLinearVelocity = flat.Unit * math.min(glideSpeed, 40)
		hum.PlatformStand = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)
	end
end

startGlide = function()
	if gliding then stopGlide() return end
	if not (hasGlide and on.glide) or busy or missileBusy then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	if hum.FloorMaterial ~= Enum.Material.Air or glideEnergy < 1 then return end -- must be airborne

	gliding = true
	local look = cam.CFrame.LookVector
	glideDir = Vector3.new(look.X, math.clamp(look.Y, -.6, .2), look.Z).Unit
	local v = root.AssemblyLinearVelocity
	glideSpeed = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude, GLIDE_START, GLIDE_MAX)
	hum.PlatformStand = true
	glideModel = buildGlider(char, root)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, coinFolder}

	glideConn = RS.Heartbeat:Connect(function(dt)
		if hum.Health <= 0 or not root.Parent then stopGlide() return end
		local l = cam.CFrame.LookVector
		local target = Vector3.new(l.X, math.clamp(l.Y, -.85, .45), l.Z).Unit
		glideDir = glideDir:Lerp(target, math.min(1, 3 * dt)).Unit
		-- dive = faster, climb = slower
		glideSpeed = math.min(GLIDE_MAX, glideSpeed + (-glideDir.Y * GLIDE_ACCEL - GLIDE_DRAG) * dt)
		glideEnergy -= dt
		if glideSpeed < GLIDE_MIN or glideEnergy <= 0 then stopGlide() return end

		local pos = root.Position
		local ahead = workspace:Raycast(pos, glideDir * (glideSpeed * dt + 3), params)
		local below = glideDir.Y <= .05 and workspace:Raycast(pos, Vector3.new(0, -5, 0), params)
		if ahead or below then stopGlide() return end

		-- lie flat like the missile, glider on your back
		root.CFrame = CFrame.lookAt(pos, pos + glideDir) * CFrame.Angles(-math.pi / 2, 0, 0)
		root.AssemblyLinearVelocity = glideDir * glideSpeed + Vector3.new(0, -GLIDE_SINK, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end)
end

-- meter recharge, jump bookkeeping, button labels
RS.Heartbeat:Connect(function(dt)
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		if hum.FloorMaterial == Enum.Material.Air then
			airTime += dt
		else
			airTime, jumpsUsed = 0, 0
			if not gliding and glideEnergy < glideMax then
				glideEnergy = math.min(glideMax, glideEnergy + GLIDE_RECHARGE * dt)
			end
		end
	end
	gfill.Size = UDim2.fromScale(math.clamp(glideEnergy / glideMax, 0, 1), 1)
	glideBtn.Text = gliding and "STOP GLIDE" or "GLIDE (G)"
	if hasMissile then
		local left = eCd() - (os.clock() - lastMissile)
		if missileBusy then abilityBtn.Text = planning and "STOP" or "ACTIVE"
		elseif left > 0 then abilityBtn.Text = "MISSILE " .. math.ceil(left) .. "s"
		else abilityBtn.Text = "MISSILE (Q)" end
	end
end)

---------------------------------------------------------------- ESP (blue)
local esp = {}
local function destroyRec(rec)
	if rec then rec.hl:Destroy() rec.bill:Destroy() rec.arrow:Destroy() end
end

local function build(p, c)
	local hl = new("Highlight", {
		Adornee = c, OutlineColor = BLUE, FillColor = BLUE,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
	}, c)
	local bill = new("BillboardGui", {
		Adornee = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"),
		Size = UDim2.fromOffset(120, 24), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Enabled = false,
	}, c)
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = p.DisplayName, TextColor3 = BLUE,
		TextStrokeTransparency = 0, TextScaled = true, Font = Enum.Font.GothamBold,
	}, bill)
	local arrow = new("Frame", {
		Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = BLUE, Visible = false,
	}, gui)
	corner(arrow, 11)
	new("Frame", {Size = UDim2.fromOffset(8, 14), Position = UDim2.new(.5, -4, 0, -10), BackgroundColor3 = BLUE, BorderSizePixel = 0}, arrow)
	return {hl = hl, bill = bill, arrow = arrow, char = c}
end

Players.PlayerRemoving:Connect(function(p) destroyRec(esp[p]) esp[p] = nil end)

RS.RenderStepped:Connect(function()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local c = p.Character
			local rec = esp[p]
			if rec and rec.char ~= c then destroyRec(rec) rec = nil esp[p] = nil end
			if c and not rec and c:FindFirstChild("HumanoidRootPart") then
				rec = build(p, c)
				esp[p] = rec
			end
			if rec then
				local show = on.esp and espTier >= 1
				rec.hl.Enabled = show
				rec.hl.FillTransparency = espTier >= 3 and .5 or 1 -- chams at tier 3
				rec.bill.Enabled = show and espTier >= 2         -- names at tier 2
				local arrowShow = false
				if show and espTier >= 4 then                     -- offscreen arrows at tier 4
					local v, onScreen = cam:WorldToViewportPoint(c.HumanoidRootPart.Position)
					if not onScreen then
						local vs = cam.ViewportSize
						local center = vs / 2
						local d = Vector2.new(v.X, v.Y) - center
						if v.Z < 0 then d = -d end
						if d.Magnitude > 0 then
							d = d.Unit
							local r = math.min(vs.X, vs.Y) / 2 - 40
							rec.arrow.Position = UDim2.fromOffset(center.X + d.X * r, center.Y + d.Y * r)
							rec.arrow.Rotation = math.deg(math.atan2(d.Y, d.X)) + 90
							arrowShow = true
						end
					end
				end
				rec.arrow.Visible = arrowShow
			end
		end
	end
end)

