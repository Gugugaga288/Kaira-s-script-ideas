local function options(super)
	local o = {}
	local function add(key, text) table.insert(o, {key, text .. " - " .. itemPrice(key, super) .. " coins"}) end
	if super then
		add("speed", "SUPER Speed (+" .. SUPER_SPEED .. ")")
		add("jump", "SUPER Jump (+" .. SUPER_JUMP .. ")")
		if not hasMissile then add("missile", "Missile Ability (" .. BASE_MTIME .. "s)") end
		add("mercy", "Mercy: next death keeps your buffs + baby Tungs drop" .. (mercy > 0 and (" (x" .. mercy .. ")") or ""))
		if not hasMulti then add("multi", "Coin Multiplier (x2)")
		elseif not hasMagnet then add("magnet", "Coin Magnet") end
		if not hasGlide then add("glide", "Glide") end
		if not hasDrone then add("drone", "Drone Ability") end
		if hasDouble and not hasTriple then add("tjump", "Triple Jump") end
	else
		add("speed", "Speed (+" .. SPEED_STEP .. ")")
		add("jump", "Jump (+" .. JUMP_STEP .. ")")
		if espTier < 4 then add("esp", TIERS[espTier + 1]) end
		if hasDrone and not hasDronePark then add("dronepark", "Drone Park") end
		if hasDrone and not hasDroneMount then add("dronemount", "Drone Mount") end
		if hasMissile then
			add("mdur", "Missile Duration (+" .. DUR_STEP .. "s)")
			add("mspeed", "Missile Speed (+" .. MSPEED_STEP .. ")")
			if missileCd > MIN_CD then add("mcd", "Missile Cooldown (-" .. CD_STEP .. "s)") end
			if not hasPhase then add("mphase", "Missile Phase (fly through walls)") end
		end
		if hasGlide then add("gdur", "Glide Duration (+" .. GDUR_STEP .. "s)") end
		if not hasDouble then add("djump", "Double Jump") end
	end
	return o
end

