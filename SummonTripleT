local BASE_SPEED, BASE_JUMP = 16, 50
local SPEED_STEP, JUMP_STEP = 3, 5          -- normal shop (weak)
local SUPER_SPEED, SUPER_JUMP = 10, 20      -- super shop (strong)
local SUPER_EVERY = 3                      -- every 3rd summon is a SUPER shop
local MISSILE_TURN = 6
