local function options(super)
	local o
	if super then
		o = {
			{"speed", "SUPER Speed (+" .. SUPER_SPEED .. ")"},
			{"jump", "SUPER Jump (+" .. SUPER_JUMP .. ")"},
		}
		if not hasMissile then table.insert(o, {"missile", "Missile Ability (" .. missileTime .. "s)"}) end
	else
		o = {
			{"speed", "Speed (+" .. SPEED_STEP .. ")"},
			{"jump", "Jump (+" .. JUMP_STEP .. ")"},
		}
		if espTier < 4 then table.insert(o, {"esp", TIERS[espTier + 1]}) end
		if hasMissile then -- missile upgrades show up in the normal shop once you own the missile
			table.insert(o, {"mdur", "Missile Duration (+" .. DUR_STEP .. "s)"})
			table.insert(o, {"mspeed", "Missile Speed (+" .. MSPEED_STEP .. ")"})
			if missileCd > MIN_CD then table.insert(o, {"mcd", "Missile Cooldown (-" .. CD_STEP .. "s)"}) end
			if not hasPhase then table.insert(o, {"mphase", "Missile Phase (fly through walls)"}) end
		end
	end
	return o
end

local function refreshMenu(super)
	menu.BackgroundColor3 = super and Color3.fromRGB(70, 50, 0) or Color3.fromRGB(20, 20, 20)
	stroke.Enabled = super
	title.Text = (super and "SUPER SHOP - " or "Pick ONE - ") .. cost() .. " coins"
	title.TextColor3 = super and GOLD or Color3.new(1, 1, 1)
	for _, b in ipairs(menuButtons) do b:Destroy() end
	menuButtons = {}
