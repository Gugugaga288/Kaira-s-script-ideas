	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	-- while piloting the drone, it collects coins instead of your (frozen) body
	local collectPos = (pilotingDrone and droneCF) and droneCF.Position or (root and root.Position)
