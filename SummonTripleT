---------------------------------------------------------------- summon sequence
local function summon()
	if busy or missileBusy then return end
	if gliding then stopGlide() end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	busy = true
	local price = cost()
	local super = (summons + 1) % SUPER_EVERY == 0

	-- levitate + freeze
	hum.WalkSpeed = 0
	hum.UseJumpPower = true
	hum.JumpPower = 0
	local start = root.Position
	local bp = new("BodyPosition", {MaxForce = Vector3.new(1e6, 1e6, 1e6), P = 3000, D = 500, Position = start}, root)
	-- no falling pose: with Freefall disabled the limbs stay like you're standing on the ground
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	-- rise smoothly, then bob up and down a little
	local t0 = os.clock()
	local bobConn = RS.Heartbeat:Connect(function()
		local k = math.min(1, (os.clock() - t0) / 2.5)
		k = k * k * (3 - 2 * k)
		bp.Position = start + Vector3.new(0, FLOAT_HEIGHT * k + math.sin((os.clock() - t0) * 2.5) * BOB_AMOUNT * k, 0)
	end)

	-- Tung Tung Tung Sahur + golden beam (beam reaches below his feet so it covers all of him)
	local p = (root.CFrame * CFrame.new(0, 0, -12)).Position + Vector3.new(0, FLOAT_HEIGHT + 4, 0)
	local tung = buildTung(super)
	tung:PivotTo(CFrame.new(p.X, p.Y + 150, p.Z))
	tung.Parent = workspace
	local beam = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(400, 10, 10), Color = GOLD, Material = Enum.Material.Neon,
		Transparency = .45, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
	}, workspace)
	local body = tung:FindFirstChildOfClass("Part")
	local tag = new("BillboardGui", {Size = UDim2.fromOffset(240, 30), StudsOffset = Vector3.new(0, 7, 0), AlwaysOnTop = true}, body)
	tag.Adornee = body
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Tung Tung Tung Sahur", TextColor3 = GOLD,
		TextStrokeTransparency = 0, TextScaled = true, Font = Enum.Font.GothamBlack,
	}, tag)
	local function place(y)
		tung:PivotTo(CFrame.lookAt(Vector3.new(p.X, y, p.Z), Vector3.new(start.X, y, start.Z)))
		beam.CFrame = CFrame.new(p.X, y + 190, p.Z) * CFrame.Angles(0, 0, math.pi / 2)
	end
	for i = 0, 60 do
		place(p.Y + 150 * (1 - i / 60) ^ 2)
		task.wait(1 / 40)
	end

	local function cleanup()
		menu.Visible = false
		bobConn:Disconnect()
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
		bp:Destroy()
		tung:Destroy()
		beam:Destroy()
		busy = false
	end

	-- pick ONE buff
	refreshMenu(super)
	menu.Visible = true
	local died = hum.Died:Connect(function() choiceEvt:Fire(nil) end)
	local chosen = choiceEvt.Event:Wait()
	died:Disconnect()
	menu.Visible = false
	if not chosen then cleanup() return end
	price += itemPrice(chosen, super) -- item price on top of the summon fee

	-- coins come out of the body and fly to Tung
	local target = tung:GetPivot().Position
	local pay = math.min(coins, price)
	for _ = 1, pay do
		task.spawn(function()
			local coin = new("Part", {
				Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 2, 2), Color = GOLD, Material = Enum.Material.Metal,
				Anchored = true, CanCollide = false, CanTouch = false,
				CFrame = root.CFrame * CFrame.new(math.random(-10, 10) / 10, math.random(-10, 10) / 10, -1),
			}, workspace)
			local tw = TS:Create(coin, TweenInfo.new(.9, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = target})
			tw:Play()
			tw.Completed:Wait()
			coin:Destroy()
		end)
		coins -= 1
		refresh()
		task.wait(.12)
	end
	task.wait(1)

	if pay < price then
		-- couldn't afford it: drift far up into the sky, then die
		bobConn:Disconnect()
		TS:Create(bp, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = bp.Position + Vector3.new(0, 250, 0)}):Play()
		task.wait(4)
		if hum.Health > 0 then
			killedByTung = true
			hum.Health = 0 -- the death hook handles Mercy / wiping your buffs
		end
		cleanup()
		return
	end

	summons += 1
	grant(chosen, super)
	-- Tung leaves and you float gently back down instead of dropping
	bobConn:Disconnect()
	tung:Destroy()
	beam:Destroy()
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = {char, coinFolder}
	local ground = workspace:Raycast(bp.Position, Vector3.new(0, -800, 0), rp)
	if ground and hum.Health > 0 then
		local destY = ground.Position.Y + hum.HipHeight + root.Size.Y / 2 + 1
		local dist = math.max(0, bp.Position.Y - destY)
		local tw = TS:Create(bp, TweenInfo.new(math.clamp(dist / 5, 1.5, 7), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Position = Vector3.new(bp.Position.X, destY, bp.Position.Z)})
		tw:Play()
		tw.Completed:Wait()
	end
	sync()
	if chosen == "glide" or chosen == "gdur" then glideEnergy = glideMax end
	cleanup()
end

