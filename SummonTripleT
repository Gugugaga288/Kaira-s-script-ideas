	if not hum then return end
	hum.UseJumpPower = true
	hum.WalkSpeed = on.speed and (BASE_SPEED + speedBonus) or BASE_SPEED
	hum.JumpPower = on.jump and (BASE_JUMP + jumpBonus) or BASE_JUMP
