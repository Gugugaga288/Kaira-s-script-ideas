---------------------------------------------------------------- map coins (client-side)
local coinFolder = new("Folder", {Name = "LocalCoins"}, workspace)
local coinList = {}

local function spawnCoin()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local origin = root.Position + Vector3.new(math.random(-150, 150), 100, math.random(-150, 150))
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {lp.Character, coinFolder}
	local hit = workspace:Raycast(origin, Vector3.new(0, -300, 0), params)
	if not hit then return end
	local c = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 2, 2), Color = GOLD, Material = Enum.Material.Metal,
		Anchored = true, CanCollide = false, CanTouch = false,
	}, coinFolder)
	c:SetAttribute("base", hit.Position + Vector3.new(0, 3, 0))
	table.insert(coinList, c)
end
for _ = 1, COIN_COUNT do spawnCoin() end

RS.Heartbeat:Connect(function()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local t = os.clock() * 2
	for i = #coinList, 1, -1 do
		local c = coinList[i]
		local base = c:GetAttribute("base")
		c.CFrame = CFrame.new(base + Vector3.new(0, math.sin(t) * .3, 0)) * CFrame.Angles(0, t, 0)
		if root and not busy and not missileBusy and (root.Position - base).Magnitude < 5 then
			coins += 1
			refresh()
			c:Destroy()
			table.remove(coinList, i)
			task.delay(COIN_RESPAWN, spawnCoin)
		end
	end
end)

---------------------------------------------------------------- Tung Tung Tung Sahur (3D model)
local function buildTung(golden)
	local m = Instance.new("Model")
	m.Name = "TungSahur"
	local wood = golden and GOLD or Color3.fromRGB(150, 100, 50)
	local dark = golden and Color3.fromRGB(230, 170, 20) or Color3.fromRGB(105, 68, 34)
	local mat = golden and Enum.Material.Metal or Enum.Material.Wood
	local Cyl, Ball, Block = Enum.PartType.Cylinder, Enum.PartType.Ball, Enum.PartType.Block
	local function part(shape, size, cf, color, material)
		return new("Part", {
			Shape = shape, Size = size, CFrame = cf, Color = color, Material = material or mat,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
	end
	local up = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder upright

	local body = part(Cyl, Vector3.new(8, 3.2, 3.2), up, wood)
	-- face (front is -Z)
	for _, s in ipairs({-1, 1}) do
		part(Ball, Vector3.new(1.2, 1.2, 1.2), CFrame.new(s * .75, 1.6, -1.45), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		part(Ball, Vector3.new(.55, .55, .55), CFrame.new(s * .75, 1.55, -1.95), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
		-- legs + feet
		part(Cyl, Vector3.new(3, .6, .6), CFrame.new(s * .8, -5.5, 0) * up, dark)
		part(Block, Vector3.new(1, .4, 1.6), CFrame.new(s * .8, -7.15, -.3), dark)
	end
	part(Block, Vector3.new(1.8, .3, .2), CFrame.new(0, .2, -1.62), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	-- left arm hangs down
	part(Cyl, Vector3.new(3.2, .5, .5), CFrame.new(-2.1, .8, 0) * up, dark)
	part(Ball, Vector3.new(.7, .7, .7), CFrame.new(-2.1, -.8, 0), dark)
	-- right arm raised, holding the bat
	part(Cyl, Vector3.new(3.2, .5, .5), CFrame.new(2.1, 1.6, -1) * CFrame.Angles(math.rad(-55), 0, 0) * up, dark)
	part(Ball, Vector3.new(.7, .7, .7), CFrame.new(2.1, 2.5, -2.3), dark)
	part(Cyl, Vector3.new(5, .7, .7), CFrame.new(2.1, 4.5, -2.4) * up, golden and GOLD or Color3.fromRGB(190, 145, 85))

	m.WorldPivot = CFrame.new()
	return m
end

---------------------------------------------------------------- summon sequence
local function summon()
	if busy or missileBusy then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	busy = true
	local price = cost()
	local super = (summons + 1) % SUPER_EVERY == 0

	-- levitate + freeze
	hum.WalkSpeed = 0
	hum.UseJumpPower = true
	hum.JumpPower = 0
	local start = root.Position
	local bp = new("BodyPosition", {MaxForce = Vector3.new(1e6, 1e6, 1e6), P = 3000, D = 500, Position = start}, root)
	-- no falling pose: with Freefall disabled the limbs stay like you're standing on the ground
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	-- rise smoothly, then bob up and down a little
	local t0 = os.clock()
	local bobConn = RS.Heartbeat:Connect(function()
		local k = math.min(1, (os.clock() - t0) / 2.5)
		k = k * k * (3 - 2 * k)
		bp.Position = start + Vector3.new(0, FLOAT_HEIGHT * k + math.sin((os.clock() - t0) * 2.5) * BOB_AMOUNT * k, 0)
	end)

	-- Tung Tung Tung Sahur + golden beam
	local p = (root.CFrame * CFrame.new(0, 0, -12)).Position + Vector3.new(0, FLOAT_HEIGHT + 4, 0)
	local tung = buildTung(super)
	tung:PivotTo(CFrame.new(p.X, p.Y + 150, p.Z))
	tung.Parent = workspace
	local beam = new("Part", {
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(400, 10, 10), Color = GOLD, Material = Enum.Material.Neon,
		Transparency = .45, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
	}, workspace)
	local tag = new("BillboardGui", {Size = UDim2.fromOffset(240, 30), StudsOffset = Vector3.new(0, 7, 0), AlwaysOnTop = true}, tung:FindFirstChildOfClass("Part"))
	tag.Adornee = tung:FindFirstChildOfClass("Part")
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Tung Tung Tung Sahur", TextColor3 = GOLD,
		TextStrokeTransparency = 0, TextScaled = true, Font = Enum.Font.GothamBlack,
	}, tag)
	local function place(y)
		tung:PivotTo(CFrame.lookAt(Vector3.new(p.X, y, p.Z), Vector3.new(start.X, y, start.Z)))
		beam.CFrame = CFrame.new(p.X, y + 190, p.Z) * CFrame.Angles(0, 0, math.pi / 2)
	end
	for i = 0, 60 do
		place(p.Y + 150 * (1 - i / 60) ^ 2)
		task.wait(1 / 40)
	end

	local function cleanup()
		menu.Visible = false
		bobConn:Disconnect()
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
		bp:Destroy()
		tung:Destroy()
		beam:Destroy()
		busy = false
	end

	-- pick ONE buff
	refreshMenu(super)
	menu.Visible = true
	local died = hum.Died:Connect(function() choiceEvt:Fire(nil) end)
	local chosen = choiceEvt.Event:Wait()
	died:Disconnect()
	menu.Visible = false
	if not chosen then cleanup() return end

	-- coins come out of the body and fly to Tung
	local target = tung:GetPivot().Position
	local pay = math.min(coins, price)
	for _ = 1, pay do
		task.spawn(function()
			local coin = new("Part", {
				Shape = Enum.PartType.Cylinder, Size = Vector3.new(.3, 2, 2), Color = GOLD, Material = Enum.Material.Metal,
				Anchored = true, CanCollide = false, CanTouch = false,
				CFrame = root.CFrame * CFrame.new(math.random(-10, 10) / 10, math.random(-10, 10) / 10, -1),
			}, workspace)
			local tw = TS:Create(coin, TweenInfo.new(.9, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = target})
			tw:Play()
			tw.Completed:Wait()
			coin:Destroy()
		end)
		coins -= 1
		refresh()
		task.wait(.12)
	end
	task.wait(1)

	if pay < price then
		-- couldn't afford it: drift far up into the sky, then die
		bobConn:Disconnect()
		TS:Create(bp, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = bp.Position + Vector3.new(0, 250, 0)}):Play()
		task.wait(4)
		if hum.Health > 0 then
			hum.Health = 0
			-- Tung killed you for not paying: lose every buff and the summon cost goes back to 5
			summons = 0
			speedBonus, jumpBonus, espTier = 0, 0, 0
			hasMissile, hasPhase = false, false
			missileTime, missileSpeed, missileCd = 5, 110, 12
			on.speed, on.jump, on.esp = false, false, false
			panelOpen = false
			abilityBtn.Visible = false
			refresh()
			refreshPanel()
		end
		cleanup()
		return
	end

	summons += 1
	if chosen == "speed" then
		speedBonus += super and SUPER_SPEED or SPEED_STEP
		on.speed = true
	elseif chosen == "jump" then
		jumpBonus += super and SUPER_JUMP or JUMP_STEP
		on.jump = true
	elseif chosen == "esp" then
		espTier = math.min(espTier + 1, 4)
		on.esp = true
	elseif chosen == "missile" then
		hasMissile = true
		abilityBtn.Visible = true
	elseif chosen == "mdur" then
		missileTime += DUR_STEP
	elseif chosen == "mspeed" then
		missileSpeed += MSPEED_STEP
	elseif chosen == "mcd" then
		missileCd = math.max(MIN_CD, missileCd - CD_STEP)
	elseif chosen == "mphase" then
		hasPhase = true
	end
	refresh()
	refreshPanel()
	cleanup()
	applyBuffs()
end

local function onChat(text)
	local s = text:lower():gsub("[^%a%s]", ""):gsub("%s+", " ")
	s = s:match("^%s*(.-)%s*$")
	if s == PHRASE then
		summon()
	elseif s == COIN_PHRASE and (table.find(OWNER_USER_IDS, lp.UserId) or RS:IsStudio()) then
		coins += COIN_AMOUNT
		refresh()
	end
end
lp.Chatted:Connect(onChat)
pcall(function()
	TCS.MessageReceived:Connect(function(m)
		if m.TextSource and m.TextSource.UserId == lp.UserId then onChat(m.Text) end
	end)
end)

---------------------------------------------------------------- Missile ability
local function buildMissile()
	local m = Instance.new("Model")
	local function part(shape, size, cf)
		return new("Part", {
			Shape = shape, Size = size, CFrame = cf, Color = BLUE, Material = Enum.Material.Neon,
			Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
		}, m)
	end
	local body = part(Enum.PartType.Cylinder, Vector3.new(6, 1.4, 1.4), CFrame.new())
	part(Enum.PartType.Ball, Vector3.new(1.4, 1.4, 1.4), CFrame.new(3, 0, 0))
	part(Enum.PartType.Block, Vector3.new(1.2, .15, 3), CFrame.new(-2.4, 0, 0))
	part(Enum.PartType.Block, Vector3.new(1.2, 3, .15), CFrame.new(-2.4, 0, 0))
	m.PrimaryPart = body
	return m
end

local function afterimage(missile)
	local g = missile:Clone()
	for _, d in ipairs(g:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = .35
			TS:Create(d, TweenInfo.new(.7), {Transparency = 1}):Play()
		end
	end
	g.Parent = workspace
	Debris:AddItem(g, .8)
end

useMissile = function()
	if missileBusy then
		-- press again while steering to stop early
		if planning and os.clock() - planStart > .4 then stopRequested = true end
		return
	end
	if busy or not hasMissile then return end
	if os.clock() - lastMissile < missileCd then return end
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return end
	missileBusy = true

	-- freeze everyone else (on your screen) and tint the world blue
	local frozen, tracks = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl ~= lp and pl.Character
		if c then
			local r = c:FindFirstChild("HumanoidRootPart")
			if r then table.insert(frozen, {root = r, cf = r.CFrame}) end
			local h = c:FindFirstChildOfClass("Humanoid")
			local an = h and h:FindFirstChildOfClass("Animator")
			if an then
				for _, t in ipairs(an:GetPlayingAnimationTracks()) do
					t:AdjustSpeed(0)
					table.insert(tracks, t)
				end
			end
		end
	end
	local freezeConn = RS.Heartbeat:Connect(function()
		for _, f in ipairs(frozen) do
			if f.root.Parent then
				f.root.CFrame = f.cf
				f.root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
	root.Anchored = true
	tint(true)

	-- planning phase: steer a ghost missile with the camera
	local missile = buildMissile()
	local dir = cam.CFrame.LookVector
	local pos = root.Position + Vector3.new(0, 1.5, 0)
	missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
	missile.Parent = workspace
	cam.CameraSubject = missile.PrimaryPart

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, coinFolder}
	local path = {}
	local elapsed, acc, lastGhost, hit = 0, 0, 0, false
	planning, stopRequested, planStart = true, false, os.clock()
	while elapsed < missileTime and not hit and not stopRequested do
		local dt = RS.Heartbeat:Wait()
		if hum.Health <= 0 then break end
		elapsed += dt
		acc += dt
		while acc >= STEP and not hit do
			acc -= STEP
			dir = dir:Lerp(cam.CFrame.LookVector, math.min(1, MISSILE_TURN * STEP)).Unit
			local move = dir * missileSpeed * STEP
			if not hasPhase and workspace:Raycast(pos, move + dir * 1.5, params) then
				hit = true
			else
				pos += move
				table.insert(path, {pos = pos, dir = dir})
			end
		end
		missile:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.pi / 2, 0))
		if os.clock() - lastGhost > .04 then
			lastGhost = os.clock()
			afterimage(missile)
		end
	end

	-- back to normal
	planning = false
	missile:Destroy()
	cam.CameraSubject = hum
	freezeConn:Disconnect()
	for _, t in ipairs(tracks) do pcall(function() t:AdjustSpeed(1) end) end
	tint(false)

	-- your real body flies the exact path you planned
	if hum.Health > 0 and #path > 1 then
		hum.PlatformStand = true
		-- NOT anchored: the client owns an unanchored character, so its movement replicates and other players see it fly
		root.Anchored = false
		local parts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.CanCollide then table.insert(parts, d) end
		end
		local a0 = new("Attachment", {Position = Vector3.new(1.5, 0, 0)}, root)
		local a1 = new("Attachment", {Position = Vector3.new(-1.5, 0, 0)}, root)
		local trail = new("Trail", {
			Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(BLUE), LightEmission = 1,
			Lifetime = .8, Transparency = NumberSequence.new(.2, 1),
		}, root)
		local i, acc2 = 1, 0
		while i <= #path and hum.Health > 0 do
			acc2 += RS.Heartbeat:Wait()
			for _, d in ipairs(parts) do d.CanCollide = false end
			while acc2 >= STEP and i <= #path do
				acc2 -= STEP
				local e = path[i]
				i += 1
				-- lie flat like a missile: head points along the flight direction
				root.CFrame = CFrame.lookAt(e.pos, e.pos + e.dir) * CFrame.Angles(-math.pi / 2, 0, 0)
				root.AssemblyLinearVelocity = e.dir * missileSpeed -- real velocity so it replicates smoothly
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
		local last = path[#path]
		local flat = Vector3.new(last.dir.X, 0, last.dir.Z)
		if flat.Magnitude < .01 then flat = Vector3.new(0, 0, -1) end
		local landing = last.pos + Vector3.new(0, 2, 0)
		if hasPhase then
			-- if you ended inside something, pop up to the first free spot
			local op = OverlapParams.new()
			op.FilterDescendantsInstances = {char, coinFolder}
			for _ = 1, 60 do
				if #workspace:GetPartBoundsInBox(CFrame.new(landing), Vector3.new(4, 6, 4), op) == 0 then break end
				landing += Vector3.new(0, 4, 0)
			end
		end
		root.CFrame = CFrame.lookAt(landing, landing + flat)
		root.AssemblyLinearVelocity = Vector3.zero
		for _, d in ipairs(parts) do d.CanCollide = true end
		hum.PlatformStand = false
		task.delay(1, function() trail:Destroy() a0:Destroy() a1:Destroy() end)
	end
	root.Anchored = false
	lastMissile = os.clock()
	missileBusy = false
end

---------------------------------------------------------------- ESP (blue)
local esp = {}
local function destroyRec(rec)
	if rec then rec.hl:Destroy() rec.bill:Destroy() rec.arrow:Destroy() end
end

local function build(p, c)
	local hl = new("Highlight", {
		Adornee = c, OutlineColor = BLUE, FillColor = BLUE,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false,
	}, c)
	local bill = new("BillboardGui", {
		Adornee = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"),
		Size = UDim2.fromOffset(120, 24), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Enabled = false,
	}, c)
	new("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = p.DisplayName, TextColor3 = BLUE,
		TextStrokeTransparency = 0, TextScaled = true, Font = Enum.Font.GothamBold,
	}, bill)
	local arrow = new("Frame", {
		Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = BLUE, Visible = false,
	}, gui)
	new("UICorner", {CornerRadius = UDim.new(1, 0)}, arrow)
	local tip = new("Frame", {
		Size = UDim2.fromOffset(8, 14), Position = UDim2.new(.5, -4, 0, -10), BackgroundColor3 = BLUE, BorderSizePixel = 0,
	}, arrow)
	return {hl = hl, bill = bill, arrow = arrow, char = c}
end

Players.PlayerRemoving:Connect(function(p) destroyRec(esp[p]) esp[p] = nil end)

RS.RenderStepped:Connect(function()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local c = p.Character
			local rec = esp[p]
			if rec and rec.char ~= c then destroyRec(rec) rec = nil esp[p] = nil end
			if c and not rec and c:FindFirstChild("HumanoidRootPart") then
				rec = build(p, c)
				esp[p] = rec
			end
			if rec then
				local show = on.esp and espTier >= 1
				rec.hl.Enabled = show
				rec.hl.FillTransparency = espTier >= 3 and .5 or 1 -- chams at tier 3
				rec.bill.Enabled = show and espTier >= 2         -- names at tier 2
				local arrowShow = false
				if show and espTier >= 4 then                     -- offscreen arrows at tier 4
					local v, onScreen = cam:WorldToViewportPoint(c.HumanoidRootPart.Position)
					if not onScreen then
						local vs = cam.ViewportSize
						local center = vs / 2
						local dir = Vector2.new(v.X, v.Y) - center
						if v.Z < 0 then dir = -dir end
						if dir.Magnitude > 0 then
							dir = dir.Unit
							local r = math.min(vs.X, vs.Y) / 2 - 40
							rec.arrow.Position = UDim2.fromOffset(center.X + dir.X * r, center.Y + dir.Y * r)
							rec.arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
							arrowShow = true
						end
					end
				end
				rec.arrow.Visible = arrowShow
			end
		end
	end
end)
