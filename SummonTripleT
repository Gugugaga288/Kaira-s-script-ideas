-- effective values (a buff only counts while its toggle is ON)
local function eTime() return on.mdur and missileTime or BASE_MTIME end
local function eSpeed() return on.mspeed and missileSpeed or BASE_MSPEED end
local function eCd() return on.mcd and missileCd or BASE_MCD end
local function ePhase() return hasPhase and on.mphase end
local function maxJumps()
	if not on.mjump then return 1 end
	if hasTriple then return 3 elseif hasDouble then return 2 end
	return 1
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o, r) new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end
local function cost() return 5 * (summons + 1) end -- the summon fee

-- Item prices are paid ON TOP of the summon fee. {base, extra per stack already owned}, so every stack costs more.
local PRICES = {
	speed = {2, 1}, jump = {2, 1}, esp = {3, 2}, mdur = {3, 2}, mspeed = {3, 2}, mcd = {4, 2}, mphase = {8, 0},
	mjump = {2, 3}, gdur = {3, 2}, glide = {10, 0}, missile = {12, 0}, multi = {10, 0}, magnet = {8, 0}, mercy = {8, 4},
}
local SUPER_PRICES = {speed = {6, 3}, jump = {6, 3}} -- super speed/jump are pricier
local function itemPrice(key, super)
	if key == "djump" or key == "tjump" then key = "mjump" end
	local p = (super and SUPER_PRICES[key]) or PRICES[key]
	if not p then return 0 end
	return p[1] + p[2] * (lv[key] or 0)
end

local useMissile, startGlide, stopGlide, sync, refreshAdmin, spawnBabies

local function grant(key, super)
	if key == "djump" or key == "tjump" then key = "mjump" end
	if lv[key] == nil or lv[key] >= (CAP[key] or 99) then return false end
	if (key == "mdur" or key == "mspeed" or key == "mcd" or key == "mphase") and lv.missile == 0 then lv.missile = 1 end
	if key == "gdur" and lv.glide == 0 then lv.glide = 1 end
	lv[key] += 1
	if key == "speed" then table.insert(speedSteps, super and SUPER_SPEED or SPEED_STEP)
	elseif key == "jump" then table.insert(jumpSteps, super and SUPER_JUMP or JUMP_STEP) end
	if on[key] ~= nil then on[key] = true end
	return true
end

local function revoke(key)
	if lv[key] == nil or lv[key] <= 0 then return false end
	lv[key] -= 1
	if key == "speed" then table.remove(speedSteps) elseif key == "jump" then table.remove(jumpSteps) end
	return true
end

