-- recompute every buff variable from the levels, then refresh all the UI
sync = function()
	speedBonus, jumpBonus = 0, 0
	for _, v in ipairs(speedSteps) do speedBonus += v end
	for _, v in ipairs(jumpSteps) do jumpBonus += v end
	espTier = lv.esp
	hasMissile, hasPhase = lv.missile > 0, lv.mphase > 0
	missileTime = BASE_MTIME + DUR_STEP * lv.mdur
	missileSpeed = BASE_MSPEED + MSPEED_STEP * lv.mspeed
	missileCd = math.max(MIN_CD, BASE_MCD - CD_STEP * lv.mcd)
	hasDouble, hasTriple = lv.mjump >= 1, lv.mjump >= 2
	hasGlide, hasMulti, hasMagnet = lv.glide > 0, lv.multi > 0, lv.magnet > 0
	mercy = lv.mercy
	glideMax = GLIDE_TIME + (on.gdur and GDUR_STEP * lv.gdur or 0)
	glideEnergy = math.min(glideEnergy, glideMax)
	refresh()
	refreshPanel()
	applyBuffs()
	refreshAdmin()
end

local function resetAll()
	summons = 0
	for k in pairs(lv) do lv[k] = 0 end
	speedSteps, jumpSteps = {}, {}
	for k in pairs(on) do on[k] = false end
	panelOpen = false
	sync()
end

local killedByTung, pendingBabies = false, false
local function onDeath()
	if DEATH_WIPES_ALL or killedByTung then
		if lv.mercy > 0 then
			lv.mercy -= 1 -- Mercy: keep everything, baby Tungs rain down when you respawn
			pendingBabies = true
			sync()
		else
			resetAll() -- lose every buff, summon fee back to 5
		end
	end
	killedByTung = false
end
local function hookDeath(char)
	local h = char:WaitForChild("Humanoid", 10)
	if h then h.Died:Connect(onDeath) end
end
if lp.Character then task.spawn(hookDeath, lp.Character) end
