	popEffect(n.pos, MATERIALS[n.mat].color)
	n.model.Parent = nil
	task.delay(RESPAWN_TIME + n.phase * 3, function()
		pcall(function()
			n.model.Parent = n.folder
			n.active = true
		end)
	end)
end

track(RunService.Heartbeat:Connect(function()
	local d = currentDim
	if not d or not d.nodes_built then return end
	local _, root = getHumanoid()
	local t = os.clock()
	for _, n in ipairs(d.nodes_built) do
		if n.active then
			n.model:PivotTo(CFrame.new(n.pos + V(0, math.sin(t * 2 + n.phase) * 0.4, 0)) * CFrame.Angles(0, t * 1.4 + n.phase, 0))
			if root and (root.Position - n.pos).Magnitude < COLLECT_RADIUS then
				collectNode(n)
			end
		end
	end
	-- safety: if you somehow fall off, go back to the arrival pad
	if root and root.Position.Y < d.base.Y - 60 then
		root.CFrame = CFrame.new(d.base + V(0, 6, 0))
		root.AssemblyLinearVelocity = Vector3.zero
	end
end))

