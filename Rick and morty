function updateSideButtons()
	for id, entry in pairs(sideButtons) do
		local isHere = (id == "home" and currentDim == nil) or (currentDim ~= nil and currentDim.id == id)
		entry.stroke.Thickness = isHere and 3.5 or 1.5
		entry.button.BackgroundColor3 = isHere and Color3.fromRGB(55, 55, 75) or Color3.fromRGB(24, 24, 32)
	end
end

local function travelTo(d)
	if traveling then return end
	if d == currentDim then
		toast(d and ("You're already in " .. d.name) or "You're already home")
		return
	end
	local _, root = getHumanoid()
	if not root then return end

	if inBench then
		local hum = getHumanoid()
		if hum then hum:UnequipTools() end
		exitBench()
	end

	traveling = true
	fadeTo(0, 0.25)
	local _, root2 = getHumanoid()
	if root2 then
		if d then
			buildDimension(d)
			if not currentDim then homeCF = root2.CFrame end
			root2.CFrame = CFrame.new(d.base + V(0, 6, 0))
		elseif homeCF then
			root2.CFrame = homeCF
		end
		root2.AssemblyLinearVelocity = Vector3.zero
		setCurrentDim(d)
	end
	fadeTo(1, 0.35)
	traveling = false
	toast(d and ("Dimension " .. d.tag .. ": " .. d.name) or "Back home")
end

